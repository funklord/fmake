@case
def a_pattern_rule_may_not_mix_a_stem_with_a_glob(t):
	"""`gen/%.c: schemas/*/%.msg` is the rule anyone writes for a tree that
	keeps one schema per directory, and it cannot work.

	The stem is the text between the fixed halves of the prerequisite, taken
	by position -- so a `*` beside the `%` makes those halves a pattern
	rather than text, the slice lands in the wrong place, and the stem comes
	out as a fragment of a path. It produced `p/bmp` from `schemas/*/%.msg`
	and then failed by saying `schemas/*/p/bmp.msg` matched nothing, naming
	a path nobody had written.

	Found while asking why situ needs ten near-identical generate rules
	rather than one."""
	t.write("schemas/bmp/bmp.msg", "x\n")
	t.write("main.c", "int made_bmp(void);\n"
	        "int main(void){ return made_bmp(); }\n")
	t.write("fmake.mk", "gen/%.c: schemas/*/%.msg\n"
	        '\t@mkdir -p gen && echo "int made_$*(void){ return 0; }" > $@\n')

	r = t.fmake()
	check(r.returncode != 0, "the mixed form should be refused")
	out = r.stdout + r.stderr
	check("mixes % with a glob" in out, f"and say why: {out}")
	check("matched nothing" not in out,
	      f"not by blaming a path nobody wrote: {out}")

	# The ordinary form is untouched.
	t.write("schemas/bmp.msg", "x\n")
	t.write("fmake.mk", "gen/%.c: schemas/%.msg\n"
	        '\t@mkdir -p gen && echo "int made_$*(void){ return 0; }" > $@\n')
	r = t.fmake("-B")
	check(r.returncode == 0, f"a plain pattern rule still works: {r.stderr}")


@case
def mk_refuses_directives_that_need_a_file(t):
	"""@target names an artifact and @os describes one translation unit.

    fmake.mk has neither, so accepting them there would mean inventing a
    scope for them. Saying so beats guessing.

    Which remedy the message offers is per directive, not a fixed sentence.
    [target.*] takes `kind` and `target`; it does not take `os`, and this
    case asserted it did until the schema was consulted instead of assumed
    -- section 31 written into a test."""
	t.write("main.c", "int main(void){ return 0; }\n")
	for directive, expect, conf in (("@target thing", "target", True),
	                                ("@os linux", "os", False),
	                                ("@kind static", "kind", True)):
		t.write("fmake.mk", directive + "\n")
		r = t.fmake()
		check(r.returncode != 0, f"{directive} should be refused here")
		check(expect in r.stderr,
		      f"the message should name the directive: {r.stderr}")
		check(("fmake.toml" in r.stderr) == conf,
		      f"{directive}: [target.*] {'has' if conf else 'has no'} key "
		      f"for it, so it {'should' if conf else 'should not'} be "
		      f"offered: {r.stderr}")


@case
def a_conf_carrying_only_directives_is_not_discarded(t):
	"""`conf or default` is a trap when __bool__ means something.

    Conf answers "is anything configured", so one holding directives folded
    in from fmake.mk was falsy with no fmake.toml present, and `or` threw it
    away -- the compile silently lost every flag."""
	t.write("fmake.mk", "@define TOKEN=99\n")
	t.write("main.c", """
#include <stdio.h>
int main(void){ printf("%d\\n", TOKEN); return 0; }
""")
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
