@case
def advice_names_only_a_place_that_exists(t):
	"""section 31 again: a remedy that does not work is worse than none.

	`@target` in fmake.mk is refused with an offer of [target.*], which is
	real. `@pkg_optional` has no such key, and offering one would send the
	reader to write something fmake then rejects."""
	t.write("main.c", "int main(void){ return 0; }\n")
	t.write("fmake.mk", "@pkg_optional zlib defines HAVE_ZLIB\n")

	out = t.fmake().stdout + t.fmake().stderr
	check("[target.*]" not in out,
	      f"there is no [target.*] key for @pkg_optional: {out}")

	t.write("fmake.mk", "@target foo\n")
	out = t.fmake().stdout + t.fmake().stderr
	check("[target.*]" in out,
	      f"@target does have one, and should still be offered: {out}")


@case
def a_headers_name_must_match_a_whole_path_component(t):
	"""`<zlib.h>` is not answered by a local `xzlib.h`.

	The depfile holds resolved paths and the proposal holds include text, so
	the two are matched on a suffix -- which is the -I search run backwards
	and correct only if the match starts at a separator. Without one, any
	header whose name merely *ends* with the proposal satisfies it, the
	guarded include looks like it was read, and the finding vanishes: a
	silent build again, by a second route.

	Mutation found this. None of the three cases written first failed when
	the separator was dropped, because none of them had a header that could
	collide."""
	if not _have_pkg("zlib"):
		raise Skip("zlib has no pkg-config file here")
	t.write("xzlib.h", "#pragma once\n")
	t.write("main.c",
	        '#include <stdio.h>\n#include "xzlib.h"\n'
	        "#ifdef HAVE_ZLIB\n#include <zlib.h>\n#endif\n"
	        "int main(void){\n"
	        "#ifdef HAVE_ZLIB\n\tprintf(\"%s\\n\", zlibVersion());\n#endif\n"
	        "\treturn 0;\n}\n")

	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	out = r.stdout + r.stderr
	check("the preprocessor did not take" in out,
	      f"xzlib.h must not answer for zlib.h: {out}")


def _vendored_tree(t, marker):
	"""Our program, a vendored library we use, and that library's own test."""
	t.write("src/main.c",
	        '#include "../flog/flog.h"\n'
	        "int main(void){ flog_say(); return 0; }\n")
	t.write("flog/flog.h", "void flog_say(void);\n")
	t.write("flog/flog.c",
	        '#include <stdio.h>\n#include "flog.h"\n'
	        'void flog_say(void){ puts("hi"); }\n')
	t.write("flog/tests/test.c",
	        '#include "../flog.h"\nint main(void){ flog_say(); return 0; }\n')
	marker(t)


def _as_submodule_file(t):
	t.write("flog/.git", "gitdir: ../.git/modules/flog\n")


def _as_gitmodules_entry(t):
	t.write(".gitmodules", '[submodule "flog"]\n\tpath = flog\n'
	                       "\turl = https://example.invalid/flog\n")


@case
def a_submodules_own_programs_are_left_to_it(t):
	"""A main() in a vendored checkout is that project's program, not ours.

	Two evaluations reported this from opposite ends of the same tree: one
	found its submodule's four upstream tools built, the other ten vendored
	fuzzers and two programs both called `test`. Neither wanted them, and
	both wanted the *library* out of the same directory -- so ignoring the
	subtree wholesale would have been just as wrong as building it.

	The signal is a `.git` git put there. What it changes is only whether a
	file roots a target; the file stays in the pool, and the library sources
	beside it link exactly as before."""
	_vendored_tree(t, _as_submodule_file)

	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	out = r.stdout + r.stderr
	check(not os.path.exists(os.path.join(t.dir, "test")),
	      f"built the submodule's own program: {out}")
	check(os.path.exists(os.path.join(t.dir, os.path.basename(t.dir))),
	      f"did not build our program: {out}")
	check("separate checkout" in out,
	      f"passing over the program should be said out loud: {out}")
	# The point of not ignoring the subtree: its library is still ours.
	check(t.run(os.path.basename(t.dir)).stdout == "hi\n",
	      "the vendored library did not get linked in")


@case
def gitmodules_marks_a_subtree_as_vendored_too(t):
	"""The other signal, and the only one a fresh clone has.

	`git submodule init` has not run, so the directory holds sources and no
	`.git` at all -- which is the state a CI checkout is in about half the
	time. The path is in `.gitmodules` either way."""
	_vendored_tree(t, _as_gitmodules_entry)

	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check(not os.path.exists(os.path.join(t.dir, "test")),
	      f"built the submodule's own program: {r.stdout}{r.stderr}")


@case
def a_vendored_program_can_be_asked_for(t):
	"""Passed over is not refused.

	`@target` in the source is the usual way to settle what a file is, and
	it is unavailable here for the same reason the feature exists: a project
	that vendors code by reference does not edit it. So the escape has to be
	in fmake.toml, where naming the root builds it."""
	_vendored_tree(t, _as_submodule_file)
	t.write("fmake.toml", '[target.flogtest]\nroot = "flog/tests/test.c"\n')

	# Named outright, because the file it roots is under tests/ and is a
	# test as well as vendored: two independent reasons not to build it by
	# default, and one way to ask for it anyway.
	r = t.fmake("flogtest")
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check(t.run("flogtest").returncode == 0,
	      f"asked-for vendored program did not build: {r.stdout}{r.stderr}")


@case
def a_vendored_main_stays_out_of_a_library(t):
	"""It stopped rooting a target; it did not stop being an entry point.

	With no main() of our own the tree is one archive, and the rule that
	keeps a program's root out of it is keyed on the roots -- which this
	file no longer is. An archive carrying a second `main` links into the
	next program that uses it and reports a duplicate symbol under a path in
	.fmake, which is section 28 arriving by a door the fix opened."""
	_vendored_tree(t, _as_submodule_file)
	os.unlink(os.path.join(t.dir, "src/main.c"))
	t.write("src/lib.c", "int ours(void){ return 7; }\n")

	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	lib = os.path.join(t.dir, f"lib{os.path.basename(t.dir)}.a")
	check(os.path.exists(lib), f"no archive built: {r.stdout}{r.stderr}")
	syms = subprocess.run(["nm", "--format=posix", lib],
	                      capture_output=True, text=True).stdout
	check(not re.search(r"^main [TT]", syms, re.M),
	      f"the archive carries the vendored main(): {syms}")


def _unrunnable(path):
	"""An executable file no binfmt handler will claim.

    An aarch64 binary is the obvious way to write "cannot run here" and is
    wrong on this machine: qemu is registered in binfmt_misc, so a target
    binary executes rather than failing. Bytes that are no format at all
    are refused everywhere, which is what the case needs.
    """
	with open(path, "wb") as fh:
		fh.write(b"\x01\x02\x03\x04not any executable format\n")
	os.chmod(path, 0o755)
	return path


@case
def a_moc_that_cannot_run_says_who_chose_it(t):
	"""Section 17 listed this as reported-but-untested. It is testable.

	On a cross build the moc pkg-config names may be a target binary that
	cannot execute on the build machine. The failure was handled and the
	message named `[toolchain] moc' -- which is right when pkg-config
	found it, and wrong the rest of the time: a reader who set
	`[toolchain] moc' was told to set `[toolchain] moc'. Section 31's
	pattern, in advice rather than in a summary.

	All three routes to a moc are reachable here. Neither named route
	needs a cross toolchain: a file that is no executable format is
	refused by every kernel, which is what "cannot run here" means to
	`subprocess`. The unnamed route needs pkg-config to name the broken
	one, and a `.pc` on `PKG_CONFIG_PATH` whose `libexecdir` points at it
	does that -- so the branch that keeps the original advice is checked
	too, rather than left as the one nothing reaches."""
	_need_qt()
	t.write("app.h", "#pragma once\n#include <QtCore/QObject>\n"
	        "class App : public QObject { Q_OBJECT public: App(); };\n")
	t.write("app.cpp", "/*! @file\n *  @pkg Qt6Core\n */\n"
	        '#include "app.h"\nApp::App() {}\nint main(){ App a; return 0; }\n')
	broken = _unrunnable(os.path.join(t.dir, "fake-moc"))

	t.write("fmake.toml", f'[toolchain]\nmoc = "{broken}"\n')
	r = t.fmake()
	check(r.returncode != 0, "a moc that cannot run should stop the build")
	out = r.stdout + r.stderr
	check("[toolchain] moc in fmake.toml and cannot execute" in out,
	      f"the message does not say that the configured moc is the one "
	      f"that failed, which is the whole correction: {out}")

	os.unlink(os.path.join(t.dir, "fmake.toml"))
	r = t.fmake(env={"MOC": broken})
	check("comes from $MOC" in (r.stdout + r.stderr),
	      f"$MOC is not named as the source: {r.stdout}{r.stderr}")

	# The branch that keeps the original advice, which is the one a real
	# cross build hits. Nothing else here reaches it.
	os.makedirs(os.path.join(t.dir, "bin"), exist_ok=True)
	shutil.copy(broken, os.path.join(t.dir, "bin/moc"))
	os.chmod(os.path.join(t.dir, "bin/moc"), 0o755)
	os.makedirs(os.path.join(t.dir, "pc"), exist_ok=True)
	real = subprocess.run(["pkg-config", "--cflags", "--libs", "Qt6Core"],
	                      capture_output=True, text=True).stdout.strip()
	t.write("pc/Qt6Core.pc",
	        f"prefix=/usr\nlibexecdir={t.dir}/bin\n"
	        f"Name: Qt6Core\nDescription: shadowed for a test\n"
	        f"Version: 6.8.0\nCflags: {real}\nLibs: {real}\n")
	r = t.fmake(env={"PKG_CONFIG_PATH": os.path.join(t.dir, "pc")})
	out = r.stdout + r.stderr
	check("moc pkg-config names is the target's" in out,
	      f"the unnamed route lost the advice that is right for it: {out}")
	check("comes from" not in out,
	      f"the unnamed route claims somebody chose this moc: {out}")


def _clang():
	"""clang, including the versioned install that is not on $PATH."""
	found = shutil.which("clang")
	if found:
		return found
	cands = sorted(glob.glob("/usr/lib/llvm-*/bin/clang"))
	return cands[-1] if cands else None


@case
def clang_lto_emits_bitcode_and_the_closure_still_works(t):
	"""Section 15 called this untested because clang was not installed.

	It is, at /usr/lib/llvm-19/bin/clang -- not on $PATH, which is the
	whole reason the entry said otherwise. The concern it recorded was
	specific and worth checking rather than assuming: `clang -flto` emits
	pure bitcode where gcc emits an ELF object with extra sections, and an
	object nm reads nothing from defines nothing, so *every* file would
	look like it provides nothing and the closure would link an empty
	program.

	It does not happen. The objects really are bitcode -- the fixture
	checks the magic rather than trusting the flag -- and the closure is
	exactly right: the file reached by symbol is compiled, the file
	reached by nothing is not."""
	clang = _clang()
	if not clang:
		raise Skip("clang not installed")
	t.write("fmake.toml", f'[toolchain]\ncc = "{clang}"\n')
	t.write("helper.c", "int helper(void){ return 7; }\n")
	t.write("unused.c", "int unused_file(void){ return 1; }\n")
	t.write("main.c", "int helper(void);\nint main(void){ "
	        "return helper() - 7; }\n")

	r = t.fmake("--cflags", "-flto -Os")
	check(r.returncode == 0, f"clang -flto build failed: {r.stdout}{r.stderr}")

	objs = glob.glob(os.path.join(t.dir, ".fmake/obj/*/helper.c.o"))
	check(objs, "no object for helper.c")
	with open(objs[0], "rb") as fh:
		magic = fh.read(4)
	check(magic == b"BC\xc0\xde",
	      f"the fixture did not produce bitcode, so it checks nothing about "
	      f"reading bitcode: magic is {magic!r}")

	check("unused.c" not in r.stdout.split("LD")[0],
	      f"unused.c was compiled, so the closure is not being computed "
	      f"from these symbols: {r.stdout}")
	prog = os.path.join(t.dir, os.path.basename(t.dir))
	check(_run_in(t.dir, "./" + os.path.basename(t.dir)).returncode == 0,
	      f"the linked binary does not run, so nm read the bitcode but "
	      f"something downstream did not: {prog}")


@case
def an_unreadable_bitcode_object_says_it_is_bitcode(t):
	"""The right advice needs the file, not the error text.

	nm reads bitcode only because LLVMgold.so is installed as a BFD plugin
	-- a property of the machine, not of the tree -- so the failure section
	15 feared is real on a machine without it. fmake already dies rather
	than silently linking nothing, which is the important half.

	The advice was the wrong half. `elf_identity` returns None for a file
	that is not ELF, so the message asked for an nm understanding
	`unknown` objects and named [toolchain] nm -- sending a reader to look
	for a cross-toolchain problem they do not have, when the first four
	bytes say LLVM bitcode and the fix is llvm-nm. The file knew; the line
	printing the advice had not asked it.

	No clang needed: a compiler that writes bitcode magic and an nm that
	refuses it are the whole condition, and both are shims."""
	cc = os.path.join(t.dir, "cc-bitcode")
	with open(cc, "w") as fh:
		fh.write("#!/bin/sh\n"
		         "# Writes bitcode magic to whatever -o names.\n"
		         "out=\n"
		         "while [ $# -gt 0 ]; do\n"
		         "\t[ \"$1\" = -o ] && { out=$2; shift 2; continue; }\n"
		         "\tshift\n"
		         "done\n"
		         "printf 'BC\\300\\336' > \"$out\"\n")
	nm = os.path.join(t.dir, "nm-noplugin")
	with open(nm, "w") as fh:
		fh.write("#!/bin/sh\n"
		         "# A binutils nm with no LLVM plugin: bitcode is a format\n"
		         "# it does not recognise.\n"
		         "echo \"nm: file format not recognized\" >&2\n"
		         "exit 1\n")
	for path in (cc, nm):
		os.chmod(path, 0o755)
	t.write("main.c", "int main(void){ return 0; }\n")

	r = t.fmake(env={"CC": cc, "NM": nm})
	check(r.returncode != 0, "an unreadable object should stop the build")
	out = r.stdout + r.stderr
	check("bitcode" in out.lower(),
	      f"the message does not say what the file is: {out}")
	check("llvm-nm" in out,
	      f"the message does not name the nm that would read it: {out}")
	check("unknown" not in out,
	      f"the message still describes bitcode as an unknown object "
	      f"identity, which is the advice this case exists to remove: {out}")


# ---------------------------------------------------------------------------

def run_case(c):
	"""Run one case in its own tree. Returns (status, detail)."""
	t = Tree(c.__name__)
	try:
		c(t)
		return "ok", ""
	except Skip as exc:
		return "skip", str(exc)
	except Failure as exc:
		return "fail", str(exc) + (f"\n       tree: {t.dir}" if KEEP else "")
	except Exception as exc:                           # noqa: BLE001
		return "err", repr(exc)
	finally:
		t.cleanup()


def main(argv):
	global KEEP, JOBS
	pats = [a for a in argv if not a.startswith("-")]
	KEEP = "-k" in argv
	for a in argv:
		if a.startswith("-j"):
			JOBS = max(1, int(a[2:] or 1))

	if not os.access(FMAKE, os.X_OK):
		print(f"{RED}fmake is not executable at {FMAKE}{OFF}")
		return 2

	cases = [c for c in CASES
	         if not pats or any(p in c.__name__ for p in pats)]
	failures = skipped = 0

	with concurrent.futures.ThreadPoolExecutor(max_workers=JOBS) as pool:
		results = list(pool.map(run_case, cases))

	for c, (status, detail) in zip(cases, results):
		if status == "ok":
			print(f"{GREEN}ok{OFF}   {c.__name__}")
		elif status == "skip":
			skipped += 1
			print(f"{DIM}skip {c.__name__} -- {detail}{OFF}")
		elif status == "fail":
			failures += 1
			print(f"{RED}FAIL{OFF} {c.__name__}")
			print(f"       {detail}")
		else:
			failures += 1
			print(f"{RED}ERR {OFF} {c.__name__}: {detail}")

	print()
	tail = f" ({skipped} skipped)" if skipped else ""
	if failures:
		print(f"{RED}{failures} of {len(cases)} failed{OFF}{tail}")
	else:
		print(f"{GREEN}all {len(cases) - skipped} passed{OFF}{tail}")
	return 1 if failures else 0


if __name__ == "__main__":
	try:
		sys.exit(main(sys.argv[1:]))
	except KeyboardInterrupt:
		sys.exit(130)
