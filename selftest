# ---------------------------------------------------------------------------
# Vendored archives
#
# A .a shipped in the tree is a provider of symbols like any object: nm reads
# it the same way, and posix format puts each member on its own header line,
# which the parser already skips. So the closure needs nothing new. What an
# archive does need is to be kept out of the compile step and put in the
# right place on the link line, which is where all of these cases look.
# ---------------------------------------------------------------------------


def _vendor(t, rel, stem, body, extra=None):
	"""Build a .a in the tree without fmake, leaving no source behind.

    The sources are removed afterwards on purpose: with them in place the
    symbols would come from translation units and the archive would prove
    nothing. `extra` adds a second member, which is what it takes to build an
    archive cycle no link order can satisfy.
    """
	objs, tmp = [], []
	for name, text in [(stem, body)] + ([extra] if extra else []):
		src = os.path.join(t.dir, name + ".c")
		obj = os.path.join(t.dir, name + ".o")
		with open(src, "w") as fh:
			fh.write(text)
		check(subprocess.run(["cc", "-c", src, "-o", obj]).returncode == 0,
		      f"could not compile {name}.c")
		objs.append(obj)
		tmp += [src, obj]
	path = os.path.join(t.dir, rel)
	os.makedirs(os.path.dirname(path), exist_ok=True)
	check(subprocess.run(["ar", "rcs", path] + objs).returncode == 0,
	      f"could not archive {rel}")
	for f in tmp:
		os.remove(f)


@case
def a_named_prebuilt_object_is_linked(t):
	"""section 18 closed this for `.a` and guessed the rest would follow.

	It does, mechanically: nm reads a loose object exactly as it reads an
	archive, so the closure needs nothing new and `vendor/blob.o` joins the
	link set by symbol like anything else.

	What does not follow is *discovering* them, which is why this is
	declared. See the case below."""
	if not shutil.which("cc"):
		raise Skip("cc not installed")
	blob = os.path.join(t.dir, "vendor")
	os.makedirs(blob, exist_ok=True)
	src = os.path.join(blob, "blob.c")
	with open(src, "w") as fh:
		fh.write("int blob_value(void){ return 9; }\n")
	check(subprocess.run(["cc", "-c", src, "-o",
	                      os.path.join(blob, "blob.o")]).returncode == 0,
	      "could not build the blob")
	os.remove(src)

	t.write("main.c", "/*! @file\n *  @sources vendor/blob.o\n */\n"
	        "int blob_value(void);\n"
	        "int main(void){ return blob_value() - 9; }\n")
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check(t.run(os.path.basename(t.dir)).returncode == 0,
	      "the program did not get the blob's value")

	r = t.fmake("--explain")
	check("vendor/blob.o" in r.stdout,
	      f"the prebuilt object is not in the link set: {r.stdout}")
	# An object is not searched member by member, so it must not be inside
	# the archive group -- that is for things the linker searches.
	link = [l for l in r.stdout.splitlines() if " -o " in l and " -c " not in l]
	check(link, "no link line in --explain")
	check("--start-group" not in link[0],
	      f"a prebuilt object was put in the archive group: {link[0]}")

	# It has to survive the exit, in both forms, or a project that leaves
	# takes a build file that silently drops a blob it needs.
	for kind, cmd in (("make", ["make", "-s"]),
	                  ("ninja", ["ninja", "-f", "build.ninja"])):
		if not shutil.which(cmd[0]):
			continue
		r = t.fmake("--eject", *([] if kind == "make" else ["ninja"]))
		check(r.returncode == 0, f"eject {kind} failed: {r.stderr}")
		name = "Makefile" if kind == "make" else "build.ninja"
		with open(os.path.join(t.dir, name), "w") as fh:
			fh.write(r.stdout)
		check("vendor/blob.o" in r.stdout,
		      f"the ejected {kind} build lost the prebuilt object")
		shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
		built = _run_in(t.dir, *cmd)
		check(built.returncode == 0,
		      f"the ejected {kind} build failed: {built.stdout}{built.stderr}")
		check(t.run(os.path.basename(t.dir)).returncode == 0,
		      f"the ejected {kind} build produced a broken program")

	# Named and absent is a mistake, not an empty list.
	t.write("main.c", "/*! @file\n *  @sources vendor/ghost.o\n */\n"
	        "int main(void){ return 0; }\n")
	r = t.fmake()
	check(r.returncode != 0, "a .o that is not there should be an error")


@case
def a_stray_object_beside_its_source_is_ignored(t):
	"""Discovering prebuilt objects would be a regression, not a feature.

	A `.o` next to its `.c` is what a hand-compile leaves behind, and it is
	ordinary litter -- a kernel checkout has dozens. Picking those up turns
	a tree that builds today into one reporting two providers for every
	symbol, where the second is a stale object nobody meant to keep.

	So they are declared, never discovered, and naming one is the whole
	difference between a vendored blob and a leftover. This case is what
	says the discovery version stays unbuilt."""
	if not shutil.which("cc"):
		raise Skip("cc not installed")
	t.write("helper.c", "int helper(void){ return 3; }\n")
	t.write("main.c", "int helper(void);\n"
	        "int main(void){ return helper() - 3; }\n")
	# Exactly what `cc -c helper.c` leaves in the directory, and stale on
	# purpose: if it were picked up the program would return 8, not 0.
	stale = os.path.join(t.dir, "stale.c")
	with open(stale, "w") as fh:
		fh.write("int helper(void){ return 11; }\n")
	check(subprocess.run(["cc", "-c", stale, "-o",
	                      os.path.join(t.dir, "helper.o")]).returncode == 0,
	      "could not build the stale object")
	os.remove(stale)

	r = t.fmake()
	check(r.returncode == 0,
	      f"a stray .o broke a build that has nothing to do with it: "
	      f"{r.stdout}{r.stderr}")
	check(t.run(os.path.basename(t.dir)).returncode == 0,
	      "the stale object was linked instead of the compiled source")
	r = t.fmake("--explain")
	check("helper.o" not in r.stdout.replace("helper.c.o", ""),
	      f"the stray object reached the build: {r.stdout}")


@case
def an_ambiguity_says_when_git_already_ignores_one(t):
	"""The commonest confusing collision, and git knew all along.

	A build output left in the tree collides with the file it was generated
	from. The reader is shown two files defining one symbol and given no
	reason to prefer either -- while `.gitignore` has said for years that
	one of them is not source. The regression sweep in section 107 hit
	exactly this twice, in two different projects, and both times the
	answer was sitting in a file fmake had not looked at.

	**Not a signal fmake builds with.** What to compile is decided from the
	source, and adding a second authority for that is a design change. This
	is consulted only while explaining a failure, on a path about to exit,
	so it costs one subprocess and can be wrong without costing anything.

	The half worth guarding is the quiet one: when git ignores *neither*
	provider, or *both*, there is nothing to say and saying it would be
	noise on top of a message that is already hard to read."""
	if not shutil.which("git"):
		raise Skip("git not installed")
	check(subprocess.run(["git", "init", "-q", t.dir],
	                     capture_output=True).returncode == 0,
	      "could not make a repository")
	t.write(".gitignore", "generated_*.c\n")
	t.write("real.c", "int shared_thing(void){ return 1; }\n")
	t.write("generated_copy.c", "int shared_thing(void){ return 1; }\n")
	t.write("main.c", "int shared_thing(void);\n"
	        "int main(void){ return shared_thing() - 1; }\n")

	r = t.fmake()
	check(r.returncode != 0, "two providers of one symbol should be refused")
	said = r.stdout + r.stderr
	check("git is told to ignore generated_copy.c" in said,
	      f"the ignored file was not named: {said}")
	check("exclude" in said, f"no remedy was offered: {said}")

	# Neither ignored: nothing to say.
	u = Tree("neither")
	try:
		check(subprocess.run(["git", "init", "-q", u.dir],
		                     capture_output=True).returncode == 0,
		      "could not make a repository")
		u.write("a.c", "int shared_thing(void){ return 1; }\n")
		u.write("b.c", "int shared_thing(void){ return 1; }\n")
		u.write("main.c", "int shared_thing(void);\n"
		        "int main(void){ return shared_thing() - 1; }\n")
		r = u.fmake()
		check(r.returncode != 0, "the ambiguity should still be refused")
		check("git is told to ignore" not in r.stdout + r.stderr,
		      f"said something about git when it had nothing to say: "
		      f"{r.stdout}{r.stderr}")
	finally:
		u.cleanup()

	# Both ignored is the same: naming both explains nothing.
	v = Tree("both")
	try:
		check(subprocess.run(["git", "init", "-q", v.dir],
		                     capture_output=True).returncode == 0,
		      "could not make a repository")
		v.write(".gitignore", "gen_*.c\n")
		v.write("gen_a.c", "int shared_thing(void){ return 1; }\n")
		v.write("gen_b.c", "int shared_thing(void){ return 1; }\n")
		v.write("main.c", "int shared_thing(void);\n"
		        "int main(void){ return shared_thing() - 1; }\n")
		r = v.fmake()
		check("git is told to ignore" not in r.stdout + r.stderr,
		      f"named both providers, which explains nothing: "
		      f"{r.stdout}{r.stderr}")
	finally:
		v.cleanup()

	# And a tree that is not a repository at all must not break.
	w = Tree("norepo")
	try:
		w.write("a.c", "int shared_thing(void){ return 1; }\n")
		w.write("b.c", "int shared_thing(void){ return 1; }\n")
		w.write("main.c", "int shared_thing(void);\n"
		        "int main(void){ return shared_thing() - 1; }\n")
		r = w.fmake()
		check("Traceback" not in r.stdout + r.stderr,
		      f"a tree with no repository tracebacked: {r.stderr}")
		check("more than one file" in r.stdout + r.stderr,
		      f"the ambiguity was not reported: {r.stdout}{r.stderr}")
	finally:
		w.cleanup()


@case
def an_ambiguity_suggests_each_stanza_once(t):
	"""Found by running fuzzypickles: 252 lines, nearly all identical.

	The refusal offers a `[target.*]` stanza per program, which is the
	thing the reader would otherwise write by hand. It was built by looping
	over one entry per *(target, symbol)* -- and a file that collides with
	another collides on everything it defines, which was eight meta-objects
	there. The same block eight times.

	The stanza depends only on the target, so it is said once. The advice
	line above it depends on the target and the file, so it is said once
	per pair. Neither is a new fact; both were being repeated.

	A message nobody can read is a message that does not do its job, and
	this one exists precisely because the situation is confusing."""
	# Two files defining the same several symbols, reachable from two
	# different programs -- the shape that produces one `trouble` entry per
	# symbol per target.
	for d in ("one", "two"):
		t.write(f"{d}/dup.h", "int dup_alpha(void);\nint dup_beta(void);\n"
		        "int dup_gamma(void);\n")
		t.write(f"{d}/dup.c",
		        '#include "dup.h"\n'
		        "int dup_alpha(void){ return 1; }\n"
		        "int dup_beta(void){ return 2; }\n"
		        "int dup_gamma(void){ return 3; }\n")
		# Includes its own sibling, so the include graph reaches exactly one
		# provider from each root -- which is the condition for the stanza
		# to be offered at all. Without it the case exercises the refusal
		# and not the suggestion, which is what it is about.
		t.write(f"{d}/main.c",
		        '/*! @file\n *  @target prog_%s\n */\n#include "dup.h"\n'
		        "int main(void){ return dup_alpha()+dup_beta()+dup_gamma()-6; }\n"
		        % d)

	r = t.fmake()
	check(r.returncode != 0, "two providers of one symbol should be refused")
	said = r.stdout + r.stderr
	check("more than one file" in said, f"no ambiguity reported: {said}")

	stanzas = [l for l in said.splitlines() if l.strip().startswith("[target.")]
	check(stanzas, f"no stanza was suggested at all: {said}")
	check(len(stanzas) == len(set(s.strip() for s in stanzas)),
	      f"the same stanza was suggested more than once: {stanzas}")

	advice = [l for l in said.splitlines()
	          if l.startswith("    ") and "dup.c" in l and "[" not in l]
	check(len(advice) == len(set(a.strip() for a in advice)),
	      f"the same advice line was repeated: {advice}")


@case
def two_ambiguous_archives_report_rather_than_traceback(t):
	"""Found by running beerssh, in code nobody had touched.

	It ships prebuilt `libcrypto.a` for two Android ABIs beside its desktop
	sources. Both define the same symbols, section 3 refuses to choose --
	correctly -- and the code that explains the refusal looked every
	provider up in the scan map with `scans[p]`. An archive has no scan: it
	was never a source. `KeyError`, and a traceback out of the command
	line, which is section 32's class arriving in the message written to
	explain a failure rather than in the failure.

	Then the advice it printed could not be followed either. `@os` and
	`@arch` go in a source file and an archive has none, so the one remedy
	offered was the one thing that could not be done -- section 101 again.

	And the remedy that *should* have worked did not: `[project] exclude`
	never reached archives, so following the corrected advice changed
	nothing. Three defects in one message, each hiding the next."""
	if not (shutil.which("ar") and shutil.which("cc")):
		raise Skip("ar or cc not installed")

	def archive(rel, value):
		src = os.path.join(t.dir, "tmp.c")
		with open(src, "w") as fh:
			fh.write(f"int zz_shared_thing(void){{ return {value}; }}\n")
		obj = os.path.join(t.dir, "tmp.o")
		check(subprocess.run(["cc", "-c", src, "-o", obj]).returncode == 0,
		      "could not compile")
		path = os.path.join(t.dir, rel)
		os.makedirs(os.path.dirname(path), exist_ok=True)
		check(subprocess.run(["ar", "rcs", path, obj]).returncode == 0,
		      f"could not archive {rel}")
		os.remove(src)
		os.remove(obj)

	archive("deps/a/libzz.a", 1)
	archive("deps/b/libzz.a", 2)
	t.write("main.c", "int zz_shared_thing(void);\n"
	        "int main(void){ return zz_shared_thing() - 1; }\n")

	r = t.fmake()
	said = r.stdout + r.stderr
	check("Traceback" not in said and "KeyError" not in said,
	      f"an ambiguous archive tracebacked instead of reporting: {said}")
	check(r.returncode != 0, "two providers of one symbol should be refused")
	check("more than one file" in said,
	      f"the ambiguity was not reported: {said}")
	# Advice that can be acted on: not @os, which an archive cannot carry.
	check("exclude" in said,
	      f"the advice does not name a remedy that works for an archive: "
	      f"{said}")
	check("@os or @arch on the platform-specific one" not in said,
	      f"offered a directive an archive cannot carry: {said}")

	# And taking that advice has to work.
	t.write("fmake.toml", '[project]\nexclude = ["deps/b/**"]\n')
	r = t.fmake()
	check(r.returncode == 0,
	      f"following the advice did not resolve it: {r.stdout}{r.stderr}")
	check(t.run(os.path.basename(t.dir)).returncode == 0,
	      "the surviving archive was not the one kept")


@case
def every_knob_that_changes_a_compile_reaches_the_object_key(t):
	"""Section 76's claim, enumerated rather than trusted.

	"Objects are keyed by the whole configuration" is the property that
	stops a sanitized object being linked into a plain build -- netcfgd's
	incident, and the reason that section exists. It is also a claim that
	decays every time a knob is added, and several were added recently:
	`$DEBUG`, `$SANITIZE`, the Qt `-fPIC`, a generator's depfile.

	Each knob here is turned and the build has to notice. Two mechanisms
	do that and both count: a knob in the *configuration* changes the
	object directory, so two configurations keep separate object trees; a
	knob in one *file* leaves the directory alone and changes that file's
	key, so it recompiles in place. What must never happen is neither.

	`include-dirs` is the one that looks wrong and is not: it shares a
	directory with the unset case and still forces a recompile, because
	the include flags are in the key without being in the path. That costs
	a rebuild when switching back and forth and cannot produce a stale
	object, which is the trade being made rather than an oversight."""
	t.write("main.c", "int main(void){ return 0; }\n")
	os.makedirs(os.path.join(t.dir, "sub"), exist_ok=True)
	t.write("sub/extra.h", "#define EXTRA 1\n")

	def objdir(conf=None, args=(), env=None):
		shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
		path = os.path.join(t.dir, "fmake.toml")
		if conf is None:
			if os.path.exists(path):
				os.remove(path)
		else:
			t.write("fmake.toml", conf)
		r = t.fmake("-n", *args, env=env)
		m = re.search(r"\.fmake/obj/([0-9a-f]+)", r.stdout)
		check(m, f"no object path in the dry run: {r.stdout}{r.stderr}")
		return m.group(1)

	base = objdir()
	separate = [
	    ("$DEBUG", None, (), {"DEBUG": "1"}),
	    ("$SANITIZE", None, (), {"SANITIZE": "1"}),
	    # Distinct values on purpose. $CFLAGS and --cflags are two
	    # spellings of one input -- the help says so -- so giving both
	    # `-O3' makes them key the same, which is correct and would fail a
	    # test asserting every knob is distinct.
	    ("$CFLAGS", None, (), {"CFLAGS": "-O3"}),
	    ("--cflags", None, ("--cflags", "-O1"), None),
	    ("[project] cflags", '[project]\ncflags = ["-DX=1"]\n', (), None),
	    ("[project] std", '[project]\nstd = "c11"\n', (), None),
	    ("[toolchain] sysroot", '[toolchain]\nsysroot = "/"\n', (), None),
	    ("a profile", '[profile.fast]\ncflags = ["-O3"]\n',
	     ("-p", "fast"), None),
	]
	seen = {base: "the default configuration"}
	for label, conf, args, env in separate:
		got = objdir(conf, args, env)
		check(got != base,
		      f"{label} does not reach the object key, so its objects share "
		      f"a directory with the default build")
		# Spelled out rather than as one check(): `check(cond, f"...
		# {seen[got]}")` builds its message whether or not the condition
		# holds, so the passing path raised a KeyError on the key it was
		# checking was absent.
		if got in seen:
			check(False,
			      f"{label} keys the same as {seen[got]}, so one can be "
			      f"handed the other's objects")
		seen[got] = label

	# The other mechanism: same directory, but the build still notices.
	shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
	os.remove(os.path.join(t.dir, "fmake.toml"))
	check(t.fmake().returncode == 0, "the plain build failed")
	t.write("fmake.toml", '[project]\ninclude-dirs = ["sub"]\n')
	r = t.fmake()
	check("CC " in r.stdout,
	      f"changing include-dirs neither rekeyed nor rebuilt: {r.stdout}")

	# And a flag written in one file. Worth being exact about what this
	# does and does not pin: a per-file flag lives *in* the file, so
	# changing it changes the content hash too, and a mutation removing
	# `u.own' from the key survives this. The observable behaviour is what
	# is checked -- the file recompiles -- and the `u.own' term is belt and
	# braces rather than the thing doing the work. Removing it on that
	# basis would still be a mistake: it is the only term that would
	# survive a flag arriving from somewhere other than the file.
	shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
	os.remove(os.path.join(t.dir, "fmake.toml"))
	t.write("main.c", "/*! @file\n *  @define A=1\n */\n"
	        "int main(void){ return 0; }\n")
	check(t.fmake().returncode == 0, "the annotated build failed")
	t.write("main.c", "/*! @file\n *  @define A=2\n */\n"
	        "int main(void){ return 0; }\n")
	r = t.fmake()
	check("CC " in r.stdout,
	      f"changing a per-file @define did not recompile it: {r.stdout}")


@case
def the_header_table_maps_to_the_module_that_ships_the_header(t):
	"""The second of section 15's load-bearing lists, checked.

	`HEADER_PKG` says which pkg-config module owns a system header, and it
	is what makes `#include <zlib.h>` propose zlib before anything has been
	compiled. A wrong entry is quiet: the module supplies flags for the
	wrong library, or does not exist and the include resolves the slow way.

	The evidence took two attempts and the first was worth nothing. Asking
	whether the header sits under one of the module's `-I` directories
	sounds right and checks almost nothing: pkg-config emits no `-I` for a
	header in a default directory, which is 11 of the 12 installed entries
	here, so the check fell back to /usr/include and passed for any module
	at all. Mapping `zlib.h` to `libpng` sailed through it.

	What does tie them together is the package manager: the header and the
	module's `.pc` file ship in the same package, or the mapping is wrong.
	That is Debian-specific and skips elsewhere, which is honest -- an
	unverifiable check that says nothing is worse than one that admits it
	cannot run."""
	if not (shutil.which("pkg-config") and shutil.which("dpkg-query")):
		raise Skip("pkg-config or dpkg-query not installed")

	def owner(path):
		r = subprocess.run(["dpkg-query", "-S", path],
		                   capture_output=True, text=True)
		return r.stdout.split(":")[0].strip() if r.returncode == 0 else None

	with open(FMAKE) as fh:
		src = fh.read()
	block = src[src.index("HEADER_PKG = {"):src.index("IMPLICIT_LIBS")]
	pairs = dict(re.findall(r'"([^"]+)":\s*"([^"]+)"', block))
	check(len(pairs) > 20, f"only {len(pairs)} entries read out of fmake")

	checked, wrong = 0, []
	for header, module in sorted(pairs.items()):
		if subprocess.run(["pkg-config", "--exists", module],
		                  capture_output=True).returncode != 0:
			continue
		pcdir = subprocess.run(["pkg-config", "--variable=pcfiledir", module],
		                       capture_output=True, text=True).stdout.strip()
		found = next((os.path.join(d, header) for d in
		              ("/usr/include", "/usr/include/x86_64-linux-gnu",
		               "/usr/local/include")
		              if os.path.isfile(os.path.join(d, header))), None)
		if not (pcdir and found):
			continue
		by_pc, by_header = owner(os.path.join(pcdir, module + ".pc")), owner(found)
		if not (by_pc and by_header):
			continue
		checked += 1
		if by_pc != by_header:
			wrong.append((header, module, by_header, by_pc))

	check(not wrong,
	      f"a header and the module mapped to it ship in different "
	      f"packages: {wrong}")
	check(checked >= 5,
	      f"only {checked} of {len(pairs)} entries were checkable here, "
	      f"which is too few for this to mean anything")


@case
def interposers_on_this_machine_are_all_known(t):
	"""The third list, and the one whose failure is silent and wrong.

	A sanitiser runtime exports the symbols it interposes on -- asan
	exports malloc, free and memcpy -- so by symbol evidence it is a
	perfectly good provider, and the cover can pick one because it happens
	to intercept more of what a program calls. Section 14 caught `-lasan`
	being offered as an alternative to `-lm`.

	The danger runs the opposite way from the linker-symbol list: there a
	missing entry produces a false alarm, here it produces a *silent wrong
	answer*, a sanitiser linked into an ordinary build.

	So the machine is asked which of its libraries look like interposers --
	exporting malloc, free and memcpy without being libc -- and every one
	of them has to be named. The compiler's own directories are searched,
	not just /usr/lib: that is where the sanitiser runtimes live, and a
	first version of this looking only at the usual places found nothing at
	all and would have passed for ever."""
	if not shutil.which("nm"):
		raise Skip("nm not installed")
	dirs = []
	for line in subprocess.run(["cc", "-print-search-dirs"],
	                           capture_output=True, text=True).stdout.splitlines():
		if line.startswith("libraries:"):
			dirs += [os.path.realpath(d)
			         for d in line.split("=", 1)[1].split(":")]
	dirs = [d for d in dict.fromkeys(dirs) if os.path.isdir(d)]
	check(dirs, "the compiler named no library directories")

	with open(FMAKE) as fh:
		src = fh.read()
	block = src[src.index("INTERPOSER_LIBS = {"):
	            src.index("# Symbols the linker itself provides")]
	listed = set(re.findall(r'"([^"]+)"', block))
	check(len(listed) > 10, f"only {len(listed)} names read out of fmake")

	marks = {b"malloc", b"free", b"memcpy"}
	found, looked = {}, 0
	for d in dirs:
		for path in sorted(glob.glob(os.path.join(d, "lib*.so"))
		                   + glob.glob(os.path.join(d, "lib*.a"))):
			stem = re.sub(r"^lib|\.(so|a)$", "", os.path.basename(path))
			if stem in ("c", "c_nonshared") or stem in found:
				continue
			args = ["nm", "--defined-only", "--format=posix"]
			if path.endswith(".so"):
				args.insert(1, "-D")
			r = subprocess.run(args + [path], capture_output=True)
			looked += 1
			syms = {l.split()[0] for l in r.stdout.splitlines() if l.split()}
			if marks <= syms:
				found[stem] = path
	check(looked > 10,
	      f"only {looked} libraries were read, so nothing was really checked")
	unknown = sorted(set(found) - listed)
	check(not unknown,
	      f"these intercept rather than implement and fmake does not know "
	      f"it, so the cover may choose one: "
	      f"{[(u, found[u]) for u in unknown]}")


@case
def linker_symbols_cover_what_the_linker_provides(t):
	"""A hand-written list, checked against the toolchain that has to match.

	Section 15 names this as one of the load-bearing lists: symbols the
	linker supplies, which nothing in the tree defines and no library
	exports. An undefined reference to one is not a missing dependency, and
	reporting it as such sends the reader looking for a package that does
	not exist.

	It had six gaps when this case was first run -- `end`, `edata`,
	`__etext`, `__tdata_start` and the two `__rela_iplt_*` bounds -- and
	the symptom was exactly what section 15 predicted:

	    no x86_64/64le library exports: __rela_iplt_start, end,
	                                    genuinely_missing

	Two of those three are not missing at all, and the one that is sits in
	a list of three.

	**The suite probes and the tool does not.** Reading the default linker
	script on every build is a subprocess for a question whose answer
	changes when binutils does, and section 17 is explicit that fmake does
	not probe features. Checking the list here is the middle: still a
	list, no longer unexamined, and a toolchain that provides something new
	fails the suite rather than somebody's build."""
	if not shutil.which("ld"):
		raise Skip("ld not installed")
	script = subprocess.run(["ld", "--verbose"], capture_output=True,
	                        text=True).stdout
	if "PROVIDE" not in script:
		raise Skip("this ld does not print a default linker script")

	provided = set(re.findall(
	    r"PROVIDE(?:_HIDDEN)?\s*\(\s*([A-Za-z_][A-Za-z0-9_]*)", script))
	# Plain assignments in the script are linker-provided too.
	provided |= set(re.findall(r"^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*[^=]",
	                           script, re.M))
	check(len(provided) > 5,
	      f"only {len(provided)} symbols parsed out of the linker script, "
	      f"so this case is not reading it properly")

	with open(FMAKE) as fh:
		src = fh.read()
	block = src[src.index("LINKER_SYMBOLS = {"):src.index("def _stdout")]
	known = set(re.findall(r'"([^"]+)"', block))
	check(len(known) > 20, f"only {len(known)} names read out of fmake")

	missing = sorted(provided - known)
	check(not missing,
	      f"this linker provides symbols fmake would report as missing "
	      f"dependencies: {missing}")

	# And the whole point, end to end: a link that fails for one real
	# reason must name one symbol, not three.
	t.write("main.c", """
extern char end[];
extern char __rela_iplt_start[];
int genuinely_missing(void);
int main(void){ return genuinely_missing() + (end != __rela_iplt_start); }
""")
	r = t.fmake()
	check(r.returncode != 0, "the build should fail on the missing symbol")
	said = r.stdout + r.stderr
	blamed = [l for l in said.splitlines() if "library exports" in l]
	check(blamed, f"no report of the unresolved symbol: {said}")
	check("genuinely_missing" in blamed[0],
	      f"the real symbol is not named: {blamed[0]}")
	for supplied in ("end", "__rela_iplt_start"):
		check(supplied not in blamed[0].split(":")[-1],
		      f"a linker-provided symbol was reported as missing: "
		      f"{blamed[0]}")


@case
def two_resolved_archives_are_grouped(t):
	"""ld searches an archive only for what is undefined when it reaches it.

	Archives *in the tree* have been grouped since section 18. The `-l`
	flags the cover resolves were not, and the cover has no reason to have
	ordered them usefully -- it ranks by coverage. So an archive needing a
	symbol from one listed earlier contributes nothing, and the link fails
	on a name neither the program nor fmake ever mentioned.

	The fixture has to be built with care to mean anything. An earlier one
	put both of the second archive's functions in a single object, so
	pulling either brought the other and any order worked -- it proved
	nothing, and passed with the fix reverted. They are separate objects
	now, and the fixture is checked against `cc` directly first: one order
	links, the other does not."""
	if not (shutil.which("ar") and shutil.which("cc")):
		raise Skip("ar or cc not installed")
	libs = tempfile.mkdtemp(prefix="fmake-arcs-")
	try:
		def obj(name, text):
			src = os.path.join(libs, name + ".c")
			with open(src, "w") as fh:
				fh.write(text)
			o = os.path.join(libs, name + ".o")
			check(subprocess.run(["cc", "-c", src, "-o", o]).returncode == 0,
			      f"could not compile {name}")
			return o

		# beta's two functions in separate objects: pulling one must not
		# bring the other, or the order stops mattering.
		bh = obj("bh", "int zzbeta_helper(void){ return 4; }\n")
		bs = obj("bs", "int zzbeta_seed(void){ return 6; }\n")
		al = obj("a", "int zzbeta_helper(void);\n"
		         "int zzalpha_thing(void){ return zzbeta_helper(); }\n")
		for name, members in (("libzzbeta.a", [bh, bs]),
		                      ("libzzalpha.a", [al])):
			check(subprocess.run(["ar", "rcs", os.path.join(libs, name)]
			                     + members).returncode == 0,
			      f"could not archive {name}")

		t.write("main.c", "int zzalpha_thing(void);\nint zzbeta_seed(void);\n"
		        "int main(void){ return zzalpha_thing() + zzbeta_seed() "
		        "- 10; }\n")

		# The fixture is only worth anything if it is order-sensitive, so
		# that is established with cc before fmake is asked.
		bad = subprocess.run(["cc", os.path.join(t.dir, "main.c"),
		                      "-L" + libs, "-lzzbeta", "-lzzalpha",
		                      "-o", os.path.join(t.dir, "probe")],
		                     capture_output=True, text=True)
		good = subprocess.run(["cc", os.path.join(t.dir, "main.c"),
		                       "-L" + libs, "-lzzalpha", "-lzzbeta",
		                       "-o", os.path.join(t.dir, "probe")],
		                      capture_output=True, text=True)
		check(bad.returncode != 0 and good.returncode == 0,
		      "the fixture is not order-sensitive, so it proves nothing "
		      f"(bad={bad.returncode} good={good.returncode})")
		os.remove(os.path.join(t.dir, "probe"))

		t.write("fmake.toml", f'[toolchain]\nlib-dirs = ["{libs}"]\n')
		r = t.fmake()
		check(r.returncode == 0,
		      f"two resolved archives did not link: {r.stdout}{r.stderr}")

		r = t.fmake("--explain")
		check("--start-group" in r.stdout and "--end-group" in r.stdout,
		      f"the resolved archives were not grouped: {r.stdout}")
	finally:
		shutil.rmtree(libs, ignore_errors=True)


@case
def one_resolved_archive_needs_no_group(t):
	"""A group is not free, and one archive cannot be on the wrong side.

	Shared libraries are not order-sensitive as providers and libc is
	implicit and last regardless, so a single archive has nothing to be
	ordered against. Emitting a group anyway would make every ordinary
	link line carry linker syntax for a problem it does not have."""
	if not (shutil.which("ar") and shutil.which("cc")):
		raise Skip("ar or cc not installed")
	libs = tempfile.mkdtemp(prefix="fmake-onearc-")
	try:
		src = os.path.join(libs, "s.c")
		with open(src, "w") as fh:
			fh.write("int zzsolo_thing(void){ return 7; }\n")
		o = os.path.join(libs, "s.o")
		check(subprocess.run(["cc", "-c", src, "-o", o]).returncode == 0,
		      "could not compile")
		check(subprocess.run(["ar", "rcs", os.path.join(libs, "libzzsolo.a"),
		                      o]).returncode == 0, "could not archive")
		t.write("main.c", "int zzsolo_thing(void);\n"
		        "int main(void){ return zzsolo_thing() - 7; }\n")
