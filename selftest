# ---------------------------------------------------------------------------
# moc
#
# The claim under test is that Qt needs no mechanism of its own: moc output
# is a translation unit whose symbols the existing closure resolves like any
# other. So most of these check where an object ended up rather than whether
# moc ran, and the programs return a value that is only correct if the
# meta-object actually works -- a signal that never fires links perfectly
# well.
# ---------------------------------------------------------------------------


def _moc_path():
	"""Where fmake would find moc, or None. Mirrors find_moc in fmake.

    Deliberately not `which("moc")`: on Debian there is none on $PATH, so a
    skip decided that way would skip everywhere that matters.
    """
	for mod in ("Qt6Core", "Qt5Core"):
		if not _have_pkg(mod):
			continue
		for var in ("libexecdir", "host_bins", "bindir"):
			r = subprocess.run(["pkg-config", f"--variable={var}", mod],
			                   capture_output=True, text=True)
			d = r.stdout.strip()
			cand = os.path.join(d, "moc") if d else None
			if cand and os.access(cand, os.X_OK):
				return cand
	return shutil.which("moc")


@case
def a_missing_moc_include_is_blamed_when_the_link_fails(t):
	"""The warning is printed first; the failure is what gets read.

	A Q_OBJECT class in a .cpp needs `#include "foo.moc"`, and fmake says
	so before compiling. Then the link fails on a mangled vtable, ten lines
	of linker noise go past, and the last line -- the one a reader acts on
	-- offered to name the missing libraries with --ldflags. A meta-object
	this tree was supposed to generate is not a missing library, and that
	advice sends somebody to install something.

	Section 31's shape, arriving in the summary printed after the message
	written to avoid it. The connection is matched on the link set rather
	than on the symbol: tying a mangled name to a class means demangling,
	and this is exact without it -- the program links a source that
	declares a Q_OBJECT class whose moc output was never generated."""
	_need_qt()
	t.write("app.cpp", """
/*! @file
 *  @pkg Qt6Core
 */
#include <QObject>
class Local : public QObject { Q_OBJECT public: int n = 0; };
int main() { Local l; return l.n; }
""")
	r = t.fmake()
	check(r.returncode != 0, "a class with no meta-object should not link")
	said = r.stdout + r.stderr
	check("app.moc" in said.split("did not link")[-1],
	      f"the failure does not mention the missing include: {said}")
	tail = said.strip().splitlines()[-1]
	check("--ldflags" not in tail or ".moc" in tail,
	      f"the last line still offers --ldflags for a meta-object: {tail}")

	# The negative direction, which is what keeps this a diagnosis rather
	# than a guess: an ordinary unresolved symbol still gets the ordinary
	# advice, and no Qt is involved at all.
	u = Tree("plain")
	try:
		u.write("prog.c", "extern int mystery_symbol(void);\n"
		        "int main(void){ return mystery_symbol(); }\n")
		r = u.fmake()
		check(r.returncode != 0, "an undefined symbol should not link")
		said = r.stdout + r.stderr
		check("--ldflags" in said,
		      f"a genuine missing library lost its advice: {said}")
		check(".moc" not in said, f"blamed moc for a C program: {said}")
	finally:
		u.cleanup()


def _need_qt():
	if not _moc_path():
		raise Skip("Qt development files not installed")


def _link_block(out):
	"""Just the link-set listing from --explain.

    The progress lines above it name the same files -- a moc output that was
    compiled and then discarded appears in both -- so a check against the
    whole of stdout cannot tell "linked" from "built and not linked", which
    is the distinction most of these cases exist to make.
    """
	after = out.split("link set", 1)[-1]
	return re.split(r"\n  (?:compiled, not linked|libraries)", after)[0]


COUNTER_H = """
#pragma once
#include <QObject>
class Counter : public QObject {
    Q_OBJECT
public:
    explicit Counter(QObject *parent = nullptr) : QObject(parent) {}
    void bump() { n++; emit changed(n); }
signals:
    void changed(int now);
private:
    int n = 0;
};
"""

# Returns 0 only if the signal actually reached the slot, which takes a
# working meta-object rather than merely a resolved symbol.
COUNTER_MAIN = """
#include <QCoreApplication>
#include "counter.h"
int main(int argc, char **argv) {
    QCoreApplication app(argc, argv);
    Counter c;
    int seen = -1;
    QObject::connect(&c, &Counter::changed, [&](int v){ seen = v; });
    c.bump();
    return seen == 1 ? 0 : 1;
}
"""


@case
def a_qtest_main_roots_a_program(t):
	"""Qt declares a test's entry point with a macro.

	So a QtTest translation unit has no main() in its text, rooted nothing,
	and then nothing reached it -- fmake reported "defines nothing
	reachable" and moved on. One project saw 547 such lines and concluded
	that symbol reachability does not work for a Qt program.

	The macro is a proposal that the file is a program; the object settles
	it, exactly as a textual main() is settled. Everything downstream is
	unchanged: Qt6Test is linked because QTest::qExec is undefined in the
	object, not because the file looked like a test."""
	_need_qt()
	if not _have_pkg("Qt6Test"):
		raise Skip("Qt6Test not installed")
	t.write("src/counter.h",
	        "#pragma once\n#include <QObject>\n"
	        "class Counter : public QObject {\n\tQ_OBJECT\npublic:\n"
	        "\texplicit Counter(QObject *p = nullptr) : QObject(p) {}\n"
	        "\tint value() const { return n; }\npublic slots:\n"
	        "\tvoid bump() { ++n; }\nprivate:\n\tint n = 0;\n};\n")
	t.write("tests/counter_test.cpp",
	        '#include <QtTest>\n#include "../src/counter.h"\n'
	        "class CounterTest : public QObject {\n\tQ_OBJECT\n"
	        "private slots:\n"
	        "\tvoid bumps() { Counter c; c.bump(); QCOMPARE(c.value(), 1); }\n"
	        "};\nQTEST_MAIN(CounterTest)\n"
	        '#include "counter_test.moc"\n')

	# Under tests/ and named _test, so it is held back -- which is right,
	# and orthogonal to the finding this case is about. `fmake test` is how
	# a QtTest binary gets built and run, and it has to do both.
	r = t.fmake("test")
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check(os.path.exists(os.path.join(t.dir, "counter_test")),
	      f"the QtTest binary should be a target: {r.stdout}{r.stderr}")
	env = dict(os.environ, QT_QPA_PLATFORM="offscreen")
	run = t.run("counter_test", env=env)
	check(run.returncode == 0,
	      f"the test binary did not pass: {run.stdout}{run.stderr}")

	# The family, not the one spelling. QTEST_APPLESS_MAIN and
	# QTEST_GUILESS_MAIN are the same declaration for tests that want no
	# QApplication, and a test suite picks whichever it needs per file.
	t.write("tests/plain_test.cpp",
	        "#include <QtTest>\n"
	        "class PlainTest : public QObject {\n\tQ_OBJECT\n"
	        "private slots:\n\tvoid trivial() { QCOMPARE(1 + 1, 2); }\n"
	        "};\nQTEST_APPLESS_MAIN(PlainTest)\n"
	        '#include "plain_test.moc"\n')
	r = t.fmake("test")
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check(os.path.exists(os.path.join(t.dir, "plain_test")),
	      f"QTEST_APPLESS_MAIN should root a program too: {os.listdir(t.dir)}")
	check(t.run("plain_test", env=env).returncode == 0,
	      "the APPLESS test binary did not pass")


@case
def a_macro_main_the_preprocessor_removes_is_settled_by_the_object(t):
	"""The proposal has to be cheap to be wrong, and it is.

	QTEST_MAIN behind a false conditional is text fmake reads and the
	compiler does not. The file becomes a candidate, compiles, exports no
	main(), and the existing mirage cache drops it and remembers -- so a
	wrong guess costs one compile, once, and the tree still builds."""
	t.write("main.cpp", "#include <cstdio>\nint helper();\n"
	        'int main(){ std::printf("%d\\n", helper()); return 0; }\n')
	t.write("maybe.cpp",
	        "#if 0\n#include <QtTest>\nQTEST_MAIN(T)\n#endif\n"
	        "int helper(){ return 5; }\n")

	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check("does not export it" in r.stdout + r.stderr,
	      f"the object should settle it: {r.stdout}{r.stderr}")
	check(t.run(os.path.basename(t.dir)).stdout == "5\n",
	      "the program should still build from the same file")
	check(not os.path.exists(os.path.join(t.dir, "maybe")),
	      "nothing should have been built from the mirage")

	# And remembered. Without the cache the file roots a target again on
	# every build, gets compiled again, and is dropped again -- the same
	# answer for the same cost, forever. The disagreement depends only on
	# the file and the configuration, so it is settled once.
	# Remembered, so the disagreement is reported once rather than every
	# build. Not "not recompiled" -- the object cache already prevents that,
	# so an assertion about compiling would pass with the memory removed.
	# What the memory buys is silence on every later build.
	again = t.fmake()
	check(again.returncode == 0, f"rebuild failed: {again.stdout}")
	check("does not export it" not in again.stdout + again.stderr,
	      f"the mirage should be reported once, not every build: "
	      f"{again.stdout}{again.stderr}")


@case
def moc_runs_because_a_class_says_q_object(t):
	"""Q_OBJECT in a header is the whole declaration Qt needs.

    No build file, no HEADERS list, no AUTOMOC switch: the token in the
