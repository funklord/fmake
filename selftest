def test_material_stays_out_of_the_library(t):
	"""situ shipped a generated test codec inside libsitu.a.

	A tree whose only programs are tests is built as one library, and the
	tests convention classifies *programs* -- so a source under tests/ that
	defines no main() was neither a test nor excluded, and went into the
	archive. The archive is what that project ships.

	The convention already knows where tests live. It asked only about
	programs."""
	t.write("runtime/situ.h", "#pragma once\nint situ_pack(int);\n")
	t.write("runtime/situ.c", '#include "situ.h"\n'
	        "int situ_pack(int n){ return n + 1; }\n")
