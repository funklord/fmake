@case
def a_timeout_that_is_not_a_number_is_refused(t):
	"""`true` is an int in Python and would pass a plain isinstance check,
	which is how `test-timeout = true` becomes a one-second deadline."""
	t.write("main.c", "int main(void){ return 0; }\n")
	for bad in ("true", "-5", '"30"'):
		t.write("fmake.toml", f"[project]\ntest-timeout = {bad}\n")
