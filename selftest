@case
def generated_depends_are_not_passed_to_the_command(t):
	"""Ordering and command arguments are different things.

    Declaring a needed-but-not-consumed file as an input would hand it to
    the tool as a second source, which is how flex ends up lexing a bison
    header. `depends` orders without feeding."""
	t.write("main.c", "int main(void){ return 0; }\n")
