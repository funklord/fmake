@case
def moc_ignores_a_class_the_preprocessor_never_reaches(t):
	"""The scan sees Q_OBJECT behind #if 0; moc correctly does not.

    Told to write to a real path moc creates the file and leaves it empty,
    so treating absence as the signal is not enough -- an empty translation
    unit would otherwise be compiled and reported for the life of the tree,
    and re-mocked on every build for want of a remembered negative."""
	_need_qt()
	t.write("ghost.h", """
#pragma once
#include <QObject>
#if 0
class Ghost : public QObject { Q_OBJECT };
#endif
int helper();
""")
	t.write("ghost.cpp", '#include "ghost.h"\nint helper(){ return 3; }\n')
	t.write("main.cpp", """
#include <QCoreApplication>
#include "ghost.h"
int main(int argc, char **argv) {
    QCoreApplication app(argc, argv);
    return helper() == 3 ? 0 : 1;
}
""")
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check(not any("moc_ghost" in c for c in compiled(r)),
	      f"an empty moc output was compiled: {compiled(r)}")
	check(not glob.glob(os.path.join(t.dir, ".fmake/moc/**/*"),
	                    recursive=True),
	      "an empty moc output was left on disk")
	check(t.run(os.path.basename(t.dir)).returncode == 0, "program failed")

	again = t.fmake("-v")
	check("MOC ghost.h" not in again.stdout,
	      f"moc re-ran for a known-empty input: {again.stdout}")


