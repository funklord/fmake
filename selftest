@case
def declared_sources_bring_their_generated_companions(t):
	"""`[target.*] sources` must not mean "and no meta-object either".

    Declaring membership switches the closure off, which is the point: it is
    the answer to which of the tree's own files belong. It is not an answer
    about generated ones -- a moc output lives under the state directory, so
    it cannot appear in any list a user writes, and a class's meta-object is
    part of that class rather than a second opinion about it. Without this,
    `sources` is unusable for every Qt target there has ever been."""
	_need_qt()
	t.write("fmake.toml",
	        '[target.app]\nsources = ["main.cpp", "widget.cpp"]\n')
	t.write("widget.h", """
#pragma once
#include <QObject>
class Widget : public QObject {
    Q_OBJECT
public:
    void bump() { emit changed(1); }
signals:
    void changed(int);
};
""")
	t.write("widget.cpp", '#include "widget.h"\nint use_widget(){ Widget w; w.bump(); return 0; }\n')
	t.write("main.cpp", """
#include <QCoreApplication>
int use_widget();
int main(int argc, char **argv) {
    QCoreApplication app(argc, argv);
    return use_widget();
}
""")
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check(t.run("app").returncode == 0, "the declared target did not run")


@case
def a_companion_is_owned_by_provenance_not_by_symbol(t):
	"""Two programs with a same-named class must not swap meta-objects.

    Choosing companions by symbol looks equivalent to choosing them by which
    file moc read, and is not: sibling programs each with a `Panel` produce
    two moc outputs defining the same names, and a symbol match hands both to
    whichever target asked first -- which is an ambiguous provider, reported
    against generated files the user never wrote."""
	_need_qt()
	t.write("fmake.toml",
	        '[target.alpha]\nsources = ["a/alpha.cpp"]\n\n'
	        '[target.beta]\nsources = ["b/beta.cpp"]\n')
	for d, stem, val in (("a", "alpha", 1), ("b", "beta", 2)):
		t.write(f"{d}/panel.h", f"""
#pragma once
#include <QObject>
class Panel : public QObject {{
    Q_OBJECT
public:
    int value() {{ emit touched(); return {val}; }}
signals:
    void touched();
}};
""")
		t.write(f"{d}/{stem}.cpp", f"""
#include <QCoreApplication>
#include "panel.h"
int main(int argc, char **argv) {{
    QCoreApplication app(argc, argv);
    Panel p;
    return p.value() == {val} ? 0 : 1;
}}
""")
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	for prog in ("alpha", "beta"):
		check(t.run(prog).returncode == 0, f"{prog} got the wrong meta-object")


@case
def an_ambiguous_symbol_suggests_the_owner(t):
	"""A dead end should hand back the config that ends it.

    section 3 must not let the include graph decide this -- it exists because the
    include graph is not good enough to. It is good enough to *suggest*,
    though, and where it reaches exactly one provider from a program's own
    root that is almost always the right answer. Reported for every affected
    target at once, because fixing a tree of sibling programs one build at a
    time is a bad way to spend an afternoon."""
	for d, stem, val in (("one", "first", 1), ("two", "second", 2)):
		t.write(f"{d}/win.h", "#pragma once\nint win(void);\n")
		t.write(f"{d}/win.c", f'#include "win.h"\nint win(void){{ return {val}; }}\n')
		t.write(f"{d}/{stem}.c",
		        f'#include "win.h"\nint main(void){{ return win() == {val} ? 0 : 1; }}\n')
	r = t.fmake()
	check(r.returncode != 0, "duplicate strong definitions should not build")
	out = r.stdout + r.stderr
	check("first" in out and "second" in out,
	      f"both targets should be named: {out}")
	check("include graph reaches exactly one" in out,
	      f"the suggestion is missing: {out}")
	check("[target.first]" in out and "[target.second]" in out,
	      f"a paste-ready stanza should be offered: {out}")
	check('"one/win.c"' in out and '"two/win.c"' in out,
	      f"each stanza should name that target's own file: {out}")

@case
def widening_does_not_compile_the_whole_tree(t):
	"""The shape section 15 feared: many loose files, one small binary.

    The worry was that a tree whose include graph is a poor guide would pay
    for compiling translation units it turns out not to need. It does not,
    because widening filters on apparent *definitions* rather than mentions:
    one undefined symbol proposes the one file that defines it. Measured on
    Angband -- 168 sources, 122 proposed by the include graph, 151 compiled,
    150 linked -- the waste is a single file.

    Guarded here because it is a property of the filter, and a future change
    that loosened it to mentions would still pass every other case in this
    suite while quietly compiling everything."""
	for i in range(1, 61):
		t.write(f"f{i}.c", f"int helper_{i}(void){{ return {i}; }}\n")
	t.write("main.c", """
int helper_7(void);
int main(void){ return helper_7() == 7 ? 0 : 1; }
""")
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	built = compiled(r)
	check(len(built) <= 3,
	      f"widening compiled {len(built)} of 61 files: {built[:8]}")
	check(any("f7.c" in c for c in built),
	      f"the one file that was needed is missing: {built}")
	check(t.run(os.path.basename(t.dir)).returncode == 0, "the program failed")


@case
def a_shared_library_says_its_own_name(t):
	"""Without DT_SONAME the consumer decides what to record, and it is wrong.

    `-lgreet` leaves the bare name and works, which is why this hides. Link
    the file by path -- what CMake does by default, and what falls out of any
    DESTDIR staging flow -- and the linker records that absolute path
    instead. The program then breaks the moment the library is installed
    where it actually belongs, and no LD_LIBRARY_PATH can repair an absolute
    DT_NEEDED."""
	t.write("fmake.toml", '[project]\nexclude = ["consumer/**"]\n')
	t.write("greet.c", """
/*! @kind shared
 *  @target greet
 *  @headers greet.h
 */
#include "greet.h"
int greet(void){ return 7; }
""")
	t.write("greet.h", "#pragma once\nint greet(void);\n")
	t.write("consumer/use.c", """
#include <greet.h>
int main(void){ return greet() == 7 ? 0 : 1; }
""")
	check(t.fmake().returncode == 0, "build failed")
	lib = os.path.join(t.dir, "libgreet.so")
	check(os.path.exists(lib), "no shared library was produced")

	# Linked by path, exactly as a consumer using the staged copy would.
	use = os.path.join(t.dir, "use")
	r = subprocess.run(["cc", os.path.join(t.dir, "consumer/use.c"),
	                    "-I" + t.dir, lib, "-o", use],
	                   capture_output=True, text=True)
	check(r.returncode == 0, f"could not build the consumer: {r.stderr}")

	# Now put the library where it would really be installed.
	moved = os.path.join(t.dir, "final")
	os.makedirs(moved, exist_ok=True)
	shutil.move(lib, os.path.join(moved, "libgreet.so"))

	env = dict(os.environ, LD_LIBRARY_PATH=moved)
	got = subprocess.run([use], capture_output=True, text=True, env=env)
	check(got.returncode == 0,
	      "the consumer broke when the library moved, so the library did "
	      f"not name itself: {got.stderr.strip()[:160]}")


@case
def a_foreign_archive_is_refused_by_name(t):
	"""A host .a left in the tree during a cross build.

    Nothing about it looks wrong on the way in: binutils nm reads a foreign
    object perfectly well, so the archive is scanned, offered and chosen, and
    the linker refuses it with `file in wrong format` -- a message that names
    neither architecture nor whose decision it was. fmake already asks the
    ELF header this question for installed libraries; archives were the one
    input that skipped it."""
	if not _cross_available():
		raise Skip(f"{CROSS_CC} not installed")
	_vendor(t, "vendor/libhelper.a", "helper",
	        "int helper(void){ return 42; }\n")     # built with the host cc
	t.write("fmake.toml",
	        f'[toolchain]\ncc = "{CROSS_CC}"\narch = "aarch64"\n')
	t.write("main.c", """
int helper(void);
int main(void){ return helper() == 42 ? 0 : 1; }
""")
	r = t.fmake()
	out = r.stdout + r.stderr
	check("vendor/libhelper.a" in out and "aarch64" in out,
	      f"the archive and the target architecture should be named: {out}")
	check("x86_64" in out or "but this build is" in out,
	      f"the mismatch should be stated, not left to the linker: {out}")


@case
def a_cross_built_archive_is_used(t):
	"""The other half: an archive of the right architecture still works.

    A check that refuses everything would pass the case above and be useless,
    which is the failure mode worth guarding against here."""
	if not _cross_available():
		raise Skip(f"{CROSS_CC} not installed")
	if not shutil.which("qemu-aarch64"):
		raise Skip("qemu-aarch64 not installed")
	src = os.path.join(t.dir, "helper.c")
	obj = os.path.join(t.dir, "helper.o")
	with open(src, "w") as fh:
		fh.write("int helper(void){ return 42; }\n")
	check(subprocess.run([CROSS_CC, "-c", src, "-o", obj]).returncode == 0,
	      "could not cross-compile the archive member")
	os.makedirs(os.path.join(t.dir, "vendor"), exist_ok=True)
	check(subprocess.run([CROSS_CC.replace("-gcc", "-ar"), "rcs",
	                      os.path.join(t.dir, "vendor/libhelper.a"),
	                      obj]).returncode == 0, "could not archive it")
	os.remove(src)
	os.remove(obj)

	t.write("fmake.toml",
	        f'[toolchain]\ncc = "{CROSS_CC}"\narch = "aarch64"\n')
	t.write("main.c", """
int helper(void);
int main(void){ return helper() == 42 ? 0 : 1; }
""")
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	prog = os.path.join(t.dir, os.path.basename(t.dir))
	got = subprocess.run(["qemu-aarch64", "-L", "/usr/aarch64-linux-gnu", prog],
	                     capture_output=True, text=True)
	check(got.returncode == 0,
	      f"the cross-built program did not run: {got.stderr[:160]}")


@case
def an_ejected_build_matches_symbol_for_symbol(t):
	"""The README's claim, made testable.

    Every other ejection case checks that the emitted build *works*. That is
    a weaker thing: a build file can lose a flag, an archive, or the order of
    the link line and still produce a program that runs. The claim is that it
    produces the same program, and the two places that nearly broke it --
    vendored archives, and the shared library soname -- were both added to
    the linker and to one ejection backend before the other.

    The tree deliberately covers what a plain hello world would not: a
    per-file @define, an -I only the config supplies, and a prebuilt archive
    that has to land after the objects."""
	if not shutil.which("make"):
		raise Skip("make not installed")
	_vendor(t, "vendor/libextra.a", "extra", "int extra(void){ return 20; }\n")
	t.write("include/dep.h", "int dep_value(void);\n")
	t.write("src/dep.c", '#include "dep.h"\nint dep_value(void){ return 22; }\n')
	t.write("src/main.c", """
/*! @file
 *  @target ejected
 *  @define BONUS=1
 */
#include <stdio.h>
#include "dep.h"
int extra(void);
int main(void){ printf("%d\\n", dep_value() + extra() + BONUS); return 0; }
""")
	t.write("fmake.toml", '[project]\ninclude-dirs = ["include"]\n')

	check(t.fmake().returncode == 0, "fmake build failed")
	mine = os.path.join(t.dir, "ejected")
	check(t.run("ejected").stdout.strip() == "43", "fmake built it wrong")

	r = t.fmake("--eject")
	check(r.returncode == 0, f"eject failed: {r.stderr}")

	# A copy with no .fmake in it, so the emitted file is on its own.
	other = tempfile.mkdtemp(prefix="fmake-ejected-")
	try:
		for name in os.listdir(t.dir):
			if name in (".fmake", "ejected"):
				continue
			src = os.path.join(t.dir, name)
			dst = os.path.join(other, name)
			(shutil.copytree if os.path.isdir(src) else shutil.copy2)(src, dst)
		with open(os.path.join(other, "Makefile"), "w") as fh:
			fh.write(r.stdout)

		m = _run_in(other, "make")
		check(m.returncode == 0, f"the ejected build failed: {m.stdout}{m.stderr}")
		theirs = os.path.join(other, "ejected")
		check(_run_in(other, "./ejected").stdout.strip() == "43",
		      "the ejected build produced a different answer")

		def syms(path):
			out = subprocess.run(["nm", "--format=posix", path],
			                     capture_output=True, text=True).stdout
			return sorted(l.split()[0] + " " + l.split()[1]
			              for l in out.splitlines() if len(l.split()) >= 2)

		a, b = syms(mine), syms(theirs)
		check(a and b, "one of the binaries had no symbols to compare")
		extra_a = [s for s in a if s not in b]
		extra_b = [s for s in b if s not in a]
		check(not extra_a and not extra_b,
		      f"the two binaries differ: only in fmake's {extra_a[:5]}, "
		      f"only in the ejected one {extra_b[:5]}")
	finally:
		shutil.rmtree(other, ignore_errors=True)


@case
def a_file_that_cannot_compile_is_not_remembered(t):
	"""A failure must not be cached as a discovery.

    The resolved unit set is remembered so a later build starts from what
    widening found rather than re-deriving it, and it was remembering
    everything -- including the files that failed. Those define nothing, so
    they can never be why anything links, and keeping them guarantees
    compiling and failing again on every future build.

    The distinction that matters: a file the *include graph* reaches is
    proposed afresh every time and must still be retried, or the error would
    be hidden rather than forgotten. So this tree reaches broken.c only
    through widening -- main.c has no includes at all, and both candidates
    appear to define the symbol it wants."""
	t.write("main.c", """
int real_thing(void);
int main(void){ return real_thing() - 7; }
""")
	t.write("good.c", "int real_thing(void){ return 7; }\n")
	t.write("broken.c",
	        '#include "nowhere_at_all.h"\nint real_thing(void){ return 0; }\n')

	first = t.fmake()
	check(any("broken.c" in c for c in compiled(first)),
	      f"widening should have tried it once: {compiled(first)}")
	check(any("good.c" in c for c in compiled(first)),
	      f"the file that works should have been found: {compiled(first)}")
	check(t.run(os.path.basename(t.dir)).returncode == 0,
	      "the program should still build and run")

	again = t.fmake()
	check(not any("broken.c" in c for c in compiled(again)),
	      f"the failure was remembered and retried: {compiled(again)}")
	check(not compiled(again), f"the rebuild was not a no-op: {compiled(again)}")
	check(again.returncode == 0,
	      f"a clean rebuild should not report failure: {again.stdout}")


@case
def widen_all_does_not_stay_switched_on(t):
	"""--widen-all is an override, not something learned about the tree.

    Its unit set is every file there is. Remembering it would leave the flag
    in effect for every later build through the cache, which is a route
    nobody would think to look for when wondering why a build compiles the
    whole tree."""
	t.write("main.c", "int helper_1(void);\nint main(void){ return helper_1() - 1; }\n")
	for i in range(1, 21):
		t.write(f"f{i}.c", f"int helper_{i}(void){{ return {i}; }}\n")

	def candidates(r):
		m = re.search(r"(\d+) candidates", r.stdout + r.stderr)
		return int(m.group(1)) if m else -1

	plain = candidates(t.fmake("-v"))
	check(0 < plain <= 4, f"a normal build should propose a few files: {plain}")

	wide = candidates(t.fmake("-v", "--widen-all"))
	check(wide >= 21, f"--widen-all should propose everything: {wide}")

	after = candidates(t.fmake("-v"))
	check(after <= plain + 1,
	      f"--widen-all stayed switched on through the cache: {after} "
	      f"candidates afterwards against {plain} before")


@case
def a_symlinked_directory_is_part_of_the_tree(t):
	"""`src/common -> ../shared` is how sibling projects share code.

    os.walk does not follow symlinked directories by default, so the whole
    subtree was invisible and nothing said so: the build failed much later on
    an undefined symbol, with no hint that a directory had been skipped."""
	# The shared tree lives *outside* this one, which is the arrangement
	# the docstring describes and the only one with a single answer. An
	# earlier version put it inside and excluded it, so the case passed
	# only when the walk happened to reach the link before the directory
	# it points at -- readdir order, which differs by filesystem. It
	# passed here and failed on CI for eleven hours.
	sibling = tempfile.mkdtemp(prefix="fmake-sibling-")
	try:
		with open(os.path.join(sibling, "thing.c"), "w") as fh:
			fh.write("int shared_thing(void){ return 5; }\n")
		os.makedirs(os.path.join(t.dir, "app"), exist_ok=True)
		os.symlink(sibling, os.path.join(t.dir, "app/common"))
		t.write("app/main.c", """
int shared_thing(void);
int main(void){ return shared_thing() == 5 ? 0 : 1; }
""")
		r = t.fmake()
		check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
		check(any("common/thing.c" in c for c in compiled(r)),
		      f"the symlinked directory was not walked: {compiled(r)}")
	finally:
		shutil.rmtree(sibling, ignore_errors=True)


@case
def a_symlink_cycle_does_not_hang(t):
	"""Following symlinked directories means guarding against loops.

    A link pointing at its own ancestor makes os.walk descend forever, which
    is the reason the default is not to follow them at all."""
	t.write("main.c", "int main(void){ return 0; }\n")
	os.makedirs(os.path.join(t.dir, "sub"), exist_ok=True)
	os.symlink("..", os.path.join(t.dir, "sub/up"))

	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check(t.run(os.path.basename(t.dir)).returncode == 0, "program failed")


@case
def two_links_to_one_directory_are_walked_once(t):
	"""Otherwise every file in it has two names, and so two definitions.

    The cycle guard is keyed on the real path rather than on the walked one
    for exactly this: a diamond is not a loop, and walking it twice would
    hand section 3 a duplicate of every symbol in the directory and no way to
    choose."""
	os.makedirs(os.path.join(t.dir, "elsewhere"), exist_ok=True)
	t.write("elsewhere/thing.c", "int shared_thing(void){ return 5; }\n")
	os.symlink("elsewhere", os.path.join(t.dir, "one"))
	os.symlink("elsewhere", os.path.join(t.dir, "two"))
	t.write("main.c", """
int shared_thing(void);
int main(void){ return shared_thing() == 5 ? 0 : 1; }
""")

	# Counted, not inferred from an exclusion. The earlier version excluded
	# the real directory and required the build to succeed, which only held
	# when the walk reached a link before the directory itself -- so it was
	# asserting the tie-break rather than the property, and the tie-break is
	# readdir order. What this is about is that thing.c is compiled once,
	# whichever of its three names it ends up with.
	r = t.fmake()
	check(r.returncode == 0,
	      f"a directory reached two ways should not be a duplicate: "
	      f"{r.stdout}{r.stderr}")
	hits = [c for c in compiled(r) if c.endswith("thing.c")]
	check(len(hits) == 1,
	      f"one file reached by three names was compiled {len(hits)} "
	      f"times: {hits}")
	check(t.run(os.path.basename(t.dir)).returncode == 0, "program failed")


MIRAGE_TOOL = """
#ifdef WANT_TOOL
#include <stdio.h>
int main(void){ printf("tool\\n"); return 0; }
#endif
int tool_spare(void){ return 3; }
"""


@case
def a_main_behind_an_ifdef_is_reported_once(t):
	"""The scan reads text and cannot evaluate #if; the object settles it.

    A main() behind a disabled #ifdef is seen by the scan, so a target is
    proposed, compiled, found to export no main, and dropped -- correctly,
    and with a warning that is worth reading the first time. Angband has such
    a file, and said so on every build forever. The same shape as moc's
    negative result for a Q_OBJECT the preprocessor never reaches."""
	t.write("tool.c", MIRAGE_TOOL)
	t.write("helper.c", "int helper(void){ return 1; }\n")
	t.write("app.c", """
int helper(void);
int main(void){ return helper() == 1 ? 0 : 1; }
""")
	first = t.fmake()
	check("looked like it defined main" in first.stdout + first.stderr,
	      f"the disagreement should be reported once: {first.stdout}")
	check(t.run("app").returncode == 0, "the real program should still build")

	again = t.fmake()
	check("looked like it defined main" not in again.stdout + again.stderr,
	      f"it should not be reported again: {again.stdout}")


@case
def a_mirage_main_is_reconsidered_when_it_becomes_real(t):
	"""Remembering the answer must not mean refusing to look again.

    The stamp covers the file's contents and the configuration, which are
    the two things that decide whether the #ifdef is on. Getting this wrong
    would leave a program permanently unbuildable with no way to find out
    why, which is far worse than the warning it replaced."""
	t.write("tool.c", MIRAGE_TOOL)
	t.write("helper.c", "int helper(void){ return 1; }\n")
	t.write("app.c", """
int helper(void);
int main(void){ return helper() == 1 ? 0 : 1; }
""")
	check(t.fmake().returncode == 0, "first build failed")
	check(not os.path.exists(os.path.join(t.dir, "tool")),
	      "tool should not have been built yet")

	r = t.fmake("--cflags", "-O2 -DWANT_TOOL")
	check(r.returncode == 0, f"build with the define failed: {r.stdout}{r.stderr}")
	check(os.path.exists(os.path.join(t.dir, "tool")),
	      f"the define makes main() real, so it should build: {r.stdout}")
	check(t.run("tool").stdout.strip() == "tool", "the program misbehaved")

	# And a plain edit is the other way the answer can change.
	t.write("tool.c", MIRAGE_TOOL + "\nint spare(void){ return 2; }\n")
	r = t.fmake()
	check("looked like it defined main" in r.stdout + r.stderr,
	      f"an edited file should be looked at afresh: {r.stdout}")


@case
def a_build_waits_for_a_lock_it_cannot_take(t):
	"""The mechanism, where one_fmake_at_a_time_per_tree tests the outcome.

    That case starts two builds and checks the result is right, which is the
    thing that actually matters -- but it only exercises anything if the two
    overlap, and nothing makes them. Removing the lock does turn it red
    today; whether it still would on a faster machine, or with a smaller
    tree, is exactly the question a timing-dependent test cannot answer.

    This one takes the lock itself and checks that fmake blocks on it, then
    that releasing it lets the build through. No timing assumption, so no
    machine on which it quietly stops testing anything."""
	try:
		import fcntl
	except ImportError:
		raise Skip("no fcntl on this platform")

	t.write("main.c", "int main(void){ return 0; }\n")
	check(t.fmake().returncode == 0, "first build failed")

	lock = os.path.join(t.dir, ".fmake", "lock")
	check(os.path.exists(lock), "no lock file was created")

	held = open(lock, "w")
	fcntl.flock(held, fcntl.LOCK_EX)
	try:
		proc = subprocess.Popen([FMAKE, "-C", t.dir, "-B"],
		                        stdout=subprocess.PIPE,
		                        stderr=subprocess.STDOUT, text=True)
		try:
			proc.wait(timeout=3)
			raise Failure("fmake built while another run held the lock")
		except subprocess.TimeoutExpired:
			pass                      # blocked, which is the point
	finally:
		fcntl.flock(held, fcntl.LOCK_UN)
		held.close()

	out, _ = proc.communicate(timeout=120)
	check(proc.returncode == 0, f"the waiting build failed: {out}")
	check("waiting for another fmake" in out,
	      f"it should say why it paused: {out}")


@case
def a_package_in_an_unusual_prefix_is_found(t):
	"""A library under /opt, ~/.local or any hand-built prefix.

    Three separate things have to work and none of them did. The .pc file is
    only reachable through $PKG_CONFIG_PATH, which `pkg-config
    --variable=pc_path` does not report -- so the header-to-package map never
    saw it and the include did not resolve, for a library that is plainly
    installed. Then the -L was parsed and discarded, because section 5 recovers
    library paths from where a library was found rather than from
    pkg-config; that works only for directories fmake already looks in, and
    this is not one. And finally the answer is cached across builds, so
    collecting the directory as a side effect of running pkg-config
    collected it on the first build and never again."""
	if not shutil.which("pkg-config"):
		raise Skip("pkg-config not installed")

	prefix = tempfile.mkdtemp(prefix="fmake-prefix-")
	try:
		for sub in ("lib/pkgconfig", "include"):
			os.makedirs(os.path.join(prefix, sub), exist_ok=True)
		with open(os.path.join(prefix, "include/mylib.h"), "w") as fh:
			fh.write("#pragma once\nint mylib_answer(void);\n")
		src = os.path.join(prefix, "mylib.c")
		with open(src, "w") as fh:
			fh.write("int mylib_answer(void){ return 42; }\n")
		lib = os.path.join(prefix, "lib/libmylib.so")
		r = subprocess.run(["cc", "-fPIC", "-shared", "-Wl,-soname,libmylib.so",
		                    src, "-o", lib], capture_output=True, text=True)
		check(r.returncode == 0, f"could not build the library: {r.stderr}")
		with open(os.path.join(prefix, "lib/pkgconfig/mylib.pc"), "w") as fh:
			fh.write(f"prefix={prefix}\nlibdir=${{prefix}}/lib\n"
			         f"includedir=${{prefix}}/include\n\n"
			         "Name: mylib\nDescription: elsewhere\nVersion: 1.0\n"
			         "Libs: -L${libdir} -lmylib\nCflags: -I${includedir}\n")

		t.write("main.c", """
#include <mylib.h>
int main(void){ return mylib_answer() == 42 ? 0 : 1; }
""")
		env = {"PKG_CONFIG_PATH": os.path.join(prefix, "lib/pkgconfig")}
		run_env = dict(env, LD_LIBRARY_PATH=os.path.join(prefix, "lib"))

		first = t.fmake(env=env)
		check(first.returncode == 0,
		      f"build failed: {first.stdout}{first.stderr}")
		check(t.run(os.path.basename(t.dir), run_env).returncode == 0,
		      "the program did not run")

		# Again, with the package answer now coming from the cache. This is
		# where collecting the directory as a side effect stopped working.
		again = t.fmake("-B", env=env)
		check(again.returncode == 0,
		      f"the second build lost the library: {again.stdout}{again.stderr}")
		check(t.run(os.path.basename(t.dir), run_env).returncode == 0,
		      "the program from the second build did not run")
	finally:
		shutil.rmtree(prefix, ignore_errors=True)


@case
def one_program_pulled_into_another_is_reported(t):
	"""A function defined next to a main() is still a function.

    So the closure reaches it, links the file it lives in, and gets a second
    main() -- which the linker reports in terms of object paths under .fmake,
    several steps from the cause. fmake then offered to name the missing
    libraries, when nothing was missing at all: the advice pointed at the
    opposite of the problem.

    section 3 excludes other programs' roots when assembling a library and does not
    when closing over a program, deliberately -- refusing to link a function
    because of what shares its file would be its own kind of guess. So this
    is reported, with the fix that actually works."""
	t.write("tool.c", """
#include <stdio.h>
int shared_bit(void){ return 5; }
int main(void){ printf("tool\\n"); return 0; }
""")
	t.write("app.c", """
#include <stdio.h>
int shared_bit(void);
int main(void){ printf("%d\\n", shared_bit()); return 0; }
""")
	r = t.fmake()
	out = r.stdout + r.stderr
	check(r.returncode != 0, "two main()s in one link should not build")
	check("app" in out and "tool.c" in out,
	      f"the program and the file it swallowed should be named: {out}")
	check("shared_bit" in out,
	      f"the symbol that pulled it in should be named: {out}")
	check("missing libraries" not in out,
	      f"nothing is missing; that advice points the wrong way: {out}")

	# And the fix it recommends has to work.
	t.write("shared.c", "int shared_bit(void){ return 5; }\n")
	t.write("tool.c", """
#include <stdio.h>
int main(void){ printf("tool\\n"); return 0; }
""")
	r = t.fmake()
	check(r.returncode == 0, f"the suggested fix failed: {r.stdout}{r.stderr}")
	check(t.run("app").stdout.strip() == "5", "app is wrong")
	check(t.run("tool").stdout.strip() == "tool", "tool is wrong")


@case
def a_mistyped_directory_is_not_a_traceback(t):
	"""`-C` naming a file, or nothing at all.

    build() checked this and the lock did not, and the lock is taken first --
    so creating .fmake under a path that is a file raised NotADirectoryError
    from os.makedirs with a stack trace attached. A traceback is never the
    right answer to a mistyped argument."""
	t.write("main.c", "int main(void){ return 0; }\n")

	r = subprocess.run([FMAKE, "-C", os.path.join(t.dir, "main.c")],
	                   capture_output=True, text=True)
	check(r.returncode != 0, "a file is not a tree")
	check("Traceback" not in r.stdout + r.stderr,
	      f"it should not crash: {r.stdout}{r.stderr}")
	check("not a directory" in r.stdout + r.stderr,
	      f"and it should say what is wrong: {r.stdout}{r.stderr}")

	r = subprocess.run([FMAKE, "-C", os.path.join(t.dir, "nowhere")],
	                   capture_output=True, text=True)
	check(r.returncode != 0, "a missing directory is not a tree")
	check("Traceback" not in r.stdout + r.stderr,
	      f"it should not crash: {r.stdout}{r.stderr}")
	check("no such directory" in r.stdout + r.stderr,
	      f"and it should say what is wrong: {r.stdout}{r.stderr}")


@case
def a_tree_it_cannot_write_to_says_so(t):
	"""fmake keeps its state beside the source, so a read-only checkout
    cannot be built. That is a refusal, not a crash -- and it has to name
    the directory and what to do, because "Permission denied" from
    os.makedirs with a stack trace above it names neither."""
	if os.geteuid() == 0:
		raise Skip("root can write anywhere")
	sub = os.path.join(t.dir, "ro")
	os.makedirs(sub, exist_ok=True)
	with open(os.path.join(sub, "main.c"), "w") as fh:
		fh.write("int main(void){ return 0; }\n")
	os.chmod(sub, 0o555)
	try:
		r = subprocess.run([FMAKE, "-C", sub], capture_output=True, text=True)
		out = r.stdout + r.stderr
		check(r.returncode != 0, "it cannot have built anything")
		check("Traceback" not in out, f"it should not crash: {out}")
		check(".fmake" in out and "writable" in out,
		      f"it should name the state directory and the way out: {out}")
	finally:
		os.chmod(sub, 0o755)


@case
def an_excluded_file_is_named_when_its_symbol_goes_missing(t):
	"""`@os windwos` removes a file on every platform, silently.

    A typo in @os or @arch does not make the directive inert the way an
    unknown directive is -- it deletes the file from the build, and the only
    sign is an undefined symbol much later. --explain has always shown the
    exclusion and its reason; the failure never did, and the failure is what
    people read."""
	t.write("util.c", """
/*! @os windwos */
int util(void){ return 1; }
""")
	t.write("main.c", """
int util(void);
int main(void){ return util() - 1; }
""")
	r = t.fmake()
	out = r.stdout + r.stderr
	check(r.returncode != 0, "it cannot link without util()")
	check("util.c is excluded" in out,
	      f"the excluded file should be named: {out}")
	check("windwos" in out,
	      f"and the reason it was excluded: {out}")


@case
def an_exclude_pattern_that_took_too_much_is_named(t):
	"""The same for a [project] exclude that matched more than intended.

    Reached by the same route -- a file fmake was told to leave out is the
    commonest reason a symbol in this tree has nowhere to come from -- so it
    costs nothing to cover both and would be strange to cover one."""
	t.write("fmake.toml", '[project]\nexclude = ["util*.c"]\n')
	t.write("util.c", "int util(void){ return 1; }\n")
	t.write("main.c", """
int util(void);
int main(void){ return util() - 1; }
""")
	r = t.fmake()
	out = r.stdout + r.stderr
	check(r.returncode != 0, "it cannot link without util()")
	check("util.c is excluded" in out and "util*.c" in out,
	      f"the file and the pattern that removed it should be named: {out}")


