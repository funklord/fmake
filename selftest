@case
def kind_static_builds_an_archive(t):
    """@kind static, and the archive actually links into a consumer."""
    t.write("mathx.h", "double mathx_scale(double, double);\nint mathx_clamp(int, int, int);\n")
    t.write("mathx.c", """
/*! @file
 *  @target  mathx
 *  @kind    static
 *  @headers mathx.h
 */
#include "mathx.h"
double mathx_scale(double v, double k){ return v * k; }
""")
    t.write("clamp.c", '#include "mathx.h"\n'
            "int mathx_clamp(int v, int lo, int hi){ return v<lo?lo:v>hi?hi:v; }\n")

    r = t.fmake()
    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
    archive = os.path.join(t.dir, "libmathx.a")
    check(os.path.exists(archive), f"expected libmathx.a: {os.listdir(t.dir)}")

    # a library is everything the tree defines, so clamp.c must be in it
    syms = subprocess.run(["nm", "--format=posix", archive],
                          capture_output=True, text=True).stdout
    check("mathx_clamp" in syms and "mathx_scale" in syms,
          "the archive should hold every TU, not a closure")

    use = os.path.join(t.dir, "use.c")
    with open(use, "w") as fh:
        fh.write('#include <stdio.h>\n#include "mathx.h"\n'
                 'int main(void){ printf("%g %d\\n", mathx_scale(3,4),'
                 ' mathx_clamp(99,0,10)); return 0; }\n')
    exe = os.path.join(t.dir, "consumer")
    r2 = subprocess.run(["cc", "-I", t.dir, "-o", exe, use, archive],
                        capture_output=True, text=True)
    check(r2.returncode == 0, f"consumer link failed: {r2.stderr}")
    out = subprocess.run([exe], capture_output=True, text=True).stdout
    check(out == "12 10\n", f"wrong output from the consumer: {out!r}")


