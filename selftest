	      f"the spare class should still have been moc'd: {r.stdout}")
	check("moc_spare" not in _link_block(r.stdout),
	      f"an unreachable class was linked anyway: {_link_block(r.stdout)}")
	check("moc_spare" in r.stdout.split("compiled, not linked")[-1],
	      f"moc_spare.cpp should be listed as compiled and not linked: "
	      f"{r.stdout}")

