# uic
#
# Unlike moc there is no symbol to fall back on: a generated header is an
# include-graph dependency, so the #include has to be believed. That makes
# the trigger the interesting part, and most of these cases are about what
# does and does not count as the source asking for it.
# ---------------------------------------------------------------------------

THING_UI = """
<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Thing</class>
 <widget class="QWidget" name="Thing">
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="label">
     <property name="text">
      <string>hello</string>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
"""

THING_MAIN = """
#include <QApplication>
#include <QLabel>
#include <QWidget>
#include "ui_thing.h"
int main(int argc, char **argv) {
    QApplication app(argc, argv);
    QWidget w;
    Ui_Thing ui;
    ui.setupUi(&w);
    return ui.label->text() == "hello" ? 0 : 1;
}
"""

OFFSCREEN = {"QT_QPA_PLATFORM": "offscreen"}


@case
def a_module_umbrella_header_resolves_to_its_own_module(t):
    """`#include <QtWidgets>` must find Qt6Widgets, not a sibling.

    Qt keeps every module under one parent directory with a directory per
    module, so testing the parent for a path called QtWidgets finds the
    *directory*. Matching on existence rather than on a file therefore
    attributed the header to whichever .pc happened to claim the parent --
    alphabetically Qt6Concurrent -- whose flags do not carry the module's own
    -I, so the include did not resolve at all. Six of Qt's own examples are
    written this way."""
    _need_qt()
    t.write("main.cpp", """
#include <QtWidgets>
int main(int argc, char **argv) {
    QApplication app(argc, argv);
    QWidget w;
    w.resize(320, 240);
    return w.width() == 320 ? 0 : 1;
}
""")
    r = t.fmake()
    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
    check(t.run(os.path.basename(t.dir), OFFSCREEN).returncode == 0,
          "the program built but did not run")


