@case
def one_fmake_at_a_time_per_tree(t):
	"""Two runs sharing a cache file lose each other's writes.

    Scan results, symbol tables, resolved libraries -- the loser's are all
    discarded and recomputed next time, and one run can be reading objects
    the other is replacing. Waiting costs less than either."""
	t.write("main.c", '#include <stdio.h>\nint helper(void);\n'
	        'int main(void){ printf("%d\\n", helper()); return 0; }\n')
	t.write("helper.c", "int helper(void){ return 7; }\n")

	import threading
	out = {}

	def run(tag):
		out[tag] = t.fmake("-v")

	a = threading.Thread(target=run, args=("a",))
	b = threading.Thread(target=run, args=("b",))
	a.start(); b.start(); a.join(); b.join()

	for tag, r in out.items():
		check(r.returncode == 0, f"run {tag} failed: {r.stdout}{r.stderr}")
	check(t.run(os.path.basename(t.dir)).stdout == "7\n",
	      "the binary is wrong after two concurrent builds")

	# Whichever went second must have found the first one's work, not
	# recomputed it: that is the property the lock exists for.
	combined = out["a"].stdout + out["b"].stdout
	check("cached" in combined,
	      f"the second run should have reused the cache: {combined}")


@case
def a_broken_file_does_not_sink_other_targets(t):
	"""Compile failures are per-target too, not just link failures.

    A real game had a test binary needing a library that was not installed;
    dying on that would have stopped the game itself from building, which is
    the same argument that makes link failures per-target.

    The original fixture put the broken file in tests/, which now means
    "not built by default" -- so it stopped exercising this at all and
    started passing for the wrong reason. Two ordinary programs instead:
    the property is per-target failure, not anything about tests."""
	t.write("main.c", '#include <stdio.h>\nint main(void){ puts("fine"); return 0; }\n')
	t.write("tools/dumper.c", "#include <nonexistent_library_header.h>\n"
	        "int main(void){ return 0; }\n")

	r = t.fmake()
	check(r.returncode != 0, "the failure should still be reported")
	check(os.path.exists(os.path.join(t.dir, os.path.basename(t.dir))),
	      f"the healthy target should still have been built: {r.stdout}")
	check("dumper skipped" in r.stdout,
	      f"the broken target should be named: {r.stdout}")


@case
def repeated_compiler_errors_are_grouped(t):
	"""One missing header fails every file that includes it.

    Printing the same diagnostic once per file buries everything else; on a
    292-file game a single absent header produced 248 identical copies."""
	t.write("common.h", "#include <nonexistent_library_header.h>\n")
	calls = []
	for name in ("a", "b", "c", "d"):
		t.write(f"{name}.h", f"int {name}_fn(void);\n")
		t.write(f"{name}.c", f'#include "{name}.h"\n#include "common.h"\n'
		        f"int {name}_fn(void){{ return 1; }}\n")
		calls.append(f"{name}_fn()")
	incs = "".join(f'#include "{n}.h"\n' for n in "abcd")
	t.write("main.c", incs + '#include "common.h"\n'
	        "int main(void){ return " + " + ".join(calls) + "; }\n")

	r = t.fmake()
	check(r.returncode != 0, "the build should fail")
	hits = r.stdout.count("nonexistent_library_header.h")
	check(hits <= 2,
	      f"the same error should be reported once, not {hits} times:"
	      f"\n{r.stdout}")
	check("other file(s)" in r.stdout,
	      f"the other affected files should be summarised: {r.stdout}")


@case
def one_failed_target_does_not_sink_the_rest(t):
