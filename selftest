        for f in files:
            got.add(os.path.relpath(os.path.join(base, f), stage))
    check("usr/local/lib64/libgreet.so" in got, f"library misplaced: {got}")
    check("usr/local/include/greet.h" in got, f"header not installed: {got}")
    check("usr/local/bin/tool" in got, f"program misplaced: {got}")
    check(len([g for g in got if g.endswith("greet.h")]) == 1,
          f"the header should be installed once, not once per target: {got}")


