@case
def odd_trees_do_not_crash(t):
    """Whatever is in the directory, the answer is a message not a traceback.

    A dangling symlink was the one that got through: the hash function
    returns None when it cannot stat a file and leaves no cache entry, so
    the scanner indexed a dict that had never been written to and raised
    KeyError -- which is not an OSError, so the handler for unreadable files
    did not catch it."""
    t.write("main.c", '#include <stdio.h>\nint main(void){ puts("ok"); return 0; }\n')
    os.symlink("/nonexistent-target", os.path.join(t.dir, "dangling.c"))
    t.write("empty.c", "")
    with open(os.path.join(t.dir, "binary.c"), "wb") as fh:
        fh.write(b"\xff\xfe\x00\x01not source at all\n")
    os.makedirs(os.path.join(t.dir, "loop"), exist_ok=True)
    os.symlink("..", os.path.join(t.dir, "loop", "up"))

    r = t.fmake()
    check(r.returncode == 0,
          f"none of these should stop the build: {r.stdout}{r.stderr}")
    check("Traceback" not in r.stderr, f"crashed: {r.stderr}")
    check("dangling.c" in r.stdout,
          f"the dangling symlink should be reported: {r.stdout}")
    check(t.run(os.path.basename(t.dir)).stdout == "ok\n", "wrong output")


@case
def an_unreadable_source_is_set_aside(t):
    """One stray file nobody can read should not stop a tree building.

    And if it was actually needed, the closure says so in its own terms --
    an undefined symbol naming what is missing, alongside the warning about
    the file, rather than a traceback naming a file nobody asked about."""
    if os.geteuid() == 0:
        raise Skip("running as root, so permissions prove nothing")

    t.write("main.c", '#include <stdio.h>\nint main(void){ puts("hi"); return 0; }\n')
    stray = t.write("stray.c", "int unrelated(void){ return 1; }\n")
    os.chmod(stray, 0)
    try:
        r = t.fmake()
        check(r.returncode == 0,
              f"an unreadable file nothing needs should not be fatal: "
              f"{r.stdout}{r.stderr}")
        check("unreadable" in r.stdout,
              f"it should still be reported: {r.stdout}")
        check(t.run(os.path.basename(t.dir)).stdout == "hi\n", "wrong output")
    finally:
        os.chmod(stray, 0o644)

    # Now one that is needed.
    t.write("main.c", "int needed(void);\nint main(void){ return needed(); }\n")
    dep = t.write("needed.c", "int needed(void){ return 0; }\n")
    os.chmod(dep, 0)
    try:
        shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
        r = t.fmake()
        check(r.returncode != 0, "the build cannot succeed without it")
        check("unreadable" in r.stdout, "the cause should be named")
        check("needed" in r.stdout, "the missing symbol should be named")
    finally:
        os.chmod(dep, 0o644)


@case
def an_unreadable_object_is_an_error(t):
    """nm failing must not look like an object with no symbols.

    Empty symbol sets make a file invisible to the closure -- it defines
    nothing so it is never linked, and needs nothing so it reports no
    externals. It would compile, appear in the build, and be absent from the
    result. A cross toolchain with the wrong nm gets here."""
    t.write("main.c", "#include <stdio.h>\nint helper(void){ return 1; }\n"
            'int main(void){ printf("%d\\n", helper()); return 0; }\n')
    bad = os.path.join(t.dir, "false-nm")
    with open(bad, "w") as fh:
        fh.write("#!/bin/sh\nexit 3\n")
    os.chmod(bad, 0o755)

    r = t.fmake(env={"NM": bad})
    check(r.returncode != 0, "a broken nm must fail the build, not be ignored")
    check("could not read" in r.stderr,
          f"the failure should be reported: {r.stderr}")
    check("main.c" in r.stderr, f"the object should be named: {r.stderr}")


