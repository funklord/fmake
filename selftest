@case
def moc_survives_ejection(t):
    """An ejected build must regenerate moc output, not depend on fmake's.

    Emitting the already-generated sources as ordinary ones is the cheaper
    contract and the wrong one: it would leave a standalone Makefile reading
    out of .fmake, which `fmake --clean` deletes and git never sees."""
    _need_qt()
    if not shutil.which("make"):
        raise Skip("make not installed")
    t.write("counter.h", COUNTER_H)
    t.write("main.cpp", COUNTER_MAIN)

    r = t.fmake("--eject")
    check(r.returncode == 0, f"eject failed: {r.stderr}")
    check(".fmake" not in r.stdout,
          "the ejected build refers to fmake's state directory")
    with open(os.path.join(t.dir, "Makefile"), "w") as fh:
        fh.write(r.stdout)

    prog = os.path.basename(t.dir)
    shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
    if os.path.exists(os.path.join(t.dir, prog)):
        os.remove(os.path.join(t.dir, prog))

    m = _run_in(t.dir, "make")
    check(m.returncode == 0, f"make failed: {m.stdout}{m.stderr}")
    check(_run_in(t.dir, "./" + prog).returncode == 0,
          "the ejected build produced a program whose signal never arrived")

