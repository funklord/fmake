@case
def a_directive_one_letter_wrong_is_named(t):
	"""`@lib` for `@libs` did nothing and said nothing.

	An unknown command has to be ignored -- the comment is shared with
	Doxygen, and warning about `@brief` would make the integration
	unusable, which is why section 15 carried this as unfixable. But the
	question was never "is this unknown". It is "is this unknown *and*
	almost one of ours", and that is answerable without knowing anything
	about Doxygen.

	One edit away, and the same first three characters. Measured, not
	argued: against Doxygen's 161 documented commands the edit distance
	alone already suffices -- none is a single edit from any directive
	here -- so the prefix is not what keeps `@brief` quiet. What it buys is
	the suggestion being useful, since Doxygen is not the only thing that
	writes `@word` in a comment and one edit is a wide net over arbitrary
	words. `@bind` is one edit from `@kind`, and "did you mean @kind?" is
	worse than silence: confident and wrong.

	Read from the scan record rather than warned about while scanning,
	because a scan is cached -- a warning printed at scan time appears once
	and never again, which is worse than not printing it. The case builds
	twice for that reason."""
	t.write("main.c", """
/*! @file
 *  @brief  a program
 *  @param  ignored
 *  @lib    m
 *  @cflag  -DX=1
 */
#include <math.h>
int main(void){ return (int)sqrt(4.0) - 2; }
""")
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	said = r.stdout + r.stderr
	check("@lib is not a directive" in said and "@libs" in said,
	      f"a one-letter typo was silent: {said}")
	check("@cflag is not a directive" in said,
	      f"the second typo was silent: {said}")

	# Doxygen's own commands must stay silent, or the integration is
	# unusable and the reason section 15 gave for leaving this alone comes
	# back.
	for quiet in ("@brief", "@param", "@file"):
		check(f"{quiet} is not a directive" not in said,
		      f"warned about a Doxygen command: {said}")

	# Cached scans must not swallow it. This is the half that decides
	# whether anyone ever sees the message.
	again = t.fmake()
	check("@lib is not a directive" in again.stdout + again.stderr,
	      f"the warning did not survive the scan cache: "
	      f"{again.stdout}{again.stderr}")

	# A word that is one edit from a directive but shares no prefix gets no
	# suggestion, because the suggestion would be wrong. This is what the
	# prefix half of the rule is for, and nothing else in this case
	# reaches it.
	t.write("other.c", "/*! @file\n *  @bind something\n */\n"
	        "int helper(void){ return 0; }\n")
	r = t.fmake()
	said = r.stdout + r.stderr
	check("@bind" not in said,
	      f"guessed @kind for @bind, which is confident and wrong: {said}")

	# A correctly spelled directive says nothing at all.
	u = Tree("correct")
	try:
		u.write("main.c", "/*! @file\n *  @libs m\n */\n"
		        "#include <math.h>\n"
		        "int main(void){ return (int)sqrt(4.0) - 2; }\n")
		r = u.fmake()
		check(r.returncode == 0, f"the correct build failed: {r.stderr}")
		check("not a directive" not in r.stdout + r.stderr,
		      f"warned about a directive that is spelled right: {r.stdout}")
	finally:
		u.cleanup()


@case
def advice_about_a_generated_file_names_its_source(t):
	"""You cannot put `@os` on a file fmake wrote.

	A compile error in moc, uic or rcc output was blamed on the output:
	`if .fmake/moc/src/moc_qtwebengine_interceptor.cpp belongs to another
	platform, @os NAME ... keeps it out of this build`. That is an
	instruction to edit a file under .fmake/ which fmake will overwrite,
	and the file to act on -- src/qtwebengine_interceptor.cpp -- was listed
	further down among the others, unremarked.

	Reported from a hydra build. Section 31's shape once more, and the
	sharpest version of it: the advice is not merely unhelpful, it cannot
	be followed.

	fmake knows where every generated file came from, because the moc, uic
	and rcc plans are built from exactly that. The map is taken from the
	plans rather than derived from the paths, since `moc_x.cpp came from
	x.h' is wrong for a Q_OBJECT declared in a .cpp."""
	_need_qt()
	t.write("src/thing.h", """#pragma once
#include <QObject>
#include <NoSuchQtHeader>
class Thing : public QObject { Q_OBJECT public: int n = 0; };
""")
	t.write("src/main.cpp", '/*! @file\n *  @pkg Qt6Core\n */\n'
	        '#include "thing.h"\nint main(){ Thing t; return t.n; }\n')

	r = t.fmake()
	check(r.returncode != 0, "a missing header should fail the build")
	said = r.stdout + r.stderr
	advice = [l for l in said.splitlines() if "belongs to another platform" in l]
	check(advice, f"the platform advice was not offered at all: {said}")
	check("src/thing.h" in advice[0],
	      f"the advice names something other than the source: {advice[0]}")
	check(".fmake" not in advice[0],
	      f"the advice still names a generated file, which cannot be "
	      f"annotated: {advice[0]}")
	check("generated from src/thing.h" in said,
	      f"nothing said where the generated file came from: {said}")

	# An error in an ordinary source still blames that source: the map has
	# to be empty for files nobody generated, or every failure would start
	# claiming to come from somewhere.
	u = Tree("plain")
	try:
		u.write("app.c", "#include <NoSuchHeaderAtAll>\n"
		        "int main(void){ return 0; }\n")
		r = u.fmake()
		check(r.returncode != 0, "a missing header should fail the build")
		said = r.stdout + r.stderr
		advice = [l for l in said.splitlines()
		          if "belongs to another platform" in l]
		check(advice and "app.c" in advice[0],
		      f"an ordinary source lost its own name: {advice}")
		check("generated from" not in said,
		      f"a file nobody generated was said to be generated: {said}")
	finally:
		u.cleanup()


@case
def the_qt_fpic_fix_actually_silences_qts_error(t):
	"""Section 98 said this could not be checked here. It can.

	That section verified the flag was *passed* -- on both routes to a
	module and into the ejected build -- and recorded that whether it
	silences Qt's #error was untestable, because it needs a Qt configured
	with `-reduce-relocations` and this machine's is not.

	Both halves of the condition can be supplied. `QT_REDUCE_RELOCATIONS`
	is an ordinary macro, so `@define` sets it; and a compiler that does
	not default to PIE -- which is the only thing different about the
	machine that reported this -- is a three-line shim putting `-fno-pie`
	before fmake's own flags. That is faithful rather than approximate:
	the reporting machine's gcc puts it there too, and fmake's `-fPIC`
	comes later and wins.

	The order is the whole mechanism and is worth stating, because it also
	corrects section 98. `-fPIC` and `-fno-pie` are last-wins:

	    -fPIC            __PIC__=2
	    -fno-pie         neither
	    -fPIC -fno-pie   neither      <- cancelled
	    -fno-pie -fPIC   __PIC__=2

	So `--cflags -fno-pie` still defeats it, because `--cflags` is emitted
	last by design. Section 98 said `--cflags` could not drop the flag;
	what it cannot do is remove it from the *list*, which is not the same
	as leaving it in effect."""
	_need_qt()
	shim = os.path.join(t.dir, "nopie-c++")
	with open(shim, "w") as fh:
		fh.write("#!/bin/sh\nexec c++ -fno-pie \"$@\"\n")
	os.chmod(shim, 0o755)
	t.write("app.cpp", """
/*! @file
 *  @pkg    Qt6Core
 *  @define QT_REDUCE_RELOCATIONS
 */
#include <QtCore/qglobal.h>
int main(){ return 0; }
""")
	r = t.fmake(env={"CXX": shim})
	check(r.returncode == 0,
	      f"a Qt build that declares -reduce-relocations did not compile, "
	      f"which is the failure the -fPIC exists to prevent: "
	      f"{r.stdout}{r.stderr}")

	# The fixture has to be able to fail, or it says nothing. Without the
	# shim there is no condition at all -- Debian's gcc defaults to PIE,
	# __PIC__ is defined, and Qt is happy whatever fmake passes.
	plain = t.fmake("-B")
	check(plain.returncode == 0, "the ordinary build should still work")
	probe = subprocess.run(["c++"] + subprocess.run(
	    ["pkg-config", "--cflags", "Qt6Core"], capture_output=True,
	    text=True).stdout.split()
	    + ["-DQT_REDUCE_RELOCATIONS", "-fno-pie", "-c",
	       os.path.join(t.dir, "app.cpp"), "-o", os.devnull],
	    capture_output=True, text=True)
	check(probe.returncode != 0 and "reduce-relocations" in probe.stderr,
	      "the same compile without -fPIC succeeded, so this case cannot "
	      f"fail and proves nothing: {probe.stderr[:300]}")


@case
def qt_code_is_compiled_position_independent(t):
	"""Reported from a build of hydra: 113 moc outputs failed at once.

	Qt configured with `-reduce-relocations` refuses to be included by code
	that is not position independent, and says so with an #error. The guard
	passes whenever __PIC__ is defined, and -fPIE defines it too -- so this
	is invisible on a distribution whose gcc defaults to PIE and fires on
	every Qt translation unit on one whose gcc does not. Nothing else about
	that machine was different.

	Qt states it nowhere fmake can read: its .pc files carry only -I and -D.
	CMake's Qt6 puts POSITION_INDEPENDENT_CODE on consumers and qmake's
	mkspec adds it for libraries -- every other Qt build system supplies it
	rather than discovering it, because there is nothing to discover from.

	Checked on both routes to a module, since @pkg and a header proposal are
	two ways to reach one and the flag is a property of the module rather
	than of how it was named. Not checked: that it fixes the #error, which
	needs a Qt built with -reduce-relocations and this machine's is not."""
	_need_qt()
	t.write("w.h", """#pragma once
#include <QObject>
class W : public QObject { Q_OBJECT public: int n = 0; };
""")
	t.write("app.cpp", '#include "w.h"\nint main(){ W w; return w.n; }\n')

	check(t.fmake().returncode == 0, "the Qt build failed")
	r = t.fmake("--explain")
	check(r.returncode == 0, f"--explain failed: {r.stderr}")
	check("-fPIC" in r.stdout,
	      f"Qt code was compiled without -fPIC: {r.stdout[:400]}")

	# Named outright rather than proposed from the include: the same module
	# by the other route.
	t.write("app.cpp", '/*! @file\n *  @pkg Qt6Core\n */\n'
	        '#include "w.h"\nint main(){ W w; return w.n; }\n')
	r = t.fmake("--explain")
	check("-fPIC" in r.stdout,
	      f"@pkg Qt6Core did not bring -fPIC: {r.stdout[:400]}")

	# And it has to survive the exit, or a project that leaves loses it.
	r = t.fmake("--eject")
	check(r.returncode == 0, f"eject failed: {r.stderr}")
	check("-fPIC" in r.stdout, "the ejected Qt build lost -fPIC")

	# A tree with no Qt in it must not acquire the flag -- and it has to be
	# a tree that resolves a package, or the check never reaches the code
	# that decides. A plain C program resolves nothing, so a version giving
	# every module -fPIC passed against it.
	if not _have_pkg("zlib"):
		raise Skip("zlib not installed, so the negative case cannot run")
	u = Tree("noqt")
	try:
		u.write("main.c", "#include <zlib.h>\n"
		        "int main(void){ return zlibVersion() ? 0 : 1; }\n")
		check(u.fmake().returncode == 0, "the zlib build failed")
		r = u.fmake("--explain")
		check("zlib" in r.stdout or "-lz" in r.stdout,
		      f"zlib was not resolved, so nothing was checked: "
		      f"{r.stdout[:300]}")
		check("-fPIC" not in r.stdout,
		      f"a non-Qt module was given -fPIC: {r.stdout[:300]}")
	finally:
		u.cleanup()


@case
def moc_survives_ejection(t):
	"""An ejected build must regenerate moc output, not depend on fmake's.

    Emitting the already-generated sources as ordinary ones is the cheaper
    contract and the wrong one: it would leave a standalone Makefile reading
    out of .fmake, which `fmake --clean` deletes and git never sees."""
	_need_qt()
	if not shutil.which("make"):
		raise Skip("make not installed")
	t.write("counter.h", COUNTER_H)
	t.write("main.cpp", COUNTER_MAIN)
	# Four moc'd files rather than one, and all four *reached*. The seeded
	# comparison below looks for a set reaching the emitted rules, and a
	# set of one element iterates the same way whatever the seed -- so the
	# original fixture could not fail it. The first attempt at widening
	# added three classes nobody constructs, which section 17 says are
	# moc'd, compiled and then dropped: they never reached the ejected file
	# either, and the check still could not fail. They have to be used.
	for extra in ("alpha", "bravo", "charlie"):
		t.write(f"{extra}.h", f"""#pragma once
#include <QObject>
class {extra.capitalize()} : public QObject {{
	Q_OBJECT
public:
	int n = 0;
}};
""")
	t.write("extras.cpp", """
#include "alpha.h"
#include "bravo.h"
#include "charlie.h"
int extras_sum(void) { Alpha a; Bravo b; Charlie c; return a.n + b.n + c.n; }
""")
	t.write("main.cpp", COUNTER_MAIN.replace(
	    "int main(int argc, char **argv) {",
	    "int extras_sum(void);\nint main(int argc, char **argv) {").replace(
	    "return seen == 1 ? 0 : 1;",
	    "return (seen == 1 && extras_sum() == 0) ? 0 : 1;"))

	r = t.fmake("--eject")
	check(r.returncode == 0, f"eject failed: {r.stderr}")
	check(".fmake" not in r.stdout,
	      "the ejected build refers to fmake's state directory")
	with open(os.path.join(t.dir, "Makefile"), "w") as fh:
		fh.write(r.stdout)

	# Byte-stable across hash seeds here too. eject_is_byte_stable forces
	# the seeds but its tree has no Qt in it, so the moc plan it iterates
	# is empty and any order of nothing is the same order -- a mutation
	# putting a set in that plan passes there and has to fail here.
	seeded = [t.fmake("--eject", env={"PYTHONHASHSEED": seed}).stdout
	          for seed in ("0", "1", "4242")]
	check(len(set(seeded)) == 1,
	      "the ejected Qt build depends on Python's hash seed, so a set is "
	      "reaching the moc rules")

	prog = os.path.basename(t.dir)
	shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
	if os.path.exists(os.path.join(t.dir, prog)):
		os.remove(os.path.join(t.dir, prog))

	m = _run_in(t.dir, "make")
	check(m.returncode == 0, f"make failed: {m.stdout}{m.stderr}")
	check(_run_in(t.dir, "./" + prog).returncode == 0,
	      "the ejected build produced a program whose signal never arrived")

