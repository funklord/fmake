# ---------------------------------------------------------------------------

def run_case(c):
    """Run one case in its own tree. Returns (status, detail)."""
    t = Tree(c.__name__)
    try:
        c(t)
        return "ok", ""
    except Skip as exc:
        return "skip", str(exc)
    except Failure as exc:
        return "fail", str(exc) + (f"\n       tree: {t.dir}" if KEEP else "")
    except Exception as exc:                           # noqa: BLE001
        return "err", repr(exc)
    finally:
        t.cleanup()


def main(argv):
    global KEEP, JOBS
    pats = [a for a in argv if not a.startswith("-")]
    KEEP = "-k" in argv
    for a in argv:
        if a.startswith("-j"):
            JOBS = max(1, int(a[2:] or 1))

    if not os.access(FMAKE, os.X_OK):
        print(f"{RED}fmake is not executable at {FMAKE}{OFF}")
        return 2

    cases = [c for c in CASES
             if not pats or any(p in c.__name__ for p in pats)]
    failures = skipped = 0

    with concurrent.futures.ThreadPoolExecutor(max_workers=JOBS) as pool:
        results = list(pool.map(run_case, cases))

    for c, (status, detail) in zip(cases, results):
        if status == "ok":
            print(f"{GREEN}ok{OFF}   {c.__name__}")
        elif status == "skip":
            skipped += 1
            print(f"{DIM}skip {c.__name__} -- {detail}{OFF}")
        elif status == "fail":
            failures += 1
            print(f"{RED}FAIL{OFF} {c.__name__}")
            print(f"       {detail}")
        else:
            failures += 1
            print(f"{RED}ERR {OFF} {c.__name__}: {detail}")

    print()
    tail = f" ({skipped} skipped)" if skipped else ""
    if failures:
        print(f"{RED}{failures} of {len(cases)} failed{OFF}{tail}")
    else:
        print(f"{GREEN}all {len(cases) - skipped} passed{OFF}{tail}")
    return 1 if failures else 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
