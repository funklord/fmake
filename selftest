def conf_toolchain_sets_the_target_platform(t):
	"""@os must be tested against what is being built for, not the host.

    Without this a cross build silently keeps the host's files and drops the
    target's, which is wrong every time and produces no error."""
	t.write("sys.h", "const char *sys_name(void);\n")
	t.write("linux_sys.c", '//! @os linux\n#include "sys.h"\n'
	        'const char *sys_name(void){ return "linux"; }\n')
	t.write("windows_sys.c", '//! @os windows\n#include "sys.h"\n'
	        'const char *sys_name(void){ return "windows"; }\n')
	t.write("main.c", '#include <stdio.h>\n#include "sys.h"\n'
	        "int main(void){ puts(sys_name()); return 0; }\n")

	# No [toolchain]: the host wins, and this machine is not Windows.
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check("windows_sys.c" not in compiled(r),
	      f"the windows file should be excluded here: {compiled(r)}")

	# Declaring a target platform must flip the choice.
	t.write("fmake.toml", '[toolchain]\nos = "windows"\n')
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	e = t.fmake("--explain").stdout
	check("building for windows" in e,
	      f"the target platform should be reported: {e}")
	check("linux_sys.c" in e.split("link set")[0],
	      f"the host's file should now be the excluded one: {e}")


