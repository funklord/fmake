def _optional_annotated(t, module):
	"""hydra's shape: a feature that exists only if a package does."""
	if not _have_pkg("zlib"):
		raise Skip("zlib has no pkg-config file here")
	t.write("main.c",
	        "/**\n * @pkg_optional " + module + " defines HAVE_ZLIB\n */\n"
	        "#include <stdio.h>\n"
	        "#ifdef HAVE_ZLIB\n#include <zlib.h>\n#endif\n"
	        "int main(void){\n"
	        "#ifdef HAVE_ZLIB\n\tprintf(\"zlib %s\\n\", zlibVersion());\n"
	        "#else\n\tprintf(\"none\\n\");\n#endif\n"
	        "\treturn 0;\n}\n")


@case
def found_means_defined(t):
	"""`@pkg_optional NAME defines MACRO`, which hydra asked for by name.

	The pattern every optional dependency in every C project uses, and the
	one thing fmake could not see. What the directive adds is the macro, not
	the library: once the macro is defined the guarded code is there and its
	symbols ask for the library themselves, so section 3 still decides the link."""
	_optional_annotated(t, "zlib")

	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	out = t.run(os.path.basename(t.dir)).stdout
	check(out.startswith("zlib "),
	      f"the feature should be compiled in: {out!r}")
	check("the preprocessor did not take" not in r.stdout + r.stderr,
	      "a feature that was turned on is not a compiled-away one")


@case
def a_missing_optional_package_is_said_out_loud(t):
	"""The other half, and it is the half that matters.

	"Built without keyring support" is the sentence hydra's browser needed
	and did not get. Printing it only when the answer is no would make its
	absence meaningless, so the yes case says so under --verbose."""
	_optional_annotated(t, "libfmake-no-such-package-9")

	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	out = r.stdout + r.stderr
	check("is not installed" in out and "HAVE_ZLIB is undefined" in out,
	      f"a feature left out should be reported: {out}")
	check(t.run(os.path.basename(t.dir)).stdout == "none\n",
	      "the feature should not be compiled in")


@case
def a_malformed_pkg_optional_is_fatal(t):
	"""Missing is tolerated; misspelt is not.

	The directive exists because a feature can vanish quietly. One fmake
	silently ignored because the keyword was left out would be that same
	failure wearing the fix as a disguise."""
	if not _have_pkg("zlib"):
		raise Skip("zlib has no pkg-config file here")
	t.write("main.c",
	        "/**\n * @pkg_optional zlib HAVE_ZLIB\n */\n"
	        "int main(void){ return 0; }\n")

