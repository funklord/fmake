# ---------------------------------------------------------------------------
# rcc
#
# The one Qt generator with no reliable symbol: a resource registers itself
# from a static constructor, so nothing refers to the generated object and
# the closure alone would always drop it. What the source does say is which
# resources it opens, and that is per file -- so these cases are mostly about
# whether the right program got it.
# ---------------------------------------------------------------------------

def _qrc(prefix, name, text):
	return (f'<!DOCTYPE RCC><RCC version="1.0">\n'
	        f'<qresource prefix="{prefix}">\n'
	        f'  <file>{name}</file>\n'
	        f'</qresource>\n</RCC>\n')


def _reader(path, want):
	"""A program that opens a resource and checks its contents."""
	return f"""
#include <QCoreApplication>
#include <QFile>
int main(int argc, char **argv) {{
    QCoreApplication app(argc, argv);
    QFile f("{path}");
    if (!f.open(QIODevice::ReadOnly)) return 2;
    return f.readAll().trimmed() == "{want}" ? 0 : 1;
}}
"""


@case
def rcc_runs_because_the_source_opens_the_resource(t):
	"""A ":/prefix/..." literal is the source saying it uses the resource.

    Nothing else can say it: the generated object is referenced by no
    symbol, so without this evidence the closure drops it and the program
    fails at runtime rather than at the link."""
	_need_qt()
	t.write("assets/greeting.txt", "hello from the resource\n")
	t.write("assets/app.qrc", _qrc("/data", "greeting.txt", ""))
	t.write("main.cpp", _reader(":/data/greeting.txt",
	                            "hello from the resource"))

	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check("RCC assets/app.qrc" in r.stdout, f"rcc did not run: {r.stdout}")
	got = t.run(os.path.basename(t.dir))
	check(got.returncode == 0,
	      f"the resource was not readable at runtime (exit {got.returncode})")


