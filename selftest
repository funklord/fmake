@case
def directives_only_count_in_doxygen_comments(t):
    """An @ in an ordinary comment is not a directive.

    Restricting to Doxygen's own markers is what stops an email address or a
    stray note from silently renaming the program."""
    # The Doxygen one comes FIRST deliberately. @target is scalar, so last
    # wins -- if the plain comments were parsed at all they would override
    # it, and the test would notice.
    t.write("main.c", """
