@case
def moc_output_is_compiled_without_waiting_for_widening(t):
	"""Widening cannot be relied on to discover moc output.

    Widening picks its extra files by scanning for apparent *definitions*,
    which is a regex over source text. That finds Foo::staticMetaObject, so
    a class whose signals are emitted survives even if moc output is left
    out of the candidate set. A class whose only debt to moc is its vtable
    does not: no regex sees a vtable, `_ZTV4Base` is nothing any source
    spells, and the build fails to link having compiled everything it was
    asked to. Hence moc output joins the candidates outright."""
	_need_qt()
	t.write("base.h", """
#pragma once
#include <QObject>
class Base : public QObject {
    Q_OBJECT
public:
    virtual ~Base();
    virtual int kind() const { return 1; }
};
""")
	t.write("base.cpp", '#include "base.h"\nBase::~Base() {}\n')
	t.write("main.cpp", """
#include <QCoreApplication>
#include "base.h"
int main(int argc, char **argv) {
    QCoreApplication app(argc, argv);
    Base *b = new Base();
    int k = b->kind();
    delete b;
    return k == 1 ? 0 : 1;
}
""")
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check(any("moc_base.cpp" in c for c in compiled(r)),
	      f"moc output was never compiled: {compiled(r)}")
	check(t.run(os.path.basename(t.dir)).returncode == 0, "program failed")


@case
def moc_leaves_out_a_class_no_program_reaches(t):
	"""A Q_OBJECT class nothing constructs must not reach the binary.

    qmake mocs and links everything in HEADERS whether the class is
    reachable or not. Here the closure decides, so the cost of an unused
    class is one compile rather than a permanent passenger."""
	_need_qt()
	t.write("counter.h", COUNTER_H)
	t.write("spare.h", COUNTER_H.replace("Counter", "Spare"))
