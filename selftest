	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	archive = os.path.join(t.dir, "libmathx.a")
	check(os.path.exists(archive), f"expected libmathx.a: {os.listdir(t.dir)}")

	# a library is everything the tree defines, so clamp.c must be in it
	syms = subprocess.run(["nm", "--format=posix", archive],
	                      capture_output=True, text=True).stdout
	check("mathx_clamp" in syms and "mathx_scale" in syms,
	      "the archive should hold every TU, not a closure")

	use = os.path.join(t.dir, "use.c")
	with open(use, "w") as fh:
		fh.write('#include <stdio.h>\n#include "mathx.h"\n'
		         'int main(void){ printf("%g %d\\n", mathx_scale(3,4),'
		         ' mathx_clamp(99,0,10)); return 0; }\n')
	exe = os.path.join(t.dir, "consumer")
	r2 = subprocess.run(["cc", "-I", t.dir, "-o", exe, use, archive],
	                    capture_output=True, text=True)
	check(r2.returncode == 0, f"consumer link failed: {r2.stderr}")
	out = subprocess.run([exe], capture_output=True, text=True).stdout
	check(out == "12 10\n", f"wrong output from the consumer: {out!r}")


@case
def a_missing_header_names_the_platform_escape(t):
	"""hydra's hard blocker, and the answer they did not find.

	Four Android sources CMake adds only inside if(ANDROID), carrying no
	self-guard because the build system is what excludes them. fmake sees
	the include behind the #ifdef -- the scan cannot evaluate one -- so the
	file is proposed, compiled, and fails on a header that is not here.
	Their conclusion: "no flag fixes it, because the question is which files
	belong in this build". Right about the question; the answer is @os, and
	nothing said so.

	Both causes are named because fmake cannot tell them apart. A header
	that is not on any include path is equally the symptom of a package
	nobody installed."""
	# Deliberately not platform-named. This case is about a header that is
	# not there, and once the filename rule learned prefixes as well as
	# suffixes, a fixture called android_view.c was excluded by name before
	# it could fail to compile -- so the case stopped testing anything and
	# said so.
	t.write("jni_bridge.h", "#pragma once\nint jni_attach(void);\n")
	t.write("main.c",
	        "#include <stdio.h>\n#ifdef ANDROID\n"
	        '#include "jni_bridge.h"\n#endif\n'
	        "int platform_id(void);\n"
	        'int main(void){ printf("%d\\n", platform_id()); return 0; }\n')
	t.write("platform_linux.c", "int platform_id(void){ return 1; }\n")
	t.write("jni_bridge.c",
	        '#include "jni_bridge.h"\n#include <fmake_no_such_header.h>\n'
	        "int jni_attach(void){ return 0; }\n")

	out = t.fmake().stdout + t.fmake().stderr
	check("fmake_no_such_header.h is on no include path here" in out,
	      f"the missing header should be named: {out}")
	check("@os NAME" in out,
	      f"the platform escape should be offered: {out}")
	check("@pkg" in out,
	      f"the other cause should be offered too: {out}")

	# And it is a real escape, not just advice.
	t.write("jni_bridge.c",
	        '/** @os android */\n#include "jni_bridge.h"\n'
	        "#include <fmake_no_such_header.h>\n"
	        "int jni_attach(void){ return 0; }\n")
	r = t.fmake("-B")
	check(r.returncode == 0, f"@os should settle it: {r.stdout}{r.stderr}")
	check(t.run(os.path.basename(t.dir)).stdout == "1\n",
	      "the program should build and run without the Android file")


@case
def a_c_file_runs_as_a_script(t):
	"""`--run` builds a C file and becomes it.

	The form with no shebang is the binfmt_misc one, where the kernel is
	told that a .c file is executable and hands it to fmake: the file stays
	pure C and there is nothing to strip. Arguments after the file are the
	program's, and the exit status is the program's -- fmake execs rather
	than waits, so it is not sitting between the program and the shell."""
	t.write("hello.c", "#include <stdio.h>\n"
	        'int main(int c, char **v){ printf("%s|%d\\n", v[0], c - 1);\n'
	        "\treturn c - 1; }\n")

	# An absolute path, because --run resolves its file against the
	# caller's working directory like any file argument -- a shebang always
	# hands it one -- while -C only says where the build root is.
	r = t.fmake("--run", os.path.join(t.dir, "hello.c"), "one", "two")
	check(r.stdout == f"{os.path.join(t.dir, 'hello.c')}|2\n",
	      f"argv[0] is the script and the arguments are its own: {r.stdout!r}")
	check(r.returncode == 2,
	      f"the program's exit status is the command's: {r.returncode}")


@case
def a_shebang_is_stripped_and_the_diagnostics_still_fit(t):
	"""`#!` on line 1 is not C: gcc calls it an invalid preprocessing
	directive, and so does g++. So a file carrying one is copied with that
	line replaced -- by `#line`, not by a blank, so a compiler error still
	names the file the author wrote and the line they wrote it on. A blank
	would keep the numbering and lose the name; deleting the line would
	lose both."""
	t.write("bad.c", "#!/usr/bin/env -S fmake --run\n"
	        "#include <stdio.h>\n"
	        "int main(void){ return oops; }\n")

	r = t.fmake("--run", os.path.join(t.dir, "bad.c"))
	check(r.returncode != 0, "it does not compile, so it does not run")
	out = r.stdout + r.stderr
	check("bad.c:3" in out,
	      f"the error should name the original file and line: {out}")
	check(".fmake" not in out.split("bad.c:3")[0][-80:],
	      f"and not the copy fmake compiled: {out}")

	# And a shebang that does compile runs.
	t.write("ok.c", "#!/usr/bin/env -S fmake --run\n"
	        '#include <stdio.h>\nint main(void){ puts("ran"); return 0; }\n')
	r = t.fmake("--run", os.path.join(t.dir, "ok.c"))
	check(r.stdout == "ran\n", f"the shebang form should run: {r.stdout!r}")


@case
def a_run_leaves_nothing_beside_the_script(t):
	"""The answer to "does it clean up" is that it never dirties.

	A script may sit in a directory that is not the author's to litter, and
	the binary belongs with the objects. Putting both under the state
	directory is also what makes the second run instant instead of a
	rebuild, which is the property that makes a compiled language usable as
	a scripting one at all."""
	t.write("hello.c", '#include <stdio.h>\nint main(void){ puts("hi");'
	        " return 0; }\n")

	before = set(os.listdir(t.dir))
	run = os.path.join(t.dir, "hello.c")
	check(t.fmake("--run", run).stdout == "hi\n", "it should run")
	after = set(os.listdir(t.dir)) - before
	check(after <= {".fmake"},
	      f"nothing should appear beside the script: {sorted(after)}")

	# The second run must not rebuild, which is the whole point of a cache.
	r = t.fmake("--run", run)
	check(r.stdout == "hi\n", "it should run again")
	check("CC " not in r.stdout + r.stderr,
	      f"the second run should not compile: {r.stdout}{r.stderr}")


@case
def a_script_runs_from_a_directory_nobody_may_write_to(t):
	"""An installed script is the case a scripting front end must handle.

	fmake keeps its cache beside the source, which is right for a project
	and impossible for a script in /usr/local/bin or a read-only checkout:
	the first attempt refused to run at all, saying it could not create
	.fmake there. It falls back to a cache of its own, keyed on the script's
	path, and builds the file alone -- a script somewhere unwritable is
	almost certainly self-contained, and if it is not, the missing symbol
	says so in the ordinary way."""
	if os.geteuid() == 0:
		raise Skip("running as root, so a read-only directory proves nothing")
	t.write("here/s.c", "#!/usr/bin/env -S fmake --run\n#include <stdio.h>\n"
	        'int main(void){ puts("ran"); return 0; }\n')
	here = os.path.join(t.dir, "here")
	script = os.path.join(here, "s.c")
	os.chmod(here, 0o555)
	try:
		r = subprocess.run([FMAKE, "--run", script],
		                   capture_output=True, text=True)
		check(r.returncode == 0, f"it should still run: {r.stdout}{r.stderr}")
		check(r.stdout == "ran\n", f"and produce its output: {r.stdout!r}")
		check(os.listdir(here) == ["s.c"],
		      f"nothing may be written beside it: {os.listdir(here)}")
	finally:
		os.chmod(here, 0o755)

	# And with no shebang, which is the case the copy is not otherwise made
	# for: a shebang forces one anyway, so a fixture that has one leaves the
	# read-only path untested. Found by mutation, which removed the copy and
	# broke nothing.
	t.write("here/plain.c", '#include <stdio.h>\n'
	        'int main(void){ puts("plain"); return 0; }\n')
	plain = os.path.join(here, "plain.c")
	os.chmod(here, 0o555)
	try:
		r = subprocess.run([FMAKE, "--run", plain],
		                   capture_output=True, text=True)
		check(r.returncode == 0,
		      f"a file with no shebang should run too: {r.stdout}{r.stderr}")
		check(r.stdout == "plain\n", f"and produce its output: {r.stdout!r}")
	finally:
		os.chmod(here, 0o755)


@case
def a_run_builds_what_the_script_needs(t):
	""""A collection of them", which needs no special case at all.

	The script is a program like any other, so its closure reaches the
	siblings that define what it calls -- and its stdin and stdout are its
	own, since fmake has execed and is no longer there."""
	t.write("util.h", "#pragma once\nint shout(const char *);\n")
	t.write("util.c", "#include <stdio.h>\n#include <ctype.h>\n"
	        '#include "util.h"\n'
	        "int shout(const char *s){ for (; *s; s++)\n"
	        "\t\tputchar(toupper((unsigned char)*s)); return 0; }\n")
	t.write("up.c", "#include <stdio.h>\n#include \"util.h\"\n"
	        "int main(void){ char b[128];\n"
	        "\twhile (fgets(b, sizeof b, stdin)) shout(b); return 0; }\n")

	r = subprocess.run([FMAKE, "-C", t.dir, "--run",
	                    os.path.join(t.dir, "up.c")],
	                   input="hello there\n", capture_output=True, text=True)
	check(r.returncode == 0, f"failed: {r.stdout}{r.stderr}")
	check(r.stdout == "HELLO THERE\n",
	      f"the sibling should be linked and stdin should reach it: "
	      f"{r.stdout!r}")


@case
def the_tree_never_stands_in_for_a_standard_header(t):
	"""fuzzypickles vendors thorvg, which vendors rapidjson, which ships an
	MSVC-only stdint.h.

	fmake resolves an include it cannot place by basename when exactly one
	file in the tree has that name -- a useful guess for a vendored
	<vterm.h>, and a catastrophic one here. That file was the only stdint.h
	in the tree, so it won, its directory went on the include path for every
	compile, and 54 files failed on the #error inside it, including moc
	output with no connection to thorvg. One vendored file four levels down
	redefined a standard header for the whole build."""
	t.write("vendor/msinttypes/stdint.h",
	        '#error "Use this header only with Microsoft Visual C++"\n')
	t.write("main.c", "#include <stdint.h>\n#include <stdio.h>\n"
	        'int main(void){ uint32_t n = 1; printf("%u\\n", n); return 0; }\n')

	r = t.fmake()
	check(r.returncode == 0,
	      f"the system stdint.h must win: {r.stdout}{r.stderr}")
	check(t.run(os.path.basename(t.dir)).stdout == "1\n",
	      "the program should build and run")
	flags = t.fmake("-B", "-n").stdout
	check("msinttypes" not in flags,
	      f"that directory must not reach the include path: {flags[:400]}")

	# A name the toolchain does not own is still resolved this way, which
	# is what makes the guess worth keeping. Included from the root, not
	# from a file reached by widening -- that second shape is the open
	# ordering question of section 68, and asserting it here would be
	# asserting something fmake does not do.
	os.remove(os.path.join(t.dir, "vendor/msinttypes/stdint.h"))
	t.write("vendor/include/vt.h", "#pragma once\nint vt(void);\n")
	t.write("vendor/vt.c", "int vt(void){ return 0; }\n")
	t.write("main.c", "#include <vt.h>\nint main(void){ return vt(); }\n")
	r = t.fmake("-B")
	check(r.returncode == 0,
	      f"a vendored header is still found by name: {r.stdout}{r.stderr}")


@case
def every_include_directory_the_tree_could_supply_is_named_at_once(t):
	"""A vendored library with its own include layout fails a group per
	header.

	thorvg gave ten, spread over three directories, and each line named one
	-- so the reader collects them by hand and re-runs to find the next.
	fmake already knows all of them when it prints the first, so it says so
	in one line. Following it took that tree from 48 files failing to 11."""
	t.write("vendor/a/one.h", "#pragma once\nint one(void);\n")
	t.write("vendor/b/two.h", "#pragma once\nint two(void);\n")
	t.write("vendor/a/one.c", '#include "one.h"\nint one(void){ return 1; }\n')
	t.write("vendor/b/two.c", '#include "two.h"\nint two(void){ return 2; }\n')
	# Reached by widening, which is where the directory is not yet known.
	# A third header in a directory already named, so the list has to
	# collapse duplicates -- without that it repeats vendor/a, and a fixture
	# with one header per directory never notices.
	t.write("vendor/a/three.h", "#pragma once\nint three(void);\n")
	t.write("vendor/a/three.c", '#include "three.h"\n'
	        "int three(void){ return 0; }\n")
	t.write("src/use_one.c", "#include <one.h>\nint u1(void){ return one(); }\n")
	t.write("src/use_two.c", "#include <two.h>\nint u2(void){ return two(); }\n")
	t.write("src/use_three.c", "#include <three.h>\n"
	        "int u3(void){ return three(); }\n")
	t.write("src/main.c", "int u1(void); int u2(void); int u3(void);\n"
	        "int main(void){ return u1() + u2() + u3() - 3; }\n")

	out = t.fmake().stdout + t.fmake().stderr
	line = [l for l in out.splitlines() if "all of those together" in l]
	check(line, f"both directories should be offered at once: {out}")
	check("vendor/a" in line[0] and "vendor/b" in line[0],
	      f"and both should be in it: {line}")
	check(line[0].count("vendor/a") == 1,
	      f"a directory needed twice is named once: {line}")

	# One missing directory needs no summary: the per-group line said it.
	t.write("src/use_two.c", "int u2(void){ return 2; }\n")
	out = t.fmake("-B").stdout + t.fmake().stderr
	check(not [l for l in out.splitlines() if "all of those together" in l],
	      f"one directory is not a list: {out}")


@case
def a_header_the_tree_already_holds_is_named(t):
	"""beerssh vendors libvterm and includes it as <vterm.h>.

	The file is at vterm/include/vterm.h -- inside the tree fmake just
	walked -- and the advice offered to install a package or exclude the
	file by platform. Neither is right, and being told to install something
	that is already there is worse than being told nothing.

	fmake knows every header in the tree, so when the missing one is among
	them it says where and what would find it. That is exact rather than a
	guess, which is why it replaces the two speculative remedies instead of
	joining them."""
	# The including file has to be one fmake reaches by widening rather
	# than through the root's include graph -- which is beerssh's shape,
	# and the first version of this fixture put the include in main.c,
	# where fmake resolves it and the case had nothing to test.
	t.write("vendor/include/thing.h", "#pragma once\nint thing(void);\n")
	t.write("vendor/thing.c", "int thing(void){ return 0; }\n")
	t.write("src/emu.c", "#include <thing.h>\n"
	        "int emu_start(void){ return thing(); }\n")
	t.write("src/main.c", "int emu_start(void);\n"
	        "int main(void){ return emu_start(); }\n")

	r = t.fmake()
	out = r.stdout + r.stderr
	check("thing.h is on no include path here" in out,
	      f"the missing header should be named: {out}")
	check("vendor/include/thing.h" in out,
	      f"and where the tree holds it: {out}")
	check("include-dirs" in out,
	      f"and what would find it: {out}")
	check("install it or name it with @pkg" not in out,
	      f"it is not a missing package: {out}")

	# And the advice works when followed.
	t.write("fmake.toml", "[project]\ninclude-dirs = ['vendor/include']\n")
	r = t.fmake("-B")
	check(r.returncode == 0,
	      f"following the advice should build: {r.stdout}{r.stderr}")

	# A header that is genuinely absent still gets the other two remedies.
	# A header that is genuinely absent still gets the other two remedies --
	# and must not be answered by one whose name merely ends the same way.
	# `xtimer.h` does not satisfy `<timer.h>`, which is the whole-component
	# rule this tree applies everywhere a name is matched against a path.
	os.remove(os.path.join(t.dir, "fmake.toml"))
	t.write("vendor/include/xtimer.h", "#pragma once\n")
	t.write("src/emu.c", "#include <timer.h>\n"
	        "int emu_start(void){ return 0; }\n")
	out = t.fmake("-B").stdout + t.fmake().stderr
	check("install it or name it with @pkg" in out,
	      f"an absent header is still a missing package: {out}")
	check("xtimer.h" not in out,
	      f"a longer name is not the header that was asked for: {out}")


@case
def an_unrelated_error_gets_no_platform_advice(t):
	"""A wrong remedy costs more than none -- section 31, and this is where it
	would land, since a compile failure is read by someone already stuck."""
	t.write("main.c", "int main(void){ return \"oops\"; }\n")

	out = t.fmake().stdout + t.fmake().stderr
	check("@os NAME" not in out,
	      f"a type error has nothing to do with platforms: {out}")


@case
def an_app_and_its_tests_build_with_no_configuration(t):
	"""src/main.cpp and tests/main.cpp, which two of five projects had.

	`src` is skipped as a directory name that names nothing, so the app is
	called after the project. `tests` is not skipped -- skipping it would
	land on the project name too and collide with the app -- so it wants to
	be called `tests`, which is the directory it came from, and fmake
	refused. Both projects wrote a config file for this on their first run.

	A name nobody chose is qualified instead. That cannot change a build
	that worked, because the only trees affected are the ones that stopped
	with an error."""
	t.write("src/session.h", "#pragma once\nint session_open(const char *);\n")
	t.write("src/session.cpp", '#include "session.h"\n'
	        "int session_open(const char *s){ return s && *s ? 7 : 0; }\n")
	t.write("src/main.cpp", '#include <cstdio>\n#include "session.h"\n'
	        'int main(){ std::printf("app %d\\n", session_open("x")); '
	        "return 0; }\n")
	t.write("tests/main.cpp", '#include <cstdio>\n'
	        '#include "../src/session.h"\n'
	        'int main(){ std::printf("test %d\\n", session_open("y")); '
	        "return 0; }\n")

	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	app = os.path.basename(t.dir)
	check(t.run(app).stdout == "app 7\n", "the app did not build")
	# Announced, because a name fmake picked is a name the reader did not.
	check("calling it" in r.stdout + r.stderr,
	      f"the rename should be said out loud: {r.stdout}{r.stderr}")

	# tests/ means two things now and they compose: the name is qualified
	# because `tests` is a directory, and the program is held back because
	# `tests` is where tests live. Both are true at once.
	check(not os.path.exists(os.path.join(t.dir, f"{app}_tests")),
	      "a program under tests/ is not in the default build")
	r = t.fmake("test")
	check(r.returncode == 0, f"fmake test failed: {r.stdout}{r.stderr}")
	check(t.run(f"{app}_tests").stdout == "test 7\n",
	      f"the test binary did not build: {os.listdir(t.dir)}")

	# A name somebody chose is still theirs.
	t.write("fmake.toml", '[target.tests]\nname = "beerssh_test"\n')
	r = t.fmake("-B", "test")
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check(t.run("beerssh_test").stdout == "test 7\n",
	      "an explicit name should win over the qualified one")


@case
def a_name_the_author_chose_is_refused_not_renamed(t):
	"""Qualifying applies to a name nobody picked, and only that.

	Renaming what an author asked for is worse than declining: they would
	get a binary under a name they did not choose and no reason to look. The
	refusal names the section that would fix it."""
	t.write("lib/helper.c", "int helper(void){ return 0; }\n")
	t.write("prog.c", "//! @target lib\nint main(void){ return 0; }\n")

	r = t.fmake()
	check(r.returncode != 0,
	      f"a chosen name over a directory should be refused: {r.stdout}")
	out = r.stdout + r.stderr
	check("would be written over" in out,
	      f"the refusal should say why: {out}")
	check("[target.lib]" in out,
	      f"the refusal should name the section that fixes it: {out}")


@case
def a_target_section_that_matches_nothing_says_what_exists(t):
	"""section 31: name a place that exists.

	A [target.*] section is keyed by the name a target already has, and that
	is not always the directory -- src/main.cpp is called after the project,
	since `src` names nothing. So [target.src] is the obvious guess and the
	wrong one, and an error that only says "declares no root" sends the
	reader to add a root rather than to fix the key. Found by making that
	exact mistake."""
	t.write("src/main.cpp", "int main(){ return 0; }\n")
	t.write("fmake.toml", '[target.src]\nname = "app"\n')

	r = t.fmake()
	check(r.returncode != 0, "an unmatched section should be refused")
	out = r.stdout + r.stderr
	check("Targets discovered here" in out and os.path.basename(t.dir) in out,
	      f"the message should name the sections that would work: {out}")


@case
def a_scalar_directive_takes_one_word(t):
	"""`@kind static @target chosen` on one line silently built `liba.a`.

	The parser hands a scalar directive the rest of the line, so the second
	directive became an argument of the first and the target name vanished.
	Two directives on one line is a reasonable thing to try, and being wrong
	about it should not be quiet -- the same reasoning that makes `@test`
	refuse two words and `@pkg_optional` require its keyword.

	Found while writing a fixture, by writing it the way anyone would."""
	t.write("a.c", "/** @kind static @target chosen */\n"
	        "int f(void){ return 0; }\n")

	r = t.fmake()
	check(r.returncode != 0, "two directives on one line should be refused")
	out = r.stdout + r.stderr
	check("takes one word" in out and "own line" in out,
	      f"and should say how to write it: {out}")

	t.write("a.c", "/**\n * @kind static\n * @target chosen\n */\n"
	        "int f(void){ return 0; }\n")
	r = t.fmake("-B")
	check(r.returncode == 0, f"one per line is fine: {r.stdout}{r.stderr}")
	check(os.path.exists(os.path.join(t.dir, "libchosen.a")),
	      f"and the target name applies: {os.listdir(t.dir)}")


@case
def only_a_program_can_be_a_test(t):
	"""A support library under tests/ is not a test.

	`@kind static` on a file in tests/ -- a helper library the test binaries
	link, which is an ordinary thing to have -- was classified as a test by
	its directory, held out of the default build, and then *run*: fmake
	tried to execute the archive and reported `Permission denied` on it. An
	errno blaming a file for not being executable, which it never claimed to
	be.

	Found by asking what a mutation left uncovered, on a tree that had just
	shipped a generated test file inside its library."""
	# One directive per line: the parser hands a scalar directive the rest
	# of the line, so both on one line is refused rather than half-read.
	t.write("tests/support.c", "/**\n * @kind static\n"
	        " * @target testsupport\n */\n"
	        "int helper(void){ return 7; }\n")
	t.write("main.c", "int helper(void);\n"
	        "int main(void){ return helper() - 7; }\n")

	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check(os.path.exists(os.path.join(t.dir, "libtestsupport.a")),
	      f"a library is built by default: {os.listdir(t.dir)}")

	# And nothing tries to run it.
	r = t.fmake("test")
	out = r.stdout + r.stderr
	check("Permission denied" not in out,
	      f"an archive must not be executed: {out}")
	check("RUN testsupport" not in out,
	      f"and must not be listed as a test: {out}")


