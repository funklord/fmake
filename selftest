@case
def odd_trees_do_not_crash(t):
	"""Whatever is in the directory, the answer is a message not a traceback.

    A dangling symlink was the one that got through: the hash function
    returns None when it cannot stat a file and leaves no cache entry, so
    the scanner indexed a dict that had never been written to and raised
    KeyError -- which is not an OSError, so the handler for unreadable files
    did not catch it."""
	t.write("main.c", '#include <stdio.h>\nint main(void){ puts("ok"); return 0; }\n')
	os.symlink("/nonexistent-target", os.path.join(t.dir, "dangling.c"))
	t.write("empty.c", "")
	with open(os.path.join(t.dir, "binary.c"), "wb") as fh:
		fh.write(b"\xff\xfe\x00\x01not source at all\n")
