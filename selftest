		      f"the key should be named: {r.stdout}{r.stderr}")


def _grouped(t):
	"""A unit test and a live driver, which is hydra's shape."""
	t.write("main.c", "int main(void){ return 0; }\n")
	t.write("tests/unit_test.c",
	        '#include <stdio.h>\nint main(void){ puts("unit ok"); return 0; }\n')
	t.write("tests/live/fetch_test.c",
	        "/** @test live */\n#include <stdio.h>\n"
	        'int main(void){ puts("live ok"); return 0; }\n')


@case
def a_test_group_is_not_run_by_the_default_group(t):
	"""hydra has 66 test programs of which 26 are live drivers.

	A directory name cannot say which is which -- `tests/` holds both,
	correctly, because both are tests. What separates them is what they
	need, not what they check, and that is something only the source can
	state. `@test live` states it; `fmake live` runs them."""
	_grouped(t)

	r = t.fmake("test")
	check(r.returncode == 0, f"failed: {r.stdout}{r.stderr}")
	check("unit ok" in r.stdout and "live ok" not in r.stdout,
	      f"`fmake test` runs the default group only: {r.stdout}")

	r = t.fmake("live")
	check(r.returncode == 0, f"failed: {r.stdout}{r.stderr}")
	check("live ok" in r.stdout and "unit ok" not in r.stdout,
	      f"`fmake live` runs that group only: {r.stdout}")

	r = t.fmake("test", "live")
	check("live ok" in r.stdout and "unit ok" in r.stdout,
	      f"naming both runs both: {r.stdout}")

	# Two filters stand between a group name and a test running: which
	# targets get built, and which of those get run. Each masks the other's
	# removal, so both need an assertion that the other cannot satisfy.
	#
	# Built: `fmake test` must not produce the live binary at all. The
	# earlier step in this case built it, and a rebuild does not unlink
	# what it does not make -- so the file has to go first or the check
	# passes on a leftover.
	os.unlink(os.path.join(t.dir, "fetch_test"))
	t.fmake("-B", "test")
	check(not os.path.exists(os.path.join(t.dir, "fetch_test")),
	      f"`fmake test` should not build the live group: "
	      f"{os.listdir(t.dir)}")

	# Run: name a live test alongside `test`. It is asked for, so it is
	# built; it is not in the group asked for, so it is not run.
	r = t.fmake("test", "fetch_test")
	check(os.path.exists(os.path.join(t.dir, "fetch_test")),
	      "naming it should build it")
	check("unit ok" in r.stdout and "live ok" not in r.stdout,
	      f"a test outside the group asked for is built, not run: "
	      f"{r.stdout}")


@case
def a_plain_build_holds_back_every_group(t):
	"""Whatever group it is in, a test is still a test.

	And the message has to name every group, because with more than one
	`fmake test` is no longer the whole answer."""
	_grouped(t)

	r = t.fmake()
	check(r.returncode == 0, f"failed: {r.stdout}{r.stderr}")
	for name in ("unit_test", "fetch_test"):
		check(not os.path.exists(os.path.join(t.dir, name)),
		      f"{name} should not be in the default build")
	out = r.stdout + r.stderr
	check("`fmake test`" in out and "`fmake live`" in out,
	      f"both groups should be named: {out}")


@case
def an_ejected_build_gets_a_rule_per_group(t):
	"""One rule per group, and `all` depends on none of them."""
	if not shutil.which("make"):
		raise Skip("make not installed")
	_grouped(t)

	mk = t.fmake("--eject").stdout
	t.write("Makefile", mk)
	shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)

	r = subprocess.run(["make", "-C", t.dir], capture_output=True, text=True)
	check(r.returncode == 0, f"default build failed: {r.stderr}")
	for name in ("unit_test", "fetch_test"):
		check(not os.path.exists(os.path.join(t.dir, name)),
		      f"`all` must not build {name}")

	for rule, want, other in (("test", "unit ok", "live ok"),
	                          ("live", "live ok", "unit ok")):
		r = subprocess.run(["make", "-C", t.dir, rule],
		                   capture_output=True, text=True)
		check(r.returncode == 0, f"make {rule} failed: {r.stderr}")
		check(want in r.stdout and other not in r.stdout,
		      f"make {rule} ran the wrong group: {r.stdout}")

	nj = t.fmake("--eject", "ninja").stdout
	check("build test: phony" in nj and "build live: phony" in nj,
	      f"ninja needs a phony per group: {nj[-500:]}")


def _qrc_file(t, path, prefix, note):
	t.write(note, "hello\n")
	t.write(path, f'<RCC><qresource prefix="/{prefix}">'
	              f"<file>{os.path.basename(note)}</file></qresource></RCC>\n")


@case
def two_resources_with_one_stem_are_reported_not_left_to_the_linker(t):
	"""rcc namespaces the file it writes and not the symbols in it.

	a/res.qrc and b/res.qrc land in different directories, so neither
	overwrites the other -- and both define qInitResources_res(), so the
	link fails with a multiple definition naming generated paths under the
	state directory. fmake's own summary then offered to name the missing
	libraries, when nothing was missing.

	Same collision as two target names sharing a Make variable, one level
	down, in a rewriting rcc does rather than fmake."""
	_need_qt()
	if not _have_pkg("Qt6Core"):
		raise Skip("Qt6Core not installed")
	_qrc_file(t, "a/res.qrc", "a", "a/note.txt")
	_qrc_file(t, "b/res.qrc", "b", "b/note.txt")
	# Both paths, because a resource is compiled only when a source opens
	# something in it. Naming one leaves the other unbuilt -- correctly --
	# and the first version of this case did exactly that and then asserted
	# a collision that could not happen.
	t.write("main.cpp",
	        "#include <QFile>\n#include <QCoreApplication>\n"
	        "int main(int c, char **v){ QCoreApplication app(c, v);\n"
	        '\treturn QFile(":/a/note.txt").exists()\n'
	        '\t    && QFile(":/b/note.txt").exists() ? 0 : 1; }\n')

	r = t.fmake()
	check(r.returncode != 0, "the collision should be reported")
	out = r.stdout + r.stderr
	check("a/res.qrc" in out and "b/res.qrc" in out,
	      f"both resources should be named: {out}")
	check("qInitResources_res" in out,
	      f"and the symbol they share: {out}")
	check("--ldflags" not in out,
	      f"nothing is missing, so do not offer to name libraries: {out}")

	# Distinct stems are untouched.
	os.remove(os.path.join(t.dir, "b/res.qrc"))
	_qrc_file(t, "b/other.qrc", "b", "b/note.txt")
	r = t.fmake("-B")
	check(r.returncode == 0,
	      f"distinct stems should link: {r.stdout}{r.stderr}")
	check(t.run(os.path.basename(t.dir)).returncode == 0,
	      "both resources should be present at run time")


@case
def two_targets_that_are_one_make_variable_are_refused(t):
	"""The same collision, in the older half of the same emitter.

	Target names become `{IDENT}_OBJS`, so `my-app` and `my_app` shared
	MY_APP_OBJS: the ejected file assigned it twice and one program linked
	the other's objects. Found by asking what else `_mk_ident` rewrites
	rather than by anything failing, which is why one function refuses both
	-- the next name rewritten for a narrower alphabet will collide too."""
	t.write("a.c", '/** @target my-app */\n#include <stdio.h>\n'
	        'int main(void){ puts("A"); return 0; }\n')
	t.write("b.c", '/** @target my_app */\n#include <stdio.h>\n'
	        'int main(void){ puts("B"); return 0; }\n')

	r = t.fmake()
	check(r.returncode != 0, "the collision should be refused")
	out = r.stdout + r.stderr
	check("my-app" in out and "my_app" in out,
	      f"both names should be given: {out}")

	# Names a Make identifier can tell apart are untouched.
	t.write("b.c", '/** @target other_app */\n#include <stdio.h>\n'
	        'int main(void){ puts("B"); return 0; }\n')
	r = t.fmake()
	check(r.returncode == 0, f"distinct names should build: {r.stderr}")


@case
def two_groups_that_are_one_make_variable_are_refused(t):
	"""`slow-net` and `slow_net` are two groups and one Make variable.

	A group becomes a variable and `-` is not legal in one, so it is
	replaced. The ejected Makefile then assigned SLOW_NET_TARGETS twice and
	every rule built whichever group came last -- silently, which is the
	part that matters. fmake refuses two targets with one name and two
	definitions of one symbol; this is the same ambiguity."""
	t.write("main.c", "int main(void){ return 0; }\n")
	t.write("tests/a_test.c", "/** @test slow-net */\n"
	        "int main(void){ return 0; }\n")
	t.write("tests/b_test.c", "/** @test slow_net */\n"
	        "int main(void){ return 0; }\n")

	r = t.fmake()
	check(r.returncode != 0, "the collision should be refused")
	out = r.stdout + r.stderr
	check("slow-net" in out and "slow_net" in out,
	      f"both spellings should be named: {out}")
	check("SLOW_NET" in out, f"and the variable they share: {out}")

	# Distinct groups are untouched.
	t.write("tests/b_test.c", "/** @test quick */\n"
	        "int main(void){ return 0; }\n")
	e = t.fmake("--eject")
	check(e.returncode == 0, f"distinct groups should eject: {e.stderr}")
	check("SLOW_NET_TARGETS" in e.stdout and "QUICK_TARGETS" in e.stdout,
	      f"each group gets its own variable: {e.stdout[:400]}")


@case
def a_group_name_that_is_not_a_name_is_refused(t):
	"""A group becomes a command-line word and a Make target, so it has to
	be spellable as both. Refusing early beats emitting a Makefile that
	will not parse."""
	t.write("main.c", "int main(void){ return 0; }\n")
