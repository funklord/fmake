@case
def a_long_list_of_failures_is_capped(t):
	"""hydra fails nine of thirty-eight in this environment, and nine names
	already wrap a terminal. A suite where forty fail would print the one
	line nobody can read, and the count is the part that matters. Every
	other list in fmake caps; this one did not."""
	t.write("main.c", "int main(void){ return 0; }\n")
	for n in range(8):
		t.write(f"tests/bad{n}_test.c", "int main(void){ return 1; }\n")

	r = t.fmake("test")
	check(r.returncode != 0, "they all fail")
