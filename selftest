@case
def resolution_notices_a_library_rewritten_in_place(t):
    """A directory's mtime does not move when a file in it is rewritten.

    It moves on add, remove and rename -- so a package manager installing by
    rename is caught -- but `install` and a plain redirect both overwrite in
    place, and a library rebuilt into a prefix would then be resolved against
    the symbols it used to have.

    The library has to live outside the scanned tree, or widening finds its
    source and compiles it directly, and the resolver is never consulted at
    all. That is what made this hard to reproduce.
    """
    libdir = os.path.join(t.dir, "prefix", "lib")
    os.makedirs(libdir, exist_ok=True)
    src = os.path.join(t.dir, "libsrc.c")

    def build_lib(with_later_b):
        with open(src, "w") as fh:
            fh.write("int filler(void){ return 0; }\n")
            if with_later_b:
                fh.write("int later_b(void){ return 2; }\n")
        out = os.path.join(libdir, "libsp.so")
        # Built somewhere else entirely: creating and removing a temporary
        # file inside libdir would move its mtime, which is the thing being
        # held still.
        tmp = os.path.join(t.dir, "staging.so")
        r = subprocess.run(["cc", "-shared", "-fPIC", "-o", tmp, src],
                           capture_output=True, text=True)
        check(r.returncode == 0, f"could not build the fixture: {r.stderr}")
        # Overwrite in place rather than rename, so the directory is untouched.
        with open(tmp, "rb") as a, open(out, "wb") as b:
            b.write(a.read())
        os.remove(tmp)
        # And the source goes away again. Leaving it means widening finds
        # later_b in the tree and compiles it directly, so the library is
        # never consulted and the case silently tests nothing.
        os.remove(src)

    build_lib(False)
    t.write("main.c", "int later_b(void);\nint main(void){ return later_b(); }\n")
    t.write("fmake.toml", f'[toolchain]\nlib-dirs = ["{libdir}"]\n')

    r = t.fmake()
    check(r.returncode != 0,
          "later_b does not exist yet, so this must not link")

    before = os.stat(libdir).st_mtime_ns
    build_lib(True)
    check(os.stat(libdir).st_mtime_ns == before,
          "the fixture changed the directory mtime, so it proves nothing")

    r = t.fmake()
    check(r.returncode == 0,
          f"the rewritten library was not noticed: {r.stdout}{r.stderr}")


@case
def libs_resolve_through_linker_scripts(t):
    """libncurses.so is a script, not an ELF file.

    Its contents are `INPUT(libncurses.so.6 -ltinfo)` -- a bare relative name
    and a -l flag, neither of which is the absolute path glibc's scripts use.
    Handling only absolute paths silently drops every symbol ncurses exports,
    and the greedy cover then picks tinfo alone and leaves the rest
    unresolved."""
    if not glob.glob("/usr/include/ncurses.h"):
        raise Skip("ncurses headers not installed")
    scripts = [p for p in glob.glob("/usr/lib/*/libncurses*.so")
               if open(p, "rb").read(4) != b"\x7fELF"]
    if not scripts:
        raise Skip("no ncurses linker script on this machine")

    t.write("main.c", """
#include <ncurses.h>
int main(void){
    initscr(); cbreak(); noecho();
    int c = COLORS; delwin(stdscr); endwin();
    return c >= 0 ? 0 : 1;
}
""")
    r = t.fmake()
    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
    libs = before_externals(t.fmake("--explain").stdout)
    check("-lncurses" in libs,
          f"ncurses should have been resolved through the script: {libs}")
    check("(unresolved)" not in libs,
          f"every curses symbol should resolve: {libs}")


@case
def linker_provided_symbols_are_not_reported(t):
    """_GLOBAL_OFFSET_TABLE_ is not a missing dependency.

    On a PIC build it can be the only thing listed as unresolved, which makes
    a perfectly good build read as a failure."""
    # Programs really do reference these -- checking heap extent against
    # _end is the classic case -- so the object genuinely leaves them
    # undefined and something has to know they need no library.
    t.write("main.c", """
#include <stdio.h>
#include <stdint.h>
extern char _end;
extern char __bss_start;
int main(void){
    printf("%zu\\n", (size_t)(&_end - &__bss_start));
    return 0;
}
""")
    r = t.fmake("--explain", "--cflags", "-O2 -g -fPIC")
    check(r.returncode == 0, f"explain failed: {r.stderr}")
    for sym in ("_GLOBAL_OFFSET_TABLE_", "_DYNAMIC", "__bss_start"):
        check(sym not in r.stdout,
              f"{sym} is provided by the linker, not a library: {r.stdout}")


@case
def sanitiser_runtimes_are_never_chosen(t):
    """asan exports lgamma, memcpy and malloc -- it intercepts them.

    By symbol evidence alone an interposer is a perfectly good provider, and
    a cover that ranks by coverage could pick one because it happens to
    intercept more of what a program calls. Linking a sanitiser into an
    ordinary program is not a build fmake should ever choose on its own."""
    # Wherever the compiler keeps it -- on Debian that is the gcc directory,
    # not a multiarch one, and fmake finds it via -print-search-dirs.
    if not (glob.glob("/usr/lib/*/libasan.so")
            or glob.glob("/usr/lib/gcc/*/*/libasan.so")):
        raise Skip("no sanitiser runtime installed to be tempted by")
    t.write("main.c", r"""
#include <stdio.h>
#include <stdlib.h>
#include <math.h>
int main(int argc, char **argv){
    double x = argc > 1 ? atof(argv[1]) : 3.0;
    printf("%.4f %.4f %.4f\n", lgamma(x), tgamma(x), erf(x));
    return 0;
}
""")
    r = t.fmake("--explain")
    check(r.returncode == 0, f"explain failed: {r.stderr}")
    libs = before_externals(r.stdout)
    for bad in ("-lasan", "-ltsan", "-lubsan", "-llsan"):
        check(bad not in libs, f"{bad} must never be chosen: {libs}")
    check("-lm" in libs, f"the real implementation should be chosen: {libs}")
    check(t.fmake().returncode == 0, "build failed")


