@case
def a_failing_test_fails_the_command(t):
	"""And a crash is reported as a crash.

	An assertion returning 1 and a SIGSEGV are different findings, and
	Python reports both as a number."""
	_suite(t)
	t.write("tests/bad_test.c", "int main(void){ return 3; }\n")
	t.write("tests/crash_test.c", "int main(void){ __builtin_trap(); }\n")

	r = t.fmake("test")
	check(r.returncode != 0, "a failing test must fail the command")
	out = r.stdout + r.stderr
	check("exit 3" in out, f"the exit status should be named: {out}")
	check("SIG" in out, f"a crash should be named as one: {out}")
	check("2 of 3 failed" in out, f"and counted: {out}")


