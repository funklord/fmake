@case
def debug_info_is_asked_for_rather_than_default(t):
	"""-g is paid by everyone and wanted by almost nobody.

	The default carried `-Os -g` for a long time. `-Os` is the shared build
	convention and right; `-g` was not, because every build paid a fatter
	binary and a slower link to serve the one run in a hundred that is under
	a debugger, and nothing said so.

	`$DEBUG` asks for it, and turns `-Os` off with it -- the same convention
	says `-Og` is the answer while debugging and `-Os` gets in the way, so a
	debug build is a different build rather than a release carrying symbols.

	The half worth guarding hardest is the cache. Debug and non-debug
	objects must not be interchangeable: handing a `-Os` object to a build
	that asked for `-Og -g` is the stale-object failure of section 48,
	arriving through a variable nothing else in the tree mentions."""
	t.write("main.c", "int main(void){ return 0; }\n")

	plain = t.fmake("-n")
	check(plain.returncode == 0, f"dry run failed: {plain.stderr}")
	check("-Os" in plain.stdout, f"the default lost -Os: {plain.stdout}")
	check(" -g" not in plain.stdout,
	      f"-g is in the default and should not be: {plain.stdout}")

	dbg = t.fmake("-n", env={"DEBUG": "1"})
	check("-Og" in dbg.stdout and " -g" in dbg.stdout,
	      f"$DEBUG did not ask for a debug build: {dbg.stdout}")
	check("-Os" not in dbg.stdout,
	      f"a debug build should not also be a size build: {dbg.stdout}")

	# Set-but-off, so that DEBUG=0 means what anyone would read it to mean.
	off = t.fmake("-n", env={"DEBUG": "0"})
	check("-Os" in off.stdout and " -g" not in off.stdout,
	      f"DEBUG=0 should be off: {off.stdout}")
	empty = t.fmake("-n", env={"DEBUG": ""})
	check("-Os" in empty.stdout, f"DEBUG= should be off: {empty.stdout}")

	# The two builds must not share objects.
	check(t.fmake().returncode == 0, "plain build failed")
	check(t.fmake(env={"DEBUG": "1"}).returncode == 0, "debug build failed")
	objdirs = os.listdir(os.path.join(t.dir, ".fmake", "obj"))
	check(len(objdirs) == 2,
	      f"debug and plain objects shared a directory: {objdirs}")


@case
def an_ejected_build_keeps_the_debug_and_sanitize_switches(t):
	"""Leaving should not cost you the switches you just gained.

	Baking the flags in leaves a Makefile that answers `make DEBUG=1' by
	building a release and saying nothing -- worse than never offering the
	switch, and it hands back something less capable than the hand-written
	Makefile it replaced, since every sibling project carries these.

	They are not the plan in any sense. Which files, which link sets, which
	libraries are all unchanged by them, so nothing needs re-ejecting to
	switch -- which is what separates this from the snapshot limit in
	section 15, where adding a source genuinely does mean ejecting again.

	The emitted test is `$(filter-out 0,$(VAR))` rather than `ifdef VAR`.
	ifdef is the idiom everyone reaches for and is wrong here: it calls
	DEBUG=0 set, so the file would contradict the tool that emitted it.
	Section 87 has that table."""
	if not shutil.which("make"):
		raise Skip("make not installed")
	t.write("prog.c", "#include <stdlib.h>\n"
	        "int main(void){ int *p = malloc(16); p[4] = 1; free(p); "
	        "return 0; }\n")
	check(t.fmake().returncode == 0, "build failed")
	r = t.fmake("--eject")
	check(r.returncode == 0, f"eject failed: {r.stderr}")
	with open(os.path.join(t.dir, "Makefile"), "w") as fh:
		fh.write(r.stdout)

	def flags(*spec):
		out = _run_in(t.dir, "make", "-n", *spec)
		compile_line = next((l for l in out.stdout.splitlines()
		                     if " -c " in l), "")
		link_line = next((l for l in out.stdout.splitlines()
		                  if " -o prog" in l and " -c " not in l), "")
		return compile_line, link_line

	# Every row of section 87's table, checked against the emitted file.
	plain, _ = flags()
	check("-Os" in plain and "-Og" not in plain, f"default is not -Os: {plain}")
	dbg, _ = flags("DEBUG=1")
	check("-Og" in dbg and " -g" in dbg, f"DEBUG=1 did nothing: {dbg}")
	for off in ("DEBUG=0", "DEBUG="):
		line, _ = flags(off)
		check("-Og" not in line,
		      f"{off} enabled the debug build, which is what ifdef would "
		      f"have done and is not what fmake does: {line}")

	san_c, san_l = flags("SANITIZE=1")
	check("fsanitize" in san_c, f"SANITIZE=1 did not reach the compile: {san_c}")
	check("fsanitize" in san_l,
	      f"SANITIZE=1 did not reach the LINK: {san_l}")
	off_c, _ = flags("SANITIZE=0")
	check("fsanitize" not in off_c, f"SANITIZE=0 should be off: {off_c}")
	both_c, _ = flags("DEBUG=1", "SANITIZE=1")
	check("-Og" in both_c and "fsanitize" in both_c,
	      f"the two should compose: {both_c}")

	# The emitted file must not depend on the environment it was emitted
	# from -- ejecting under SANITIZE=1 used to bake it in permanently.
	under = t.fmake("--eject", env={"SANITIZE": "1", "DEBUG": "1"})
	check(under.returncode == 0, f"eject under the switches failed: {under.stderr}")
	check(under.stdout == r.stdout,
	      "the ejected Makefile changed with the ambient DEBUG/SANITIZE, so "
	      "the switches were baked in rather than emitted")

	# And it has to work, not merely say the right words.
	check(_run_in(t.dir, "make", "SANITIZE=1").returncode == 0,
	      "the sanitized ejected build failed")
	run = subprocess.run([os.path.join(t.dir, "prog")], capture_output=True,
	                     text=True, env=dict(os.environ,
	                                         ASAN_OPTIONS="exitcode=0"))
	check("runtime error" in run.stderr or "AddressSanitizer" in run.stderr,
	      f"the sanitized ejected build caught nothing: {run.stderr}")


@case
def project_cflags_reach_the_link(t):
	"""A whole family of flags is an instrumentation *and* a runtime.

	The compiler links the runtime half only if it sees the flag again at
	link time. Leaving the project's compile flags off the link line meant:

	  --coverage   `undefined reference to __gcov_exit' -- a hard failure,
	               and the lucky case, because it says something
	  -pg          links, runs, and writes no gmon.out: the profiler does
	               nothing at all and nothing reports it
	  -fopenmp     undefined GOMP_* the moment a pragma is used

	The sanitizers were special-cased for this after netcfgd hit it in
	section 76, and special-casing them one at a time builds another of the
	hand-written lists section 15 already warns about three of. Passing the
	project's compile flags is what the sibling Makefiles do -- `LDFLAGS ?=
	$(CFLAGS)` -- and needs no list.

	--coverage is the case worth having because it fails loudly: -pg would
	pass this case before the fix, which is the point being made about
	it."""
	t.write("fmake.toml", '[project]\ncflags = ["--coverage"]\n')
	t.write("prog.c", "int main(void){ return 0; }\n")

	r = t.fmake("-n")
	link = next((l for l in r.stdout.splitlines()
	             if " -o " in l and " -c " not in l), "")
	check("--coverage" in link,
	      f"the link line does not carry the project's cflags: {link}")

	r = t.fmake()
	check(r.returncode == 0,
	      f"--coverage failed to link, which is the whole defect: "
	      f"{r.stdout}{r.stderr}")

	# Per-file flags must NOT be there: they belong to one translation
	# unit, which is section 4's asymmetry and why @ldflags exists.
	t.write("fmake.toml", "")
	t.write("prog.c", '/*! @file\n *  @cflags -DPER_FILE_ONLY\n */\n'
	        "int main(void){ return 0; }\n")
	r = t.fmake("-n", "-B")
	link = next((l for l in r.stdout.splitlines()
	             if " -o " in l and " -c " not in l), "")
	check("PER_FILE_ONLY" not in link,
	      f"a per-file @cflags reached the link line: {link}")


@case
def sanitize_reaches_the_link_and_actually_catches_something(t):
	"""$SANITIZE, spelled as the sibling projects spell it.

	`-fsanitize=address,undefined -fno-omit-frame-pointer`, the name and the
	flags both taken from fuzzypickles, which has them in six Makefiles.
	Independent of DEBUG for the reason they give: a sanitized build of the
	*release* flags is a real thing to want, because that is the build being
	shipped.

	**The link is the half that matters.** A sanitizer is a runtime as well
	as an instrumentation, so compiling with it and linking without leaves
	every `__asan_report_*` undefined -- which is the failure netcfgd
	reported in section 76, and it arrives as a wall of link errors naming
	none of this.

	So the case does not check that a flag was passed. It builds a program
	that reads past the end of a heap allocation and checks that the
	sanitized binary *says so* and the plain one does not, which is the only
	evidence that the whole chain works."""
	# Named for the program rather than main.c, which would take its name
	# from the temporary directory instead.
	t.write("overflow.c", """
#include <stdlib.h>
int main(void) {
	int *p = malloc(4 * sizeof(int));
	p[4] = 1;
	free(p);
	return 0;
}
""")
	plain = t.fmake("-n")
	check("fsanitize" not in plain.stdout,
	      f"sanitizers are on by default: {plain.stdout}")

	san = t.fmake("-n", env={"SANITIZE": "1"})
	check(san.returncode == 0, f"dry run failed: {san.stderr}")
	compiles = [l for l in san.stdout.splitlines() if " -c " in l]
	links = [l for l in san.stdout.splitlines()
	         if " -o " in l and " -c " not in l]
	check(compiles and links, f"expected a compile and a link: {san.stdout}")
	check(all("fsanitize" in l for l in compiles),
	      f"a compile went unsanitized: {compiles}")
	check(all("fsanitize" in l for l in links),
	      f"the LINK went unsanitized, which is the section 76 failure: "
	      f"{links}")

	off = t.fmake("-n", env={"SANITIZE": "0"})
	check("fsanitize" not in off.stdout, f"SANITIZE=0 should be off: {off.stdout}")

	both = t.fmake("-n", env={"DEBUG": "1", "SANITIZE": "1"})
	check("fsanitize" in both.stdout and "-Og" in both.stdout,
	      f"DEBUG and SANITIZE should compose: {both.stdout}")

	# --cflags replaces the defaults; it must not be able to drop the
	# sanitizer, because asking for a sanitized build and quietly not
	# getting one is the whole failure this feature exists to avoid.
	forced = t.fmake("-n", "--cflags", "-O0", env={"SANITIZE": "1"})
	check("fsanitize" in forced.stdout,
	      f"--cflags dropped the sanitizer: {forced.stdout}")

	# The evidence: it has to catch the bug.
	check(t.fmake().returncode == 0, "plain build failed")
	quiet = t.run("overflow")
	check("runtime error" not in quiet.stderr and "AddressSanitizer"
	      not in quiet.stderr,
	      f"the unsanitized build already reported it, so this proves "
	      f"nothing: {quiet.stderr}")

	check(t.fmake(env={"SANITIZE": "1"}).returncode == 0, "sanitized build failed")
	loud = t.run("overflow", env={"ASAN_OPTIONS": "exitcode=0"})
	check("runtime error" in loud.stderr or "AddressSanitizer" in loud.stderr,
	      f"the sanitized build did not catch a heap overflow: "
	      f"{loud.stdout}{loud.stderr}")

	# Two flavours of object must never be interchangeable. Counting the
	# directories would be wrong -- this case has built several
	# configurations by now -- so compare the two that matter directly.
	def objdir(dry):
		for line in dry.stdout.splitlines():
			m = re.search(r"\.fmake/obj/([0-9a-f]+)/", line)
			if m:
				return m.group(1)
		raise AssertionError(f"no object path in: {dry.stdout}")

	check(objdir(plain) != objdir(san),
	      f"sanitized and plain objects share a directory: {objdir(plain)}")


@case
def ldflags_propagate_and_cflags_do_not(t):
	"""The asymmetry section 4 is built on.

    A compile flag is a property of the file it is written in. A link flag is
    a property of whatever that file ends up inside -- which is what lets a
    dependency be declared next to the code that uses it and still reach the
    program three files away."""
	t.write("dep.h", "int dep_value(void);\n")
	t.write("dep.c", """
/*! @file
 *  @cflags  -DPRIVATE_TO_DEP=1
 *  @ldflags -Wl,--build-id=none
 */
#include "dep.h"
int dep_value(void){
#ifdef PRIVATE_TO_DEP
    return 7;
#else
    return 0;
#endif
}
""")
	t.write("main.c", """
#include <stdio.h>
#include "dep.h"
int main(void){
#ifdef PRIVATE_TO_DEP
    printf("leaked %d\\n", dep_value());
#else
    printf("%d\\n", dep_value());
#endif
    return 0;
}
""")
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")

	out = t.run(os.path.basename(t.dir)).stdout
	check(out == "7\n",
	      f"dep.c's @cflags reached main.c, which it should not: {out!r}")

	# The link flag came from dep.c and had to reach the program.
	prog = os.path.join(t.dir, os.path.basename(t.dir))
	notes = subprocess.run(["readelf", "-n", prog],
	                       capture_output=True, text=True).stdout
	check("Build ID" not in notes,
	      "dep.c's @ldflags did not propagate to the program")


