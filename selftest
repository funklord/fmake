	r = t.fmake("test")
	check(r.returncode == 0, f"fmake test failed: {r.stdout}{r.stderr}")


@case
def a_tree_whose_only_program_is_a_test_still_builds_its_library(t):
	"""netcfgd's `client/`: library sources, and a test beside them.

	Before tests were held back from the default build the test binary was
	the only target and got built, so nothing noticed that the library was
	never a target at all. Afterwards the default build had nothing left and
	said "no target could be built" -- about a directory whose whole purpose
	is an archive.

	A tree whose only programs are tests is a library with tests beside it.
	Found by running fmake on the project that declined over exactly this
	shape, which is why it is here and not in a fixture invented first."""
	# The test sorts first on purpose. Whatever roots the library is taken
	# from the sources in order, so a test named later in the alphabet
	# leaves the bug invisible -- which is how the first version of this
	# fixture passed with the guard removed.
	t.write("zz_client.h", "#pragma once\nint ncfg_connect(const char *);\n")
	t.write("zz_client.c", '#include "zz_client.h"\n'
	        "int ncfg_connect(const char *s){ return s && *s ? 1 : 0; }\n")
	t.write("zz_json.c", "int ncfg_json_ok(void){ return 1; }\n")
	t.write("aa_client_test.c", '#include <stdio.h>\n'
	        '#include "zz_client.h"\n'
	        'int main(void){ if (ncfg_connect("x") != 1) return 1;\n'
	        '\tputs("passed"); return 0; }\n')

	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	lib = os.path.join(t.dir, f"lib{os.path.basename(t.dir)}.a")
	check(os.path.exists(lib),
	      f"the library is what a plain build produces: {os.listdir(t.dir)}")
	check(not os.path.exists(os.path.join(t.dir, "aa_client_test")),
	      "the test is still held back")

	# The test's own source must not end up in the archive, and must not
	# root it either -- with tests present it can be the first source.
	members = subprocess.run(["ar", "t", lib],
	                         capture_output=True, text=True).stdout.split()
	check("aa_client_test.c.o" not in members,
	      f"a test does not belong in the library: {members}")

	r = t.fmake("test")
	check(r.returncode == 0, f"fmake test failed: {r.stdout}{r.stderr}")
	check("passed" in r.stdout, f"and it runs: {r.stdout}")


@case
def a_library_and_its_consumers_coexist(t):
	"""netcfgd's shape, and the reason they declined.

	A library, and a test binary beside it that links the library. Their
	report: "fmake linked the library sources into the test binary and
	produced no archive [...] nothing that says these translation units are
	a library others link." It builds correctly today and the answer is one
	comment, which is a discoverability failure rather than a missing
	feature -- so this pins the shape, and --explain now names @kind where
	the question gets asked.

	Both artifacts, from one tree, with no fmake.toml."""
	t.write("ncfg_client.h", "#pragma once\nint ncfg_connect(const char *);\n")
	t.write("ncfg_client.c",
	        "/**\n * @kind static\n * @target ncfg_client\n */\n"
	        '#include "ncfg_client.h"\n'
	        "int ncfg_json_parse(const char *);\n"
	        "int ncfg_connect(const char *s){ return ncfg_json_parse(s); }\n")
	t.write("ncfg_json.c",
	        "int ncfg_json_parse(const char *s){ return s && *s ? 1 : 0; }\n")
	t.write("tests/client_test.c",
	        '#include "../ncfg_client.h"\n#include <stdio.h>\n'
	        'int main(void){ printf("%d\\n", ncfg_connect("{}")); return 0; }\n')

	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	archive = os.path.join(t.dir, "libncfg_client.a")
	check(os.path.exists(archive),
	      f"the archive is a deliverable too: {os.listdir(t.dir)}")
	members = subprocess.run(["ar", "t", archive],
	                         capture_output=True, text=True).stdout.split()
	check(sorted(members) == ["ncfg_client.c.o", "ncfg_json.c.o"],
