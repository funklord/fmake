@case
def vendored_archives_resolve_a_cycle(t):
	"""Two archives that no order can satisfy, so a group is the only answer.

    Getting this shape right took two attempts. Two archives merely calling
    each other are not enough: the closure discovers them in the order the
    symbols were needed, which is already a working order, so a group changes
    nothing and a test built that way proves nothing.

    A cycle that defeats every linear order needs the crossing to run both
    ways from members not yet pulled in. Here libA's a1 needs libB's b2 and
    libB's b1 needs libA's a2, with main calling a1 and b1. Whichever archive
    the linker reaches first, the second one raises a symbol back in the
    first, which it has already walked past. Checked directly: both orders
    leave exactly one undefined reference, and the group leaves none."""
	_vendor(t, "lib/libA.a", "a1", "int b2(void);\nint a1(void){ return 1 + b2(); }\n",
	        extra=("a2", "int a2(void){ return 10; }\n"))
	_vendor(t, "lib/libB.a", "b1", "int a2(void);\nint b1(void){ return 100 + a2(); }\n",
	        extra=("b2", "int b2(void){ return 1000; }\n"))
	t.write("main.c", """
#include <stdio.h>
int a1(void); int b1(void);
int main(void){ int r = a1() + b1(); printf("%d\\n", r); return r == 1111 ? 0 : 1; }
""")
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	got = t.run(os.path.basename(t.dir))
	check(got.returncode == 0,
	      f"the mutually dependent archives did not resolve: {got.stdout}")
	check(got.stdout.strip() == "1111", f"wrong result: {got.stdout!r}")


