@case
def moc_output_does_not_cross_between_same_named_sources(t):
	"""Two local.cpp, each with its own local.moc, must not swap.

    `#include "local.moc"` is unqualified and the file is not in the
    including directory, so a global include path picks whichever sorts
    first and the other file compiles against a class it has never heard
    of. The include belongs to the one TU that asks for it."""
	_need_qt()
	for d, cls, val in (("a", "ThingA", 1), ("b", "ThingB", 2)):
		t.write(f"{d}/local.cpp", f"""
#include <QObject>
class {cls} : public QObject {{
    Q_OBJECT
public:
    void ping() {{ emit pinged({val}); }}
signals:
    void pinged(int v);
}};
int check_{d}() {{
    {cls} x;
    int seen = -1;
    QObject::connect(&x, &{cls}::pinged, [&](int v){{ seen = v; }});
    x.ping();
    return seen;
}}
#include "local.moc"
""")
	t.write("main.cpp", """
#include <QCoreApplication>
int check_a(); int check_b();
int main(int argc, char **argv) {
    QCoreApplication app(argc, argv);
    return (check_a() == 1 && check_b() == 2) ? 0 : 1;
}
""")
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check(t.run(os.path.basename(t.dir)).returncode == 0,
	      "the two .moc files were crossed")


@case
def moc_survives_ejection(t):
	"""An ejected build must regenerate moc output, not depend on fmake's.

    Emitting the already-generated sources as ordinary ones is the cheaper
    contract and the wrong one: it would leave a standalone Makefile reading
    out of .fmake, which `fmake --clean` deletes and git never sees."""
	_need_qt()
	if not shutil.which("make"):
		raise Skip("make not installed")
	t.write("counter.h", COUNTER_H)
	t.write("main.cpp", COUNTER_MAIN)

	r = t.fmake("--eject")
	check(r.returncode == 0, f"eject failed: {r.stderr}")
	check(".fmake" not in r.stdout,
	      "the ejected build refers to fmake's state directory")
	with open(os.path.join(t.dir, "Makefile"), "w") as fh:
		fh.write(r.stdout)

	prog = os.path.basename(t.dir)
	shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
	if os.path.exists(os.path.join(t.dir, prog)):
		os.remove(os.path.join(t.dir, prog))

	m = _run_in(t.dir, "make")
	check(m.returncode == 0, f"make failed: {m.stdout}{m.stderr}")
	check(_run_in(t.dir, "./" + prog).returncode == 0,
	      "the ejected build produced a program whose signal never arrived")

# ---------------------------------------------------------------------------
# uic
#
# Unlike moc there is no symbol to fall back on: a generated header is an
# include-graph dependency, so the #include has to be believed. That makes
# the trigger the interesting part, and most of these cases are about what
# does and does not count as the source asking for it.
# ---------------------------------------------------------------------------

THING_UI = """
<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Thing</class>
 <widget class="QWidget" name="Thing">
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="label">
     <property name="text">
      <string>hello</string>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
"""

THING_MAIN = """
#include <QApplication>
#include <QLabel>
#include <QWidget>
#include "ui_thing.h"
int main(int argc, char **argv) {
    QApplication app(argc, argv);
    QWidget w;
    Ui_Thing ui;
    ui.setupUi(&w);
    return ui.label->text() == "hello" ? 0 : 1;
}
"""

OFFSCREEN = {"QT_QPA_PLATFORM": "offscreen"}


@case
def a_module_umbrella_header_resolves_to_its_own_module(t):
	"""`#include <QtWidgets>` must find Qt6Widgets, not a sibling.

    Qt keeps every module under one parent directory with a directory per
    module, so testing the parent for a path called QtWidgets finds the
    *directory*. Matching on existence rather than on a file therefore
    attributed the header to whichever .pc happened to claim the parent --
    alphabetically Qt6Concurrent -- whose flags do not carry the module's own
    -I, so the include did not resolve at all. Six of Qt's own examples are
    written this way."""
	_need_qt()
	t.write("main.cpp", """
#include <QtWidgets>
int main(int argc, char **argv) {
    QApplication app(argc, argv);
    QWidget w;
    w.resize(320, 240);
    return w.width() == 320 ? 0 : 1;
}
""")
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check(t.run(os.path.basename(t.dir), OFFSCREEN).returncode == 0,
	      "the program built but did not run")


