	check("moc_spare" in r.stdout.split("compiled, not linked")[-1],
	      f"moc_spare.cpp should be listed as compiled and not linked: "
	      f"{r.stdout}")

	prog = os.path.join(t.dir, os.path.basename(t.dir))
	syms = subprocess.run(["nm", "-C", prog], capture_output=True,
	                      text=True).stdout
	check("Spare" not in syms, "Spare symbols reached the binary")


@case
def moc_handles_a_class_declared_in_a_source(t):
	"""Q_OBJECT inside a .cpp needs foo.moc, which is included not compiled.

    Different output name, different relationship: it is text pulled into an
    existing translation unit rather than one of its own, so it has to land
    on that file's include path and must never be compiled separately."""
	_need_qt()
	t.write("local.cpp", """
#include <QObject>
class Local : public QObject {
    Q_OBJECT
public:
    void ping() { emit pinged(7); }
signals:
    void pinged(int v);
};
int local_check() {
    Local l;
    int seen = -1;
    QObject::connect(&l, &Local::pinged, [&](int v){ seen = v; });
    l.ping();
    return seen;
}
#include "local.moc"
""")
	t.write("main.cpp", """
#include <QCoreApplication>
int local_check();
int main(int argc, char **argv) {
    QCoreApplication app(argc, argv);
    return local_check() == 7 ? 0 : 1;
}
""")
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check("MOC local.cpp" in r.stdout, f"moc did not run: {r.stdout}")
	check(not any(c.endswith("local.moc") for c in compiled(r)),
	      f"local.moc must not be compiled on its own: {compiled(r)}")
	check(t.run(os.path.basename(t.dir)).returncode == 0,
	      "the built program says its signal never arrived")


@case
def moc_does_not_compile_an_output_a_source_includes(t):
	"""The `#include "moc_foo.cpp"` idiom must not produce it twice.

    An older habit ends foo.cpp with the moc output to save a translation
    unit. Compiling it as well defines every meta-object twice, and the
    closure would report that as an ambiguous provider -- which is a
    baffling way to say a file is already in the build."""
	_need_qt()
	t.write("old.h", COUNTER_H)
	t.write("old.cpp", """
#include "old.h"
int old_check() { Counter c; c.bump(); return 0; }
#include "moc_old.cpp"
""")
	t.write("main.cpp", """
#include <QCoreApplication>
int old_check();
int main(int argc, char **argv) {
    QCoreApplication app(argc, argv);
    return old_check();
}
""")
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check(not any("moc_old.cpp" in c for c in compiled(r)),
	      f"moc_old.cpp was compiled as well as included: {compiled(r)}")
	check(t.run(os.path.basename(t.dir)).returncode == 0,
	      "the built program did not run")


@case
def moc_says_so_when_a_source_cannot_reach_its_output(t):
	"""A .cpp with Q_OBJECT and no #include of its .moc is a project bug.

    Generating it anyway would leave a file nothing compiles and nothing
    includes, and the build would fail later on an undefined symbol that
    names none of this."""
	_need_qt()
	t.write("orphan.cpp", """
#include <QObject>
class Orphan : public QObject { Q_OBJECT public: void f(); };
void Orphan::f() {}
""")
	t.write("main.cpp", """
#include <QCoreApplication>
int main(int argc, char **argv) {
