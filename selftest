          f"the broken target should be named: {r.stdout}")


@case
def repeated_compiler_errors_are_grouped(t):
    """One missing header fails every file that includes it.

    Printing the same diagnostic once per file buries everything else; on a
    292-file game a single absent header produced 248 identical copies."""
    t.write("common.h", "#include <nonexistent_library_header.h>\n")
    calls = []
    for name in ("a", "b", "c", "d"):
        t.write(f"{name}.h", f"int {name}_fn(void);\n")
        t.write(f"{name}.c", f'#include "{name}.h"\n#include "common.h"\n'
                f"int {name}_fn(void){{ return 1; }}\n")
        calls.append(f"{name}_fn()")
    incs = "".join(f'#include "{n}.h"\n' for n in "abcd")
    t.write("main.c", incs + '#include "common.h"\n'
            "int main(void){ return " + " + ".join(calls) + "; }\n")

    r = t.fmake()
    check(r.returncode != 0, "the build should fail")
    hits = r.stdout.count("nonexistent_library_header.h")
    check(hits <= 2,
          f"the same error should be reported once, not {hits} times:"
          f"\n{r.stdout}")
    check("other file(s)" in r.stdout,
          f"the other affected files should be summarised: {r.stdout}")


