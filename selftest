@case
def wrap_flags_are_inferred(t):
    """Defining __wrap_X means --wrap=X, and nothing else.

    Without the flag the program links fine and silently calls the real
    function -- the failure mode that makes a mocked unit test pass against
    the real syscall. Only the closure knows which objects are in the link,
    so only it can decide which wrappers apply."""
    # argv[0], so the call survives constant folding and a real undefined
    # reference to strlen reaches the linker.
    t.write("main.c", """
#include <stdio.h>
#include <string.h>
size_t __wrap_strlen(const char *s){ (void)s; return 99; }
int main(int argc, char **argv){ (void)argc; printf("%d\\n", (int)strlen(argv[0])); return 0; }
""")
    r = t.fmake()
    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
    e = t.fmake("--explain").stdout
    check("--wrap=strlen" in e, f"the wrapper should be detected: {e}")
    check(t.run(os.path.basename(t.dir)).stdout == "99\n",
          "the wrapper was not actually applied at link time")


