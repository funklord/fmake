"""
selftest -- build real trees with fmake and check what it decided.

Every case here is a claim project.md makes about the design. The important
ones are the trees that defeat the #include graph: if fmake gets those link
sets right with no annotations, the symbol-closure model works.

    ./selftest              run everything
    ./selftest closure      run cases whose name contains "closure"
    ./selftest -k           keep the scratch trees for inspection
    ./selftest -j1          one at a time (default: one per core)

Cases are independent -- each builds in its own scratch tree and shares no
state -- so they run in parallel. Results are printed in declaration order
regardless, because a suite whose output shuffles between runs is a suite
nobody diffs.
"""

import concurrent.futures
import glob
import os
import platform
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time

FMAKE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "fmake")

GREEN = "\033[32;1m"; RED = "\033[31;1m"; DIM = "\033[2m"; OFF = "\033[0m"
if not sys.stdout.isatty():
	GREEN = RED = DIM = OFF = ""

CASES = []
KEEP = False
JOBS = os.cpu_count() or 4


def case(fn):
	CASES.append(fn)
	return fn


class Tree:
	"""A scratch source tree with an fmake runner attached."""

	def __init__(self, name):
		self.name = name
		self.dir = tempfile.mkdtemp(prefix=f"fmake-{name}-")

	def write(self, rel, text):
		path = os.path.join(self.dir, rel)
		os.makedirs(os.path.dirname(path), exist_ok=True)
		with open(path, "w") as fh:
			fh.write(text.lstrip("\n"))
		return path

	def fmake(self, *args, env=None):
		e = dict(os.environ)
		e.pop("CFLAGS", None)
		e.pop("LDFLAGS", None)
		# DEBUG for the same reason, and it is the section 80 shape: a
		# suite launched with it set would build every case differently
		# from one launched without, and no case says so.
		e.pop("DEBUG", None)
		e.pop("SANITIZE", None)
		e.update(env or {})
		r = subprocess.run([FMAKE, "-C", self.dir, *args],
		                   capture_output=True, text=True, env=e)
		return r

	def run(self, prog, env=None):
		e = dict(os.environ)
		e.update(env or {})
		return subprocess.run([os.path.join(self.dir, prog)],
		                      capture_output=True, text=True, env=e)

	def cleanup(self):
		if not KEEP:
			shutil.rmtree(self.dir, ignore_errors=True)


class Failure(Exception):
	pass


class Skip(Exception):
	"""The machine lacks something the case needs -- not a failure."""


def check(cond, what):
	if not cond:
		raise Failure(what)


def before_externals(explain_out):
	"""The part of --explain above the external-symbol list.

    Not a plain split on "external symbols": the `libraries` header reads
    "[from the external symbols above]", so splitting on the bare phrase cuts
    the output off before the library decisions it was meant to include.
    """
	return re.split(r"\n  external symbols", explain_out)[0]


def compiled(r):
	"""Files fmake compiled in this invocation, from the progress lines."""
	out = []
	for line in r.stdout.splitlines():
		if line.startswith("[") and "] " in line:
			out.append(line.split("] ", 1)[1].split(" ", 1)[1].strip())
	return out

