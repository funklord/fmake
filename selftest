@case
def os_directive_resolves_platform_duplicates(t):
    """The answer to two files defining the same symbol.

    Without @os this is the ambiguity error from the closure -- which is the
    right answer to the wrong question, since only one of them was ever meant
    to be built here."""
    t.write("sys.h", "void sys_init(void);\n")
    t.write("win32_sys.c", """
/*! @file
 *  @os windows
 */
#include <stdio.h>
#include "sys.h"
void sys_init(void){ puts("win32"); }
""")
    t.write("posix_sys.c", """
/*! @file
 *  @os linux darwin freebsd openbsd netbsd
 */
