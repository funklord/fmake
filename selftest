@case
def a_hanging_test_is_stopped_and_the_suite_continues(t):
	"""hydra's suite stopped at 47 of 66 because one live driver was still
	fetching a real website minutes in.

	Nothing was wrong with that test -- it is a live driver doing what it
	says -- but a runner with no limit lets one of them suspend the suite
	and throw away the results already collected. Timing out is its own
	finding, worded as one: not "failed", which is what a test that returned
	1 did."""
	t.write("main.c", "int main(void){ return 0; }\n")
	t.write("tests/hang_test.c",
	        "#include <unistd.h>\nint main(void){ for(;;) sleep(60); }\n")
	t.write("tests/quick_test.c",
	        '#include <stdio.h>\nint main(void){ puts("quick"); return 0; }\n')
	t.write("fmake.toml", "[project]\ntest-timeout = 1\n")

	r = t.fmake("test")
	out = r.stdout + r.stderr
	check(r.returncode != 0, f"a timed-out test must fail the command: {out}")
	check("timed out after 1s" in out,
	      f"the limit should be named: {out}")
	check("quick" in out,
	      f"the suite must go on to the next test: {out}")


@case
def a_test_deadline_reaches_what_the_test_started(t):
	"""A test that hangs on the network usually hangs with a helper alive.

	Killing only the process fmake launched leaves that helper holding the
	terminal, so the test gets its own process group and the signal goes to
	the group."""
	t.write("main.c", "int main(void){ return 0; }\n")
	t.write("tests/fork_test.c",
	        "#include <unistd.h>\n"
	        "int main(void){ if (fork() == 0) { for(;;) sleep(60); }\n"
	        "\tfor(;;) sleep(60); }\n")
	t.write("fmake.toml", "[project]\ntest-timeout = 1\n")

	r = t.fmake("test")
	check("timed out" in r.stdout + r.stderr, "the deadline should fire")
	time.sleep(2)
	alive = subprocess.run(["ps", "-eo", "args"],
	                       capture_output=True, text=True).stdout
	check(os.path.join(t.dir, "fork_test") not in alive,
	      "nothing the test started should outlive it")


@case
def a_stubborn_test_leaves_nothing_behind(t):
	"""A test that ignores SIGTERM and forks is the shape that leaks.

	The deadline sends SIGTERM to the group, then SIGKILL, and waits after
	each -- the waiting is what reaps, and a child nobody waits on is a
	zombie for the rest of the run. The forked grandchild is in the group,
	so it goes too; killing only the process fmake launched would leave it
	holding whatever it holds."""
	t.write("main.c", "int main(void){ return 0; }\n")
	t.write("tests/stubborn_test.c",
	        "#include <signal.h>\n#include <unistd.h>\n"
	        "int main(void){\n"
	        "\tsignal(SIGTERM, SIG_IGN);\n"
	        "\tif (fork() == 0) { signal(SIGTERM, SIG_IGN); for (;;) pause(); }\n"
	        "\tfor (;;) pause(); }\n")
	t.write("fmake.toml", "[project]\ntest-timeout = 1\n")

	r = t.fmake("test")
	check("timed out" in r.stdout + r.stderr, "the deadline should fire")
	time.sleep(1)
	alive = subprocess.run(["ps", "-eo", "stat,args"],
	                       capture_output=True, text=True).stdout
	mine = [l for l in alive.splitlines()
	        if os.path.join(t.dir, "stubborn_test") in l]
	check(not mine, f"nothing of the test may outlive it: {mine}")
	check(not [l for l in mine if l.startswith("Z")],
	      f"and nothing may be left unreaped: {mine}")


@case
def a_test_under_the_limit_is_untouched(t):
	"""The deadline must not become a second way for a test to fail.

	A test that takes a second under a default of sixty is an ordinary
	passing test, and the cheapest wrong implementation -- passing the
	limit as the wait rather than as a deadline -- makes every test that
	runs at all report a timeout."""
	t.write("main.c", "int main(void){ return 0; }\n")
	t.write("tests/slow_test.c",
	        "#include <unistd.h>\n#include <stdio.h>\n"
