@case
def hello_needs_no_files(t):
    """A lone main.c builds, and takes its name from the directory."""
    t.write("main.c", """
#include <stdio.h>
int main(void){ puts("hello"); return 0; }
""")
    r = t.fmake()
    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
    prog = os.path.basename(t.dir)
    check(os.path.exists(os.path.join(t.dir, prog)),
          f"expected a binary named {prog}")
    check(t.run(prog).stdout == "hello\n", "binary did not run correctly")


@case
def closure_beats_include_graph(t):
    """The trees that defeat header-to-source matching.

    shapes.h is implemented across circle.c and square.c; util.h is
    implemented by util_posix.c; scratch.c is unreachable. No name matches
    any header, so the include graph finds nothing at all."""
    t.write("shapes.h", "double circle_area(double);\ndouble square_area(double);\n")
    t.write("circle.c", '#include "shapes.h"\ndouble circle_area(double r){ return 3.0*r*r; }\n')
    t.write("square.c", '#include "shapes.h"\ndouble square_area(double s){ return s*s; }\n')
    t.write("util.h", "void banner(void);\n")
    t.write("util_posix.c", '#include <stdio.h>\n#include "util.h"\nvoid banner(void){ puts("hi"); }\n')
    t.write("scratch.c", "int unused_thing(void){ return 1; }\n")
    t.write("main.c", """
#include <stdio.h>
#include "shapes.h"
#include "util.h"
int main(void){ banner(); printf("%g %g\\n", circle_area(2), square_area(3)); return 0; }
""")
    r = t.fmake()
    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")

    e = t.fmake("--explain").stdout
    for want in ("main.c", "circle.c", "square.c", "util_posix.c"):
        check(want in before_externals(e),
              f"{want} missing from the link set")
    check("scratch.c" not in before_externals(e)
          or "not linked" in e, "scratch.c should not be in the link set")
    check(t.run(os.path.basename(t.dir)).stdout == "hi\n12 9\n",
          "wrong output")


@case
def candidates_span_a_split_include_layout(t):
    """include/ for headers, src/ for sources -- and no siblings anywhere.

    Under a strict sibling rule the include graph finds nothing in this
    layout, which is one of the commonest in C++. Everything would then have
    to be discovered by widening from symbols, which works but does far more
    compiling than it needs to."""
    t.write("include/engine.h", "int engine_tick(void);\n")
    t.write("include/render.h", "int render_frame(void);\n")
    t.write("src/engine.cpp", '#include "engine.h"\n'
            "int engine_tick(void){ return 2; }\n")
    t.write("src/render.cpp", '#include "render.h"\n'
            "int render_frame(void){ return 40; }\n")
    t.write("src/main.cpp", """
#include <cstdio>
#include "engine.h"
#include "render.h"
int main(){ printf("%d\\n", engine_tick() + render_frame()); }
""")
    r = t.fmake("-v")
    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
    check("widening" not in r.stdout,
          f"the include graph should have found these without widening: "
          f"{r.stdout}")
    check(t.run(os.path.basename(t.dir)).stdout == "42\n", "wrong output")


@case
def candidates_follow_angle_bracket_project_headers(t):
    """<engine.h> is a project header if it resolves inside the tree.

    Putting include/ on the -I path and using angle brackets for your own
    headers is standard practice, and what CMake encourages. Deciding by
    punctuation rather than by what the name resolves to misses all of it --
    on a real 292-file game, 2342 such includes against 425 quoted ones."""
    t.write("include/engine.h", "int engine_tick(void);\n")
    t.write("src/engine.cpp", "#include <engine.h>\n"
            "int engine_tick(void){ return 42; }\n")
    t.write("src/main.cpp", """
#include <cstdio>
#include <engine.h>
int main(){ printf("%d\\n", engine_tick()); }
""")
    r = t.fmake("-v")
    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
    check("widening" not in r.stdout,
          f"angle-bracket project headers should be followed: {r.stdout}")
    check(t.run(os.path.basename(t.dir)).stdout == "42\n", "wrong output")

    # And it must not be mistaken for a package to look up.
    e = t.fmake("--explain").stdout
    check("engine.h" not in before_externals(e).split("link set")[0],
          f"a project header should not be proposed as a library: {e}")


@case
def closure_ignores_weak_cxx_symbols(t):
    """Templates and inlines emit weak definitions into every object.

    Treating those as strong would both drag in unrelated files and report
    duplicate definitions across ordinary C++ sources."""
    t.write("w.hpp", """
#include <string>
template<class T> T twice(T x){ return x + x; }
inline int helper(int x){ return x + 1; }
int compute();
std::string describe();
""")
    t.write("compute.cpp", '#include "w.hpp"\nint compute(){ return twice(3) + helper(4); }\n')
    t.write("describe.cpp", '#include "w.hpp"\nstd::string describe(){ return std::to_string(twice(7)); }\n')
    t.write("main.cpp", """
#include <iostream>
#include "w.hpp"
int main(){ std::cout << compute() << " " << describe() << "\\n"; }
""")
    r = t.fmake()
    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
    check("defined by more than one file" not in r.stderr,
          "weak symbols were mistaken for duplicate definitions")
    check(t.run(os.path.basename(t.dir)).stdout == "11 14\n", "wrong output")


@case
def closure_follows_weak_only_providers(t):
    """A weak definition is still the only definition there is.

    `extern template` leaves main.o with a plain undefined reference to
    Box<int>::get, and the file that instantiates it offers only a weak (W)
    definition. Skipping weak providers entirely would compile tpl.cpp,
    leave it out of the link set, and fail at the linker."""
    t.write("tpl.hpp", """
template<class T> struct Box { T v; T get(); };
extern template struct Box<int>;
""")
    t.write("tpl.cpp", """
#include "tpl.hpp"
template<class T> T Box<T>::get(){ return v; }
template struct Box<int>;
""")
    t.write("main.cpp", """
#include <cstdio>
#include "tpl.hpp"
int main(){ Box<int> b{41}; printf("%d\\n", b.get()+1); }
""")
    r = t.fmake()
    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
    e = t.fmake("--explain").stdout
    check("tpl.cpp" in before_externals(e),
          f"tpl.cpp should be in the link set: {e}")
    check(t.run(os.path.basename(t.dir)).stdout == "42\n", "wrong output")


@case
def closure_allows_many_weak_providers(t):
    """Several files offering the same weak definition is not ambiguity.

    a.cpp and b.cpp each instantiate Box<int> implicitly, so each emits a
    weak copy of Box<int>::get; main.cpp declares `extern template` and so
    leaves it undefined. Nothing else in main.cpp refers to either file, so
    that weak symbol is the only thing the closure can resolve them by --
    treating weak definitions as strong would see two providers for a needed
    symbol and refuse to build a legal program.

    --widen-all because the definition lives in a header, so the
    definition-scanning widening filter cannot see that a.cpp or b.cpp
    provide it. That limitation is real and noted in project.md."""
    t.write("box.hpp",
            "template<class T> struct Box { T v; T get(){ return v; } };\n")
    t.write("decl.hpp", '#include "box.hpp"\nextern template struct Box<int>;\n')
    t.write("a.cpp", '#include "box.hpp"\nint a_thing(){ Box<int> b{1}; return b.get(); }\n')
    t.write("b.cpp", '#include "box.hpp"\nint b_thing(){ Box<int> b{2}; return b.get(); }\n')
    t.write("main.cpp", """
#include <cstdio>
#include "decl.hpp"
int main(){ Box<int> z{42}; printf("%d\\n", z.get()); }
""")
    r = t.fmake("--widen-all", "--cflags", "-O0 -g")
    check("defined by more than one file" not in r.stderr,
          f"weak copies were reported as a conflict: {r.stderr}")
    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
    check(t.run(os.path.basename(t.dir)).stdout == "42\n", "wrong output")


@case
def closure_never_lets_weak_shadow_strong(t):
    """A strong definition must win wherever it is, and whenever it is found.

    hooks.c defines a weak default for `hook` and also `driver`, which main
    calls. If the closure accepts a weak definition already in the link set
    as satisfying the symbol, then processing `driver` first pulls in hooks.c
    and `hook` is then considered done -- so override.c is never linked and
    the weak default silently wins.

    What decides the order is the alphabetical position of an unrelated
    symbol, so the same program links two different ways depending on what
    its functions are called. Renaming driver to zdriver flips it."""
    for prefix in ("driver", "zdriver"):
        t.write("hooks.c", f"""
__attribute__((weak)) int hook(void){{ return 1; }}
int {prefix}(void){{ return 10; }}
""")
        t.write("override.c", "int hook(void){ return 2; }\n")
        t.write("main.c", f"""
#include <stdio.h>
int {prefix}(void); int hook(void);
int main(void){{ printf("%d\\n", {prefix}() + hook()); return 0; }}
""")
        shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
        r = t.fmake()
        check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
        got = t.run(os.path.basename(t.dir)).stdout
        check(got == "12\n",
              f"with {prefix}: the strong override should win, got {got!r}")


@case
def pic_is_part_of_the_object_identity(t):
    """A flag fmake adds itself still has to invalidate objects.

    Building only the program compiles without -fPIC. Building the shared
    library too adds it. If that flag is not part of the configuration
    identity, the objects look up to date and the .so is linked from
    non-PIC code -- which Debian's default -fPIE happens to mask, so the
    invariant is checked directly: different effective flags must mean a
    different object directory.
    """
    t.write("greet.c", """
/*! @file
 *  @target greet
 *  @kind   shared
 */
static const char msg[] = "hello";
const char *greet(void){ return msg; }
""")
    t.write("tool.c", '#include <stdio.h>\nconst char *greet(void);\n'
            "int main(void){ puts(greet()); return 0; }\n")

    def objdirs():
        base = os.path.join(t.dir, ".fmake", "obj")
        return set(os.listdir(base)) if os.path.isdir(base) else set()

    check(t.fmake("tool").returncode == 0, "program-only build failed")
    without_pic = objdirs()
    check(len(without_pic) == 1, f"expected one config: {without_pic}")

    r = t.fmake()
    check(r.returncode == 0, f"shared build failed: {r.stdout}{r.stderr}")
    check(len(objdirs()) == 2,
          f"adding -fPIC must change the object directory, not reuse it: "
          f"{objdirs()}")
    check(os.path.exists(os.path.join(t.dir, "libgreet.so")),
          "the shared library was not produced")
    check("-fPIC" in t.fmake("--explain").stdout, "-fPIC should be in effect")


@case
def cli_flags_override_annotations(t):
    """The command line is an override, so it has to come last.

    Forcing -O0 for a debugging run is the entire purpose of the flag, and a
    file asking for -O2 must not defeat it."""
    t.write("main.c", """
/*! @file
 *  @cflags -O2
 */
#include <stdio.h>
int main(void){
#if __OPTIMIZE__
    puts("optimised");
#else
    puts("not optimised");
#endif
    return 0;
}
""")
    prog = os.path.basename(t.dir)
    check(t.fmake("--cflags", "-O0").returncode == 0, "build failed")
    check(t.run(prog).stdout == "not optimised\n",
          "--cflags should override the file's own flags")

    shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
    check(t.fmake().returncode == 0, "build failed")
    check(t.run(prog).stdout == "optimised\n",
          "without the flag, the file's own flags still apply")


@case
def relinking_follows_the_command_not_just_mtimes(t):
    """Object mtimes miss every change that is not a recompile.

    A different library resolved, a --wrap added, an explicit --ldflags: none
    of them touch an object, so a staleness rule built on object timestamps
    leaves the binary exactly as it was and reports success."""
    t.write("main.c", '#include <stdio.h>\nint main(void){ puts("hi"); return 0; }\n')
    prog = os.path.join(t.dir, os.path.basename(t.dir))

    check(t.fmake().returncode == 0, "first build failed")

    def has_build_id():
        out = subprocess.run(["readelf", "-n", prog],
                             capture_output=True, text=True).stdout
        return "Build ID" in out

    if not has_build_id():
        raise Skip("this toolchain does not emit a build id")

    r = t.fmake("--ldflags", "-Wl,--build-id=none")
    check(r.returncode == 0, f"relink failed: {r.stdout}{r.stderr}")
    check(not has_build_id(),
          "the link flag was ignored: the binary was not relinked")

    # and an unchanged command must still be a no-op
    r = t.fmake("--ldflags", "-Wl,--build-id=none")
    check("built" not in r.stdout,
          f"nothing changed, so nothing should relink: {r.stdout}")


@case
def a_library_will_not_hold_two_definitions(t):
    """§3 refuses to guess for programs; a library is not exempt.

    `ar` resolves duplicate members by order, silently, and the consumer
    inherits the coin flip with no way to see where it came from."""
    t.write("impl_a.c", "int compute(void){ return 1; }\n")
    t.write("impl_b.c", "int compute(void){ return 2; }\n")
    t.write("util.c", "int helper(void){ return 0; }\n")

    r = t.fmake()
    check(r.returncode != 0, "two definitions should be refused")
    check("impl_a.c" in r.stderr and "impl_b.c" in r.stderr,
          f"both should be named: {r.stderr}")

    # and the documented escape still works
    t.write("impl_b.c", "//! @os windows\nint compute(void){ return 2; }\n")
    shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
    r = t.fmake()
    check(r.returncode == 0, f"@os should settle it: {r.stdout}{r.stderr}")
    archive = [f for f in os.listdir(t.dir) if f.endswith(".a")]
    check(len(archive) == 1, f"expected an archive: {os.listdir(t.dir)}")
    syms = subprocess.run(["nm", "--format=posix",
                           os.path.join(t.dir, archive[0])],
                          capture_output=True, text=True).stdout
    check(syms.count("compute T") == 1,
          f"the archive should hold one definition: {syms}")


@case
def explain_shows_the_command_that_runs(t):
    """A drifted --explain is worse than none.

    Principle 4 is that every decision is inspectable, which is only true if
    what is shown is what is executed -- so both come from one function."""
    # Something that resolves a library, or the two renderings agree
    # trivially and the case proves nothing.
    t.write("main.c", """
#include <stdio.h>
#include <stdlib.h>
#include <math.h>
int main(int argc, char **argv){
    printf("%f\\n", lgamma(argc > 1 ? atof(argv[1]) : 3.0));
    return 0;
}
""")
    shown = [l.strip() for l in t.fmake("--explain").stdout.splitlines()
             if l.strip().startswith(("cc -o", "c++ -o"))]
    check(shown, "no link command in --explain")
    check("-lm" in shown[-1],
          f"the resolved library should appear: {shown[-1]}")

    # The strongest form of the claim: run exactly what was shown, from the
    # project root, and require a working binary out of it. --explain
    # compiles but does not link, so there is nothing there yet to be
    # mistaken for the result.
    prog = os.path.join(t.dir, os.path.basename(t.dir))
    check(not os.path.exists(prog), "--explain should not have linked")
    r = subprocess.run(shown[-1], shell=True, cwd=t.dir,
                       capture_output=True, text=True)
    check(r.returncode == 0,
          f"the command --explain printed does not work: {r.stderr}")
    out = _run_in(t.dir, "./" + os.path.basename(t.dir), "5").stdout
    check(out.startswith("3.17"),
          f"the binary built from the shown command is wrong: {out!r}")


@case
def two_mains_two_programs(t):
    """Each main() is its own program; shared code is compiled once."""
    t.write("lib.h", "int shared_calc(int);\n")
    t.write("lib.c", '#include "lib.h"\nint shared_calc(int x){ return x*3; }\n')
    t.write("main.c", '#include <stdio.h>\n#include "lib.h"\nint main(void){ printf("app %d\\n", shared_calc(5)); return 0; }\n')
    t.write("tool.c", '#include <stdio.h>\n#include "lib.h"\nint main(void){ printf("tool %d\\n", shared_calc(9)); return 0; }\n')

    r = t.fmake()
    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
    check(compiled(r).count("lib.c") == 1, "lib.c should compile exactly once")
    check(t.run(os.path.basename(t.dir)).stdout == "app 15\n", "wrong output")
    check(t.run("tool").stdout == "tool 27\n", "wrong output")


@case
def one_target_does_not_drag_in_the_other(t):
    """Widening must chase definitions, not mentions.

    Filtering on any occurrence of a symbol name would match every file that
    merely calls printf, and building `tool` would compile main.c too."""
    t.write("lib.h", "int shared_calc(int);\n")
    t.write("lib.c", '#include "lib.h"\nint shared_calc(int x){ return x*3; }\n')
    t.write("main.c", '#include <stdio.h>\n#include "lib.h"\nint main(void){ printf("app %d\\n", shared_calc(5)); return 0; }\n')
    t.write("tool.c", '#include <stdio.h>\n#include "lib.h"\nint main(void){ printf("tool %d\\n", shared_calc(9)); return 0; }\n')

    r = t.fmake("tool")
    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
    check("main.c" not in compiled(r),
          f"main.c should not have been compiled: {compiled(r)}")


@case
def duplicate_definitions_are_refused(t):
    """Two files defining the same symbol is ambiguity, not a coin flip."""
    t.write("sys.h", "void sys_init(void);\n")
    t.write("win32_sys.c", '#include <stdio.h>\n#include "sys.h"\nvoid sys_init(void){ puts("win32"); }\n')
    t.write("posix_sys.c", '#include <stdio.h>\n#include "sys.h"\nvoid sys_init(void){ puts("posix"); }\n')
    t.write("main.c", '#include "sys.h"\nint main(void){ sys_init(); return 0; }\n')

    r = t.fmake()
    check(r.returncode != 0, "should have refused to guess")
    check("win32_sys.c" in r.stderr and "posix_sys.c" in r.stderr,
          f"both candidates should be named: {r.stderr}")


@case
def force_link_reaches_unreferenced_code(t):
    """A constructor-registered plugin is referenced by nothing.

    Closure cannot find it, so it must be asserted -- and once asserted its
    own dependencies have to resolve normally."""
    t.write("reg.h", "void register_plugin(const char*);\nvoid run_all(void);\n")
    t.write("reg.c", """
#include <stdio.h>
#include "reg.h"
static const char *names[16]; static int n;
void register_plugin(const char *s){ names[n++] = s; }
void run_all(void){ for(int i=0;i<n;i++) printf("plugin: %s\\n", names[i]); }
""")
    t.write("plugin_a.c", '#include "reg.h"\n__attribute__((constructor)) static void init_a(void){ register_plugin("alpha"); }\n')
    t.write("main.c", '#include "reg.h"\nint main(void){ run_all(); return 0; }\n')

    prog = os.path.basename(t.dir)
    r = t.fmake()
    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
    check(t.run(prog).stdout == "", "plugin should not be linked by default")

    r = t.fmake("--force-link", "plugin_a.c")
    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
    check(t.run(prog).stdout == "plugin: alpha\n",
          "--force-link should put the plugin in the link set")


@case
def incremental_rebuilds_only_what_changed(t):
    """Content hashing, depfiles, and a cached link set."""
    t.write("lib.h", "int calc(int);\n")
    t.write("lib.c", '#include "lib.h"\nint calc(int x){ return x*2; }\n')
    t.write("other.c", "int other(void){ return 1; }\n")
    t.write("main.c", '#include <stdio.h>\n#include "lib.h"\nint main(void){ printf("%d\\n", calc(4)); return 0; }\n')
    check(t.fmake().returncode == 0, "initial build failed")

    # touching without changing content must rebuild nothing
    os.utime(os.path.join(t.dir, "lib.c"), None)
    os.utime(os.path.join(t.dir, "main.c"), None)
    r = t.fmake()
    check(compiled(r) == [], f"touch should rebuild nothing: {compiled(r)}")

    # a body change rebuilds one file
    t.write("lib.c", '#include "lib.h"\nint calc(int x){ return x*10; }\n')
    r = t.fmake()
    check(compiled(r) == ["lib.c"], f"expected only lib.c: {compiled(r)}")
    check(t.run(os.path.basename(t.dir)).stdout == "40\n",
          "binary was not relinked")

    # a header change rebuilds everything that includes it
    t.write("lib.h", "int calc(int);\n/* touched */\n")
    r = t.fmake()
    check(set(compiled(r)) == {"lib.c", "main.c"},
          f"expected lib.c and main.c: {compiled(r)}")


@case
def widening_does_not_disturb_what_it_already_built(t):
    """A build must reach a fixed point on the first attempt.

    The flags a file is compiled with have to be settled before anything is
    compiled. Deriving them from the candidate pool instead means a file
    widened in later can contribute an -I, and everything compiled before
    that was built with a different include path than fmake records -- so
    the next build recompiles it, and the objects on disk were never quite
    what fmake thought they were."""
    if not _have_pkg("libxml-2.0"):
        raise Skip("libxml2 not installed")

    # extra.c is reachable only through the symbol, and it is the only file
    # needing an -I, so the include path is not known until widening.
    t.write("main.c", """
#include <stdio.h>
int widened_thing(void);
int main(void){ printf("%d\\n", widened_thing()); return 0; }
""")
    t.write("extra.c", """
#include <libxml/parser.h>
int widened_thing(void){ return xmlReadMemory("<a/>",4,NULL,NULL,0) ? 1 : 0; }
""")
    r = t.fmake("-v")
    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
    check("widening" in r.stdout, "the case needs widening to happen")

    for attempt in (1, 2):
        again = t.fmake("-v")
        check(not compiled(again),
              f"build {attempt} after a complete one recompiled "
              f"{compiled(again)}")


@case
def new_symbol_widens_the_compiled_set(t):
    """An undefined symbol should widen the build, not fail it."""
    t.write("main.c", "int main(void){ return 0; }\n")
    check(t.fmake().returncode == 0, "initial build failed")

    t.write("extra.c", "int newly_added(void){ return 42; }\n")
    t.write("main.c", "int newly_added(void);\nint main(void){ return newly_added() == 42 ? 0 : 1; }\n")
    r = t.fmake()
    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
    check("extra.c" in compiled(r), f"widening missed extra.c: {compiled(r)}")
    check(t.run(os.path.basename(t.dir)).returncode == 0, "wrong result")


@case
def one_fmake_at_a_time_per_tree(t):
    """Two runs sharing a cache file lose each other's writes.

    Scan results, symbol tables, resolved libraries -- the loser's are all
    discarded and recomputed next time, and one run can be reading objects
    the other is replacing. Waiting costs less than either."""
    t.write("main.c", '#include <stdio.h>\nint helper(void);\n'
            'int main(void){ printf("%d\\n", helper()); return 0; }\n')
    t.write("helper.c", "int helper(void){ return 7; }\n")

    import threading
    out = {}

    def run(tag):
        out[tag] = t.fmake("-v")

    a = threading.Thread(target=run, args=("a",))
    b = threading.Thread(target=run, args=("b",))
    a.start(); b.start(); a.join(); b.join()

    for tag, r in out.items():
        check(r.returncode == 0, f"run {tag} failed: {r.stdout}{r.stderr}")
    check(t.run(os.path.basename(t.dir)).stdout == "7\n",
          "the binary is wrong after two concurrent builds")

    # Whichever went second must have found the first one's work, not
    # recomputed it: that is the property the lock exists for.
    combined = out["a"].stdout + out["b"].stdout
    check("cached" in combined,
          f"the second run should have reused the cache: {combined}")


@case
def a_broken_file_does_not_sink_other_targets(t):
