    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
    names = set(os.listdir(t.dir))
    check("honoured" in names, f"the //! directive should apply: {names}")
    check("should-be-ignored" not in names and "also-ignored" not in names,
          f"plain comments must not carry directives: {names}")


