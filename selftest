@case
def widened_files_keep_their_own_flags(t):
	"""A file found by widening must still get its @define.

    Per-TU flags were computed once, over the candidate set, before widening
    had run -- so anything the include graph missed was compiled with no
    @define, @cflags or @std at all. Nothing downstream reads the
    annotations again, so the result was a program that built cleanly and
    answered differently. Not a Qt case; moc only happened to reveal it."""
	t.write("extra.c", """
/*! @define SCALE=7 */
#ifndef SCALE
#define SCALE 1
#endif
int widened(void){ return SCALE; }
""")
	t.write("main.c", """
#include <stdio.h>
int widened(void);
int main(void){ printf("%d\\n", widened()); return widened() == 7 ? 0 : 1; }
""")
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	got = t.run(os.path.basename(t.dir))
	check(got.stdout.strip() == "7",
	      f"@define was dropped on a widened file: printed {got.stdout!r}")


# ---------------------------------------------------------------------------
# rcc
#
# The one Qt generator with no reliable symbol: a resource registers itself
# from a static constructor, so nothing refers to the generated object and
# the closure alone would always drop it. What the source does say is which
# resources it opens, and that is per file -- so these cases are mostly about
# whether the right program got it.
# ---------------------------------------------------------------------------

def _qrc(prefix, name, text):
	return (f'<!DOCTYPE RCC><RCC version="1.0">\n'
	        f'<qresource prefix="{prefix}">\n'
	        f'  <file>{name}</file>\n'
	        f'</qresource>\n</RCC>\n')


def _reader(path, want):
	"""A program that opens a resource and checks its contents."""
	return f"""
#include <QCoreApplication>
#include <QFile>
int main(int argc, char **argv) {{
    QCoreApplication app(argc, argv);
    QFile f("{path}");
    if (!f.open(QIODevice::ReadOnly)) return 2;
    return f.readAll().trimmed() == "{want}" ? 0 : 1;
}}
"""


@case
def rcc_runs_because_the_source_opens_the_resource(t):
	"""A ":/prefix/..." literal is the source saying it uses the resource.

    Nothing else can say it: the generated object is referenced by no
    symbol, so without this evidence the closure drops it and the program
    fails at runtime rather than at the link."""
	_need_qt()
	t.write("assets/greeting.txt", "hello from the resource\n")
	t.write("assets/app.qrc", _qrc("/data", "greeting.txt", ""))
	t.write("main.cpp", _reader(":/data/greeting.txt",
	                            "hello from the resource"))

	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check("RCC assets/app.qrc" in r.stdout, f"rcc did not run: {r.stdout}")
	got = t.run(os.path.basename(t.dir))
	check(got.returncode == 0,
	      f"the resource was not readable at runtime (exit {got.returncode})")


@case
def rcc_ignores_a_resource_nothing_opens(t):
	"""A .qrc in the tree is not by itself a reason to embed it.

    Linking every resource into every binary is what listing them by hand
    gets you; the point of reading the source is to do better than that."""
	_need_qt()
	t.write("assets/greeting.txt", "hello from the resource\n")
	t.write("assets/app.qrc", _qrc("/data", "greeting.txt", ""))
	t.write("extra/unused.txt", "nobody wants this\n")
	t.write("extra/unused.qrc", _qrc("/unused", "unused.txt", ""))
	t.write("main.cpp", _reader(":/data/greeting.txt",
	                            "hello from the resource"))

	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check("RCC extra/unused.qrc" not in r.stdout,
	      f"rcc ran for a resource nothing opens: {r.stdout}")
	prog = os.path.join(t.dir, os.path.basename(t.dir))
	check(b"nobody wants this" not in open(prog, "rb").read(),
	      "an unreferenced resource was embedded anyway")


@case
def rcc_gives_each_program_only_what_it_opens(t):
	"""Two programs, two resources, and neither carries the other's.

    This is the case that makes the evidence worth gathering. A rule that
    linked every .qrc into every binary would pass every other test here and
    still put a megabyte of somebody else's icons in each one."""
	_need_qt()
	t.write("a.txt", "resource for alpha\n")
	t.write("alpha.qrc", _qrc("/alpha", "a.txt", ""))
	t.write("b.txt", "resource for beta\n")
	t.write("beta.qrc", _qrc("/beta", "b.txt", ""))
	t.write("alpha.cpp", _reader(":/alpha/a.txt", "resource for alpha"))
	t.write("beta.cpp", _reader(":/beta/b.txt", "resource for beta"))

	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	for prog, mine, theirs in (("alpha", b"resource for alpha",
	                            b"resource for beta"),
	                           ("beta", b"resource for beta",
	                            b"resource for alpha")):
		got = t.run(prog)
		check(got.returncode == 0, f"{prog} could not read its resource")
		blob = open(os.path.join(t.dir, prog), "rb").read()
		check(mine in blob, f"{prog} is missing its own resource")
		check(theirs not in blob,
