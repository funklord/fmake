		        if len(l.split()) > 1 and l.split()[1] == "T"}

	check(members() == {"a_fn", "b_fn"}, f"unexpected archive: {members()}")

	os.remove(os.path.join(t.dir, "b.c"))
	check(t.fmake().returncode == 0, "rebuild failed")
	check(members() == {"a_fn"},
	      f"a deleted source is still in the archive: {members()}")


