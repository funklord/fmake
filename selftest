@case
def an_archive_does_not_keep_stale_members(t):
	"""`ar` appends. A member whose source is gone would otherwise survive."""
	t.write("a.c", "int a_fn(void){ return 1; }\n")
	t.write("b.c", "int b_fn(void){ return 2; }\n")
	check(t.fmake().returncode == 0, "first build failed")

	archive = [f for f in os.listdir(t.dir) if f.endswith(".a")]
	check(len(archive) == 1, f"expected one archive: {os.listdir(t.dir)}")
	path = os.path.join(t.dir, archive[0])

	def members():
		out = subprocess.run(["nm", "--format=posix", path],
		                     capture_output=True, text=True).stdout
