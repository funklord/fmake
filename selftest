def install_places_artifacts_and_headers(t):
    """What @headers is for."""
    t.write("greet.h", "const char *greet(void);\n")
    t.write("greet.c", """
/*! @file
 *  @target  greet
 *  @kind    shared
 *  @headers greet.h
 */
#include "greet.h"
const char *greet(void){ return "hello"; }
""")
    t.write("tool.c", '#include <stdio.h>\n#include "greet.h"\n'
            "int main(void){ puts(greet()); return 0; }\n")
