def _gen_tree(t):
	"""A tree whose only source of a symbol is a generated file."""
	# The definition arrives through a macro, as flex's yylex does, so the
	# definition-scanning widening filter cannot see it. Only being a
	# declared generator output gets this file compiled.
	t.write("src/mk.py", """
import sys
with open(sys.argv[1], "w") as fh:
    fh.write("#define DEFINE_FN(n, v) int n(void){ return v; }\\n")
    fh.write("DEFINE_FN(generated_value, 40)\\n")
""")
	t.write("main.c", """
#include <stdio.h>
int generated_value(void);
int main(void){ printf("%d\\n", generated_value() + 2); return 0; }
""")
	t.write("fmake.toml", f"""
[generate.values]
description = "make values.c"
command = "{sys.executable} src/mk.py $out"
inputs  = ["src/mk.py"]
outputs = ["gen/values.c"]
""")


@case
def generated_sources_are_built(t):
	"""A .c that does not exist when the tree is scanned.

    Running the generators first means everything downstream sees an
    ordinary source -- no second scanning pass, no special case in the
    closure."""
	_gen_tree(t)
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check(os.path.exists(os.path.join(t.dir, "gen/values.c")),
	      "the generator did not produce its output")
	check(t.run(os.path.basename(t.dir)).stdout == "42\n",
	      "the generated code was not linked in")


@case
def generated_sources_rerun_on_content_change(t):
	"""Hash-driven like everything else: touching is not changing."""
	_gen_tree(t)
	check(t.fmake().returncode == 0, "initial build failed")

	r = t.fmake()
	check("GEN" not in r.stdout, f"nothing changed, so nothing to do: {r.stdout}")

	os.utime(os.path.join(t.dir, "src/mk.py"), None)
	r = t.fmake()
	check("GEN" not in r.stdout, f"touch must not regenerate: {r.stdout}")

	gen = os.path.join(t.dir, "src/mk.py")
	with open(gen) as fh:
		body = fh.read()
	with open(gen, "w") as fh:
		fh.write(body.replace("40", "100"))
	r = t.fmake()
	check("GEN" in r.stdout, f"a real change must regenerate: {r.stdout}")
	check(t.run(os.path.basename(t.dir)).stdout == "102\n",
	      "the regenerated code was not rebuilt")


@case
def generated_rules_run_in_dependency_order(t):
