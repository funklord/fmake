REPO = os.path.dirname(os.path.abspath(FMAKE))


@case
def the_package_version_matches_the_program(t):
    """debian/changelog and VERSION are the same number in two places.

    Nothing enforces that, and the failure is quiet in the worst way: a
    package that installs cleanly and reports a version it is not."""
    changelog = os.path.join(REPO, "debian/changelog")
    if not os.path.exists(changelog):
        raise Skip("no debian/ in this tree")
    with open(changelog) as fh:
        first = fh.readline()
    m = re.match(r"\S+ \(([^)]+)\)", first)
    check(m, f"cannot read a version from {first!r}")
    packaged = m.group(1).split("-")[0]

    with open(FMAKE) as fh:
        src = fh.read()
    m = re.search(r'^VERSION\s*=\s*"([^"]+)"', src, re.M)
    check(m, "no VERSION in fmake")
    check(m.group(1) == packaged,
          f"fmake says {m.group(1)}, debian/changelog says {packaged}")


@case
def the_packaged_script_has_an_absolute_interpreter(t):
    """Debian Policy 10.4: an installed script names its interpreter outright.

    The repository copy keeps `#!/usr/bin/env python3`, because copying it
    into $PATH and running it anywhere is half of what fmake is and that half
    wants the lookup. The installed copy must not, so `make install` rewrites
    the line -- which means there are now two spellings and a way for the
    rewrite to stop happening without anyone noticing."""
    if not shutil.which("make"):
        raise Skip("make not installed")
    if not os.path.exists(os.path.join(REPO, "Makefile")):
        raise Skip("no Makefile in this tree")

    stage = tempfile.mkdtemp(prefix="fmake-stage-")
    try:
        r = subprocess.run(["make", "install", f"DESTDIR={stage}",
                            "PREFIX=/usr", "PYTHON=/usr/bin/python3"],
                           cwd=REPO, capture_output=True, text=True)
        check(r.returncode == 0, f"make install failed: {r.stdout}{r.stderr}")
        installed = os.path.join(stage, "usr/bin/fmake")
        check(os.path.exists(installed), "nothing was installed")
        with open(installed) as fh:
            first = fh.readline().strip()
        check(first == "#!/usr/bin/python3",
              f"the installed shebang is {first!r}")
        check(os.access(installed, os.X_OK), "the installed copy is not executable")

        got = subprocess.run([installed, "-V"], capture_output=True, text=True)
        check(got.returncode == 0 and "fmake" in got.stdout,
              f"the installed copy does not run: {got.stdout}{got.stderr}")
    finally:
        shutil.rmtree(stage, ignore_errors=True)


@case
def the_manual_describes_every_option(t):
    """--man is generated from the parser, and has to stay that way.

    A manual page is the one piece of documentation nobody re-reads, so a
    hand-kept copy of the option list is a copy that goes stale in a place
    only a stranger will look. This checks the generated page against what
    argparse actually accepts, which is the property that makes generating
    it worth doing at all."""
    page = subprocess.run([FMAKE, "--man"], capture_output=True, text=True)
    check(page.returncode == 0, f"--man failed: {page.stderr}")
    helped = subprocess.run([FMAKE, "--help"], capture_output=True, text=True)

    opts = set(re.findall(r"(?<![\w-])(--[a-z][a-z-]+)", helped.stdout))
    check(len(opts) > 10, f"suspiciously few options found: {opts}")
    # roff escapes the hyphens, so compare against the escaped spelling.
    missing = [o for o in sorted(opts)
               if o.replace("-", "\\-") not in page.stdout]
    check(not missing, f"the manual does not mention: {missing}")

    check(".TH FMAKE 1" in page.stdout, "no roff header")
    if shutil.which("man"):
        with tempfile.NamedTemporaryFile("w", suffix=".1", delete=False) as fh:
            fh.write(page.stdout)
            path = fh.name
        try:
            r = subprocess.run(["man", "--warnings", "-l", path],
                               capture_output=True, text=True,
                               env=dict(os.environ, MANWIDTH="80"))
            check(not r.stderr.strip(),
                  f"roff warnings from the generated page: {r.stderr[:200]}")
        finally:
            os.unlink(path)


@case
def an_ejected_makefile_survives_a_deleted_header(t):
    """`-MP`, which code-style.md holds ejected Makefiles to.

    A depfile names every header an object depended on. Delete one -- which
    is what a refactor that inlines a declaration does -- and make finds a
    prerequisite with no rule and stops, before it ever reaches the
    compiler, saying `No rule to make target 'util.h'`. -MP emits a phony
    target for each header so that a vanished one is simply not there any
    more.

    fmake's own builds do not need it: it reads its own depfiles and skips a
    prerequisite that is gone. A Makefile has no such luxury, and an ejected
    Makefile is a Makefile someone will edit."""
    if not shutil.which("make"):
        raise Skip("make not installed")
    t.write("util.h", "#pragma once\nint helper(void);\n")
    t.write("util.c", '#include "util.h"\nint helper(void){ return 7; }\n')
    t.write("main.c", '#include "util.h"\nint main(void){ return helper() - 7; }\n')

    check(t.fmake().returncode == 0, "first build failed")
    r = t.fmake("--eject")
    check(r.returncode == 0, f"eject failed: {r.stderr}")
    with open(os.path.join(t.dir, "Makefile"), "w") as fh:
        fh.write(r.stdout)
    shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
    check(_run_in(t.dir, "make").returncode == 0, "the ejected build failed")

    # The refactor: the declaration moves into the caller, the header goes.
    t.write("util.c", "int helper(void){ return 7; }\n")
    t.write("main.c", "int helper(void);\nint main(void){ return helper() - 7; }\n")
    os.remove(os.path.join(t.dir, "util.h"))

    m = _run_in(t.dir, "make")
    check("No rule to make target" not in m.stdout + m.stderr,
          f"a deleted header stalled the build: {m.stdout}{m.stderr}")
    check(m.returncode == 0, f"the rebuild failed: {m.stdout}{m.stderr}")
    check(_run_in(t.dir, "./" + os.path.basename(t.dir)).returncode == 0,
          "the rebuilt program is wrong")


# ---------------------------------------------------------------------------

def run_case(c):
    """Run one case in its own tree. Returns (status, detail)."""
    t = Tree(c.__name__)
    try:
        c(t)
        return "ok", ""
    except Skip as exc:
        return "skip", str(exc)
    except Failure as exc:
        return "fail", str(exc) + (f"\n       tree: {t.dir}" if KEEP else "")
    except Exception as exc:                           # noqa: BLE001
        return "err", repr(exc)
    finally:
        t.cleanup()


def main(argv):
    global KEEP, JOBS
    pats = [a for a in argv if not a.startswith("-")]
    KEEP = "-k" in argv
    for a in argv:
        if a.startswith("-j"):
            JOBS = max(1, int(a[2:] or 1))

    if not os.access(FMAKE, os.X_OK):
        print(f"{RED}fmake is not executable at {FMAKE}{OFF}")
        return 2

    cases = [c for c in CASES
             if not pats or any(p in c.__name__ for p in pats)]
    failures = skipped = 0

    with concurrent.futures.ThreadPoolExecutor(max_workers=JOBS) as pool:
        results = list(pool.map(run_case, cases))

    for c, (status, detail) in zip(cases, results):
        if status == "ok":
            print(f"{GREEN}ok{OFF}   {c.__name__}")
        elif status == "skip":
            skipped += 1
            print(f"{DIM}skip {c.__name__} -- {detail}{OFF}")
        elif status == "fail":
            failures += 1
            print(f"{RED}FAIL{OFF} {c.__name__}")
            print(f"       {detail}")
        else:
            failures += 1
            print(f"{RED}ERR {OFF} {c.__name__}: {detail}")

    print()
    tail = f" ({skipped} skipped)" if skipped else ""
    if failures:
        print(f"{RED}{failures} of {len(cases)} failed{OFF}{tail}")
    else:
        print(f"{GREEN}all {len(cases) - skipped} passed{OFF}{tail}")
    return 1 if failures else 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
