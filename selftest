def libs_resolve_through_linker_scripts(t):
	"""libncurses.so is a script, not an ELF file.

    Its contents are `INPUT(libncurses.so.6 -ltinfo)` -- a bare relative name
    and a -l flag, neither of which is the absolute path glibc's scripts use.
    Handling only absolute paths silently drops every symbol ncurses exports,
    and the greedy cover then picks tinfo alone and leaves the rest
    unresolved."""
	if not glob.glob("/usr/include/ncurses.h"):
		raise Skip("ncurses headers not installed")
	scripts = [p for p in glob.glob("/usr/lib/*/libncurses*.so")
	           if open(p, "rb").read(4) != b"\x7fELF"]
	if not scripts:
		raise Skip("no ncurses linker script on this machine")

	t.write("main.c", """
#include <ncurses.h>
int main(void){
    initscr(); cbreak(); noecho();
    int c = COLORS; delwin(stdscr); endwin();
    return c >= 0 ? 0 : 1;
}
""")
	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
