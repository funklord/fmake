def _install_fixture(t):
	"""A library, a program and a published header, installed by fmake.

	Returns the staged tree as {path: mode}, which is what every ejected
	form then has to reproduce exactly."""
	t.write("greet.h", "#pragma once\nconst char *greet(void);\n")
	t.write("greet.c", """
/*! @file
 *  @target  greet
 *  @kind    static
 *  @headers greet.h
 */
#include "greet.h"
const char *greet(void){ return "hello"; }
""")
	t.write("tool.c", '/*! @file\n *  @target tool\n */\n'
	        '#include <stdio.h>\n#include "greet.h"\n'
	        "int main(void){ puts(greet()); return 0; }\n")
	check(t.fmake().returncode == 0, "build failed")
	stage = os.path.join(t.dir, "by-fmake")
	r = t.fmake("--install", "--destdir", stage)
	check(r.returncode == 0, f"--install failed: {r.stdout}{r.stderr}")
	mine = _staged(stage)
	check(mine, "fmake installed nothing, so there is nothing to compare")
	# All three kinds, or an agreement between two empty halves would pass.
	for want in ("bin/tool", "lib/libgreet.a", "include/greet.h"):
		check(any(p.endswith(want) for p in mine),
		      f"{want} was not installed at all: {sorted(mine)}")
	return mine


def _staged(root):
	out = {}
	for base, _dirs, files in os.walk(root):
		for f in files:
			p = os.path.join(base, f)
			out[os.path.relpath(p, root)] = os.stat(p).st_mode & 0o777
	return out


def _same_install(mine, theirs, who):
	check(mine == theirs,
	      f"the {who} install differs from --install:\n"
	      f"  only --install: {sorted(set(mine) - set(theirs))}\n"
	      f"  only {who}: {sorted(set(theirs) - set(mine))}\n"
	      f"  modes: {[(k, oct(mine[k]), oct(theirs[k])) for k in mine
	                  if k in theirs and mine[k] != theirs[k]]}")


@case
def uninstall_removes_exactly_what_install_placed(t):
	"""The inverse, held to `clean`'s rule rather than to a pattern.

	A target everybody runs without reading must not be able to remove
	something it did not put there, which is why `clean` names its files
	and why this does. There is no manifest and no wildcard: the list comes
	from install_plan, the same one --install, the ejected Makefile and the
	ejected ninja read.

	The property checked is not that files disappeared. It is that the
	staging tree is **empty of files and has all its directories**, and
	that a neighbour installed beside them is untouched -- because "removed
	everything under the prefix" would pass a weaker test and is exactly
	the behaviour being avoided."""
	mine = _install_fixture(t)
	stage = os.path.join(t.dir, "by-fmake")

	# Somebody else's file, in a directory fmake installs into.
	intruder = os.path.join(stage, "usr", "local", "bin", "not-ours")
	with open(intruder, "w") as fh:
		fh.write("someone else's\n")

	r = t.fmake("--uninstall", "--destdir", stage, "-n")
	check(r.returncode == 0, f"dry run failed: {r.stderr}")
	check(len([l for l in r.stdout.splitlines() if l.startswith("rm ")])
	      == len(mine), f"the dry run does not match the install: {r.stdout}")
	check(os.path.exists(os.path.join(stage, "usr", "local", "bin", "tool")),
	      "the dry run removed something")

	r = t.fmake("--uninstall", "--destdir", stage)
	check(r.returncode == 0, f"uninstall failed: {r.stdout}{r.stderr}")
	left = _staged(stage)
	check("usr/local/bin/not-ours" in left,
	      f"uninstall removed a file it did not install: {sorted(left)}")
	check(set(left) == {"usr/local/bin/not-ours"},
	      f"something fmake installed survived: {sorted(left)}")
	# Directories are not ours to remove; `bin' was not ours to begin with.
	for kept in ("usr/local/bin", "usr/local/lib", "usr/local/include"):
		check(os.path.isdir(os.path.join(stage, kept)),
		      f"{kept} was removed, and a directory is not ours to remove")

	# Twice is an ordinary thing to do.
	r = t.fmake("--uninstall", "--destdir", stage)
	check(r.returncode == 0,
	      f"uninstalling twice should not be an error: {r.stderr}")


@case
def an_ejected_build_uninstalls_what_it_installed(t):
	"""Both emitted forms carry the inverse too, or leaving costs it.

	The install rule without an uninstall rule is the same half-promise the
	build file made before section 85: everything to put a project in
	place, and nothing to take it out again."""
	if not shutil.which("make") or not shutil.which("install"):
		raise Skip("make or install(1) not installed")
	mine = _install_fixture(t)

	r = t.fmake("--eject")
	check(r.returncode == 0, f"eject failed: {r.stderr}")
	with open(os.path.join(t.dir, "Makefile"), "w") as fh:
		fh.write(r.stdout)
	body = r.stdout
	check("rm -rf" not in body.split("uninstall:")[-1].split("\n\n")[0],
	      "the ejected uninstall uses rm -rf")
	check("*" not in body.split("uninstall:")[-1].split("\n\n")[0],
	      "the ejected uninstall uses a wildcard")

	stage = os.path.join(t.dir, "by-make")
	shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
	check(_run_in(t.dir, "make", "install", "DESTDIR=" + stage).returncode == 0,
	      "the ejected install failed")
	check(_staged(stage) == mine, "the ejected install differs")
	check(_run_in(t.dir, "make", "uninstall",
	              "DESTDIR=" + stage).returncode == 0,
	      "the ejected uninstall failed")
	check(not _staged(stage),
	      f"the ejected uninstall left files: {sorted(_staged(stage))}")

	if not shutil.which("ninja"):
		return
	r = t.fmake("--eject", "ninja")
	check(r.returncode == 0, f"ninja eject failed: {r.stderr}")
	with open(os.path.join(t.dir, "build.ninja"), "w") as fh:
		fh.write(r.stdout)
	shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
	check(_run_in(t.dir, "ninja", "-f", "build.ninja").returncode == 0,
	      "the ninja build failed")
	nstage = os.path.join(t.dir, "by-ninja")
	check(_run_in(t.dir, "ninja", "-f", "build.ninja", "install",
	              env={"DESTDIR": nstage}).returncode == 0,
	      "the ninja install failed")
	check(_staged(nstage) == mine, "the ninja install differs")
	check(_run_in(t.dir, "ninja", "-f", "build.ninja", "uninstall",
	              env={"DESTDIR": nstage}).returncode == 0,
	      "the ninja uninstall failed")
	check(not _staged(nstage),
	      f"the ninja uninstall left files: {sorted(_staged(nstage))}")


@case
def a_versioned_shared_library_installs_a_soname_chain(t):
	"""What makes a `.so` publishable rather than merely private.

	Section 22 gave shared libraries a soname and section 15 recorded the
	rest as missing: a `.so` installed under its plain name, which is right
	for a library shipping beside the thing that uses it and wrong for one
	anybody else links against.

	The `version` that section 102 added for pkg-config is the same
	declaration, so the chain costs a rule rather than a concept:

	    libgreet.so       -> libgreet.so.1        what -lgreet finds
	    libgreet.so.1     -> libgreet.so.1.2.3    what NEEDED records
	    libgreet.so.1.2.3                         the file

	The soname is the *major* only, which is the promise it makes -- and
	the reason a distribution can replace 1.2.3 with 1.2.4 underneath a
	program linked years ago. The check is a consumer: what a program
	actually records, not what the link line said."""
	if not shutil.which("readelf"):
		raise Skip("readelf not installed")
	t.write("greet.h", "#pragma once\nconst char *greet(void);\n")
	t.write("greet.c", """
/*! @file
 *  @kind    shared
 *  @target  greet
 *  @headers greet.h
 *  @version 1.2.3
 */
#include "greet.h"
const char *greet(void){ return "hi"; }
""")
	check(t.fmake().returncode == 0, "build failed")
	so = os.path.join(t.dir, "libgreet.so")
	dyn = subprocess.run(["readelf", "-d", so], capture_output=True, text=True)
	check("libgreet.so.1" in dyn.stdout and "1.2.3" not in dyn.stdout,
	      f"the soname is not the major version alone: {dyn.stdout}")

	stage = os.path.join(t.dir, "stage")
	check(t.fmake("--install", "--destdir", stage).returncode == 0,
	      "install failed")
	lib = os.path.join(stage, "usr", "local", "lib")
	real = os.path.join(lib, "libgreet.so.1.2.3")
	check(os.path.isfile(real) and not os.path.islink(real),
	      "the versioned file is missing or is a link")
	for link, points_at in (("libgreet.so.1", "libgreet.so.1.2.3"),
	                        ("libgreet.so", "libgreet.so.1")):
		path = os.path.join(lib, link)
		check(os.path.islink(path), f"{link} is not a symlink")
		check(os.readlink(path) == points_at,
		      f"{link} points at {os.readlink(path)!r}, not {points_at!r}")
		# Bare, so the chain survives the prefix moving -- which is what a
		# staged install is, and what every distribution does.
		check(not os.path.isabs(os.readlink(path)),
		      f"{link} points at an absolute path into the build tree")

	# The point of all of it: a consumer records the soname.
	if shutil.which("cc"):
		use = os.path.join(t.dir, "use.c")
		with open(use, "w") as fh:
			fh.write('#include "greet.h"\nint main(void){ return greet()[0] '
			         "!= 'h'; }\n")
		out = os.path.join(t.dir, "use")
		r = subprocess.run(["cc", use, "-I" + t.dir, "-L" + lib, "-lgreet",
		                    "-o", out], capture_output=True, text=True)
		check(r.returncode == 0, f"a consumer could not link: {r.stderr}")
		dyn = subprocess.run(["readelf", "-d", out], capture_output=True,
		                     text=True)
		check("libgreet.so.1" in dyn.stdout,
		      f"the consumer did not record the soname: {dyn.stdout}")
		ran = subprocess.run([out], env=dict(os.environ,
		                                     LD_LIBRARY_PATH=lib))
		check(ran.returncode == 0, "the consumer did not run against it")

	check(t.fmake("--uninstall", "--destdir", stage).returncode == 0,
	      "uninstall failed")
	for gone in ("libgreet.so", "libgreet.so.1", "libgreet.so.1.2.3"):
		p = os.path.join(lib, gone)
		check(not os.path.exists(p) and not os.path.islink(p),
		      f"uninstall left {gone}")

	# An unversioned shared library keeps the plain name and gets no chain,
	# which is right for one that ships beside its consumer.
	u = Tree("plain")
	try:
		u.write("q.h", "#pragma once\nint q(void);\n")
		u.write("q.c", "/*! @file\n *  @kind shared\n *  @target q\n"
		        " *  @headers q.h\n */\n"
		        '#include "q.h"\nint q(void){ return 1; }\n')
		check(u.fmake().returncode == 0, "the plain build failed")
		st = os.path.join(u.dir, "stage")
		check(u.fmake("--install", "--destdir", st).returncode == 0,
		      "the plain install failed")
		got = glob.glob(os.path.join(st, "usr", "local", "lib", "libq.so*"))
		check([os.path.basename(g) for g in got] == ["libq.so"],
		      f"an unversioned library got a chain: {sorted(got)}")
	finally:
		u.cleanup()


@case
def explain_says_what_would_be_installed(t):
	"""The packaging evaluation's second ask, and its own words for it.

	*"Which files are products, which are intermediates, which are meant to
	ship. That is knowledge fmake has and currently keeps."* It had it in
	`install_plan` -- the same list `--install` and both ejected builds read
	-- and printed none of it.

	The directories are shown as the variables rather than as resolved
	paths, because a packager stages under a different prefix than a plain
	build would use, and `$LIBDIR` is what a `debian/rules` is written
	against.

	It reads from the plan rather than describing it, so it cannot drift
	from what installing actually does -- which is the property that makes
	this worth printing at all."""
	t.write("greet.h", "#pragma once\nconst char *greet(void);\n")
	t.write("greet.c", """
/*! @file
 *  @kind    shared
 *  @target  greet
 *  @headers greet.h
 *  @version 1.2.3
 */
#include "greet.h"
const char *greet(void){ return "hi"; }
""")
	check(t.fmake().returncode == 0, "build failed")
	r = t.fmake("--explain")
	check(r.returncode == 0, f"--explain failed: {r.stderr}")
	block = r.stdout.split("installs")[-1] if "installs" in r.stdout else ""
	check(block, f"--explain says nothing about installing: {r.stdout}")

	# Everything the plan holds, and the directory as a variable.
	for want in ("libgreet.so.1.2.3", "libgreet.so.1", "libgreet.so",
	             "greet.h", "greet.pc"):
		check(want in block, f"{want} is not in the install listing: {block}")
	for var in ("$LIBDIR", "$INCLUDEDIR", "$PKGCONFIGDIR"):
		check(var in block, f"{var} is not named: {block}")
	check("/usr/local" not in block,
	      f"a resolved path leaked into the listing, which is wrong for "
	      f"anybody staging under another prefix: {block}")
	# A symlink is not a copy and must not read as one.
	check("(link)" in block, f"the chain is not shown as links: {block}")

	# It has to match what installing does, or it is a description rather
	# than a report.
	stage = os.path.join(t.dir, "stage")
	check(t.fmake("--install", "--destdir", stage).returncode == 0,
	      "install failed")
	# Files only: os.walk lists the directories it descends into as well,
	# and `usr`, `local` and `lib` are not things anybody installed. The
	# symlinks here point at files, so `files` already carries them.
	staged = set()
	for _base, _dirs, files in os.walk(stage):
		staged |= set(files)
	listed = {l.strip().split()[0] for l in block.splitlines() if l.strip()}
	check(staged <= listed,
	      f"installed files that --explain did not list: {staged - listed}")


@case
def a_versioned_library_gets_a_pkgconfig_file(t):
	"""fmake resolves through pkg-config and published nothing it could read.

	A header proposes a module, the module's `.pc` supplies the flags --
	that is section 5. A library fmake installed was findable by none of it:
	headers in `includedir`, an archive in `libdir`, and nothing tying them
	together, so the next project had to be told with `@pkg` or `@libs`
	what fmake would otherwise have worked out. The consumer this most
	obviously helps is fmake.

	Declaring a version is the opt-in, and there is no default: a `.pc`
	without a Version is one pkg-config refuses, and inventing one would
	publish a number nobody chose into a file other projects depend on.

	The check is pkg-config's own opinion rather than a substring: it is
	the reader, and a file it will not parse is not a pkg-config file
	however much it looks like one."""
	if not shutil.which("pkg-config"):
		raise Skip("pkg-config not installed")
	t.write("greet.h", "#pragma once\nconst char *greet(void);\n")
	t.write("greet.c", """
/*! @file
 *  @kind    static
 *  @target  greet
 *  @headers greet.h
 *  @version 1.2.3
 */
#include "greet.h"
const char *greet(void){ return "hi"; }
""")
	check(t.fmake().returncode == 0, "build failed")
	pc = os.path.join(t.dir, "greet.pc")
	check(os.path.exists(pc), "no .pc was written")

	env = dict(os.environ, PKG_CONFIG_PATH=t.dir)
	got = subprocess.run(["pkg-config", "--modversion", "greet"],
	                     capture_output=True, text=True, env=env)
	check(got.returncode == 0 and got.stdout.strip() == "1.2.3",
	      f"pkg-config will not read it: {got.stdout}{got.stderr}")

	# The paths must survive relocation, which is what a staged install and
	# every distribution do. Baked absolute paths would pass a substring
	# check and be wrong the moment the prefix moves.
	body = open(pc).read()
	check("${prefix}" in body,
	      f"the .pc has its paths baked in rather than relative to "
	      f"${{prefix}}: {body}")

	stage = os.path.join(t.dir, "stage")
	check(t.fmake("--install", "--destdir", stage).returncode == 0,
	      "install failed")
	staged = os.path.join(stage, "usr", "local", "lib", "pkgconfig",
	                      "greet.pc")
	check(os.path.exists(staged), f"the .pc was not installed: {staged}")
	check(t.fmake("--uninstall", "--destdir", stage).returncode == 0,
	      "uninstall failed")
	check(not os.path.exists(staged), "uninstall left the .pc behind")

	# A program publishes no API and gets none, version or not.
	u = Tree("prog")
	try:
		u.write("main.c", "/*! @file\n *  @version 9.9\n */\n"
		        "int main(void){ return 0; }\n")
		check(u.fmake().returncode == 0, "the program build failed")
		check(not glob.glob(os.path.join(u.dir, "*.pc")),
		      "a program was given a pkg-config file")
	finally:
		u.cleanup()

	# And a library that declares no version gets none: the opt-in is the
	# version, not the kind.
	v = Tree("noversion")
	try:
		v.write("q.h", "#pragma once\nint q(void);\n")
		v.write("q.c", "/*! @file\n *  @kind static\n *  @target q\n"
		        " *  @headers q.h\n */\n"
		        '#include "q.h"\nint q(void){ return 1; }\n')
		check(v.fmake().returncode == 0, "the unversioned build failed")
		check(not glob.glob(os.path.join(v.dir, "*.pc")),
		      "a library with no version was given a .pc anyway")
	finally:
		v.cleanup()


@case
def an_ejected_build_writes_the_same_pkgconfig_file(t):
	"""A clean checkout has no `.pc`, so the ejected build must write one.

	An install rule naming a file nothing produces fails on the one machine
	that matters -- somebody else's, from a fresh clone of a project that
	committed the Makefile.

	Compared byte for byte against fmake's own, which is how the first
	version was caught: `${prefix}` is a pkg-config variable *and* a Make
	variable reference, and Make wins. The recipe ran, succeeded, and wrote
	a .pc with empty paths -- section 26's trap, in a new file."""
	if not shutil.which("pkg-config"):
		raise Skip("pkg-config not installed")
	t.write("greet.h", "#pragma once\nconst char *greet(void);\n")
	t.write("greet.c", """
/*! @file
 *  @kind    static
 *  @target  greet
 *  @headers greet.h
 *  @version 1.2.3
 */
#include "greet.h"
const char *greet(void){ return "hi"; }
""")
	check(t.fmake().returncode == 0, "build failed")
	with open(os.path.join(t.dir, "greet.pc")) as fh:
		mine = fh.read()

	for kind, cmd in (("make", ["make", "-s"]),
	                  ("ninja", ["ninja", "-f", "build.ninja"])):
		if not shutil.which(cmd[0]):
			continue
		r = t.fmake("--eject", *([] if kind == "make" else ["ninja"]))
		check(r.returncode == 0, f"eject {kind} failed: {r.stderr}")
		name = "Makefile" if kind == "make" else "build.ninja"
		with open(os.path.join(t.dir, name), "w") as fh:
			fh.write(r.stdout)
		# Deleted, so the rule has to produce it rather than the tree
		# happening to still hold fmake's copy.
		os.remove(os.path.join(t.dir, "greet.pc"))
		shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
		stage = os.path.join(t.dir, "by-" + kind)
		run = _run_in(t.dir, *(cmd + ["install", "DESTDIR=" + stage]
		                       if kind == "make" else cmd))
		if kind == "ninja":
			check(run.returncode == 0, f"the ninja build failed: {run.stderr}")
			run = _run_in(t.dir, "ninja", "-f", "build.ninja", "install",
			              env={"DESTDIR": stage})
		check(run.returncode == 0,
		      f"the ejected {kind} install failed: {run.stdout}{run.stderr}")
		got = os.path.join(stage, "usr", "local", "lib", "pkgconfig",
		                   "greet.pc")
		check(os.path.exists(got), f"the ejected {kind} wrote no .pc")
		with open(got) as fh:
			theirs = fh.read()
		check(theirs == mine,
		      f"the ejected {kind} .pc differs from fmake's:\n"
		      f"  fmake: {mine!r}\n  {kind}: {theirs!r}")
		env = dict(os.environ, PKG_CONFIG_PATH=os.path.dirname(got))
		v = subprocess.run(["pkg-config", "--modversion", "greet"],
		                   capture_output=True, text=True, env=env)
		check(v.returncode == 0 and v.stdout.strip() == "1.2.3",
		      f"pkg-config will not read the ejected {kind} .pc: {v.stderr}")


@case
def an_ejected_makefile_installs_what_fmake_installs(t):
	"""The exit has to include the install, or it is only half an exit.

	Section 12 says a tool this opinionated has to be leaveable, and a
	project that leaves takes the build file with it. Until this rule
	existed that file could build the tree and not put it anywhere, so the
	one step between adoption and packaging was hand-written -- which the
	packaging evaluation named as the thing standing between it and a
	switch.

	What is checked is not that an install rule exists. It is that the two
	install the *same set*: same paths under the staging root, same modes.
	That is the property worth guarding, because the failure it prevents is
	silent -- an ejected build that installs a slightly different set goes
	on working, and the difference surfaces as a package missing a header.
	The plan comes from one function for exactly that reason, and this case
	is what says so."""
	if not shutil.which("make") or not shutil.which("install"):
		raise Skip("make or install(1) not installed")
	mine = _install_fixture(t)

	r = t.fmake("--eject")
	check(r.returncode == 0, f"eject failed: {r.stderr}")
	with open(os.path.join(t.dir, "Makefile"), "w") as fh:
		fh.write(r.stdout)
	# From a clean tree, so the ejected build genuinely rebuilds and cannot
	# pass by installing what fmake had already left behind.
	shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
	by_make = os.path.join(t.dir, "by-make")
	run = _run_in(t.dir, "make", "install", "DESTDIR=" + by_make)
	check(run.returncode == 0,
	      f"the ejected install failed: {run.stdout}{run.stderr}")
	_same_install(mine, _staged(by_make), "make")

	# It installs what was built, rather than whatever happens to be there.
	check("install: all" in open(os.path.join(t.dir, "Makefile")).read(),
	      "the install rule does not depend on the build")


@case
def an_ejected_ninja_installs_what_fmake_installs(t):
	"""The third caller of the same plan.

	Ninja has no `install' convention and no way to set a variable on the
	command line, which is why this was first recorded as not worth
	inventing. It does pass the environment through to a command, and that
	is enough: the recipe reads PREFIX, BINDIR, LIBDIR, INCLUDEDIR and
	DESTDIR with the same defaults the Makefile uses, so the same words mean
	the same thing in all three places.

	Its own case rather than a second half of the Makefile one, so that a
	machine without ninja skips this and still checks that."""
	if not shutil.which("ninja") or not shutil.which("install"):
		raise Skip("ninja or install(1) not installed")
	mine = _install_fixture(t)

	r = t.fmake("--eject", "ninja")
	check(r.returncode == 0, f"ninja eject failed: {r.stderr}")
	with open(os.path.join(t.dir, "build.ninja"), "w") as fh:
		fh.write(r.stdout)
	shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
	built = _run_in(t.dir, "ninja", "-f", "build.ninja")
	check(built.returncode == 0, f"the ninja build failed: {built.stderr}")

	by_ninja = os.path.join(t.dir, "by-ninja")
	inst = _run_in(t.dir, "ninja", "-f", "build.ninja", "install",
	               env={"DESTDIR": by_ninja})
	check(inst.returncode == 0,
	      f"the ninja install failed: {inst.stdout}{inst.stderr}")
	_same_install(mine, _staged(by_ninja), "ninja")

	# PREFIX from the environment: the part with no ninja precedent, and so
	# the part most likely to be wrong.
	elsewhere = os.path.join(t.dir, "by-ninja-prefix")
	inst = _run_in(t.dir, "ninja", "-f", "build.ninja", "install",
	               env={"DESTDIR": elsewhere, "PREFIX": "/opt/x"})
	check(inst.returncode == 0, f"PREFIX install failed: {inst.stderr}")
	check(any(p.startswith("opt/x/") for p in _staged(elsewhere)),
	      f"PREFIX from the environment was ignored: "
	      f"{sorted(_staged(elsewhere))}")


@case
def advice_distinguishes_an_excluded_file_from_a_typo(t):
	"""Two failures that read alike and mean opposite things.

	`@sources 'net_win32.c' matched no source file` about a file sitting
	right there is read as a typo, and the reader goes looking for a
	misspelling that is not there. The glob already knows the difference --
	what is on disk against what survived the platform rules -- and the
	`[target.*]` form of the same message already carried a warning about
	it, so the two spellings of one situation disagreed.

	The half that matters is that a genuine typo must stay a typo: adding
	the note to both cases would trade one misreading for another."""
	t.write("main.c", "/*! @file\n *  @sources net_win32.c\n */\n"
	        "int main(void){ return 0; }\n")
	t.write("net_win32.c", "int helper(void){ return 1; }\n")
	r = t.fmake()
	check(r.returncode != 0, "@sources naming nothing buildable should fail")
	said = r.stdout + r.stderr
	check("net_win32.c matched" in said,
	      f"the file is there and the message says it matched nothing: "
	      f"{said}")

	# A name that matches nothing at all must not gain the note.
	t.write("main.c", "/*! @file\n *  @sources ghost.c\n */\n"
	        "int main(void){ return 0; }\n")
	r = t.fmake()
	said = r.stdout + r.stderr
	check("matched but is not in the build" not in said,
	      f"a real typo was excused as an exclusion: {said}")


@case
def run_says_a_file_is_not_a_program(t):
	"""`--run` is the front end a newcomer meets first.

	It names its target after the file, so a file with no `main()` arrives
	at target selection as a name nobody declared, and the answer was `no
	target 'nomain'. Available: ...` -- a list of other targets, to someone
	who asked to run one file. The fact fmake had and was discarding is
	that the file is not a program."""
	t.write("main.c", "int main(void){ return 0; }\n")
	t.write("nomain.c", "int helper(void){ return 1; }\n")
	r = t.fmake("--run", os.path.join(t.dir, "nomain.c"))
	check(r.returncode != 0, "a file with no main() cannot be run")
	said = r.stdout + r.stderr
	check("main()" in said and "nomain.c" in said,
	      f"the reason is not given: {said}")
	check("Available:" not in said,
	      f"still answering with a list of other targets: {said}")

	# A file that IS a program still runs, so the check above is not simply
	# refusing --run.
	t.write("hello.c", "#include <stdio.h>\n"
	        'int main(void){ puts("ran"); return 0; }\n')
	r = t.fmake("--run", os.path.join(t.dir, "hello.c"))
	check(r.returncode == 0, f"--run failed on a real program: {r.stderr}")
	check("ran" in r.stdout, f"the program did not run: {r.stdout}")


@case
def a_generators_own_script_is_found_from_anywhere(t):
	"""`cd tree && fmake` accepted what `fmake -C tree` refused.

	Recipes run with cwd set to the tree, so `./mk.sh' in a command means
	the script in the project. The check that catches a command naming a
	program nobody has installed asked `shutil.which`, which resolves a
	relative path against *this process's* directory -- so the same tree
	built from outside was told its own script was not installed, and
	pointed at `uses', for a file sitting right there.

	Section 80's shape: a check whose answer depends on how it was
	invoked, and the two answers disagree. The case builds the same tree
	both ways and requires them to agree, which is the property rather
	than either answer."""
	t.write("mk.sh", "#!/bin/sh\nprintf 'int v(void){return 1;}\\n' > \"$1\"\n")
	os.chmod(os.path.join(t.dir, "mk.sh"), 0o755)
	t.write("seed.txt", "1\n")
	t.write("main.c", "int v(void);\nint main(void){ return v() - 1; }\n")
	t.write("fmake.toml", """
[generate.v]
command = "./mk.sh gen/v.c"
inputs  = ["seed.txt"]
outputs = ["gen/v.c"]
""")
	outside = t.fmake()
	check(outside.returncode == 0,
	      f"-C refused a tree with its own generator script: "
	      f"{outside.stdout}{outside.stderr}")

	shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
	os.remove(os.path.join(t.dir, "gen", "v.c"))
	inside = subprocess.run([FMAKE], cwd=t.dir, capture_output=True,
	                        text=True)
	check(inside.returncode == outside.returncode,
	      f"the same tree gave two answers: -C said "
	      f"{outside.returncode}, cwd said {inside.returncode}: "
	      f"{inside.stdout}{inside.stderr}")

	# A program that really is missing is still refused, or the fix has
	# traded a false refusal for a silent one.
	u = Tree("absent")
	try:
		u.write("main.c", "int v(void);\nint main(void){ return v(); }\n")
		u.write("fmake.toml", """
[generate.v]
command = "definitely-not-a-real-tool gen/v.c"
inputs  = ["main.c"]
outputs = ["gen/v.c"]
""")
		r = u.fmake()
		check(r.returncode != 0, "a missing generator program must be refused")
		check("definitely-not-a-real-tool" in r.stdout + r.stderr,
		      f"the refusal does not name the program: {r.stdout}{r.stderr}")
	finally:
		u.cleanup()


@case
def clean_says_how_much_it_freed(t):
	"""The answer to the question that brings anybody to `--clean`.

	An object directory is kept per configuration on purpose: switching
	profiles, toolchains or `$DEBUG` is then free, because the previous
	set is still there. Nothing ever reclaims one, so a tree built four
	ways holds four sets -- 274M and 14M side by side in a real project
	after a single change of default flags.

	That is the intended trade and it is invisible. The size makes it
	visible at the one moment somebody is asking."""
	t.write("main.c", "int main(void){ return 0; }\n")
	check(t.fmake().returncode == 0, "build failed")
	check(t.fmake(env={"DEBUG": "1"}).returncode == 0, "debug build failed")

	r = t.fmake("--clean")
	check(r.returncode == 0, f"clean failed: {r.stderr}")
	said = r.stdout + r.stderr
	check("file(s)" in said, f"the count is gone: {said}")
	check(re.search(r"\d+(\.\d+)?[BKMG]\)", said),
	      f"no size was reported: {said}")
	check(not os.path.isdir(os.path.join(t.dir, ".fmake")),
	      "the state directory survived")

	# Nothing to clean is still nothing to clean, not "0B".
	r = t.fmake("--clean")
	check("nothing to clean" in r.stdout + r.stderr,
	      f"a second clean should say there was nothing: {r.stdout}")


@case
def clean_removes_generated_sources_by_name(t):
	"""`--clean` left a build behind that a fresh checkout would not have.

	It removed `.fmake/` and nothing else, so the sources a generator wrote
	into the tree stayed -- and the ejected Makefile's clean rule has
	removed those since it first had one. The two disagreed, in the
	direction of leaving files a clean checkout does not contain.

	Named one by one, for the reason `--uninstall` names its files: this is
	deleting from somebody's source tree. The list is what the generators
	actually wrote, recorded in the cache and read out of it before the
	cache goes -- not a pattern, and not the declared outputs, which would
	mean scanning the tree to find rules living in source comments."""
	t.write("seed.txt", "in\n")
	t.write("main.c", "int v(void);\nint main(void){ return v() - 1; }\n")
	t.write("fmake.toml", """
[generate.v]
command = "mkdir -p gen && printf 'int v(void){return 1;}\\n' > gen/v.c"
inputs  = ["seed.txt"]
outputs = ["gen/v.c"]
""")
	check(t.fmake().returncode == 0, "build failed")
	made = os.path.join(t.dir, "gen", "v.c")
	check(os.path.exists(made), "the generator did not run")

	r = t.fmake("--clean")
	check(r.returncode == 0, f"clean failed: {r.stderr}")
	check(not os.path.exists(made),
	      "a generated source survived --clean, which a fresh checkout "
	      "would not contain")
	check(not os.path.exists(os.path.join(t.dir, ".fmake")),
	      "the state directory survived --clean")

	# Everything the tree came with is still there. This is the half that
	# matters: the rule deletes from a source tree, so it must not be able
	# to take a file it did not write.
	for kept in ("seed.txt", "main.c", "fmake.toml"):
		check(os.path.exists(os.path.join(t.dir, kept)),
		      f"--clean removed {kept}, which it did not write")
	# The directory the generator made is not ours to remove either.
	check(os.path.isdir(os.path.join(t.dir, "gen")),
	      "--clean removed a directory, and a directory was not named")

	# It builds again from what is left, which is what says the clean was
	# a clean rather than a demolition.
	check(t.fmake().returncode == 0, "the tree did not rebuild after --clean")
	check(os.path.exists(made), "the generator did not re-run")

	# A second clean is not an error, and a tree that never generated
	# anything is unaffected.
	check(t.fmake("--clean").returncode == 0, "the second clean failed")
	u = Tree("nogen")
	try:
		u.write("main.c", "int main(void){ return 0; }\n")
		check(u.fmake().returncode == 0, "the plain build failed")
		r = u.fmake("--clean")
		check(r.returncode == 0, f"clean of a plain tree failed: {r.stderr}")
		check("generated" not in r.stdout,
		      f"a tree with no generators was told about generated files: "
		      f"{r.stdout}")
		check(os.path.exists(os.path.join(u.dir, "main.c")),
		      "--clean removed a source from a tree with no generators")
	finally:
		u.cleanup()


@case
def a_generator_depfile_is_read_back(t):
	"""What the compiler's -MD does, for generators that can say the same.

	A `.y` that `%include`s another file re-ran only when the `.y` itself
	changed; everything else had to be listed in `depends` by hand, which
	is a list somebody has to keep right and will not. The tool that did
	the reading is the only thing that knows what it read, which is exactly
	the argument for depfiles on the compile side.

	So a rule may name one, and fmake folds what it names into the
	freshness key. `depends` stays for generators that cannot write one --
	flex cannot, and a shell script only can if somebody makes it."""
	t.write("schema/common.inc", "1\n")
	t.write("schema/thing.def", "include common.inc\n")
	# Reads every include the .def names, so a later edit can make the set
	# of files it depends on grow rather than merely change.
	t.write("mk.sh", """#!/bin/sh
total=0
deps=""
for inc in $(sed -n 's/^include //p' "$1"); do
	total=$((total + $(cat "schema/$inc")))
	deps="$deps schema/$inc"
done
printf 'int thing_value(void){ return %s; }\\n' "$total" > "$2"
printf '%s: %s%s\\n' "$2" "$1" "$deps" > "$3"
""")
	os.chmod(os.path.join(t.dir, "mk.sh"), 0o755)
	t.write("main.c", "int thing_value(void);\n"
	        "int main(void){ return thing_value() - 1; }\n")
	t.write("fmake.toml", """
[generate.thing]
command = "./mk.sh schema/thing.def gen/thing.c gen/thing.d"
inputs  = ["schema/thing.def"]
outputs = ["gen/thing.c"]
depfile = "gen/thing.d"
""")
	r = t.fmake()
	check(r.returncode == 0, f"the first build failed: {r.stdout}{r.stderr}")
	out = os.path.join(t.dir, "gen", "thing.c")
	check("return 1" in open(out).read(), "the generator did not run")

	# The file the generator read is neither an input nor in `depends`.
	# Nothing but the depfile can know about it.
	t.write("schema/common.inc", "2\n")
	r = t.fmake()
	check(r.returncode == 0, f"the rebuild failed: {r.stderr}")
	check("return 2" in open(out).read(),
	      "a file the generator read changed and it did not re-run")

	# And it settles: no third run without a reason.
	r = t.fmake()
	check("GEN" not in r.stdout, f"the generator re-ran for nothing: {r.stdout}")

	# The dep set *growing* has to settle in one run too. The rule reads a
	# file it never read before, so the key it was checked against could
	# not have mentioned it -- and storing that key would leave the next
	# build stale for a reason that no longer exists, regenerating a second
	# time to reach the same answer.
	t.write("schema/extra.inc", "10\n")
	t.write("schema/thing.def", "include common.inc\ninclude extra.inc\n")
	r = t.fmake()
	check(r.returncode == 0, f"the grow rebuild failed: {r.stderr}")
	check("return 12" in open(out).read(),
	      f"the second include was not read: {open(out).read()}")
	r = t.fmake()
	check("GEN" not in r.stdout,
	      f"a rule that read a new file regenerated twice to settle: "
	      f"{r.stdout}")

	# Without the depfile the same tree is stale-clean, which is what says
	# this feature does something rather than the fixture being rebuilt for
	# an unrelated reason.
	#
	# Written from scratch rather than copied out of the tree above, whose
	# files have been edited three times by now. Copying live state into a
	# control is how a control stops testing what it was built to test.
	u = Tree("nodepfile")
	try:
		u.write("schema/common.inc", "1\n")
		u.write("schema/thing.def", "include common.inc\n")
		with open(os.path.join(t.dir, "mk.sh")) as fh:
			u.write("mk.sh", fh.read())
		os.chmod(os.path.join(u.dir, "mk.sh"), 0o755)
		u.write("main.c", "int thing_value(void);\n"
		        "int main(void){ return thing_value() - 1; }\n")
		u.write("fmake.toml", """
[generate.thing]
command = "./mk.sh schema/thing.def gen/thing.c gen/thing.d"
inputs  = ["schema/thing.def"]
outputs = ["gen/thing.c"]
""")
		cr = u.fmake()
		check(cr.returncode == 0,
		      f"the control build failed: {cr.stdout}{cr.stderr}")
		u.write("schema/common.inc", "9\n")
		u.fmake()
		check("return 9" not in open(os.path.join(u.dir, "gen/thing.c")).read(),
		      "the control tree re-ran too, so the case proves nothing")
	finally:
		u.cleanup()


@case
def a_depfile_a_generator_never_wrote_is_refused(t):
	"""Declared and absent is a mistake, not an empty dependency list.

	Treating a missing depfile as "it read nothing" is the silent failure
	this whole feature exists to remove: the rule would look tracked and
	behave exactly as it did before."""
	t.write("in.txt", "1\n")
	t.write("main.c", "int v(void);\nint main(void){ return v() - 1; }\n")
	t.write("fmake.toml", """
[generate.thing]
command = "printf 'int v(void){return 1;}\\n' > gen/v.c"
inputs  = ["in.txt"]
outputs = ["gen/v.c"]
depfile = "gen/v.d"
""")
	r = t.fmake()
	check(r.returncode != 0, "a depfile that was never written must be an error")
	said = r.stdout + r.stderr
	check("gen/v.d" in said and "did not write" in said,
	      f"the refusal does not say what is missing: {said}")


@case
def an_exclusion_that_empties_the_tree_names_what_did_it(t):
	"""`@os windwos` is a platform problem for about a minute.

	The message was true and pointed at the wrong thing: told that every
	source is excluded when building for linux/x86_64, a reader checks
	[toolchain], checks the machine, and never suspects the spelling --
	which is the one thing that can be wrong. Section 31's pattern, in the
	message written to avoid it.

	fmake recorded the reason per file while excluding it, so saying which
	file and which directive costs nothing but printing what it already
	knows. The fix is exact rather than a guess, which is what lets it
	replace the bare sentence instead of joining it."""
	t.write("prog.c", "/*! @file\n *  @os windwos\n */\n"
	        "int main(void){ return 0; }\n")
	r = t.fmake()
	check(r.returncode != 0, "a tree with nothing to build should fail")
	said = r.stdout + r.stderr
	check("prog.c" in said, f"the file that was excluded is not named: {said}")
	check("windwos" in said,
	      f"the directive that excluded it is not named, so the reader "
	      f"cannot see the typo: {said}")

	# Two files, two different reasons, both named.
	t.write("lib.c", "/*! @file\n *  @arch riscv\n */\n"
	        "int helper(void){ return 1; }\n")
	r = t.fmake()
	said = r.stdout + r.stderr
	check("riscv" in said and "windwos" in said,
	      f"only one of the two reasons was given: {said}")

	# A real platform exclusion still reads as one rather than as a typo.
	u = Tree("named")
	try:
		u.write("net_win32.c", "int main(void){ return 0; }\n")
		r = u.fmake()
		said = r.stdout + r.stderr
		check("net_win32.c" in said and "@os" in said,
		      f"a filename exclusion lost its explanation: {said}")
	finally:
		u.cleanup()


@case
def a_program_only_headers_directive_is_reported(t):
	"""A directive read, understood, and discarded in silence.

	@headers is gathered for libraries only, and that rule is right --
	section 7 -- but being right is not being understood. Somebody who
	writes it beside a program's source runs --install, is told one file
	was installed, and gets no header and no word about why.

	The half that decides whether this is a diagnostic or a nuisance is the
	negative case: the source carrying the directive is *usually* linked
	into one of the tree's programs as well, and warning about that normal
	shape would be crying wolf on every project that has a library and a
	consumer."""
	t.write("api.h", "void f(void);\n")
	t.write("prog.c", '/*! @file\n *  @headers api.h\n */\n'
	        '#include "api.h"\nvoid f(void){}\n'
	        "int main(void){ f(); return 0; }\n")
	r = t.fmake("--install", "--destdir", os.path.join(t.dir, "stage"))
	check(r.returncode == 0, f"install failed: {r.stderr}")
	said = r.stdout + r.stderr
	check("api.h" in said and "not installed" in said,
	      f"a @headers that installs nothing said nothing: {said}")

	# The normal shape must stay quiet: greet.c is the archive's source and
	# is also linked into tool, so the header IS published and there is
	# nothing to report.
	u = Tree("normal")
	try:
		u.write("greet.h", "#pragma once\nconst char *greet(void);\n")
		u.write("greet.c", """
/*! @file
 *  @kind    static
 *  @target  greet
 *  @headers greet.h
 */
#include "greet.h"
const char *greet(void){ return "hi"; }
""")
		u.write("tool.c", '/*! @file\n *  @target tool\n */\n'
		        '#include <stdio.h>\n#include "greet.h"\n'
		        "int main(void){ puts(greet()); return 0; }\n")
		r = u.fmake("--install", "--destdir", os.path.join(u.dir, "stage"))
		check(r.returncode == 0, f"install failed: {r.stderr}")
		said = r.stdout + r.stderr
		check("not installed" not in said,
		      f"warned about a header it did install: {said}")
		check("include/greet.h" in said, f"the header was not installed: {said}")
	finally:
		u.cleanup()


@case
def install_does_not_publish_headers_for_programs(t):
	"""A program has no public API to publish.

    The header here is reachable only through the executable, so nothing
    should install it -- deduplication cannot cover this case, only the rule
    that @headers is gathered for libraries can."""
	t.write("helper.h", "int helper(void);\n")
	t.write("helper.c", """
/*! @file
 *  @headers helper.h
 */
#include "helper.h"
int helper(void){ return 7; }
