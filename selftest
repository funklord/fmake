@case
def install_places_artifacts_and_headers(t):
    """What @headers is for."""
    t.write("greet.h", "const char *greet(void);\n")
    t.write("greet.c", """
/*! @file
 *  @target  greet
 *  @kind    shared
 *  @headers greet.h
 */
#include "greet.h"
const char *greet(void){ return "hello"; }
""")
    t.write("tool.c", '#include <stdio.h>\n#include "greet.h"\n'
            "int main(void){ puts(greet()); return 0; }\n")
    t.write("fmake.toml", '[install]\nprefix = "/usr/local"\nlibdir = "lib64"\n')

    stage = os.path.join(t.dir, "stage")
    r = t.fmake("--install", "--destdir", stage)
    check(r.returncode == 0, f"install failed: {r.stdout}{r.stderr}")

    got = set()
    for base, _dirs, files in os.walk(stage):
        for f in files:
            got.add(os.path.relpath(os.path.join(base, f), stage))
    check("usr/local/lib64/libgreet.so" in got, f"library misplaced: {got}")
    check("usr/local/include/greet.h" in got, f"header not installed: {got}")
    check("usr/local/bin/tool" in got, f"program misplaced: {got}")
    check(len([g for g in got if g.endswith("greet.h")]) == 1,
          f"the header should be installed once, not once per target: {got}")


