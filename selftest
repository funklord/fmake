@case
def an_ejected_fragment_is_included_not_obeyed(t):
	"""fuzzypickles named this as what would change their answer.

	Their build's difficulty is mostly not compile-and-link: CPack, qmake,
	androiddeployqt, five submodules, and a `make apk` sequencing all of it.
	Adopting fmake wholesale means two build systems where there was one. A
	fragment their Makefile includes for the compile rules is an incremental
	path instead of a switch.

	Two things have to hold, and the second is the one that would fail
	silently. The parent keeps its own default goal and its own targets --
	and the parent's CFLAGS, which is the most ordinary thing for a Makefile
	to set, must not replace the flags fmake worked out."""
	if not shutil.which("make"):
		raise Skip("make not installed")
	t.write("main.c", "#include <stdio.h>\nint util_twice(int);\n"
	                  'int main(void){ printf("%d\\n", util_twice(21)); '
	                  "return 0; }\n")
	t.write("src/util.c", "int util_twice(int n){ return n * 2; }\n")

	e = t.fmake("--eject", "make-fragment")
	check(e.returncode == 0, f"eject failed: {e.stderr}")
	t.write("compile.mk", e.stdout)
	check("FM_CFLAGS" in e.stdout and "\nCFLAGS" not in e.stdout,
	      "a fragment must not own CFLAGS")
	check("\nall:" not in e.stdout,
	      "a fragment must not define the parent's default goal")

	prog = os.path.basename(t.dir)
	t.write("Makefile",
	        "CFLAGS = -this-would-break-everything\n\n"
	        ".PHONY: all package\n"
	        f"all: {prog} package\n\n"
	        "include compile.mk\n\n"
	        f"package: {prog}\n\t@echo packaged\n")
	shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
	r = subprocess.run(["make", "-C", t.dir], capture_output=True, text=True)
	check(r.returncode == 0,
	      f"the including Makefile failed: {r.stdout}{r.stderr}")
	check("packaged" in r.stdout,
	      f"the parent's own target should still run: {r.stdout}")
	check(t.run(prog).stdout == "42\n",
	      "the fragment's rules did not produce a working program")


@case
def an_ejected_build_uses_the_canonical_directory_variable(t):
	"""BUILD_DIR, in every backend, spelled the same way.

	The convention moved from OBJDIR to BUILD_DIR, chosen by counting
	spellings across the workspace rather than by taste. What made the
	rename worth a case is that it is emitted in four places -- the
	standalone Makefile, the fragment with its FM_ prefix, the ninja
	declaration, and the ninja rules that reference it -- and the rules were
	missed, which produces a build file that parses and cannot build."""
	t.write("main.c", "int helper(void);\nint main(void){ return helper(); }\n")
	t.write("helper.c", "int helper(void){ return 0; }\n")

	mk = t.fmake("--eject").stdout
	check("BUILD_DIR" in mk and "OBJDIR" not in mk,
	      f"the standalone Makefile should use BUILD_DIR: {mk[:400]}")

	frag = t.fmake("--eject", "make-fragment").stdout
	check("FM_BUILD_DIR" in frag and "OBJDIR" not in frag,
	      f"the fragment should use FM_BUILD_DIR: {frag[:400]}")

	nj = t.fmake("--eject", "ninja").stdout
	check("build_dir = " in nj and "objdir" not in nj,
	      f"ninja should declare and use build_dir: {nj[:400]}")

	# The three the parent controls keep their conventional spellings, so
	# the prefix must not reach them. Asserted here rather than left to the
	# alignment case, which detected it only by failing to find the block.
	for name in ("CC", "CXX", "AR"):
		check(re.search(rf"^{name} +\?= ", frag, re.M),
		      f"{name} is the parent's in a fragment: {frag[:400]}")
		check(f"FM_{name} " not in frag,
		      f"FM_ must not reach {name}: {frag[:400]}")


@case
def an_ejected_makefile_wraps_a_long_flag_list(t):
	"""A Qt project's CXXFLAGS is eighteen hundred characters on one line.

	The file's header invites hand-editing, which is the argument one
	evaluation made about the `-include` line naming every object; it
	applies with more force to a flag list twenty times longer. Make joins a
	continuation with a space, so the value is unchanged -- and the
	symbol-for-symbol case is what proves that rather than this one."""
	t.write("main.c", "int main(void){ return 0; }\n")
	# [project] cflags, not --cflags: the command-line form is an override
	# and lands in CFLAGS_LAST, so it never exercises the line that is
	# eighteen hundred characters long in a real Qt build.
	many = ", ".join(f'"-DLONG_ENOUGH_TO_WRAP_{n}=1"' for n in range(20))
	t.write("fmake.toml", f"[project]\ncflags = [{many}]\n")

	out = t.fmake("--eject").stdout
	longest = max(len(l) for l in out.splitlines())
	check(longest < 200,
	      f"no line should be a wall of flags, longest was {longest}")
	# The CFLAGS line specifically. CLEAN and OBJS are lists that end with
	# a backslash too, so "some line is continued" passes with the
	# continuation removed from the value that needed it.
	cflags = next(l for l in out.splitlines() if l.startswith("CFLAGS "))
	check(cflags.endswith(" \\"),
	      f"a long value should be continued: {cflags}")
	# Alignment, not indentation: a continuation lines up under the value.
	check(all(l.startswith(" ") for l in out.splitlines()
	          if l.strip().startswith("-DLONG_ENOUGH_TO_WRAP")),
	      f"continuations should be space-aligned: {out[:600]}")
	# And it still has to be a Makefile that works.
	if shutil.which("make"):
		t.write("Makefile", out)
		shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
		r = subprocess.run(["make", "-C", t.dir], capture_output=True,
		                   text=True)
		check(r.returncode == 0, f"the wrapped Makefile failed: {r.stderr}")


@case
def an_ejected_makefile_aligns_its_assignments(t):
	"""Alignment computed from the names, not counted once by hand.

	The variable block was hand-spaced to a column that fitted OBJDIR. A
	name two characters longer put three assignments out of line, which is
	what a hand-spaced table does the first time a name changes -- and it is
	the project's own rule about alignment, applied to the file it
	generates."""
	t.write("main.c", "int main(void){ return 0; }\n")

	# The header block only. CLEAN and OBJS are lists in later sections of
	# the file, not rows of this table, and a table aligns within itself.
	for args in (("--eject",), ("--eject", "make-fragment")):
		lines = t.fmake(*args).stdout.splitlines()
		start = next(i for i, l in enumerate(lines) if l.startswith("CC "))
		block = []
		for line in lines[start:]:
			if not line.strip():
				break
			block.append(line)
		cols = {l.index("=") for l in block if "=" in l}
		check(len(block) >= 6,
		      f"{' '.join(args)}: expected the variable block, got {block}")
		check(len(cols) == 1,
		      f"{' '.join(args)}: assignments should share a column, "
		      f"found {sorted(cols)} in {block}")


