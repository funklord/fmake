CROSS_CC = "aarch64-linux-gnu-gcc"


def _cross_available():
	return shutil.which(CROSS_CC) is not None


def _elf_machine(path):
	"""The e_machine of an ELF file, read the way fmake reads it."""
	with open(path, "rb") as fh:
		head = fh.read(20)
	if len(head) < 20 or head[:4] != b"\x7fELF":
		return None
	order = "little" if head[5] == 1 else "big"
	return int.from_bytes(head[18:20], order)


@case
def a_cross_build_derives_the_cxx_compiler(t):
	"""Naming the compiler is supposed to be enough, and was not for C++.

	`aarch64-linux-gnu-gcc` already implied the matching `nm` and `ar` --
	the rule was written down beside them. The C++ compiler was chosen a
	line *above* the prefix that would have derived it, so it never did.

	What that produced is the worst shape a build tool has: a tree
	declaring linux/aarch64 compiled its C++ with the host compiler, linked
	with the host compiler, wrote an x86-64 binary, and printed `built
	prog'. Nothing was wrong anywhere a person would look, and the artifact
	was for the wrong machine."""
	if not _cross_available():
		raise Skip(f"{CROSS_CC} not installed")
	if not shutil.which("aarch64-linux-gnu-g++"):
		raise Skip("aarch64-linux-gnu-g++ not installed")
	t.write("prog.cpp", "#include <string>\n"
	        'int main(){ std::string s = "x"; return (int)s.size() - 1; }\n')
	t.write("fmake.toml", f'[toolchain]\ncc = "{CROSS_CC}"\n'
	        'os = "linux"\narch = "aarch64"\n')

	r = t.fmake("-n")
	compile_line = next((l for l in r.stdout.splitlines() if " -c " in l), "")
	check("g++" in compile_line and "aarch64" in compile_line,
	      f"the host C++ compiler was chosen for a cross build: "
	      f"{compile_line}")

	check(t.fmake().returncode == 0, "the cross build failed")
	prog = os.path.join(t.dir, "prog")
	check(os.path.exists(prog), "no binary was produced")
	check(_elf_machine(prog) == 0xB7,
	      f"a build declaring aarch64 produced a "
	      f"0x{_elf_machine(prog):x} binary")


@case
def an_object_built_for_the_wrong_machine_is_refused(t):
	"""Deriving the compiler fixes one instance; this closes the class.

	The next one will be a compiler named by hand, an `arch' that does not
	match the `cc', or a $CXX left over in a shell -- none of which a
	derivation can help with, and all of which produce an artifact for the
	wrong machine while reporting success.

	The evidence is the ELF header, the same thing section 23 reads off a
	vendored archive: exact for any architecture, and needing no knowledge
	of triplets. The guard only speaks when both sides are certain, so a
	tree it cannot judge builds exactly as before."""
	if not _cross_available():
		raise Skip(f"{CROSS_CC} not installed")
	t.write("prog.cpp", "int main(){ return 0; }\n")
	# The wrong C++ compiler, named outright, which is what the derivation
	# cannot save anybody from.
	t.write("fmake.toml", f'[toolchain]\ncc = "{CROSS_CC}"\n'
	        'cxx = "c++"\nos = "linux"\narch = "aarch64"\n')
	r = t.fmake()
	check(r.returncode != 0, "an x86-64 object satisfied an aarch64 build")
	said = r.stdout + r.stderr
	check("aarch64" in said and "x86_64" in said,
	      f"the refusal does not say which machine is which: {said}")
	check("cxx" in said or "CXX" in said,
	      f"the refusal does not name the knob that fixes it: {said}")

	# A correct cross build is untouched by the guard.
	t.write("fmake.toml", f'[toolchain]\ncc = "{CROSS_CC}"\n'
	        'os = "linux"\narch = "aarch64"\n')
	t.write("prog.c", "int main(void){ return 0; }\n")
	os.remove(os.path.join(t.dir, "prog.cpp"))
	check(t.fmake().returncode == 0,
	      "the guard refused a correct cross build")

	# And a plain host build, which is the path every other case takes.
	u = Tree("host")
	try:
		u.write("prog.c", "int main(void){ return 0; }\n")
		check(u.fmake().returncode == 0, "the guard refused a host build")
	finally:
		u.cleanup()


def host_machine():
	"""This machine's e_machine value, for comparing against a built tool."""
	return {"x86_64": 0x3E, "aarch64": 0xB7, "x86": 0x03, "arm": 0x28,
	        "riscv": 0xF3, "ppc64": 0x15}.get(platform.machine().lower()
	                                          .replace("amd64", "x86_64"))


def _elf_machine(path):
	with open(path, "rb") as fh:
		head = fh.read(20)
	if head[:4] != b"\x7fELF":
		return None
	order = "little" if head[5] == 1 else "big"
	return int.from_bytes(head[18:20], order)


@case
def cross_builds_for_the_target_architecture(t):
	"""A real cross build, end to end.

    The interesting part is not the compiler -- naming that is easy -- but
    that library resolution has to answer for the target machine. The
    symbols come from the target's libraries or the link fails."""
	if not _cross_available():
		raise Skip(f"{CROSS_CC} not installed")
	t.write("main.c", """
#include <stdio.h>
#include <stdlib.h>
#include <math.h>
int main(int argc, char **argv){
    double x = argc > 1 ? atof(argv[1]) : 7.0;
    printf("%.4f\\n", sqrt(x) + lgamma(x));
    return 0;
}
""")
	t.write("fmake.toml", f'[toolchain]\ncc = "{CROSS_CC}"\narch = "aarch64"\n')

	r = t.fmake()
	check(r.returncode == 0, f"cross build failed: {r.stdout}{r.stderr}")

	prog = os.path.join(t.dir, os.path.basename(t.dir))
	check(_elf_machine(prog) == 0xB7,
	      f"expected an aarch64 binary, got machine "
	      f"{_elf_machine(prog):#x}")

	e = t.fmake("--explain").stdout
	check("-lm" in e, f"libm should have been resolved for the target: {e}")
	check("aarch64" in e, f"the target architecture should be reported: {e}")

	qemu = shutil.which("qemu-aarch64") or shutil.which("qemu-aarch64-static")
	if qemu:
		out = subprocess.run([qemu, "-L", "/usr/aarch64-linux-gnu", prog, "7"],
		                     capture_output=True, text=True)
		check(out.stdout == "9.2250\n",
		      f"the cross-built binary does not run correctly: {out.stdout!r}"
		      f" {out.stderr!r}")


@case
def cross_refuses_host_libraries(t):
	"""The bug this fixes.

    zlib exists on the build machine and not for the target. Offering it
    would produce a linker error about incompatible architectures; the
    truthful answer is that the target has no zlib, and the message has to
    say which architecture it looked for."""
	if not _cross_available():
		raise Skip(f"{CROSS_CC} not installed")
	if not os.path.exists("/usr/include/zlib.h"):
		raise Skip("zlib headers not installed")
	if glob.glob("/usr/aarch64-linux-gnu/lib/libz.so"):
		raise Skip("the target has zlib too, so there is nothing to reject")

	t.write("main.c", "#include <stdio.h>\n#include <zlib.h>\n"
	        'int main(void){ printf("%s\\n", zlibVersion()); return 0; }\n')

	# Native first: this must resolve, or the case proves nothing.
	check("-lz" in t.fmake("--explain").stdout,
	      "zlib should resolve natively")

	t.write("fmake.toml", f'[toolchain]\ncc = "{CROSS_CC}"\narch = "aarch64"\n')
	shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
	# Assert on fmake's own decision. The linker's failure output happens to
	# contain both "zlibVersion" and "aarch64" (from gcc-cross paths), so
	# matching those in a failed build would pass even if -lz were offered.
	e = t.fmake("--explain").stdout
	libs = before_externals(e)
	check("-lz" not in libs,
	      f"the host's zlib must not be offered to a cross link: {libs}")
	check("(unresolved)" in libs and "zlibVersion" in libs,
	      f"zlibVersion should be reported unresolved: {libs}")
	check("aarch64" in libs,
	      f"the architecture searched should be named: {libs}")
	check(t.fmake().returncode != 0,
	      "the build cannot succeed without the target's zlib")


@case
def cross_rejects_wrong_architecture_libraries(t):
	"""The architecture check itself, pointed straight at host libraries.

    With this toolchain the host's multiarch directory happens not to be on
    the cross compiler's search path, so host libraries are excluded by
    accident of layout. Naming that directory in lib-dirs removes the
    accident: nothing but the ELF header can reject what is in there, and
    offering it would produce a link error about incompatible architectures.
    """
	if not _cross_available():
		raise Skip(f"{CROSS_CC} not installed")
	host_dir = subprocess.run(["cc", "-print-multiarch"],
	                          capture_output=True, text=True).stdout.strip()
	host_libs = f"/usr/lib/{host_dir}" if host_dir else "/usr/lib"
	if not glob.glob(f"{host_libs}/libz.so"):
		raise Skip(f"no host zlib in {host_libs} to reject")
	if glob.glob("/usr/aarch64-linux-gnu/lib/libz.so"):
		raise Skip("the target has zlib too, so there is nothing to reject")

	t.write("main.c", "#include <stdio.h>\n#include <zlib.h>\n"
	        'int main(void){ printf("%s\\n", zlibVersion()); return 0; }\n')
	t.write("fmake.toml", f"""
[toolchain]
cc       = "{CROSS_CC}"
arch     = "aarch64"
lib-dirs = ["{host_libs}"]
""")
	libs = before_externals(t.fmake("--explain").stdout)
	check(f"{host_libs}" not in libs or "-lz" not in libs,
	      f"a host library was offered to a cross link: {libs}")
	check("-lz" not in libs,
	      f"host zlib must be rejected by architecture: {libs}")
	check("zlibVersion" in libs and "(unresolved)" in libs,
	      f"the symbol should remain unresolved: {libs}")


@case
def cross_builds_generators_for_the_build_machine(t):
	"""A generator runs here; the program it generates for runs there.

    Compiling the tool with the target toolchain produces something that
    cannot be executed, which is the classic build-versus-host distinction
    and the one place a cross build needs two toolchains rather than one."""
	if not _cross_available():
		raise Skip(f"{CROSS_CC} not installed")
	t.write("util/mktable.c", r"""
#include <stdio.h>
int main(int argc, char **argv){
    FILE *f = fopen(argv[1], "w");
    fprintf(f, "int table_value(void){ return 42; }\n");
    fclose(f);
    return 0;
}
""")
	t.write("main.c", r"""
#include <stdio.h>
int table_value(void);
int main(void){ printf("%d\n", table_value()); return 0; }
""")
	t.write("fmake.toml", f"""
[toolchain]
cc   = "{CROSS_CC}"
arch = "aarch64"

[target.mktable]
root = "util/mktable.c"

[generate.table]
uses    = "mktable"
command = "$tool gen/table.c"
inputs  = ["util/mktable.c"]
outputs = ["gen/table.c"]
""")
	r = t.fmake()
	check(r.returncode == 0, f"cross build failed: {r.stdout}{r.stderr}")

	tool = os.path.join(t.dir, ".fmake", "tools", "mktable")
	check(_elf_machine(tool) == host_machine(),
	      "the generator must be built for the machine that runs it")
	prog = os.path.join(t.dir, os.path.basename(t.dir))
	check(_elf_machine(prog) == 0xB7,
	      "the program must still be built for the target")

	qemu = shutil.which("qemu-aarch64") or shutil.which("qemu-aarch64-static")
	if qemu:
		out = subprocess.run([qemu, "-L", "/usr/aarch64-linux-gnu", prog],
		                     capture_output=True, text=True).stdout
		check(out == "42\n", f"the generated code did not survive: {out!r}")


@case
def cross_rejects_an_unrunnable_generator(t):
	"""Declared wrong, caught rather than trusted."""
