REPO = os.path.dirname(os.path.abspath(FMAKE))


@case
def the_package_version_matches_the_program(t):
	"""debian/changelog and VERSION are the same number in two places.

    Nothing enforces that, and the failure is quiet in the worst way: a
    package that installs cleanly and reports a version it is not."""
	changelog = os.path.join(REPO, "debian/changelog")
	if not os.path.exists(changelog):
		raise Skip("no debian/ in this tree")
	with open(changelog) as fh:
		first = fh.readline()
	m = re.match(r"\S+ \(([^)]+)\)", first)
	check(m, f"cannot read a version from {first!r}")
	packaged = m.group(1).split("-")[0]

	with open(FMAKE) as fh:
		src = fh.read()
	m = re.search(r'^VERSION\s*=\s*"([^"]+)"', src, re.M)
	check(m, "no VERSION in fmake")
	check(m.group(1) == packaged,
	      f"fmake says {m.group(1)}, debian/changelog says {packaged}")


@case
def the_packaged_script_has_an_absolute_interpreter(t):
	"""Debian Policy 10.4: an installed script names its interpreter outright.

    The repository copy keeps `#!/usr/bin/env python3`, because copying it
    into $PATH and running it anywhere is half of what fmake is and that half
    wants the lookup. The installed copy must not, so `make install` rewrites
    the line -- which means there are now two spellings and a way for the
    rewrite to stop happening without anyone noticing."""
	if not shutil.which("make"):
		raise Skip("make not installed")
	if not os.path.exists(os.path.join(REPO, "Makefile")):
		raise Skip("no Makefile in this tree")

	stage = tempfile.mkdtemp(prefix="fmake-stage-")
	try:
		r = subprocess.run(["make", "install", f"DESTDIR={stage}",
		                    "PREFIX=/usr", "PYTHON=/usr/bin/python3"],
		                   cwd=REPO, capture_output=True, text=True)
		check(r.returncode == 0, f"make install failed: {r.stdout}{r.stderr}")
		installed = os.path.join(stage, "usr/bin/fmake")
		check(os.path.exists(installed), "nothing was installed")
		with open(installed) as fh:
			first = fh.readline().strip()
		check(first == "#!/usr/bin/python3",
		      f"the installed shebang is {first!r}")
		check(os.access(installed, os.X_OK), "the installed copy is not executable")

		got = subprocess.run([installed, "-V"], capture_output=True, text=True)
		check(got.returncode == 0 and "fmake" in got.stdout,
		      f"the installed copy does not run: {got.stdout}{got.stderr}")
	finally:
		shutil.rmtree(stage, ignore_errors=True)


@case
def the_source_runs_on_the_python_it_declares(t):
	"""A syntax the declared interpreter cannot read is a package that
	installs and then never starts.

	fmake declares python3 (>= 3.11), which is where tomllib arrives. Two
	f-strings had a replacement field spanning a line break -- PEP 701, new
	in 3.12 -- so on Debian bookworm the package would install cleanly,
	satisfy its dependency, configure, and then die with a SyntaxError
	before reaching main. The failure lands at the far end of the chain from
	the thing that caused it.

	It cannot be caught by reading, and the obvious check is worse than
	useless: ast.parse(..., feature_version=(3, 11)) *accepts* these,
	because the change is in the tokeniser rather than the grammar. Running
	fmake locally passes too. Only an old interpreter or a token-level check
	sees it -- and the check has to run on 3.12+, since FSTRING_START does
	not exist as a token type before then, which is the right way round.

	Reported by apt-emerge, which hit the identical bug in its own CI."""
	changelog = os.path.join(REPO, "debian/control")
	if not os.path.exists(changelog):
		raise Skip("no debian/ in this tree")
	m = re.search(r"python3 \(>= (\d+)\.(\d+)\)", open(changelog).read())
	check(m, "debian/control does not declare a python3 version")
	floor = (int(m.group(1)), int(m.group(2)))
	if floor >= (3, 12):
		raise Skip(f"declares {floor[0]}.{floor[1]}, so PEP 701 is allowed")

	# `fmake` only. It is the file the package installs and therefore the
	# only one the declared dependency is a promise about; `selftest` is a
	# development tool that runs on whatever the developer has, and holding
	# it to a floor nobody declared would be inventing a rule.
	# A stack, not a variable. f-strings nest -- a replacement field can
	# hold another f-string -- and a single `start` is overwritten by the
	# inner one, so the outer f-string's span gets measured from the inner
	# one's opening quote and a multi-line outer reads as single-line. That
	# is how this check passed on a file python3.11 refuses to parse.
	import tokenize
	stack, bad = [], []
	with open(FMAKE, "rb") as fh:
		for tok in tokenize.tokenize(fh.readline):
			if tok.type == tokenize.FSTRING_START:
				stack.append(tok.start[0])
			elif tok.type == tokenize.FSTRING_END:
				begin = stack.pop() if stack else tok.end[0]
				if tok.end[0] != begin:
					bad.append(begin)
	check(not bad,
	      f"f-string spanning lines at {bad}, which needs 3.12 but "
	      f"debian/control declares {floor[0]}.{floor[1]}")

	# And if the declared interpreter is actually here, run it. The token
	# check is an inference about what an old Python would say; this is the
	# old Python saying it, and it covers every syntax added since rather
	# than the one that bit us. The first version of the check above passed
	# on a file 3.11 could not parse, so the inference has already been
	# wrong once.
	old_python = shutil.which(f"python{floor[0]}.{floor[1]}")
	if not old_python:
		raise Skip(f"python{floor[0]}.{floor[1]} is not installed, so only "
		           f"the token check ran")
	r = subprocess.run([old_python, FMAKE, "--version"],
	                   capture_output=True, text=True)
	check(r.returncode == 0,
	      f"python{floor[0]}.{floor[1]} cannot run fmake: {r.stderr}")
	r = subprocess.run([old_python, FMAKE, "--help"],
	                   capture_output=True, text=True)
	check(r.returncode == 0,
	      f"python{floor[0]}.{floor[1]} cannot run fmake --help: {r.stderr}")


@case
def the_completion_offers_every_option(t):
	"""--completion is generated from the parser, for the same reason --man
	is, and needs the same guard.

	A stale completion offers a flag the program no longer accepts and omits
	the one you wanted, and neither is an error -- it is wrong in the one
	place a user trusts without checking. Generating it removes the question
	only as long as nothing hand-maintains a second list."""
	comp = subprocess.run([FMAKE, "--completion", "bash"],
	                      capture_output=True, text=True)
	check(comp.returncode == 0, f"--completion failed: {comp.stderr}")
	helped = subprocess.run([FMAKE, "--help"], capture_output=True, text=True)

	opts = set(re.findall(r"(?<![\w-])(--[a-z][a-z-]+)", helped.stdout))
	check(len(opts) > 10, f"suspiciously few options found: {opts}")
	missing = [o for o in sorted(opts) if o not in comp.stdout]
	check(not missing, f"the completion does not offer: {missing}")

	# It has to be a script bash will accept, and one that completes.
	if not shutil.which("bash"):
		raise Skip("bash not installed")
	t.write("fmake.bash", comp.stdout)
	script = os.path.join(t.dir, "fmake.bash")
	r = subprocess.run(["bash", "-n", script], capture_output=True, text=True)
	check(r.returncode == 0, f"the completion is not valid bash: {r.stderr}")

	probe = (f'source {shlex.quote(script)}\n'
	         'COMP_WORDS=(fmake --eject ""); COMP_CWORD=2; _fmake\n'
	         'echo "${COMPREPLY[*]}"\n')
	r = subprocess.run(["bash", "-c", probe], capture_output=True, text=True)
	check("make-fragment" in r.stdout and "ninja" in r.stdout,
	      f"an option with fixed values should complete to them: {r.stdout!r}")


@case
def the_manual_describes_every_option(t):
	"""--man is generated from the parser, and has to stay that way.

    A manual page is the one piece of documentation nobody re-reads, so a
    hand-kept copy of the option list is a copy that goes stale in a place
    only a stranger will look. This checks the generated page against what
    argparse actually accepts, which is the property that makes generating
    it worth doing at all."""
	page = subprocess.run([FMAKE, "--man"], capture_output=True, text=True)
	check(page.returncode == 0, f"--man failed: {page.stderr}")
	helped = subprocess.run([FMAKE, "--help"], capture_output=True, text=True)

	opts = set(re.findall(r"(?<![\w-])(--[a-z][a-z-]+)", helped.stdout))
	check(len(opts) > 10, f"suspiciously few options found: {opts}")
	# roff escapes the hyphens, so compare against the escaped spelling.
	missing = [o for o in sorted(opts)
	           if o.replace("-", "\\-") not in page.stdout]
	check(not missing, f"the manual does not mention: {missing}")

	check(".TH FMAKE 1" in page.stdout, "no roff header")
	if shutil.which("man"):
		with tempfile.NamedTemporaryFile("w", suffix=".1", delete=False) as fh:
			fh.write(page.stdout)
			path = fh.name
		try:
			r = subprocess.run(["man", "--warnings", "-l", path],
			                   capture_output=True, text=True,
			                   env=dict(os.environ, MANWIDTH="80"))
			check(not r.stderr.strip(),
			      f"roff warnings from the generated page: {r.stderr[:200]}")
		finally:
			os.unlink(path)


@case
def the_readme_documents_every_directive(t):
	"""The README's *other* list of what the program knows.

	Section 82 guarded the option table and stated the rule: anything the
	README lists that the program also knows needs a case holding the two
	together. The directive table is the second such list in the same file
	and was left unguarded -- so `@version`, added a few commits later,
	went undocumented exactly as the rule predicts.

	`@defines` is deliberately absent from the README. It is the plural
	spelling of `@define`, accepted so a fact does not need a different
	word for living in a config file, and documenting both would suggest
	they are two things."""
	with open(FMAKE) as fh:
		src = fh.read()

	def names(start, end):
		return set(re.findall(r'"([^"]+)"', src[src.index(start):src.index(end)]))

	scalar = names("DIRECTIVE_SCALAR = {", "# Accumulate across")
	listed = names("DIRECTIVE_LIST = {", "# @define and @defines")
	# Anchored at a line start and searched forward from the alias table.
	# `src.index("DIRECTIVES = ")` finds MK_PROJECT_DIRECTIVES twelve
	# hundred lines earlier, which makes the slice run backwards and the
	# alias map come out empty -- so `@defines` read as undocumented.
	at = src.index("\nDIRECTIVE_ALIAS = {")
	alias = dict(re.findall(r'"([^"]+)": "([^"]+)"',
	                        src[at:src.index("\nDIRECTIVES = ", at)]))
	check(alias, "no directive aliases were read, so the check is wrong")
	want = {alias.get(d, d) for d in scalar | listed}
	check(len(want) > 10, f"only {len(want)} directives read out of fmake")

	with open(os.path.join(REPO, "README.md")) as fh:
		readme = fh.read()
	marker = "| `@target NAME`"
	check(marker in readme, "the README has no directive table")
	table = readme[readme.index(marker):]
	table = table[:table.index("\n\n")]
	documented = set(re.findall(r"@(\w+)", table))
	check(len(documented) > 10,
	      f"only {len(documented)} rows found; the split is wrong")

	missing = sorted(want - documented)
	check(not missing, f"the README's directive table does not document: "
	                   f"{missing}")
	invented = sorted(documented - want - set(alias))
	check(not invented,
	      f"the README documents directives fmake does not have: {invented}")


@case
def the_readme_documents_every_option(t):
	"""The README is the manual, so its option table is a third copy.

	project.md says "for using the tool, read README.md", and the manual
	page is generated and git-ignored -- so it exists only after a build,
	and the README is what a reader of the repository actually has. That
	makes its Commands table documentation of record rather than a summary,
	and a hand-written list is exactly the thing --man and --completion are
	generated to avoid.

	It had already drifted when this case was written: --run, --man,
	--completion, --doxygen-aliases, -V and -h were all absent from the
	table, four of them discussed elsewhere in the file and two documented
	nowhere at all. Section 78 records the same failure from the other
	direction, where a --man paragraph went missing in a restructure and
	nothing noticed."""
	with open(os.path.join(REPO, "README.md")) as fh:
		readme = fh.read()

	marker = "| Flag | |"
	check(marker in readme, "the README has no Commands flag table")
	table = readme.split(marker, 1)[1].split("\n\n", 1)[0]
	rows = [line for line in table.splitlines() if line.startswith("| `")]
	# A table this check could not fail against is not a check. If the
	# split above ever stops finding the rows, say so rather than passing.
	check(len(rows) > 10, f"only {len(rows)} rows found; the split is wrong")

	helped = subprocess.run([FMAKE, "--help"], capture_output=True, text=True)
	check(helped.returncode == 0, f"--help failed: {helped.stderr}")
	usage = helped.stdout.split("positional arguments:")[0]
	opts = set(re.findall(r"(?<![\w-])(--[a-z][a-z-]+)", usage))
	check(len(opts) > 10, f"suspiciously few options found: {opts}")

	# argparse prints a short and long spelling as one entry; the README
	# lists whichever is the one people type.
	same = {"--directory": "-C", "--jobs": "-j", "--output": "-o",
	        "--profile": "-p", "--dry-run": "-n", "--always-make": "-B",
	        "--version": "-V", "--verbose": "-v", "--quiet": "-q"}
	documented = set(re.findall(r"`(--?[A-Za-z][\w-]*)", "\n".join(rows)))
	missing = [o for o in sorted(opts)
	           if o not in documented and same.get(o) not in documented]
	check(not missing, f"the README's table does not document: {missing}")

	# -h earns its place separately: argparse never prints it in the usage
	# line, so the loop above cannot reach it.
	check("-h" in documented, "the README's table does not document: ['-h']")


@case
def the_contents_index_lists_every_section(t):
	"""project.md's index is a fourth hand-kept list, and it had stopped.

	The document runs to 82 numbered sections; the index covered 34 of
	them, having last been extended around section 38, and it had also
	skipped section 35 within the range it did cover. An index that stops
	is worse than no index: it reads as complete, so a reader concludes the
	section they want does not exist rather than scrolling for it.

	Two properties, and the second is the one that rots quietly. Every
	section must be listed, and every link must resolve -- a heading
	reworded without its anchor being updated leaves a link that looks
	right and goes nowhere, which nothing but a click would reveal."""
	with open(os.path.join(REPO, "project.md")) as fh:
		doc = fh.read()

	head = doc.index("## Contents")
	index = doc[head:doc.index("\n---\n", head)]
	headings = [line[3:].strip() for line in doc.split("\n")
	            if line.startswith("## ") and line[3:].strip() != "Contents"]
	check(len(headings) > 20, f"only {len(headings)} sections found")

	def anchor(heading):
		slug = re.sub(r"[^\w\s-]", "", heading.lower())
		return "#" + re.sub(r"\s+", "-", slug.strip())

	links = re.findall(r"\]\((#[^)]+)\)", index)
	check(len(links) > 20, f"only {len(links)} links found; the split is wrong")

	known = {anchor(h) for h in headings}
	broken = sorted(set(links) - known)
	check(not broken, f"the index links to no such heading: {broken}")

	unlisted = sorted(h for h in headings if anchor(h) not in links)
	check(not unlisted, f"the index does not list: {unlisted}")

	repeated = sorted({a for a in links if links.count(a) > 1})
	check(not repeated, f"the index lists a section twice: {repeated}")


@case
def an_ejected_makefile_survives_a_deleted_header(t):
	"""`-MP`, which code-style.md holds ejected Makefiles to.

    A depfile names every header an object depended on. Delete one -- which
    is what a refactor that inlines a declaration does -- and make finds a
    prerequisite with no rule and stops, before it ever reaches the
    compiler, saying `No rule to make target 'util.h'`. -MP emits a phony
    target for each header so that a vanished one is simply not there any
    more.

    fmake's own builds do not need it: it reads its own depfiles and skips a
    prerequisite that is gone. A Makefile has no such luxury, and an ejected
    Makefile is a Makefile someone will edit."""
	if not shutil.which("make"):
		raise Skip("make not installed")
	t.write("util.h", "#pragma once\nint helper(void);\n")
	t.write("util.c", '#include "util.h"\nint helper(void){ return 7; }\n')
	t.write("main.c", '#include "util.h"\nint main(void){ return helper() - 7; }\n')

	check(t.fmake().returncode == 0, "first build failed")
	r = t.fmake("--eject")
	check(r.returncode == 0, f"eject failed: {r.stderr}")
	with open(os.path.join(t.dir, "Makefile"), "w") as fh:
		fh.write(r.stdout)
	shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
	check(_run_in(t.dir, "make").returncode == 0, "the ejected build failed")

	# The refactor: the declaration moves into the caller, the header goes.
	t.write("util.c", "int helper(void){ return 7; }\n")
	t.write("main.c", "int helper(void);\nint main(void){ return helper() - 7; }\n")
	os.remove(os.path.join(t.dir, "util.h"))

	m = _run_in(t.dir, "make")
	check("No rule to make target" not in m.stdout + m.stderr,
	      f"a deleted header stalled the build: {m.stdout}{m.stderr}")
	check(m.returncode == 0, f"the rebuild failed: {m.stdout}{m.stderr}")
	check(_run_in(t.dir, "./" + os.path.basename(t.dir)).returncode == 0,
	      "the rebuilt program is wrong")


@case
def an_ejected_clean_names_what_it_removes(t):
	"""No wildcards, no rm -rf, no directory removal: only named files.

	The earlier version of this case checked that `make clean BUILD_DIR=/` was
	*refused*. Refusing is the second-best answer. fmake listed every object
	in the same file one line below, to -include their depfiles, so it knows
	exactly what the build creates and can say so -- and a generator that
	knows what it made has no reason to delete by pattern. `BUILD_DIR=/` now
	expands to `rm -f //main.c.o ...`, which names files that do not exist
	and removes nothing.

	The object directory itself is left behind. Removing it would mean
	removing something the rule did not name."""
	if not shutil.which("make"):
		raise Skip("make not installed")
	t.write("sub/util.h", "#pragma once\nint helper(void);\n")
	t.write("sub/util.c", '#include "sub/util.h"\nint helper(void){ return 4; }\n')
	t.write("main.c", '#include "sub/util.h"\nint main(void){ return helper() - 4; }\n')
	check(t.fmake().returncode == 0, "build failed")
	r = t.fmake("--eject")
	check(r.returncode == 0, f"eject failed: {r.stderr}")
	with open(os.path.join(t.dir, "Makefile"), "w") as fh:
		fh.write(r.stdout)

	body = "\n".join(l for l in r.stdout.splitlines()
	                  if not l.lstrip().startswith("#"))
	check("rm -rf" not in body, "the ejected build still has an rm -rf")
	check("*" not in body.split("clean:")[-1],
	      f"the clean target has a wildcard: {body.split('clean:')[-1][:200]}")

	check(_run_in(t.dir, "make").returncode == 0, "the ejected build failed")
	prog = os.path.basename(t.dir)
	objs = os.path.join(t.dir, "build")
	check(os.path.isdir(objs), "no object directory was made")
	check(_run_in(t.dir, "make", "clean").returncode == 0, "clean failed")
	check(not os.path.exists(os.path.join(t.dir, prog)),
	      "clean left the program behind")
	left = [f for _d, _s, fs in os.walk(objs) for f in fs]
	check(not left, f"clean left objects behind: {left[:4]}")

	# And an overridden BUILD_DIR can no longer reach anything: it names files
	# under a path that does not exist rather than removing a directory.
	check(t.fmake().returncode == 0, "rebuild for the abuse check failed")
	dry = _run_in(t.dir, "make", "-n", "clean", "BUILD_DIR=/")
	check("rm -rf" not in dry.stdout, f"still an rm -rf: {dry.stdout}")
	check(dry.stdout.strip().startswith("rm -f "),
	      f"clean should be a named rm -f: {dry.stdout[:120]}")


@case
def a_case_reading_make_output_is_not_a_sub_make(t):
	"""The case above failed under `make check` and passed on its own.

	`make` exports MAKEFLAGS to everything it starts, so the suite's own
	`make` runs inherited `-w` from whichever make launched the suite and
	printed "Entering directory" ahead of the recipe. A case reading stdout
	for `rm -f` got that instead.

	This guards the scrubbing directly rather than through a build, so it
	fails when `_run_in` stops stripping the variables no matter how the
	suite was started -- the bug's own reproduction only fails when the
	suite happens to be run from make, which is what let it through."""
	if not shutil.which("make"):
		raise Skip("make not installed")
	t.write("Makefile", "clean:\n\trm -f nothing\n")
	saved = os.environ.get("MAKEFLAGS")
	os.environ["MAKEFLAGS"] = "w"
	try:
		out = _run_in(t.dir, "make", "-n", "clean").stdout
	finally:
		if saved is None:
			os.environ.pop("MAKEFLAGS", None)
		else:
			os.environ["MAKEFLAGS"] = saved
	check("Entering directory" not in out,
	      f"the outer make's -w leaked into a case: {out[:120]}")
	check(out.strip() == "rm -f nothing", f"unexpected recipe: {out[:120]}")


@case
def explain_always_separates_a_name_from_its_message(t):
	"""A generated moc path is longer than the report's column.

	`:<{W}}` stops padding when it overflows, so the filename and its
	explanation run together with no space at all. On a Qt tree that is most
	of the report -- one project counted 547 such lines -- and it is the
	output fmake is judged by."""
	_need_qt()
	t.write("a_rather_long_widget_name_for_the_column.h", """
#pragma once
#include <QObject>
class LongNamedWidget : public QObject {
	Q_OBJECT
public:
	void bump() { emit changed(1); }
signals:
	void changed(int);
};
""")
	t.write("main.cpp", """
#include <QCoreApplication>
#include "a_rather_long_widget_name_for_the_column.h"
int main(int argc, char **argv) {
	QCoreApplication app(argc, argv);
	LongNamedWidget w;
	w.bump();
	return 0;
}
""")
	r = t.fmake("--explain")
	check(r.returncode == 0, f"explain failed: {r.stderr}")
	glued = [l for l in r.stdout.splitlines()
	         if re.search(r"\S\.(cpp|h|c)(<-|defines|root:|\")", l)]
	check(not glued, f"name and message ran together: {glued[:3]}")


@case
def clean_refuses_a_state_directory_that_is_a_symlink(t):
	"""`--clean` removes a whole directory, which needs the path checked.

	It is the one shape a wholesale removal is allowed to take -- a
	directory the tool created, holding nothing else -- and even then the
	rule is to verify rather than trust, because a clean target eating
	something it should not is always a path that did not hold what everyone
	assumed. A symlinked state directory points at something that is not
	fmake's to remove."""
	t.write("main.c", "int main(void){ return 0; }\n")
	check(t.fmake().returncode == 0, "build failed")

	elsewhere = tempfile.mkdtemp(prefix="fmake-notours-")
	try:
		with open(os.path.join(elsewhere, "keepme"), "w") as fh:
			fh.write("not fmake's\n")
		state = os.path.join(t.dir, ".fmake")
		shutil.rmtree(state)
		os.symlink(elsewhere, state)

		r = t.fmake("--clean")
		out = r.stdout + r.stderr
		check(r.returncode != 0, "it should refuse a symlinked state dir")
		# Not a substring of the word "symlink": without the guard, rmtree
		# raises and the traceback quotes shutil's own source, which
		# contains it -- so that assertion passed on the very crash it was
		# meant to catch. Match fmake's own wording, and require that there
		# was no traceback at all.
		check("Traceback" not in out, f"it crashed rather than refused: {out[:200]}")
		check("refusing to clean" in out, f"it should say it refused: {out[:200]}")
		check(os.path.exists(os.path.join(elsewhere, "keepme")),
		      "it followed the symlink and removed what was behind it")
	finally:
		if os.path.islink(os.path.join(t.dir, ".fmake")):
			os.unlink(os.path.join(t.dir, ".fmake"))
		shutil.rmtree(elsewhere, ignore_errors=True)


@case
def clean_says_how_much_it_removed(t):
	"""A clean target lists what it deletes; a count is the honest form here.

	Naming several hundred cached objects would be noise, but "nothing to
	clean" and "removed 4 files" are different facts and a user acting on
	the wrong one wastes time looking for state that is not there."""
	t.write("main.c", "int main(void){ return 0; }\n")
	check(t.fmake().returncode == 0, "build failed")

	first = t.fmake("--clean")
	check(first.returncode == 0, f"clean failed: {first.stderr}")
	check(re.search(r"removed .*\d+ file", first.stdout),
	      f"it should say how much it removed: {first.stdout}")

	again = t.fmake("--clean")
	check("nothing to clean" in again.stdout,
	      f"a second clean has nothing to do: {again.stdout}")


@case
def a_subdirectory_qualified_include_resolves(t):
	"""`#include "model/profile.h"` from a source root needs -Isrc.

	fmake added an -I for every directory that *contains* sources, which is
	the obvious answer and useless here: the file is in src/model, so
	-Isrc/model is what got added, and the include is written relative to
	src. Ordinary C++, and one project lost 84 files to it in a single
	build -- every one a plain missing include, so the cause was one compile
	away and the fix was not.

	The directory now comes from the include text: whatever is left of the
	resolved path once the include name is taken off the end. For a bare
	`#include "profile.h"` that is still the containing directory."""
	t.write("src/model/profile.h", "#pragma once\nint profile_id(void);\n")
	t.write("src/model/session.h",
	        '#pragma once\n#include "model/profile.h"\nint session_open(void);\n')
	t.write("src/model/session.cpp",
	        '#include "model/session.h"\n'
	        "int profile_id(void){ return 3; }\n"
	        "int session_open(void){ return profile_id(); }\n")
	t.write("src/ui/theme.h",
	        '#pragma once\n#include "model/session.h"\nint theme_id(void);\n')
	t.write("src/ui/theme.cpp",
	        '#include "ui/theme.h"\nint theme_id(void){ return session_open(); }\n')
	t.write("src/main.cpp",
	        '#include "ui/theme.h"\nint main(void){ return theme_id() == 3 ? 0 : 1; }\n')

	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	check(t.run(os.path.basename(t.dir)).returncode == 0, "the program failed")

	flags = t.fmake("-B", "-n").stdout
	check(re.search(r"-I\S*/src(\s|$)", flags),
	      f"the source root should be on the include path: {flags[:300]}")


def _optional_feature(t, guard):
	"""A feature behind a macro the build system would have defined.

	zlib because it is the one system library with a pkg-config file that
	every machine running this suite already has; the shape is hydra's
	keyring integration, not anything about compression.
	"""
	if not _have_pkg("zlib"):
		raise Skip("zlib has no pkg-config file here")
	t.write("main.c",
	        "#include <stdio.h>\n"
	        + (f"#ifdef {guard}\n" if guard else "")
	        + "#include <zlib.h>\n"
	        + ("#endif\n" if guard else "")
	        + "int main(void){\n"
	        + (f"#ifdef {guard}\n\tprintf(\"%s\\n\", zlibVersion());\n#endif\n"
	           if guard else "\tprintf(\"none\\n\");\n")
	        + "\treturn 0;\n}\n")


@case
def a_feature_compiled_away_is_not_silent(t):
	"""The step where every part is right and the answer is wrong.

	hydra: a file guarded top to bottom by a macro CMake defines after
	pkg_check_modules finds the library. fmake did not know the macro, so
	the body vanished, so no symbol needed the library, so it correctly
	declined to link it -- and the result was a browser with no keyring
	integration, built without a warning. Their verdict was that this is
	worse than refusing.

	The depfile settles it exactly. `-MD` lists every file the preprocessor
	opened, so a header the scan saw and the compiler never read was inside
	a conditional that was false."""
	_optional_feature(t, "HAVE_ZLIB")

	r = t.fmake()
	check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")
	out = r.stdout + r.stderr
	# The whole phrase, not the word: this case's own name reaches the
	# output as the scratch directory, and a bare "conditional" matched it.
	# section 38 in the harmless direction, which is the only reason it was cheap.
	check("the preprocessor did not take" in out,
	      f"a feature compiled away should be reported: {out}")


@case
def a_compiled_away_header_with_no_package_is_still_reported(t):
	"""The gap the hydra trial found in the report that fixed hydra.

	section 40 keyed the finding on a *proposal*, and a proposal comes from
	pkg-config attributing a header to a module. A package whose headers sit
	in a default include directory emits no `-I`, so nothing attributes it,
	so nothing was proposed and nothing was said. Three of hydra's five
	optional features were that shape -- libtorrent, lz4, libsodium -- and
	the browser was built without any of them while the diagnostic that
	exists for exactly this stayed quiet.

	`dlfcn.h` is the stand-in because no `.pc` file claims it and every
	machine that can run this suite has it. Using a header pkg-config *can*
	attribute tests the old path and passes either way, which is how the
	first version of this case was written."""
	t.write("main.c", "#include <stdio.h>\n"
	        "#ifdef HAVE_DL\n#include <dlfcn.h>\n#endif\n"
	        'int main(void){ puts("built"); return 0; }\n')

	out = t.fmake().stdout + t.fmake().stderr
	check("dlfcn.h" in out and "on this machine" in out,
	      f"a compiled-away header with no package should still be "
	      f"reported: {out}")


@case
def a_header_this_machine_does_not_have_is_not_reported(t):
	"""Existence is what keeps the new half quiet.

	`#ifdef _WIN32` guarding `<windows.h>` is the commonest conditional
	include there is, and here the header is simply absent -- nothing was
	lost, so there is nothing to say. Without the existence check every
	portable C file in the world produces a warning, and the feature becomes
	noise on first contact with real code."""
	t.write("main.c", "#include <stdio.h>\n"
	        "#ifdef _WIN32\n#include <fmake_no_such_platform_header.h>\n"
	        "#endif\n"
	        'int main(void){ puts("built"); return 0; }\n')

	out = t.fmake().stdout + t.fmake().stderr
	check("the preprocessor did not take" not in out,
	      f"an absent header is not a lost feature: {out}")


@case
def one_line_per_file_not_per_include(t):
	"""hydra's guarded block opens with fourteen headers from one package,
	and fourteen lines saying the same thing is how a real finding gets
	skimmed past."""
	t.write("main.c", "#include <stdio.h>\n#ifdef HAVE_DL\n"
	        "#include <dlfcn.h>\n#include <fcntl.h>\n#endif\n"
	        'int main(void){ puts("built"); return 0; }\n')

	out = t.fmake().stdout + t.fmake().stderr
	hits = [l for l in out.splitlines()
	        if "the preprocessor did not take" in l]
	check(len(hits) == 1, f"one file, one line: {hits}")
	check("1 other header" in hits[0],
	      f"and it should say how many it stands for: {hits[0]}")


@case
def a_projects_own_header_behind_a_conditional_is_not_a_lost_feature(t):
	"""Only `<>` includes are read this way, and the distinction is the
	whole point of the report.

	A missing feature is a package this machine has and the build did not
	use. `#ifdef DEBUG` guarding `"debug_helpers.h"` is the project's own
	code deciding about itself, and there is no package, no dependency and
	nothing lost -- reporting it would put a warning on every debug-guarded
	include in every tree."""
