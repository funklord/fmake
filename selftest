signals:
    void pinged(int v);
}};
int check_{d}() {{
    {cls} x;
    int seen = -1;
    QObject::connect(&x, &{cls}::pinged, [&](int v){{ seen = v; }});
    x.ping();
    return seen;
}}
#include "local.moc"
""")
    t.write("main.cpp", """
#include <QCoreApplication>
int check_a(); int check_b();
int main(int argc, char **argv) {
