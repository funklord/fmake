# ---------------------------------------------------------------------------

def main(argv):
    global KEEP
    pats = [a for a in argv if not a.startswith("-")]
    KEEP = "-k" in argv

    if not os.access(FMAKE, os.X_OK):
        print(f"{RED}fmake is not executable at {FMAKE}{OFF}")
        return 2

    cases = [c for c in CASES
             if not pats or any(p in c.__name__ for p in pats)]
    failures = skipped = 0
    for c in cases:
        t = Tree(c.__name__)
        try:
            c(t)
            print(f"{GREEN}ok{OFF}   {c.__name__}")
        except Skip as exc:
            skipped += 1
            print(f"{DIM}skip {c.__name__} -- {exc}{OFF}")
        except Failure as exc:
            failures += 1
            print(f"{RED}FAIL{OFF} {c.__name__}")
            print(f"       {exc}")
            if KEEP:
                print(f"       {DIM}tree: {t.dir}{OFF}")
        except Exception as exc:                       # noqa: BLE001
            failures += 1
            print(f"{RED}ERR {OFF} {c.__name__}: {exc!r}")
        finally:
            t.cleanup()

    print()
    tail = f" ({skipped} skipped)" if skipped else ""
    if failures:
        print(f"{RED}{failures} of {len(cases)} failed{OFF}{tail}")
    else:
        print(f"{GREEN}all {len(cases) - skipped} passed{OFF}{tail}")
    return 1 if failures else 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
