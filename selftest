@case
def moc_ignores_a_class_the_preprocessor_never_reaches(t):
    """The scan sees Q_OBJECT behind #if 0; moc correctly does not.

    Told to write to a real path moc creates the file and leaves it empty,
    so treating absence as the signal is not enough -- an empty translation
    unit would otherwise be compiled and reported for the life of the tree,
    and re-mocked on every build for want of a remembered negative."""
    _need_qt()
    t.write("ghost.h", """
#pragma once
#include <QObject>
#if 0
class Ghost : public QObject { Q_OBJECT };
#endif
int helper();
""")
    t.write("ghost.cpp", '#include "ghost.h"\nint helper(){ return 3; }\n')
    t.write("main.cpp", """
#include <QCoreApplication>
#include "ghost.h"
int main(int argc, char **argv) {
    QCoreApplication app(argc, argv);
    return helper() == 3 ? 0 : 1;
}
""")
