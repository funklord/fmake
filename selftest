	"""A .a in the tree satisfies the closure like any object.

    Also the only test the link *order* needs: an archive is searched only
    for what is undefined at the point the linker reaches it, so one placed
    before the objects contributes nothing at all and this fails to link.
    """
	_vendor(t, "vendor/libhelper.a", "helper",
	        "int helper(void){ return 42; }\n")
	t.write("main.c", """
#include <stdio.h>
int helper(void);
int main(void){ printf("%d\\n", helper()); return helper() == 42 ? 0 : 1; }
""")
	r = t.fmake()
