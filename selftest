	os.symlink("..", os.path.join(t.dir, "loop", "up"))

	r = t.fmake()
	check(r.returncode == 0,
	      f"none of these should stop the build: {r.stdout}{r.stderr}")
	check("Traceback" not in r.stderr, f"crashed: {r.stderr}")
	check("dangling.c" in r.stdout,
	      f"the dangling symlink should be reported: {r.stdout}")
	check(t.run(os.path.basename(t.dir)).stdout == "ok\n", "wrong output")


@case
def an_unreadable_source_is_set_aside(t):
	"""One stray file nobody can read should not stop a tree building.

    And if it was actually needed, the closure says so in its own terms --
    an undefined symbol naming what is missing, alongside the warning about
    the file, rather than a traceback naming a file nobody asked about."""
	if os.geteuid() == 0:
		raise Skip("running as root, so permissions prove nothing")

	t.write("main.c", '#include <stdio.h>\nint main(void){ puts("hi"); return 0; }\n')
	stray = t.write("stray.c", "int unrelated(void){ return 1; }\n")
	os.chmod(stray, 0)
	try:
		r = t.fmake()
		check(r.returncode == 0,
		      f"an unreadable file nothing needs should not be fatal: "
		      f"{r.stdout}{r.stderr}")
		check("unreadable" in r.stdout,
		      f"it should still be reported: {r.stdout}")
		check(t.run(os.path.basename(t.dir)).stdout == "hi\n", "wrong output")
	finally:
		os.chmod(stray, 0o644)

	# Now one that is needed.
	t.write("main.c", "int needed(void);\nint main(void){ return needed(); }\n")
	dep = t.write("needed.c", "int needed(void){ return 0; }\n")
	os.chmod(dep, 0)
	try:
		shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
		r = t.fmake()
		check(r.returncode != 0, "the build cannot succeed without it")
		check("unreadable" in r.stdout, "the cause should be named")
		check("needed" in r.stdout, "the missing symbol should be named")
	finally:
		os.chmod(dep, 0o644)


