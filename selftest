@case
def a_library_the_code_does_not_call_is_a_different_finding(t):
	"""And must not be reported as the one above.

	An include the preprocessor did read, whose library no symbol needs, is
	section 3 working -- the symbol evidence disagreed with the include and won.
	Warning about it would put a warning on correct builds, which is how a
