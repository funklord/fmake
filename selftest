@case
def conf_splits_two_libraries_from_one_tree(t):
    """The seam @kind could not reach.

    Two archives sharing a file. Nothing in the source says which library a
    shared file belongs to, because that is a fact about the project rather
    than about any file in it -- so the closure must not be consulted, and
    declared membership is the answer rather than a starting point."""
    t.write("src/shared.c", "int shared_helper(int x){ return x * 2; }\n")
    t.write("src/alpha.c", "int shared_helper(int);\n"
            "int alpha_go(int x){ return shared_helper(x) + 1; }\n")
    t.write("src/beta.c", "int shared_helper(int);\n"
            "int beta_go(int x){ return shared_helper(x) + 2; }\n")
    t.write("fmake.toml", """
[target.alpha]
kind    = "static"
sources = ["src/alpha.c", "src/shared.c"]

[target.beta]
kind    = "static"
sources = ["src/beta.c", "src/shared.c"]
""")
    r = t.fmake()
    check(r.returncode == 0, f"build failed: {r.stdout}{r.stderr}")

    def syms(archive):
        out = subprocess.run(["nm", "--format=posix",
                              os.path.join(t.dir, archive)],
                             capture_output=True, text=True).stdout
        return {l.split()[0] for l in out.splitlines()
                if len(l.split()) > 1 and l.split()[1] == "T"}

    a, b = syms("libalpha.a"), syms("libbeta.a")
    check("alpha_go" in a and "beta_go" not in a, f"libalpha.a holds {a}")
    check("beta_go" in b and "alpha_go" not in b, f"libbeta.a holds {b}")
    check("shared_helper" in a and "shared_helper" in b,
          "the shared file belongs to both")


