def an_unreadable_source_is_set_aside(t):
    """One stray file nobody can read should not stop a tree building.

    And if it was actually needed, the closure says so in its own terms --
    an undefined symbol naming what is missing, alongside the warning about
    the file, rather than a traceback naming a file nobody asked about."""
    if os.geteuid() == 0:
        raise Skip("running as root, so permissions prove nothing")

    t.write("main.c", '#include <stdio.h>\nint main(void){ puts("hi"); return 0; }\n')
    stray = t.write("stray.c", "int unrelated(void){ return 1; }\n")
    os.chmod(stray, 0)
