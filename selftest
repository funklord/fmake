def _eject_tree(t):
    """A tree whose build fails unless the emitted flags are really applied.

    The header is in a subdirectory reachable only via -I, and the program
    prints a value that only a @define supplies -- so a build file that
    silently loses its flags does not compile, rather than quietly working.
    """
    t.write("include/dep.h", "int dep_value(void);\n")
    t.write("src/dep.c", '#include "dep.h"\nint dep_value(void){ return 20; }\n')
    t.write("src/main.c", """
/*! @file
 *  @target ejected
 *  @define BONUS=22
 */
#include <stdio.h>
#include "dep.h"
int main(void){ printf("%d\\n", dep_value() + BONUS); return 0; }
""")
    t.write("fmake.toml", '[project]\ninclude-dirs = ["include"]\n')


def _run_in(cwd, *cmd):
    return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)


@case
def eject_make_builds_without_fmake(t):
    """The exit has to work, and exercising it checks the model twice.

    A second implementation, sharing no code with the builder, producing
    working binaries from the same link sets and flags."""
    if not shutil.which("make"):
        raise Skip("make not installed")
    _eject_tree(t)

    r = t.fmake("--eject")
    check(r.returncode == 0, f"eject failed: {r.stderr}")
    with open(os.path.join(t.dir, "Makefile"), "w") as fh:
        fh.write(r.stdout)

    # Build it with fmake first, so the two can be compared rather than
    # just checked for not crashing.
    check(t.fmake().returncode == 0, "fmake's own build failed")
    _nm = subprocess.run(["nm", "--format=posix",
                          os.path.join(t.dir, "ejected")],
                         capture_output=True, text=True)
    fmake_symbols = sorted(l.split()[0] + " " + l.split()[1]
                           for l in _nm.stdout.splitlines()
                           if len(l.split()) > 1)

    # fmake's own state goes away, so nothing it built can be mistaken for
    # something make built.
    shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
    for f in os.listdir(t.dir):
        if f == "ejected":
            os.remove(os.path.join(t.dir, f))

    m = _run_in(t.dir, "make")
    check(m.returncode == 0, f"make failed: {m.stdout}{m.stderr}")
    out = _run_in(t.dir, "./ejected").stdout
    check(out == "42\n",
          f"the ejected build lost its flags or its link set: {out!r}")

    # Equivalence, not merely "it works": the same link set and the same
    # flags should produce the same symbols.
    def symbols(path):
        r = subprocess.run(["nm", "--format=posix", path],
                           capture_output=True, text=True)
        return sorted(l.split()[0] + " " + l.split()[1]
                      for l in r.stdout.splitlines() if len(l.split()) > 1)
    check(symbols(os.path.join(t.dir, "ejected")) == fmake_symbols,
          "the ejected binary does not match the one fmake built")

    # A second make must do nothing: the depfiles have to be wired up.
    again = _run_in(t.dir, "make")
    check("Nothing to be done" in again.stdout or not again.stdout.strip()
          or "up to date" in again.stdout,
          f"the ejected build is not incremental: {again.stdout!r}")

    c = _run_in(t.dir, "make", "clean")
    check(c.returncode == 0, f"make clean failed: {c.stderr}")
    check(not os.path.exists(os.path.join(t.dir, "ejected")),
          "clean should remove the artifacts")


