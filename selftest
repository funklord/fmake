@case
def objects_are_not_shared_between_configurations(t):
	"""netcfgd asked whether fmake keys its object cache on flags, and said
	that if it does not, it is "a stale-object bug waiting in every project
	that switches compilers or adds a sanitizer".

	They have the incident: `make SANITIZE=1 test` followed by a plain build
	elsewhere linked a sanitized archive into a binary with no sanitizer
	runtime, and it surfaced as forty lines of `__asan_report_store1` at
	link time with no clue why. Their Makefile grew a `.build-flags` stamp
	file that every object depends on, because changing a flag is not
	changing a source file and nothing in the tree records that it happened.

	fmake keys the object directory on the whole configuration, so this is
	answered by construction -- but it was never asserted, and a guarantee
	worth documenting is worth a case. The existing --cflags case wipes
	.fmake between builds, which is exactly the thing that must not be
	necessary."""
	t.write("main.c", "#include <stdio.h>\nint main(void){\n"
	        "#ifdef FEATURE\n\tputs(\"with feature\");\n"
	        "#else\n\tputs(\"without feature\");\n#endif\n"
	        "\treturn 0;\n}\n")
	prog = os.path.basename(t.dir)

	check(t.fmake().returncode == 0, "first build failed")
	check(t.run(prog).stdout == "without feature\n", "wrong first build")
	# No wipe between any of these. That is the whole point.
	check(t.fmake("--cflags", "-DFEATURE").returncode == 0, "second failed")
	check(t.run(prog).stdout == "with feature\n",
	      "a changed flag must not reuse objects built without it")
	check(t.fmake().returncode == 0, "third build failed")
	check(t.run(prog).stdout == "without feature\n",
	      "going back must not reuse the objects built with the flag")

	objdirs = os.path.join(t.dir, ".fmake", "obj")
	kept = [d for d in os.listdir(objdirs)
	        if os.path.isdir(os.path.join(objdirs, d))]
	check(len(kept) >= 2,
	      f"each configuration needs its own object directory: {kept}")

	# Two *different* --cflags, which is the probe that actually tests the
	# override. Passing --cflags at all replaces the default flags, so a
	# plain build and a --cflags build differ in the key for that reason
	# alone -- the check above passes even with the override left out of it.
	# Mutation found that; the first version of this case was weaker than it
	# looked.
	t.write("main.c", "#include <stdio.h>\nint main(void){\n"
	        "#ifdef A\n\tputs(\"A\");\n#elif defined(B)\n\tputs(\"B\");\n"
	        "#else\n\tputs(\"neither\");\n#endif\n\treturn 0;\n}\n")
	check(t.fmake("--cflags", "-DA").returncode == 0, "-DA build failed")
	check(t.run(prog).stdout == "A\n", "wrong -DA build")
	check(t.fmake("--cflags", "-DB").returncode == 0, "-DB build failed")
	check(t.run(prog).stdout == "B\n",
	      "two different --cflags must not share objects")

	# And the same for flags that came from the config file rather than the
	# command line. These are a different field, reached by a different
	# route, and with --cflags in play on both sides of the check above they
	# are not exercised at all -- mutation again.
	t.write("fmake.toml", '[project]\ncflags = ["-DA"]\n')
	check(t.fmake().returncode == 0, "[project] cflags build failed")
	check(t.run(prog).stdout == "A\n", "wrong [project] cflags build")
	t.write("fmake.toml", '[project]\ncflags = ["-DB"]\n')
	check(t.fmake().returncode == 0, "changed [project] cflags failed")
	check(t.run(prog).stdout == "B\n",
	      "editing [project] cflags must not reuse the old objects")

	# The compiler is part of the identity too, and the name is the part a
	# machine with one compiler can still check: cc and gcc are the same
	# binary here and two different answers to "what built this". A wrapper
	# under a different name is not obliged to behave the same way.
	os.unlink(os.path.join(t.dir, "fmake.toml"))
	def objdir_set():
		return {d for d in os.listdir(objdirs)
		        if os.path.isdir(os.path.join(objdirs, d))}
	if shutil.which("gcc") and shutil.which("cc"):
		check(t.fmake(env={"CC": "cc"}).returncode == 0, "CC=cc failed")
		before = objdir_set()
		check(t.fmake(env={"CC": "gcc"}).returncode == 0, "CC=gcc failed")
		check(objdir_set() - before,
		      "a different compiler must not share objects")


@case
def a_sanitizer_does_not_survive_being_turned_off(t):
	"""The same guarantee at the size it actually bit somebody.

	A binary carrying instrumented objects and no sanitizer runtime is the
	failure netcfgd hit, and it is invisible until the link."""
	t.write("main.c", "int main(void){ int a[4]; a[0] = 1; return a[0] - 1; }\n")
	prog = os.path.basename(t.dir)

	r = t.fmake("--cflags", "-fsanitize=address",
	            "--ldflags", "-fsanitize=address")
	if r.returncode != 0:
		raise Skip("no address sanitizer in this toolchain")
	syms = subprocess.run(["nm", os.path.join(t.dir, prog)],
	                      capture_output=True, text=True).stdout
	check("__asan" in syms, "the sanitized build is not instrumented")

	check(t.fmake().returncode == 0, "plain rebuild failed")
	syms = subprocess.run(["nm", os.path.join(t.dir, prog)],
	                      capture_output=True, text=True).stdout
	check("__asan" not in syms,
	      "instrumented objects survived into a plain build")


@case
def relinking_follows_the_command_not_just_mtimes(t):
	"""Object mtimes miss every change that is not a recompile.

    A different library resolved, a --wrap added, an explicit --ldflags: none
    of them touch an object, so a staleness rule built on object timestamps
    leaves the binary exactly as it was and reports success."""
	t.write("main.c", '#include <stdio.h>\nint main(void){ puts("hi"); return 0; }\n')
	prog = os.path.join(t.dir, os.path.basename(t.dir))

	check(t.fmake().returncode == 0, "first build failed")

	def has_build_id():
		out = subprocess.run(["readelf", "-n", prog],
		                     capture_output=True, text=True).stdout
		return "Build ID" in out

	if not has_build_id():
		raise Skip("this toolchain does not emit a build id")

	r = t.fmake("--ldflags", "-Wl,--build-id=none")
	check(r.returncode == 0, f"relink failed: {r.stdout}{r.stderr}")
	check(not has_build_id(),
	      "the link flag was ignored: the binary was not relinked")

	# and an unchanged command must still be a no-op
	r = t.fmake("--ldflags", "-Wl,--build-id=none")
	check("built" not in r.stdout,
	      f"nothing changed, so nothing should relink: {r.stdout}")


@case
def a_library_will_not_hold_two_definitions(t):
	"""section 3 refuses to guess for programs; a library is not exempt.

    `ar` resolves duplicate members by order, silently, and the consumer
    inherits the coin flip with no way to see where it came from."""
	t.write("impl_a.c", "int compute(void){ return 1; }\n")
	t.write("impl_b.c", "int compute(void){ return 2; }\n")
	t.write("util.c", "int helper(void){ return 0; }\n")

	r = t.fmake()
	check(r.returncode != 0, "two definitions should be refused")
	check("impl_a.c" in r.stderr and "impl_b.c" in r.stderr,
	      f"both should be named: {r.stderr}")

	# and the documented escape still works
	t.write("impl_b.c", "//! @os windows\nint compute(void){ return 2; }\n")
	shutil.rmtree(os.path.join(t.dir, ".fmake"), ignore_errors=True)
	r = t.fmake()
	check(r.returncode == 0, f"@os should settle it: {r.stdout}{r.stderr}")
	archive = [f for f in os.listdir(t.dir) if f.endswith(".a")]
	check(len(archive) == 1, f"expected an archive: {os.listdir(t.dir)}")
	syms = subprocess.run(["nm", "--format=posix",
	                       os.path.join(t.dir, archive[0])],
	                      capture_output=True, text=True).stdout
	check(syms.count("compute T") == 1,
	      f"the archive should hold one definition: {syms}")


@case
def explain_shows_the_command_that_runs(t):
	"""A drifted --explain is worse than none.

    Principle 4 is that every decision is inspectable, which is only true if
    what is shown is what is executed -- so both come from one function."""
	# Something that resolves a library, or the two renderings agree
	# trivially and the case proves nothing.
	t.write("main.c", """
#include <stdio.h>
#include <stdlib.h>
#include <math.h>
int main(int argc, char **argv){
    printf("%f\\n", lgamma(argc > 1 ? atof(argv[1]) : 3.0));
    return 0;
}
""")
	shown = [l.strip() for l in t.fmake("--explain").stdout.splitlines()
	         if l.strip().startswith(("cc -o", "c++ -o"))]
	check(shown, "no link command in --explain")
	check("-lm" in shown[-1],
	      f"the resolved library should appear: {shown[-1]}")

	# The strongest form of the claim: run exactly what was shown, from the
	# project root, and require a working binary out of it. --explain
	# compiles but does not link, so there is nothing there yet to be
	# mistaken for the result.
	prog = os.path.join(t.dir, os.path.basename(t.dir))
	check(not os.path.exists(prog), "--explain should not have linked")
	r = subprocess.run(shown[-1], shell=True, cwd=t.dir,
	                   capture_output=True, text=True)
	check(r.returncode == 0,
	      f"the command --explain printed does not work: {r.stderr}")
	out = _run_in(t.dir, "./" + os.path.basename(t.dir), "5").stdout
	check(out.startswith("3.17"),
	      f"the binary built from the shown command is wrong: {out!r}")


