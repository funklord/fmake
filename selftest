	      "a consumer under tests/ is not in the default build")
	r = t.fmake("test")
	check(r.returncode == 0, f"fmake test failed: {r.stdout}{r.stderr}")
	check(t.run("client_test").stdout == "1\n",
	      "the consumer should still build and run")


