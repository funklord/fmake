# Build
# ---------------------------------------------------------------------------

def build(args, _bootstrapping=False):
	root = os.path.abspath(args.directory)
	if not os.path.isdir(root):
		die(f"no such directory: {args.directory}")

	state  = os.path.join(root, STATE_DIR)
	cache  = Cache(os.path.join(state, CACHE_FILE))
	conf   = Conf(load_conf(root), args.profile)
	# fmake.mk may carry project-scope directives beside its rules. They fold
	# into [project], so the two files say the same things the same way and
	# a project needing both a rule and a flag needs only one of them.
	for name, args_ in mk_directives(root).items():
		key = {"define": "define"}.get(name, name)
		conf.project[key] = list(conf.project.get(key, [])) + args_
		if name == "std" and args_:
			conf.project["std"] = args_[-1]
	if getattr(args, "use_build_toolchain", False):
		# A tool built to run here is a separate build for a separate
		# machine, so it takes none of the target's flags. Inheriting them
		# is not a small inaccuracy: -march=armv8-a, or a --sysroot pointing
		# at the target's filesystem, simply will not compile here.
		bt = conf.build_tool_conf
		conf.tool = bt
		conf.project = {k: v for k, v in bt.items()
		                if k in ("cflags", "defines", "std")}
		conf.profile = {}
	cfg    = Config(args, conf)
	# Built here rather than where the -I flags are worked out, because moc
	# has to run before the tree is complete and it is pkg-config that knows
	# where moc lives.
	pkg    = PkgConfig(cfg.pkgexe, cfg.sysroot, cfg.triplet)
	outdir = os.path.abspath(args.output) if args.output else root
	if args.run and not args.output:
		# Nothing appears beside the script. The answer to "does it clean
		# up" is that it never dirties: the binary and its objects live
		# under the state directory, which is also what makes the second
		# run of a script instant rather than a rebuild.
		outdir = os.path.join(root, RUN_DIR)
		os.makedirs(outdir, exist_ok=True)
	jobs   = args.jobs or (os.cpu_count() or 4)

	bootstrapped = []

	def build_tool(name):
		"""Build a target from this tree so a generator can run it.

        A nested build restricted to that one target, into a scratch
        directory. The tool is an ordinary program as far as fmake is
        concerned -- closure, libraries and all -- it just happens to be
        built first and consumed rather than shipped.
        """
		if _bootstrapping:
			die(f"{CONF_FILE}: [generate.*] uses = {name!r}, but that is "
			    f"itself being built to run a generator. A tool cannot "
			    f"depend on its own output.")
		tooldir = os.path.join(state, "tools")
		os.makedirs(tooldir, exist_ok=True)
		sub = argparse.Namespace(**vars(args))
		sub.targets, sub.output = [name], tooldir
		sub.explain = sub.install = False
		sub.eject, sub.dry_run = None, False
		sub.quiet = not VERBOSE
		# A generator runs here, on the machine doing the building, so it must
		# not be compiled with the toolchain aimed at the target. That is what
		# [build-toolchain] is for, and without it a cross build would produce
		# a tool it cannot execute.
		sub.use_build_toolchain = True
		sub.cflags, sub.ldflags = [], []
		say(f"{YELLOW('TOOL')} {name}")
		bootstrapped.append(name)
		if build(sub, _bootstrapping=True) != 0:
			die(f"could not build {name!r}, which a generator needs")
		for cand in (name, f"lib{name}.so", f"lib{name}.a"):
			path = os.path.join(tooldir, cand)
			if not os.path.exists(path):
				continue
			# Checked rather than inferred: whatever came out has to run on
			# this machine, whatever anyone declared.
			want, got = host_elf_machine(), elf_identity(path)
			if want is not None and got is not None and got[2] != want:
				die(f"{name!r} was built for {describe_identity(got)} and "
				    f"cannot run here.\nA generator runs on the build "
				    f"machine, so give it a [build-toolchain] in "
				    f"{CONF_FILE}.")
			return path
		die(f"built {name!r} but found no artifact in {_rel(tooldir, root)}")

	# Generators run before anything looks at the tree, so their output is
	# an ordinary source from here on -- seen by the include graph, the
	# closure and the symbol tables alike, with no special case anywhere.
	# A file that cannot be read is set aside rather than fatal. One
	# unreadable stray in a directory should not stop a tree from building,
	# and if it was actually needed the closure says so in its own terms --
	# an undefined symbol naming what is missing, rather than a traceback
	# naming a file nobody asked about.
	scans, unreadable = {}, {}

	def scan_all(files):
		for rel in files:
			if rel in scans or rel in unreadable:
				continue
			try:
				scans[rel] = cache.scan(os.path.join(root, rel), rel)
			except OSError as exc:
				unreadable[rel] = f"unreadable: {exc.strerror or exc}"

	# Scanned before generating, because @rule lives in a comment and cannot
	# be read any other way -- and again afterwards, because generating adds
	# files nobody has looked at. The two-pass scan section 7 once said was
	# unnecessary turns out to be exactly what putting rules in comments
	# costs.
	srcs, hdrs = walk_tree(root)
	if args.run:
		# Staged like a generated source, and for the same reason: from
		# here on it is an ordinary source that the include graph, the
		# closure and the symbol tables see with no special case.
		run_rel = stage_run_source(root, args.run,
		                           alone=not args.run_with_siblings)
		if run_rel not in srcs:
			srcs.append(rel_ := run_rel)
			srcs.sort()
		# The original carries the shebang the copy exists to remove, so it
		# must not also be compiled -- two mains, and one of them will not
		# parse.
		original = os.path.relpath(os.path.abspath(args.run), root)
		if run_rel != original and original in srcs:
			srcs.remove(original)
		args.targets = [default_name(run_rel, root)]
	scan_all(srcs + hdrs)

	generated = run_generators(root, conf, cache, args.dry_run,
	                           None if _bootstrapping else build_tool,
	                           [r for r in srcs if r in scans], scans)
	if bootstrapped:
		# A nested build wrote object entries to the same cache file. Merge
		# them in rather than replacing this cache, which still holds the
		# generator freshness keys that were just written and are not on
		# disk yet.
		disk = Cache(os.path.join(state, CACHE_FILE))
		for section in ("files", "objects"):
			merged = dict(disk.data.get(section, {}))
			merged.update(cache.data.get(section, {}))
			cache.data[section] = merged
		cache.files = cache.data["files"]
		cache.objects = cache.data["objects"]

	if generated:
		srcs, hdrs = walk_tree(root)
		for rel in generated:
			ext = os.path.splitext(rel)[1]
			if ext in SRC_EXTS and rel not in srcs:
				srcs.append(rel)
			elif ext in HDR_EXTS and rel not in hdrs:
				hdrs.append(rel)
		srcs.sort()
		hdrs.sort()
		scan_all(srcs + hdrs)

	gen_dirs = sorted({os.path.dirname(g) for g in generated
	                   if os.path.splitext(g)[1] in HDR_EXTS})
	if not srcs:
		die("no C or C++ source files found here")

	for rel in list(unreadable):
		if rel in srcs:
			srcs.remove(rel)
		elif rel in hdrs:
			hdrs.remove(rel)
	if unreadable:
		for rel, why in sorted(unreadable.items())[:5]:
			warn(f"{rel}: {why}")
		if len(unreadable) > 5:
			note(f"... and {len(unreadable) - 5} more")

	# ---- platform filtering -------------------------------------------
	# A TU excluded here never exists as far as the rest of the build is
	# concerned. This is what makes win32_sys.c and posix_sys.c coexist:
	# without it they are two definitions of the same symbol and section 3 refuses
	# to guess, which is the right answer to the wrong question.
	def exclude_pattern(rel):
		"""The [project] exclude pattern matching a path, or None.

        Wanted for headers too, not just sources: an excluded subtree must
        not have its Q_OBJECT classes moc'd or its .ui files generated, or
        the work fmake was told to skip comes back as generated code.
        """
		for pat in conf.project.get("exclude", []):
			if fnmatch.fnmatch(rel, pat) or rel.startswith(pat.rstrip("/*") + "/"):
				return pat
		return None

	excluded = dict(unreadable)
	by_name = []
	for rel in list(srcs):
		pat = exclude_pattern(rel)
		if pat:
			excluded[rel] = f"[project] exclude = {pat!r}"
		else:
			ann = Ann(scans[rel].get("dirs"))
			why = platform_excludes(ann, cfg.os, cfg.arch)
			from_name = False
			if not why:
				why = filename_excludes(rel, ann, cfg.os, cfg.arch)
				from_name = bool(why)
			if not why:
				continue
			excluded[rel] = why
			# Which branch decided, recorded rather than read back out of
			# the sentence. Sniffing the message for "named _" tied the
			# summary to a wording, and rewording it -- which happened one
			# commit later -- silently stopped the summary being printed.
			if from_name:
				by_name.append(rel)
		srcs.remove(rel)
	if not srcs:
		die(f"every source file is excluded when building for "
		    f"{cfg.os}/{cfg.arch}")
	# Said out loud, because a file that stops being compiled is a file
	# whose symbols stop existing, and the link error that follows names
	# neither the file nor the reason. @os or @arch in the file overrides
	# the name if it was wrong.
	if by_name:
		n = len(by_name)
		info(f"{n} source{'' if n == 1 else 's'} named for another platform "
		     f"({', '.join(os.path.basename(r) for r in sorted(by_name)[:3])}"
		     f"{', ...' if n > 3 else ''}) not built for "
		     f"{cfg.os}/{cfg.arch}")

	# Headers under an excluded subtree are excluded too. srcs was filtered
	# above; hdrs is not filtered in place because include resolution may
	# still legitimately reach into such a directory.
	gen_hdrs = [h for h in hdrs if not exclude_pattern(h)]

	# ---- uic ----------------------------------------------------------
	# Before moc, so a widget header that includes its ui_ header is moc'd
	# against the real thing rather than against a missing include. Nothing
	# here depends on that -- moc does not fail on an include it cannot find
	# -- but it costs nothing to be right about the order.
	ui_jobs, ui_outs = [], []
	uic_exe = None
	ui_jobs = uic_plan(srcs + gen_hdrs, hdrs, scans, root)
	if not args.dry_run:
		prune_generated(root, UI_DIR, [j["out"] for j in ui_jobs])
	if ui_jobs:
		uic_exe = find_qt_tool("uic", cfg.uic, pkg)
		if not uic_exe:
			die("this tree includes a ui_*.h header generated from a .ui "
			    "file, which needs Qt's uic.\nInstall the Qt development "
			    f"package, or name it with [toolchain] uic in {CONF_FILE}.")
		ui_outs = run_uic(root, ui_jobs, uic_exe, cache, args.dry_run)
		for rel in ui_outs:
			if rel not in hdrs:
				hdrs.append(rel)
		hdrs.sort()
		scan_all(hdrs)

	# ---- rcc ----------------------------------------------------------
	# A resource registers itself from a static constructor, so nothing in
	# any object refers to the generated one and section 3 alone would always drop
	# it. What the source does say is which resources it opens -- a
	# ":/icons/..." literal, or Q_INIT_RESOURCE naming one outright -- and
	# that is per file, so it survives into a per-program answer rather than
	# linking every resource into every binary.
	qrc_jobs, qrc_outs = [], []
	rcc_exe = None
	qrc_jobs = rcc_plan(srcs + gen_hdrs, scans, root)
	if not args.dry_run:
		prune_generated(root, QRC_DIR, [j["out"] for j in qrc_jobs])
	if qrc_jobs:
		rcc_exe = find_qt_tool("rcc", cfg.rcc, pkg)
		if not rcc_exe:
			die("this tree refers to a Qt resource, which needs Qt's rcc.\n"
			    "Install the Qt development package, or name it with "
			    f"[toolchain] rcc in {CONF_FILE}.")
		qrc_outs = run_rcc(root, qrc_jobs, rcc_exe, cache, args.dry_run)
		for rel in qrc_outs:
			if rel not in srcs:
				srcs.append(rel)
		srcs.sort()
		scan_all(srcs)

	# ---- moc ----------------------------------------------------------
	# After the generators, so a generated header carrying Q_OBJECT is moc'd
	# like any other, and before everything else, so what moc writes is an
	# ordinary source from here on -- seen by the include graph, the closure
	# and the symbol tables with no special case, exactly as section "Generated
	# sources" has it.
	moc_jobs, moc_outs, moc_flags, moc_own = [], [], [], {}
	moc_incflags, src_set = [], set(srcs)
	moc_exe = None
	moc_jobs = moc_plan(srcs, gen_hdrs, scans)
	# Swept before the guard, not inside it: a tree that stops using Qt
	# altogether is exactly the case where every moc output is stale, and a
	# check for Q_OBJECT is the one thing that would skip it.
	if not args.dry_run:
		prune_generated(root, MOC_DIR, [j["out"] for j in moc_jobs])
	if moc_jobs:
		moc_exe = find_qt_tool("moc", cfg.moc, pkg)
		if not moc_exe:
			die("this tree declares Q_OBJECT classes, which need Qt's moc.\n"
			    "Install the Qt development package, or name it with "
			    f"[toolchain] moc in {CONF_FILE}.")
		moc_flags = moc_cflags(root, hdrs, conf)
		moc_outs = run_moc(root, moc_jobs, moc_exe, moc_flags, cache,
		                   args.dry_run)
		done = set(moc_outs)
		for j in moc_jobs:
			if j["out"] not in done:
				continue
			if j["inline"]:
				# An included moc output is text, not a translation unit, and
				# `#include "foo.moc"` is unqualified. Putting its directory
				# on the global include path means two local.cpp in different
				# directories each find whichever .moc sorts first -- so it
				# goes on the include path of the files that actually pull it
				# in, and nowhere else. Per-TU flags are already part of the
				# object's cache key, so this costs nothing extra.
				flag = "-I" + os.path.join(root, os.path.dirname(j["out"]))
				for who in j["includers"]:
					if who in src_set:
						moc_own.setdefault(who, []).append(flag)
					elif flag not in moc_incflags:
						# A header did the including, so every TU reaching it
						# needs the path and there is no one TU to give it
						# to. Rare, and worth being conservative about.
						moc_incflags.append(flag)
			elif j["out"] not in srcs:
				srcs.append(j["out"])
		srcs.sort()
		scan_all(srcs)

	proj = Project(root, srcs, hdrs, scans)

	# ---- targets ------------------------------------------------------
	# A TU roots an artifact if it defines main() or carries @kind. A tree
	# with neither is a library named after its directory, which is the only
	# thing it could sensibly be. fmake.toml can also declare a target that
	# no file roots, and can override anything a file said.
	# A file whose main() the compiler did not agree with, remembered so the
	# disagreement is reported once rather than every build. The scan reads
	# text and cannot evaluate #if, so a main() behind one is seen; the
	# object settles it, and the answer only changes if the file changes or
	# the configuration does. Both are in the stamp. Same shape as moc's
	# negative result for a Q_OBJECT the preprocessor never reaches.
	nomain = cache.data.setdefault("nomain", {})

	def main_stamp(rel):
		"""What the answer depends on: the file, and the configuration.

        Computed in one place because the store and the check have to agree
        exactly -- two copies that drift merely never match, which looks like
        the feature being off rather than broken.
        """
		return sha((cache.hash_of(os.path.join(root, rel), rel) or "?")
		           + cfg.key)

	def main_is_a_mirage(rel):
		return nomain.get(rel) == main_stamp(rel)

	# A main() in a vendored subtree is that project's own program -- its
	# test runner, its fuzzers, its example tools -- and not something this
	# tree asked for. The sources around it usually are: both projects that
	# reported this build a library out of the submodule and want nothing
	# else from it. So the file stops rooting a target and stays in the pool
	# like any other source; `[target.x] root = ...` still builds it for
	# anyone who does want it, which is the only way to ask, and vendored
	# code cannot be annotated by a project that treats it as read-only.
	vendored = vendored_dirs(root, srcs)
	passed_over = []

	targets, claimed = [], set()
	for rel in srcs:
		ann = Ann(scans[rel].get("dirs"))
		if ann.scalar("kind") is None and scans[rel]["has_main"] \
		        and main_is_a_mirage(rel):
			continue
		if scans[rel]["has_main"] and not ann.scalar("kind") \
		        and not ann.scalar("target"):
			owner = vendor_of(rel, vendored)
			if owner:
				passed_over.append((owner, rel))
				continue
		if scans[rel]["has_main"] or ann.scalar("kind"):
			name = ann.scalar("target") or default_name(rel, root)
			t = Target(rel, root, ann, conf.target(name))
			# Both names are spoken for: the one the section was found under,
			# and whatever it renamed the target to. Otherwise a section that
			# renames looks unconsumed and gets built a second time.
			claimed.add(name)
			claimed.add(t.name)
			if t.kind not in KINDS:
				die(f"{rel}: kind {t.kind!r} is not one of "
				    f"{', '.join(KINDS)}")
			if t.kind == "exe" and not scans[rel]["has_main"]:
				die(f"{rel}:{ann.line('kind')}: @kind exe needs a main()")
			targets.append(t)
		elif ann.scalar("target"):
			warn(f"{rel}:{ann.line('target')}: @target on a file that defines "
			     f"no main() and no @kind is ignored")

	# Targets declared only in fmake.toml. These need explicit sources or a
	# root, since nothing in the tree points at them.
	for name in sorted(conf.targets):
		if name in claimed:
			continue
		section = conf.targets[name]
		rel = section.get("root")
		if rel is None:
			if not section.get("sources"):
				# A section is keyed by the target's *default* name, which
				# is not always the directory it came from -- src/main.cpp
				# is called after the project, since `src` names nothing. So
				# [target.src] is the obvious guess and the wrong one, and
				# the message that only says "declares no root" sends the
				# reader to add a root rather than to fix the key.
				found = sorted(t.name for t in targets)
				hint = (f"\nTargets discovered here: {', '.join(found)}. A "
				        f"section is keyed by the name a target already has;"
				        f" `name = ...` inside it renames one."
				        if found else "")
				die(f"{CONF_FILE}: [target.{name}] declares no root and no "
				    f"sources, so fmake cannot tell what is in it{hint}")
			rel = None
		elif rel not in proj.src_set:
			die(f"{CONF_FILE}: [target.{name}] root = {rel!r} is not a "
			    f"source file in this tree")
		t = Target(rel or "", root, Ann(), section)
		t.name = section.get("name", name)
		if not rel:
			# No root: the first named source stands in, so the closure and
			# the link have something concrete to start from.
			hits = _expand_sources(section["sources"], root, proj, name)
			t.rel, t.members = hits[0], hits
		if t.kind not in KINDS:
			die(f"{CONF_FILE}: [target.{name}] kind = {t.kind!r} is not one "
			    f"of {', '.join(KINDS)}")
		targets.append(t)

	# Said once per subtree rather than once per file: libvterm contributes
	# four and miniz ten, and a list of ten is noise where the directory is
	# the whole finding. Visible without --verbose, because a program that
	# was not built is worth a line even when not building it is right.
	rooted = {t.rel for t in targets}
	skipped = {}
	for owner, rel in passed_over:
		if rel not in rooted:
			skipped.setdefault(owner, []).append(rel)
	for owner in sorted(skipped):
		names = sorted(skipped[owner])
		shown = ", ".join(os.path.basename(n) for n in names[:3])
		if len(names) > 3:
			shown += f", and {len(names) - 3} more"
		n = len(names)
		info(f"{owner} is a separate checkout; leaving its own "
		     f"{n} program{'' if n == 1 else 's'} to it ({shown})")

	# Explicit membership is resolved once, here, so a bad glob is reported
	# before anything is compiled.
	for t in targets:
		if t.members is not None and t.conf.get("sources"):
			t.members = _expand_sources(t.conf["sources"], root, proj, t.name)

	# A tree whose only programs are tests is a library with tests beside
	# it, and a plain build should produce the library. Before tests were
	# held back the test binary was the only target and got built, so
	# nothing noticed; afterwards the default build had nothing left and
	# said "no target could be built" about a directory whose whole purpose
	# is an archive. Found by running fmake on the project that declined
	# over exactly this shape.
	library_only = targets and all(t.test for t in targets)
	whole_tree_library = not targets or library_only
	if whole_tree_library:
		ann = Ann()
		name = conf.project.get("name") or os.path.basename(root) or "lib"
		# Not srcs[0]: a test's own source must not root the library, and
		# with tests present srcs[0] may well be one.
		body = [r for r in srcs
		        if r not in {t.rel for t in targets if t.test}]
		t = Target(body[0] if body else srcs[0], root, ann,
		           conf.target(name))
		t.rel = body[0] if body else srcs[0]
		t.kind = t.conf.get("kind", "static")
		t.name = t.conf.get("name", name)
		targets.append(t)
		vinfo(f"{'only tests define' if library_only else 'no main() anywhere;'}"
		      f" building the tree as {t.filename}")

	# tests/main.cpp wants to be called `tests`, which is the directory it
	# came from. Two of five projects hit this on their first run and both
	# had to write a config file for it. `src` is already skipped as a name
	# that names nothing, but skipping `tests` too would land on the project
	# name and collide with the program.
	#
	# So a name nobody chose gets qualified rather than refused. This cannot
	# change a build that worked: the only trees affected are the ones that
	# stopped with an error. A name somebody *did* choose is still refused,
	# because renaming what an author asked for is worse than declining.
	project_name = conf.project.get("name") or os.path.basename(root) or ""
	for t in targets:
		if not os.path.isdir(os.path.join(outdir, t.filename)):
			continue
		chosen = (t.ann.scalar("target") or t.conf.get("name")
		          or t.conf.get("target"))
		if chosen or not project_name or t.name.startswith(project_name):
			continue
		alt = f"{project_name}_{t.name}"
		if os.path.isdir(os.path.join(outdir, alt)):
			continue
		was = t.filename
		t.name = alt
		info(f"{t.rel} would be built as {was}, which is a directory; "
		     f"calling it {t.filename} instead (@target or {CONF_FILE} "
		     f"picks the name)")

	clash = {}
	for t in targets:
		clash.setdefault(t.filename, []).append(t.rel or f"[target.{t.name}]")
	for fn, rels in sorted(clash.items()):
		if len(rels) > 1:
			die(f"two targets are both called {fn!r}:\n    "
			    + "\n    ".join(rels) + "\n"
			    f"give one of them a different @target, or a name in "
			    f"{CONF_FILE}.")
	refuse_ident_collisions("targets", [t.name for t in targets])
	for t in targets:
		if os.path.isdir(os.path.join(outdir, t.filename)):
			die(f"target {t.filename!r} (from {t.rel}) would be written over "
			    f"a directory of that name.\n"
			    f"name it with @target, or with "
			    f"[target.{t.name}] name = \"...\" in {CONF_FILE}.")

	phony = phony_rules(root)
	asked_phony = [n for n in args.targets if n in phony]

	# A plain build produces the library and the programs; `fmake test`
	# produces and runs the test binaries. The convention buys a fast
	# default build, and it is paid for by the object cache being keyed on
	# the whole configuration -- otherwise "build only what you asked for"
	# is how a stale binary gets tested. Naming a test outright still builds
	# it: the rule is about what a bare `fmake` does, not about permission.
	held = [t for t in targets if t.test]
	wanted = [t for t in targets if not t.test]
	groups = sorted({t.test_group for t in held})
	for g in groups:
		if not RE_TEST_GROUP.match(g):
			die(f"test group {g!r} is not a name: lowercase, starting with "
			    f"a letter, then letters, digits, - or _")
	# A group becomes a Make variable, and `-` is not legal in one, so it is
	# replaced -- which makes `slow-net` and `slow_net` two groups sharing
	# one variable. The ejected Makefile then assigns it twice and every
	# rule builds whichever group came last, silently. fmake refuses two
	# targets with one name and two definitions of one symbol; this is the
	# same ambiguity and gets the same answer.
	refuse_ident_collisions("test groups", groups)
	run_groups, named = [], []
	if args.eject:
		# An ejected build file describes the project, not this invocation.
		# Leaving the tests out would produce a Makefile that cannot build
		# them at all, which is a worse answer than the one the convention
		# is about: there, `test` is a target that `all` does not depend on.
		held, wanted = [], targets
	if args.targets:
		by_name = {}
		for t in targets:
			by_name[t.name] = t
			by_name[t.filename] = t
		wanted = []
		for name in args.targets:
			if name in phony:
				# Its prerequisites are what has to be built; the action
				# itself runs after.
				wanted += [by_name[p] for p in phony[name]["inputs"]
				           if p in by_name]
				continue
			if name in by_name:
				wanted.append(by_name[name])
				named.append(by_name[name])
				continue
			# Last, so a project that has its own `test` -- a phony rule in
			# fmake.mk, or a program actually called that -- keeps it.
			if name in groups:
				run_groups.append(name)
				continue
			known = set(by_name) | set(phony)
			if held:
				known.add("test")
			die(f"no target {name!r}. Available: "
			    f"{', '.join(sorted(known)) or '(none)'}")
		# `fmake test foo bar` runs those and no others -- re-running one
		# test out of sixty-six is the commonest thing anybody does with a
		# suite, and naming it on its own only ever built it. Naming
		# something that is not a test alongside `test` still builds it and
		# does not make it a test.
		picked = [t for t in named if t.test_group in run_groups]
		if run_groups and not picked:
			wanted += [t for t in held
			           if t.test_group in run_groups and t not in wanted]
		if not wanted and asked_phony:
			wanted = []         # an action with nothing of ours to build
		if run_groups and not held:
			warn("no test programs here: nothing is in a test directory, "
			     "named as a test, or marked @test")
			return 0
	elif held:
		n = len(held)
		how = " or ".join(f"`fmake {g}`" for g in groups)
		info(f"{n} test program{'' if n == 1 else 's'} not built by "
		     f"default ({', '.join(sorted(t.name for t in held)[:3])}"
		     f"{', ...' if n > 3 else ''}); {how} builds and runs them")

	# ---- candidate set from the include graph -------------------------
	units = {}

	def unit(rel):
		if rel not in units:
			units[rel] = Unit(rel, root, objdir, scans[rel])
		return units[rel]

	# Shared objects need position-independent code, and mixing PIC objects
	# into an executable is harmless, so one setting covers the whole tree.
	# Decided here, before the object directory is named, because -fPIC has
	# to be part of the configuration identity: building only the program and
	# then building the library as well must not reuse the non-PIC objects.
	if any(t.kind == "shared" for t in wanted):
		cfg.cflags = cfg.cflags + ["-fPIC"]
		cfg.refresh_key()
	objdir = os.path.join(state, "obj", cfg.key)

	# @sources, resolved next to the file that asked for them, then from the
	# project root. Same semantics as --force-link: the files nothing
	# references but that must be in the link anyway.
	forced_rels, forced_why = list(args.force_link), {}
	for f in forced_rels:
		forced_why[f] = "--force-link"
	for rel in srcs:
		ann_s = Ann(scans[rel].get("dirs"))
		for pat in ann_s.items("sources"):
			# recursive=True everywhere, so ** means the same thing in
			# @sources as it does in fmake.toml. Two spellings of "all the
			# files under here" is the kind of difference nobody discovers
			# except by having a pattern quietly match nothing.
			hits = (glob.glob(os.path.join(root, os.path.dirname(rel), pat),
			                  recursive=True)
			        or glob.glob(os.path.join(root, pat), recursive=True))
			got = [os.path.relpath(h, root) for h in sorted(hits)]
			got = [g for g in got if g in proj.src_set]
			if not got:
				die(f"{rel}: @sources {pat!r} matched no source file")
			for g in got:
				forced_why[g] = f"@sources in {rel}:{ann_s.line('sources')}"
			forced_rels += got

	candidates = set()
	for t in wanted:
		if t.members is not None:
			candidates |= set(t.members)
		elif t.kind != "exe":
			candidates |= set(srcs)
		else:
			candidates |= proj.candidates(t.rel)
	for rel in forced_rels:
		if rel not in proj.src_set:
			die(f"{rel!r} is not a source file in this tree")
		candidates.add(rel)
	# A file you wrote a generator for is obviously worth compiling, so
	# generated sources join the candidate set outright. This is not forcing
	# them into the link -- the closure still decides that -- but it means
	# their symbols exist to be closed over. Without it flex output goes
	# unbuilt, since yylex arrives through a macro that the definition-scanning
	# widening filter cannot see.
	candidates |= {g for g in generated if g in proj.src_set}
	# Same for moc output, and it needs saying separately because nothing
	# includes a moc_foo.cpp -- that is the whole reason moc is hard in an
	# include-graph build. Widening is not a substitute here: it picks its
	# extra files by scanning for apparent definitions, which finds
	# Foo::staticMetaObject but can never find a vtable, since _ZTV4Base is
	# not a string any source spells. A class whose only debt to moc is its
	# vtable would fail to link having compiled everything it was asked to.
	# Compiling is still not linking: the closure decides, so the object of
	# a class no program constructs is simply never reached.
	candidates |= {m for m in moc_outs if m in proj.src_set}
	candidates |= {q for q in qrc_outs if q in proj.src_set}
	# Whatever widening discovered last time is a far better starting guess
	# than the include graph, so start from it. Widening still corrects it if
	# the tree has changed.
	candidates |= {r for r in cache.data["units"] if r in proj.src_set}
	if args.widen_all or any(t.kind != "exe" and t.members is None
	                         for t in wanted):
		# A library with no declared membership is everything, so there is
		# nothing to narrow down to.
		candidates = set(srcs)

	# Last, because a library with no declared membership resets the set to
	# the whole tree and would otherwise put these back. A held-back test's
	# root is not worth compiling for somebody else's sake: without this the
	# objects for thirty-five test binaries are still built on a plain build
	# and merely not linked, which is most of the cost the convention was
	# traded for. They cannot be used either way -- an exe root is excluded
	# from every library closure by construction.
	candidates -= {t.rel for t in held} - {t.rel for t in wanted}

	base_incflags = ["-I" + os.path.join(root, d) if d != "." else "-I" + root
	                 for d in sorted(proj.incdirs | {"."})]
	# uic output is flat and its includes are unqualified, so one -I covers
	# it. Added explicitly rather than left to the include graph to discover,
	# because a header nothing has walked to yet still has to be findable.
	for d in gen_dirs + ([UI_DIR] if ui_outs else []):
		flag = "-I" + os.path.join(root, d) if d else "-I" + root
		if flag not in base_incflags:
			base_incflags.append(flag)
	for flag in moc_incflags:
		if flag not in base_incflags:
			base_incflags.append(flag)
	for d in conf.project.get("include-dirs", []):
		flag = "-I" + (d if os.path.isabs(d) else os.path.join(root, d))
		if flag not in base_incflags:
			base_incflags.append(flag)

	for rel in sorted(candidates):
		unit(rel)

	hdr_store = cache.data.setdefault("headers", {})
	incflags, proposed = list(base_incflags), {}
	pkg_sig = pkg.signature()

	def own_flags(u):
		"""The compile flags a TU asked for, plus any fmake owes it.

        Wanted wherever a Unit enters the pool, not just here: a Unit is
        created with no flags of its own, and widening adds units after this
        point. A file the include graph missed would otherwise be compiled
        without its @define, @cflags or @std -- silently, since nothing
        downstream reads the annotations again, and a wrong -D produces a
        program that builds and answers differently.
        """
		for group in u.ann.groups("pkg"):
			# Checked up front rather than at the compiler's "no such file",
			# which is a much worse way to learn a package is missing.
			if pkg.satisfies(group) is False:
				die(f"{u.rel}:{u.ann.line('pkg')}: @pkg {' '.join(group)} is "
				    f"not satisfied (installed: {pkg.version(group[0])})")
		for group in u.ann.groups("pkg_optional"):
			# Malformed is fatal where missing is not. The whole directive
			# is about a feature that vanishes quietly, so one that fmake
			# silently ignored because the keyword was misspelt would be
			# the same failure wearing the fix as a disguise.
			if optional_pkg(group) is None:
				die(f"{u.rel}:{u.ann.line('pkg_optional')}: @pkg_optional "
				    f"{' '.join(group)} is not "
				    f"'@pkg_optional NAME defines MACRO'")
		return unit_cflags(u, pkg, hdr_store, pkg_sig) + moc_own.get(u.rel, [])

	for rel in sorted(units):
		units[rel].own = own_flags(units[rel])

	# Which optional features this build has, and which it does not. Said
	# once per package rather than per file, and said whether the answer is
	# yes or no: "built without keyring support" is the sentence hydra's
	# browser needed and did not get, and it is only trustworthy if the
	# other half is printed too.
	optional = {}
	for rel in sorted(units):
		for group in units[rel].ann.groups("pkg_optional"):
			spec = optional_pkg(group)
			if spec:
				optional.setdefault(spec, []).append(rel)
	for (module, macro), users in sorted(optional.items()):
		if pkg.for_module(module, hdr_store, pkg_sig):
			vinfo(f"{module} found: -D{macro} for "
			      f"{len(users)} file{'' if len(users) == 1 else 's'}")
		else:
			info(f"{module} is not installed, so {macro} is undefined and "
			     f"whatever {users[0]} guards with it is not in this build")


	vinfo(f"{len(srcs)} sources, {len(candidates)} candidates, "
	      f"{len(wanted)} target(s)"
		  # Not "by platform": this set also holds the files [project]
		  # exclude named and the ones that could not be read, and saying
		  # otherwise sends anyone looking for the reason to @os first.
		  # --explain gives the reason per file.
	      + (f", {len(excluded)} excluded" if excluded else ""))

	if args.always_make:
		# Links too, or -B recompiles everything, finds the objects came out
		# byte-identical, and reports the target up to date -- which is true,
		# and not what anyone typing --always-make is asking for.
		cache.objects.clear()
		cache.data.pop("links", None)

	# ---- vendored archives --------------------------------------------
	# Anything fmake builds itself is not one of these. A static target
	# writes lib<name>.a into the output directory, which is the tree root
	# unless -o says otherwise, so without this the second build would find
	# the first build's output and offer it back as a dependency of itself.
	ours = {t.filename for t in targets if t.kind == "static"}
	out_prefix = os.path.join(os.path.abspath(outdir), "")
	vendored = []
	for a in find_archives(root):
		if os.path.basename(a) in ours:
			continue        # something this tree builds, not something it ships
		# And anything already sitting in the output directory, unless that
		# is the tree itself -- which it is by default, so this test has to
		# be conditional or it excludes every archive there is.
		if outdir != root and \
		        os.path.abspath(os.path.join(root, a)).startswith(out_prefix):
			continue
		vendored.append(a)
	archives = archive_units(vendored, root, cfg, jobs)
	if archives:
		vinfo(f"{len(archives)} vendored archive(s): "
		      + ", ".join(a.rel for a in archives[:4]))

	# ---- compile, close, widen ----------------------------------------
	tried, broken = set(), set()
	closures = {}
	target_ident, vetted = None, False
	# Computed once, over every source in the tree rather than over the
	# evolving candidate pool. Recomputing per pass looks thriftier, but the
	# flags then depend on how far widening has got: a file compiled before
	# some later file contributed an -I was built with a different include
	# path than fmake believes it used, and its cache key -- which contains
	# the flags -- disagrees with the final one, so the next build recompiles
	# it for no reason. Stable inputs, stable keys, idempotent builds.
	if not args.no_libs:
		every_unit = [units.get(rel) or Unit(rel, root, objdir, scans[rel])
		              for rel in srcs]
		pkg_cflags, _ = propose_from_headers(every_unit, pkg, hdr_store, proj)
		incflags = base_incflags + [f for f in pkg_cflags
		                            if f not in base_incflags]

	# Wherever the packages resolved so far said their libraries live. section 5
	# recovers -L from where a library was actually found rather than from
	# pkg-config, which is what makes libraries found by symbol alone work
	# -- but it can only find one in a directory it looks in, and a package
	# under /opt or a home prefix is in none of them. This is pkg-config
	# proposing, exactly as it proposes the -I; the symbols still decide.
	if pkg.libdirs:
		cfg.extra_libdirs += [d for d in pkg.libdirs
		                      if d not in cfg.extra_libdirs]
		cfg._libdirs = None         # recomputed with the new directories

	while True:
		pool = [units[r] for r in sorted(units)]
		compile_units(pool, cfg, cache, root, incflags, jobs, args.dry_run,
		              broken, tree_headers=hdrs, quiet=args.quiet)
		# The architecture to require is whatever fmake just compiled. Asking
		# the objects avoids having to know anything about toolchain
		# triplets, and is right by construction -- but it means waiting
		# until something has been compiled, which is why this is here and
		# not where the archives were found.
		if target_ident is None:
			for u in pool:
				target_ident = elf_identity(u.obj)
				if target_ident:
					break

		# Archives join the pool only after compiling, which is the whole
		# difference between them and a source: they are already built. And
		# being already built, they have an architecture of their own, which
		# nothing else here does: a host archive left in the tree during a
		# cross build reads perfectly well -- binutils nm will happily list
		# symbols from a foreign object -- so it is offered, chosen, and then
		# refused by the linker with `file in wrong format`, which names
		# neither architecture nor whose decision it was.
		if archives and not vetted:
			vetted, keep = True, []
			for a in archives:
				got = elf_identity(a.obj)
				if target_ident and got and got != target_ident:
					warn(f"{a.rel} is {describe_identity(got)}, but this "
					     f"build is {describe_identity(target_ident)}")
					note("not using it; anything it defines will be reported "
					     "as missing")
					continue
				keep.append(a)
			archives = keep
		pool = pool + archives

		# confirm main() against the symbol tables now that objects exist
		if not args.dry_run:
			for t in list(wanted):
				if t.rel in broken:
					warn(f"{t.name} skipped: {t.rel} did not compile")
					wanted.remove(t)
					continue
				if t.kind == "exe" and "main" not in units[t.rel].strong:
					warn(f"{t.rel} looked like it defined main() but the "
					     f"object does not export it; skipping")
					# Remembered against the file and the configuration, so
					# the next build does not propose it, compile it, link
					# nothing and say this again.
					nomain[t.rel] = main_stamp(t.rel)
					wanted.remove(t)
			if not wanted:
				die("no target could be built")

		forced = [units[f] for f in forced_rels if f in units]
		# The vendored main()s too. They stopped rooting a target, which is
		# the point, but the reason a library must not contain them did not
		# change with it -- an archive carrying a second entry point is section 28,
		# and it would now arrive by the one path that no longer names it.
		other_roots = {t.rel for t in targets if t.kind == "exe"}
		other_roots |= {rel for _, rel in passed_over} - {t.rel for t in targets}
		closures = {}
		for t in wanted:
			if t.members is not None:
				# Declared membership is the answer, not a starting point.
				# Nothing in the source says which of two libraries a shared
				# file belongs to, so the closure must not be consulted.
				#
				# It decides which of *the tree's own* sources belong, though,
				# not which generated ones do. A moc output lives under the
				# state directory and is named after an implementation detail:
				# it is not something anyone can list, and it is not a choice
				# either -- a class's meta-object is part of that class, not a
				# second opinion about it. So declared members bring their
				# generated companions with them, found by symbol.
				chosen = [units[r] for r in t.members if r in units]
				owned = companions(t.members,
				                   proj.reachable_headers(t.members),
				                   moc_jobs, qrc_jobs)
				chosen += [units[o] for o in sorted(owned)
				           if o in units and units[o] not in chosen]
				closures[t] = close_over_library(chosen, units[t.rel])
			elif t.kind == "exe":
				closures[t] = close_over_symbols(units[t.rel], pool, forced,
				                                 forced_why)
				# A resource is asserted, not deduced -- nothing references
				# the object. Which program gets it comes from which of its
				# files opened it, so the closure has to exist before the
				# question can be asked, and is then recomputed with the
				# answer. One extra pass: rcc output refers to Qt and to
				# nothing in the tree, so it cannot widen anything.
				have = {u.rel for u in closures[t].link}
				add = {}
				for job in qrc_jobs:
					if job["out"] in have or job["out"] not in units:
						continue
					for who, why in job["users"].items():
						if who in have:
							add[job["out"]] = f"{why} in {who}"
							break
				if add:
					extra_why = dict(forced_why)
					extra_why.update(add)
					closures[t] = close_over_symbols(
					    units[t.rel], pool,
					    forced + [units[o] for o in sorted(add)], extra_why)
			else:
				members = [u for u in pool
				           if u.rel == t.rel or u.rel not in other_roots]
				closures[t] = close_over_library(members, units[t.rel])

		unresolved = set()
		for cl in closures.values():
			unresolved |= set(cl.external)
		fresh = unresolved - tried
		if not fresh or args.widen_all or args.dry_run:
			break
		tried |= fresh

		rest = [Unit(rel, root, objdir, scans[rel])
		        for rel in srcs if rel not in units]
		extra = widen_candidates(fresh, rest)
		if not extra:
			break
		vinfo(f"widening: {len(extra)} more file(s) may define "
		      f"{len(fresh)} unresolved symbol(s)")
		for u in extra:
			u.own = own_flags(u)
			units[u.rel] = u

	# ---- report ambiguity ---------------------------------------------
	# Every affected target at once, not the first one and then exit. A tree
	# of sibling programs that each define a `Window` produces the same
	# complaint once per program, and fixing them one build at a time is a
	# bad way to spend an afternoon.
	trouble = [(t, sym, providers) for t, cl in closures.items()
	           for sym, providers in cl.ambiguous]
	if trouble:
		first_sym, first_providers = trouble[0][1], trouble[0][2]
		shown = first_providers[:6]
		listing = "\n    ".join(shown)
		if len(first_providers) > len(shown):
			listing += f"\n    ... and {len(first_providers) - len(shown)} more"
		lines = [f"symbol {first_sym!r} is defined by more than one file:",
		         "    " + listing,
		         "fmake will not guess which one belongs in "
		         + ", ".join(sorted({t.name for t, _s, _p in trouble})) + "."]

		# The include graph must not decide this -- section 3 exists because it is
		# not good enough to -- but it is good enough to *suggest*, and a
		# suggestion costs nothing if it is labelled as one. Where it reaches
		# exactly one of the providers from a target's own root, that is
		# almost always the right answer, and the stanza below is the thing
		# the user would otherwise write out by hand.
		advice, stanzas = [], []
		for t, _sym, providers in trouble:
			reach = proj.candidates(t.rel)
			mine = [p for p in providers if p in reach]
			if len(mine) != 1:
				continue
			advice.append(f"    {t.name:<20} {mine[0]}")
			members = sorted(r for r in reach if r in proj.src_set)
			stanzas.append(f"[target.{t.name}]\nsources = ["
			               + ", ".join(f'"{m}"' for m in members) + "]")
		if advice:
			lines += ["",
			          "The include graph reaches exactly one of them from "
			          "each program's own root:",
			          *advice,
			          "",
			          "which is a guess, not a decision. To make it the "
			          f"answer, put this in {CONF_FILE} -- the source lists "
			          "are that same guess and are worth checking:",
			          ""]
			lines += ["    " + s.replace("\n", "\n    ") for s in stanzas]
		elif len(first_providers) > 3:
			# Two very different causes, and the wrong hint sends people the
			# wrong way. A handful of files is usually one implementation per
			# platform; dozens is usually a directory of programs that each
			# supply the same entry point, expecting to be linked separately.
			lines.append(f"\n{len(first_providers)} files define it, which "
			             f"usually means they are separate programs sharing "
			             f"an entry point rather than one library.\nGive each "
			             f"a [target.*] with its own sources in {CONF_FILE}, "
			             f"or drop them with [project] exclude.")
		elif any(scans[p].get("dirs", {}).get("os") for p in first_providers):
			lines.append("\nOne of them has @os; the others may need one too.")
		else:
			lines.append("\n@os or @arch on the platform-specific one will "
			             "settle it, or name the sources of each target in "
			             f"{CONF_FILE}.")
		die("\n".join(lines))

	# ---- one program's root inside another's link set -----------------
	# Every exe root defines main(), so a closure that reaches a second one
	# cannot link -- and the linker says so in terms of object paths under
	# .fmake, several steps from the cause. Worse, fmake's own summary then
	# offered to name the missing libraries, when nothing is missing at all.
	# section 3 excludes other roots when assembling a library and does not when
	# closing over a program, deliberately: a function defined next to a
	# main() is still a function, and refusing to link it would be its own
	# kind of guess. So this reports rather than resolves.
	roots = {t.rel: t.name for t in wanted if t.kind == "exe"}
	intruders = []
	for t, cl in closures.items():
		if t.kind != "exe":
			continue
		for u in cl.link:
			if u.rel != t.rel and u.rel in roots:
				sym, by = cl.why.get(u.rel, ("", ""))
				intruders.append((t.name, u.rel, roots[u.rel], sym, by))
	if intruders:
		lines = ["a program's own file was pulled into another program:"]
		for name, rel, owner, sym, by in intruders:
			lines.append(f"    {name} links {rel}, which roots {owner}"
			             + (f"\n        <- {sym}" + (f"  ({by})" if by else "")
			                if sym else ""))
		lines += ["",
		          "Both define main(), so this cannot link. What is shared "
		          "belongs in a file of its own:",
		          "move it out of " + ", ".join(sorted({r for _n, r, *_ in intruders}))
		          + " and both programs can reach it.",
		          "Naming each program's sources in " + CONF_FILE
		          + " settles it too."]
		die("\n".join(lines))

	# Two .qrc files with the same stem, in one program. rcc namespaces the
	# *file* it writes by directory, so a/res.qrc and b/res.qrc do not
	# overwrite each other -- and it derives the *symbols* from the stem, so
	# both define qInitResources_res and the link fails with a multiple
	# definition. The paths are distinct and the names are not, which is the
	# collision of sections 65 and 66 one level down, in a rewriting rcc
	# does rather than fmake.
	#
	# Reported here for the same reason the block above exists: left to the
	# linker it arrives as an error about generated paths under the state
	# directory, and fmake's own summary then offers to name the missing
	# libraries when nothing is missing.
	by_out = {j["out"]: j for j in qrc_jobs}
	for t, cl in closures.items():
		seen = {}
		for u in cl.link:
			job = by_out.get(u.rel)
			if job:
				seen.setdefault(job["name"], []).append(job["src"])
		for name, srcs_with_name in sorted(seen.items()):
			if len(srcs_with_name) > 1:
				die(f"{t.name} links resources that would define the same "
				    f"symbols:\n    "
				    + "\n    ".join(sorted(srcs_with_name))
				    + f"\nrcc names them after the file, so each defines "
				    f"qInitResources_{name}(). Rename one so the stems "
				    f"differ.")

	# ---- resolve external symbols to libraries ------------------------
	resolutions = {}
	if not args.no_libs and not args.dry_run:
		every = set()
		for t in wanted:
			every |= set(closures[t].external)
		# target_ident was settled in the compile loop, from the first object
		# that had one -- the same question, asked once.
		providers, paths = scan_providers(cfg, every, cache, jobs,
		                                  target_ident)
		for t in wanted:
			resolutions[t] = resolve_libraries(t, closures[t], cfg, pkg,
			                                   hdr_store, providers, paths,
			                                   target_ident, proj)

		# Said outside --explain, because the build that needs to hear it is
		# the one nobody is inspecting. A feature guarded by a macro fmake
		# was not given compiles to nothing, needs no library, and links --
		# so the program is built, is smaller than it should be, and says
		# so nowhere. There is no error to notice and no symbol to miss.
		told, told_files = set(), set()
		for t in wanted:
			gone = resolutions[t].get("compiled_away") or {}
			for lib, (module, where, header) in sorted(gone.items()):
				if (where, header) in told:
					continue
				told.add((where, header))
				told_files.add(where.rsplit(":", 1)[0])
				warn(f"{where}: {header} is behind a conditional the "
				     f"preprocessor did not take, so {module} was not "
				     f"linked -- if a feature macro should have turned it "
				     f"on, say so next to the include with "
				     f"'@pkg_optional {module} defines MACRO', or pass "
				     f"-DMACRO with --cflags")

		# The same finding for a header no package could be attributed to.
		# Reported second and worded differently, because there is no
		# module name to offer: the reader knows which package ships the
		# header and fmake does not.
		incdirs = [f[2:] for f in incflags if f.startswith("-I")]
		incdirs += default_include_dirs(cfg)
		# One line per file, not per include. A guarded block opens with
		# fourteen headers from the same package in hydra's case, and
		# fourteen lines saying the same thing is how a real finding gets
		# skimmed past.
		grouped = {}
		for t in wanted:
			for where, header in compiled_away_includes(
			        closures[t], preprocessed_headers(closures[t]), incdirs):
				# A file already named with its package is the same
				# finding said better; saying it twice in two wordings
				# reads as two problems.
				src = where.rsplit(":", 1)[0]
				if (where, header) in told or src in told_files:
					continue
				told.add((where, header))
				grouped.setdefault(src, []).append((where, header))
		for src in sorted(grouped):
			hits = grouped[src]
			where, header = hits[0]
			more = (f" and {len(hits) - 1} other header"
			        f"{'' if len(hits) == 2 else 's'}" if len(hits) > 1
			        else "")
			warn(f"{where}: {header}{more} on this machine but behind a "
			     f"conditional the preprocessor did not take -- if a "
			     f"feature macro should have turned it on, say so with "
			     f"'@pkg_optional PACKAGE defines MACRO', or pass "
			     f"-DMACRO with --cflags")

	# ---- explain or link ----------------------------------------------
	# What widening discovered, to start from next time -- but not what it
	# discovered was useless. A file that failed to compile defines nothing,
	# so it can never be why anything links; remembering it only guarantees
	# compiling it again, and failing again, on every future build. If it is
	# genuinely reachable the include graph or widening proposes it afresh
	# and the error comes back, which is the difference between forgetting it
	# and hiding it.
	#
	# --widen-all is not remembered at all. Its set is every file in the tree
	# rather than a discovery about this program, and inheriting it would
	# leave the flag switched on for every later build by a route nobody
	# would think to look for.
	if not args.widen_all:
		cache.data["units"] = sorted(r for r in units if r not in broken)

	if args.eject:
		emit = eject_ninja if args.eject == "ninja" else eject_make
		done = set(moc_outs)
		extra = ({"fragment": True} if args.eject == "make-fragment" else {})
		sys.stdout.write(emit(wanted, closures, resolutions, cfg, incflags,
		                      root, conf,
		                      all_generate_rules(root, conf, srcs, scans),
		                      {"exe": moc_exe, "flags": moc_flags,
		                       "jobs": [j for j in moc_jobs
		                                if j["out"] in done]},
		                      {"exe": uic_exe, "jobs": ui_jobs},
		                      {"exe": rcc_exe, "jobs": qrc_jobs}, **extra))
		cache.save()
		return 0

	all_units = [units[r] for r in sorted(units)]
	if args.explain:
		for t in wanted:
			explain(t, closures[t], cfg, incflags, outdir, all_units, root,
			        {x.rel for x in targets} - {t.rel}, resolutions.get(t),
			        excluded, conf,
			        {"exe": moc_exe, "jobs": moc_jobs} if moc_exe else None,
			        {"exe": uic_exe, "jobs": ui_jobs} if uic_exe else None,
			        {"exe": rcc_exe, "jobs": qrc_jobs} if rcc_exe else None)
		cache.save()
		return 0

	# Targets are discovered, not requested, so one of them failing must not
	# discard the others -- you did not ask for the test binary that needs a
	# library fmake cannot resolve yet.
	built, failed, changed = [], [], False
	for t in wanted:
		res = resolutions.get(t)
		out, did, ok = link_target(t, closures[t], cfg, outdir,
		                           args.dry_run,
		                           res["ldflags"] if res else [],
		                           cache, root, quiet=args.quiet)
		changed = changed or did
		(built if ok else failed).append((t.filename, closures[t], res))

	cache.save()
	if args.dry_run and not args.install:
		if not args.no_libs:
			note("libraries are not resolved in a dry run: nothing was "
			     "compiled, so there are no symbols to resolve. The link "
			     "lines above are missing their -l flags.")
		return 0
	if args.dry_run and args.install:
		return do_install(wanted, closures, root, outdir, conf, args)

	if not args.quiet:
		if changed:
			# Only worth saying when something was actually rebuilt; on a
			# no-op build it is the same notice every time.
			# A held-back test is not unreachable, it was not asked
			# for, and saying the wrong one of those sends the reader to
			# --force-link for a file that needs `fmake test`.
			ignored = sorted(set(srcs) - set(units)
			                 - {t.rel for t in held})
			for rel in ignored[:5]:
				note(f"{rel} not compiled: nothing reaches it "
				     f"(--force-link if it is needed anyway)")
			if len(ignored) > 5:
				note(f"... and {len(ignored) - 5} more")

		names = ", ".join(n for n, _, _ in built)
		if built:
			info(f"built {names}" if changed else f"{names} up to date")

	if args.install and not failed:
		say()
		return do_install(wanted, closures, root, outdir, conf, args)

	if asked_phony and not failed:
		made = {}
		for t in wanted:
			made[t.name] = made[t.filename] = os.path.join(outdir, t.filename)
		for name in asked_phony:
			rc = run_phony(name, phony[name], root, made, args.dry_run)
			if rc:
				return rc
		return 0

	# After the build, and only if the build produced them. A test binary
	# that did not relink is a test binary that answers a question about
	# some earlier version of the code, which is the failure this whole
	# convention was traded against.
	if run_groups and not failed:
		if broken:
			say()
			warn(f"{len(broken)} file(s) did not compile; not running tests")
			return 1
		say()
		return run_tests_now([t for t in wanted
		                      if t.test_group in run_groups],
		                     root, outdir, conf, args.dry_run)

	if broken:
		say()
		warn(f"{len(broken)} file(s) did not compile")
		for rel in sorted(broken)[:5]:
			note(rel)
		if len(broken) > 5:
			note(f"... and {len(broken) - 5} more")

	if failed:
		say()
		for name, cl, res in failed:
			warn(f"{name} did not link")
			if res and res["chosen"]:
				note(f"resolved to: {' '.join(res['ldflags'])}")
			missing = res["unresolved"] if res else sorted(cl.external)
			if missing:
				note(f"no {describe_identity(res.get('ident') if res else None)}"
				     f" library exports: {', '.join(missing[:6])}"
				     + (" ..." if len(missing) > 6 else ""))
			# A file fmake was told to leave out is the commonest reason a
			# symbol in this tree has nowhere to come from, and the exclusion
			# is invisible here: @os with a typo removes a file on every
			# platform, and a stray [project] exclude pattern removes
			# whatever it happens to match. --explain has always said so;
			# the failure never did, and the failure is what people read.
			toks = set()
			for s in missing:
				toks |= symbol_tokens(s)
			for rel, why in sorted(excluded.items()):
				if toks.intersection(scans.get(rel, {}).get("defs") or []):
					note(f"{rel} is excluded ({why}) and appears to define "
					     f"one of them")
		note("name the missing libraries with --ldflags, or build only the "
		     "targets you want")
		return 1
	return 1 if broken else 0

# ---------------------------------------------------------------------------
# --eject
#
# The exit. Everything fmake worked out -- link sets, per-file flags, resolved
# libraries, wrap flags -- written as a build file that needs no fmake to run.
# A tool this opinionated has to be leaveable, and a promise to be leaveable is
# worth nothing unless it is exercised.
#
# It is also the cheapest independent check on the whole model. If the emitted
# build produces working binaries, the link sets and flags were right, verified
# by a second implementation that shares no code with the first.
#
# Goes to stdout rather than to a file. Writing Makefile by default would mean
# clobbering the hand-written Makefile that fmake was very likely run beside --
# the udp-echo project used to develop this has exactly that -- and a build
# tool that eats build files is not a good neighbour.
# ---------------------------------------------------------------------------

EJECT_BUILD_DIR = "build"
# Where fmake's generated trees land inside an ejected build's object
# directory. A standalone build file should not write into the bookkeeping of
# the tool it no longer needs, and `fmake --clean` must not be able to delete
# something an ejected build depends on.
EJECT_GENDIRS = ((MOC_DIR, "moc"), (UI_DIR, "ui"), (QRC_DIR, "qrc"))


def _eject_gen(rel):
	"""Remap a generated path out of the state directory, or None.

    Matches the directory itself as well as what is under it: an -I naming a
    generated root is exactly what flat uic output produces, and a prefix
    test that misses it emits a build compiling against a directory only
    fmake creates.
    """
	for src_dir, dst in EJECT_GENDIRS:
		if rel == src_dir or rel.startswith(src_dir + os.sep):
			return os.path.normpath(os.path.join(dst,
			                                     os.path.relpath(rel, src_dir)))
	return None


def _eject_src(rel):
	"""Where a source file lives in an ejected build."""
	sub = _eject_gen(rel)
	return os.path.join(EJECT_BUILD_DIR, sub) if sub else rel


def _eject_obj(rel):
	"""A source's object path, relative to the ejected object directory."""
	return _eject_gen(rel) or rel


def _eject_flags(flags, root):
	"""Make in-tree paths relative so the emitted build is portable."""
	out = []
	for f in flags:
		for prefix in ("-I", "-L"):
			if f.startswith(prefix) and os.path.isabs(f[2:]):
				rel = _rel(f[2:], root)
				out.append(prefix + (_eject_src(rel) if rel != root else "."))
				break
		else:
			out.append(f)
	return out


def _mk_ident(name):
	return re.sub(r"[^A-Za-z0-9_]", "_", name)


def refuse_ident_collisions(what, names):
	"""Refuse names a Make identifier cannot tell apart.

    `-` is not legal in a Make variable, so `my-app` and `my_app` both
    become MY_APP. The emitted file then assigns MY_APP_OBJS twice and every
    rule using it takes the second, so one artifact is built from another's
    objects and nothing says so. Valid Makefile, wrong program.

    Two callers and the same failure, which is why this is one function: any
    name rewritten to suit a consumer with a narrower alphabet can collide,
    and the next one will too.
    """
	spelt = {}
	for name in names:
		spelt.setdefault(_mk_ident(name).upper(), []).append(name)
	for ident, clashing in sorted(spelt.items()):
		if len(clashing) > 1:
			die(f"{what} {' and '.join(repr(c) for c in sorted(clashing))} "
			    f"are the same Make variable ({ident}_...): give one of "
			    f"them a different name")


RE_NINJA_ESCAPE = re.compile(r"([ :$])")


def _ninja(path):
	"""Ninja escapes a space, colon or dollar in a path with `$`."""
	return RE_NINJA_ESCAPE.sub(r"$\1", path)


def _refuse_whitespace(targets, closures, root):
	"""Make cannot express a filename containing whitespace.

    Not a limitation worth working around: Make splits prerequisites on
    spaces and has no escaping that survives every position one can appear
    in. Emitting something that looks like a build file and silently means
    something else is worse than saying so -- and ninja can express it, so
    there is somewhere to send people.
    """
	bad = set()
	for t in targets:
		if any(c.isspace() for c in t.filename):
			bad.add(t.filename)
		for u in closures[t].link:
			if any(c.isspace() for c in u.rel):
				bad.add(u.rel)
	if bad:
		die("cannot eject a Makefile for paths containing whitespace:\n    "
		    + "\n    ".join(sorted(bad)[:5])
		    + ("\n    ..." if len(bad) > 5 else "")
		    + "\nMake splits prerequisites on spaces and cannot express "
		      "these.\nUse `--eject ninja`, which can.")


def eject_make(targets, closures, resolutions, cfg, incflags, root, conf,
               gen_rules=None, moc=None, uic=None, rcc=None,
               fragment=False):
	"""A standalone Makefile, or a fragment for an existing one to include.

    The fragment exists because replacing a build system is not the only way
    to adopt one. A project whose Makefile also patches a submodule,
    cross-builds for two Android ABIs and produces two .debs does not want
    fmake to own any of that -- and the compile step, which is the part
    fmake is actually better at, is a small share of what that Makefile
    does. Ejecting a fragment lets the hand-written one keep everything else
    and stop maintaining object rules.

    So the fragment differs only where inclusion demands it: it sets no
    default goal, its aggregate rules are `fmake-all` and `fmake-clean`, and
    every variable it owns carries FM_. That prefix is not tidiness. A
    parent Makefile setting CFLAGS -- which is the most ordinary thing a
    Makefile does -- would otherwise replace every flag fmake worked out,
    and nothing about the result would look wrong until a build failed for
    an unrelated-looking reason. CC, CXX and AR stay unprefixed and become
    conditional, because those the parent *should* control.
    """
	P = "FM_" if fragment else ""
	_refuse_whitespace(targets, closures, root)
	common = _eject_flags(cfg.cflags + incflags, root)
	override = _eject_flags(cfg.override, root)
	L = []
	a = L.append

	a(f"# Generated by `fmake --eject "
	  f"{'make-fragment' if fragment else 'make'}`.")
	a("#")
	a("# This file is yours: fmake is not needed to build it, and nothing here")
	a("# refers back to fmake. Every flag was worked out from the source -- the")
	a("# link sets come from object symbol tables, not from the #include graph")
	a("# -- so editing by hand is fine, but re-ejecting will not preserve it.")
	a("#")
	# Said here because it is invisible everywhere else. A project that
	# ejects and commits the result silently adopts fmake's defaults in
	# place of whatever its own build passed -- a language standard, a
	# warning set its Makefile's own comments called "not decoration".
	# Neither shows up as an error, and the diff is the only place it exists.
	a("# The flags below are what fmake worked out, not what your previous")
	a("# build system passed. If you are replacing one, diff the flags first:")
	a("# a dropped -std= or -W set is silent, and shows up as behaviour.")
	a("#")
	# None is needed, and the reason is worth writing down because the
	# obvious helpful edit is the one that reintroduces the hazard.
	a("# There are no pattern rules here -- one explicit rule per object, so")
	a("# per-file flags survive -- which means nothing is an intermediate and")
	a("# .SECONDARY has nothing to do. Do not add a bare `.SECONDARY:': it")
	a("# would cover every pattern-matched target, and Make does not rebuild")
	a("# a missing secondary when the thing needing it already exists.")
	a("#")
	if fragment:
		a("# Include this from your own Makefile:")
		a("#")
		a("#     include fmake.mk")
		a("#     all: $(FM_TARGETS) my-other-thing")
		a("#")
		a("# It sets no default goal, so include it *after* your own default")
		a("# target -- or accept `fmake-all', the first rule below, which")
		a("# builds everything and is the least surprising thing to land on.")
		a("# Every variable it owns is FM_-prefixed so your CFLAGS cannot")
		a("# silently replace the flags above; CC, CXX and AR are yours, and")
		a("# use ?= so what you set wins.")
		a("#")
	a(f"# Built for: {cfg.os}/{cfg.arch}"
	  + (f"    profile: {conf.profile_name}" if conf.profile_name else ""))
	a("")
	assign = "?=" if fragment else "="
	# Aligned on the longest name rather than on a column somebody counted
	# once. BUILD_DIR replacing OBJDIR is two characters longer and put
	# three assignments out of line, which is what a hand-spaced table does
	# the first time a name changes.
	width = len(P) + len("CFLAGS_LAST")

	def var(name, value, how="=", own=True):
		"""One assignment, padded to the widest name this file emits.

        `own` is false for the three the parent controls: they keep their
        conventional spellings in a fragment, so FM_ must not reach them.
        """
		# The operator is right-aligned in two columns so that `=` and `?=`
		# end at the same one. Aligning on the name alone puts every plain
		# assignment a column left of every conditional, which is only
		# invisible in a file that has one kind or the other.
		head = f"{(P if own else '') + name:<{width}} {how:>2} "
		if not isinstance(value, list):
			return (head + str(value)).rstrip()
		# Wrapped, because a Qt project's CXXFLAGS is eighteen hundred
		# characters on one line and this file's header invites editing it.
		# Make joins a continuation with a space, so the value is unchanged
		# -- which the symbol-for-symbol comparison is what proves.
		lines, cur = [], head
		for item in value:
			if cur != head and len(cur) + len(item) + 3 > 78:
				lines.append(cur + " \\")
				cur = " " * (width + 4)
			cur += ("" if cur.endswith(" ") or cur == head else " ") + item
		lines.append(cur)
		return "\n".join(lines).rstrip() if lines else head.rstrip()

	a(var("CC", cfg.cc, assign, own=False))
	a(var("CXX", cfg.cxx, assign, own=False))
	a(var("AR", cfg.ar_name, assign, own=False))
	a(var("CFLAGS", common))
	a(var("CXXFLAGS", common))
	# Emitted separately so it stays after each file's own flags, which is
	# what makes it an override rather than just another default.
	a(var("CFLAGS_LAST", override))
	a(var("LDFLAGS", _eject_flags(cfg.ldflags, root)))
	a(var("BUILD_DIR", EJECT_BUILD_DIR, assign))
	a("")
	# The default target does not build tests, and a separate one builds
	# and runs them. That is what three of the projects that read this
	# output already do by hand, and what their conventions require of any
	# Makefile -- including a generated one, since a generated Makefile is
	# still a Makefile someone will edit.
	tests = [t for t in targets if t.test]
	by_group = {}
	for t in tests:
		by_group.setdefault(t.test_group, []).append(t)
	group_names = sorted(by_group)
	names = " ".join(t.filename for t in targets if not t.test)

	def group_var(g):
		return ("FM_" if fragment else "") + _mk_ident(g).upper() + "_TARGETS"

	def group_rule(g):
		return ("fmake-" + g) if fragment else g

	if fragment:
		a(f"FM_TARGETS = {names}")
	for g in group_names:
		a(f"{group_var(g)} = "
		  + " ".join(t.filename for t in sorted(by_group[g],
		                                        key=lambda x: x.name)))
	a("")
	phonies = " ".join(group_rule(g) for g in group_names)
	if fragment:
		a(".PHONY: fmake-all fmake-clean"
		  + (" " + phonies if phonies else ""))
		a("fmake-all: $(FM_TARGETS)")
	else:
		a(".PHONY: all clean" + (" " + phonies if phonies else ""))
		a(f"all: {names}")
	a("")
	for g in group_names:
		a(f"{group_rule(g)}: $({group_var(g)})")
		for t in sorted(by_group[g], key=lambda x: x.name):
			argv = " ".join(shlex.quote(x)
			                for x in t.conf.get("test-args", []))
			a(f"\t./{t.filename}" + (f" {argv}" if argv else ""))
		a("")

	gen_rules = gen_rules if gen_rules is not None else {}
	gen_outs = [o for n in _gen_order(gen_rules)
	            for o in gen_rules[n]["outputs"]]
	if gen_rules:
		a("# ---- generated sources " + "-" * 40)
		a("")
		a(f"{P}GENERATED = {' '.join(gen_outs)}")
		a("")
		for name in _gen_order(gen_rules):
			r = gen_rules[name]
			outs, ins = r["outputs"], r["inputs"]
			deps = r.get("depends", [])
			a(f"{outs[0]}: {' '.join(ins + deps)}")
			a("\t@mkdir -p $(@D)")
			for c in (r.get("commands") or [r["command"]]):
				line, quiet, ignore = _recipe_prefix(c)
				line = _gen_command(line, ins, outs, None, r.get("stem"))
				# Whatever $ survives substitution is the shell's, and Make
				# would read $(x) as its own function call and expand it to
				# nothing -- a recipe that runs, succeeds, and produces an
				# empty file.
				a("\t" + ("@" if quiet else "") + ("-" if ignore else "")
				  + line.replace("$", "$$"))
			# Secondary outputs hang off the first, which is the portable way
			# to say one command produces several files.
			for extra in outs[1:]:
				a(f"{extra}: {outs[0]}")
				a("\t@:")
			a("")

	every = {}
	for t in targets:
		for u in closures[t].link:
			if not u.archive:       # prebuilt: there is nothing to compile
				every[u.rel] = u

	# Only the moc outputs this build actually reaches. The caller has
	# already dropped the inputs that produced nothing -- a rule promising a
	# file that never appears would stall a build rather than fail it -- and
	# what is left still includes the classes no target links, which belong
	# in fmake's own report but not in a Makefile that would never run them.
	moc = moc or {}
	moc_jobs = [j for j in (moc.get("jobs") or [])
	            if (j["src"] if j["inline"] else j["out"]) in every]
	# Every uic job was triggered by an include that some file makes, so
	# unlike moc there is nothing to filter -- a header nothing wanted would
	# never have been generated.
	uic = uic or {}
	uic_jobs = uic.get("jobs") or []

	# The generated files that are #included rather than compiled: the uic
	# headers and the .moc bodies. They must exist before anything compiles,
	# and nothing declares that until a depfile does, so they are an
	# order-only prerequisite of every object.
	genhdrs = ([_eject_src(j["out"]) for j in uic_jobs]
	           + [_eject_src(j["out"]) for j in moc_jobs if j["inline"]])
	if genhdrs:
		a(f"{P}GENHDRS = {' '.join(genhdrs)}")
		a("")

	if uic_jobs:
		a("# ---- uic " + "-" * 54)
		a("#")
		a('# Selected by `#include "ui_*.h"` in the source, not by a list.')
		a("")
		a(f"{P}UIC      = {uic['exe']}")
		a("")
		for j in uic_jobs:
			a(f"{_eject_src(j['out'])}: {j['src']}")
			a("\t@mkdir -p $(@D)")
			a(f"\t$({P}UIC) $< -o $@")
			a("")
	rcc = rcc or {}
	rcc_jobs = [j for j in (rcc.get("jobs") or []) if j["out"] in every]
	if rcc_jobs:
		a("# ---- rcc " + "-" * 54)
		a("#")
		a("# Selected by what the source opens, not by a list.")
		a("")
		a(f"{P}RCC      = {rcc['exe']}")
		a("")
		for j in rcc_jobs:
			a(f"{_eject_src(j['out'])}: {j['src']}")
			a("\t@mkdir -p $(@D)")
			a(f"\t$({P}RCC) --name {j['name']} $< -o $@")
			a("")

	if moc_jobs:
		a("# ---- moc " + "-" * 54)
		a("#")
		a("# Selected by Q_OBJECT in the source, not by a list. Override MOC")
		a("# if Qt lives elsewhere on the machine doing the building.")
		a("")
		a(f"{P}MOC      = {moc['exe']}")
		a(f"{P}MOCFLAGS = {' '.join(_eject_flags(moc.get('flags', []), root))}")
		a("")
		for j in moc_jobs:
			a(f"{_eject_src(j['out'])}: {j['src']}")
			a("\t@mkdir -p $(@D)")
			a(f"\t$({P}MOC) $({P}MOCFLAGS) $< -o $@")
			a("")

	# One rule per object, because per-file flags are the point: @cflags and
	# @define belong to a translation unit, so a single pattern rule cannot
	# express them.
	a("# ---- objects " + "-" * 50)
	a("")
	for rel in sorted(every):
		u = every[rel]
		obj = f"$({P}BUILD_DIR)/{_eject_obj(rel)}.o"
		# CC pairs with CFLAGS, not CCFLAGS. Getting this wrong expands to an
		# undefined variable, so every compile silently loses its flags and
		# only a project that actually needs an -I notices.
		var, flags = ("CXX", "CXXFLAGS") if u.cxx else ("CC", "CFLAGS")
		own = " ".join(_eject_flags(u.own, root))
		after = ([f"$({P}GENERATED)"] if gen_outs else []) \
		        + ([f"$({P}GENHDRS)"] if genhdrs else [])
		order_only = (" | " + " ".join(after)) if after else ""
		a(f"{obj}: {_eject_src(rel)}{order_only}")
		a("\t@mkdir -p $(@D)")
		# -MP as well as -MD: it emits a phony target for every header, so
		# deleting one leaves `No rule to make target` behind instead of a
		# build. fmake's own depfiles are read by fmake, which simply skips a
		# prerequisite that is gone; a Makefile has no such luxury, and an
		# ejected Makefile is a Makefile someone will edit.
		a(f"\t$({var}) $({P}{flags}){' ' + own if own else ''} $({P}CFLAGS_LAST) "
		  f"-c $< -o $@ -MD -MP -MF $(@:.o=.d)")
		a("")

	a("# ---- targets " + "-" * 50)
	a("")
	for t in targets:
		ident = _mk_ident(t.name).upper()
		objs = [f"$({P}BUILD_DIR)/{_eject_obj(u.rel)}.o" for u in closures[t].link
		        if not u.archive]
		a(f"{P}{ident}_OBJS = \\")
		for i, o in enumerate(objs):
			a(f"\t{o}" + (" \\" if i < len(objs) - 1 else ""))
		a("")
		res = resolutions.get(t)
		libs = " ".join(_eject_flags(res["ldflags"], root)) if res else ""
		driver = "CXX" if any(u.cxx for u in closures[t].link) else "CC"
		# Vendored archives are prerequisites, so a changed one relinks, but
		# they are named on the command line rather than taken from $^: they
		# have to come after every object, and a group cannot be expressed by
		# a prerequisite list at all. A static target takes none of them,
		# matching what fmake itself does.
		arcs = [] if t.kind == "static" else \
		       [u.rel for u in closures[t].link if u.archive]
		arcs_txt = " ".join(arcs)
		if len(arcs) > 1:
			arcs_txt = f"-Wl,--start-group {arcs_txt} -Wl,--end-group"
		tail = ((f" {arcs_txt}" if arcs_txt else "")
		        + (f" {libs}" if libs else "") + f" $({P}LDFLAGS)")
		a(f"{t.filename}: $({P}{ident}_OBJS)"
		  + (f" {' '.join(arcs)}" if arcs else ""))
		if t.kind == "static":
			a("\trm -f $@")
			a("\t$(AR) rcs $@ $^")
		elif t.kind == "shared":
			a(f"\t$({driver}) -shared -Wl,-soname,{t.filename} -o $@ $({P}{ident}_OBJS){tail}")
		else:
			a(f"\t$({driver}) -o $@ $({P}{ident}_OBJS){tail}")
		a("")

	all_objs = sorted({f"$({P}BUILD_DIR)/{_eject_obj(rel)}.o" for rel in every})
	# Every file this build creates, named. Not `rm -rf $(BUILD_DIR)`: BUILD_DIR
	# is an ordinary Make variable and overriding it is expected usage, so
	# an empty or mistyped one removes something else entirely -- and this
	# file is handed to people to edit, with a header telling them fmake is
	# not needed to read it, so nobody reviews it. Three projects reported
	# that shape independently, two having written it themselves.
	#
	# Naming them is possible because fmake knows them: it listed every
	# object to -include the depfiles a line below. A generator that cannot
	# say what it made has no business deleting by pattern, and one that can
	# has no need to.
	#
	# The directories are left behind. Removing them would mean removing
	# something this rule did not name, which is the whole point.
	a(f"{P}CLEAN = \\")
	leavings = ([f"$({P}BUILD_DIR)/{_eject_obj(rel)}.o" for rel in sorted(every)]
	            + [f"$({P}BUILD_DIR)/{_eject_obj(rel)}.d" for rel in sorted(every)]
	            + [t.filename for t in targets]
	            + [_eject_src(j["out"]) for j in uic_jobs]
	            + [_eject_src(j["out"]) for j in moc_jobs]
	            + [_eject_src(j["out"]) for j in rcc_jobs]
	            + list(gen_outs))
	for i, item in enumerate(leavings):
		a(f"\t{item}" + (" \\" if i < len(leavings) - 1 else ""))
	a("")
	a("fmake-clean:" if fragment else "clean:")
	a(f"\trm -f $({P}CLEAN)")
	a("")
	# One named list rather than every object spelled out again on the
	# -include line. That line worked and was unpleasant to hand-edit, in a
	# file whose header invites hand-editing.
	a(f"{P}OBJS = \\")
	for n, o in enumerate(all_objs):
		a(f"\t{o}" + (" \\" if n < len(all_objs) - 1 else ""))
	a("")
	a("# Depfiles the compiler writes as a side effect, so a changed header")
	a("# rebuilds what includes it.")
	a(f"-include $({P}OBJS:.o=.d)")
	return "\n".join(L) + "\n"


def eject_ninja(targets, closures, resolutions, cfg, incflags, root, conf,
                gen_rules=None, moc=None, uic=None, rcc=None):
	"""A standalone build.ninja."""
	common = " ".join(_eject_flags(cfg.cflags + incflags, root))
	override = " ".join(_eject_flags(cfg.override, root))
	L = []
	a = L.append

	a("# Generated by `fmake --eject ninja`.")
	a("#")
	a("# Standalone: fmake is not needed to build this. Link sets were")
	a("# computed from object symbol tables rather than from the #include")
	a("# graph, so they are exact rather than inferred.")
	a("#")
	a(f"# Built for: {cfg.os}/{cfg.arch}"
	  + (f"    profile: {conf.profile_name}" if conf.profile_name else ""))
	a("")
	a("ninja_required_version = 1.5")
	a("")
	a(f"cc = {cfg.cc}")
	a(f"cxx = {cfg.cxx}")
	a(f"ar = {cfg.ar_name}")
	a(f"cflags = {common}")
	a(f"cflags_last = {override}")
	a(f"ldflags = {' '.join(_eject_flags(cfg.ldflags, root))}")
	a(f"build_dir = {EJECT_BUILD_DIR}")
	a("")
	# `deps = gcc` lets ninja read the depfile and then discard it, which is
	# what makes header dependencies free here too.
	a("rule cc")
	a("  command = $cc $cflags $extra $cflags_last -c $in -o $out -MD -MF $out.d")
	a("  depfile = $out.d")
	a("  deps = gcc")
	a("  description = CC $in")
	a("")
	a("rule cxx")
	a("  command = $cxx $cflags $extra $cflags_last -c $in -o $out -MD -MF $out.d")
	a("  depfile = $out.d")
	a("  deps = gcc")
	a("  description = CXX $in")
	a("")
	a("rule link")
	a("  command = $driver -o $out $in $arcs $libs $ldflags")
	a("  description = LD $out")
	a("")
	a("rule solink")
	a("  command = $driver -shared -Wl,-soname,$soname -o $out $in $arcs $libs $ldflags")
	a("  description = LD $out")
	a("")
	a("rule archive")
	a("  command = rm -f $out && $ar rcs $out $in")
	a("  description = AR $out")
	a("")

	gen_rules = gen_rules if gen_rules is not None else {}
	gen_outs = []
	for name in _gen_order(gen_rules):
		r = gen_rules[name]
		cmds = []
		for c in (r.get("commands") or [r["command"]]):
			line, _quiet, ignore = _recipe_prefix(c)
			line = _gen_command(line, r["inputs"], r["outputs"], None,
			                    r.get("stem"))
			# Ninja reads $ as its own escape, so the shell's must be doubled.
			cmds.append(line.replace("$", "$$") + (" || true" if ignore else ""))
		a(f"rule gen_{_mk_ident(name)}")
		a(f"  command = {' && '.join(cmds)}")
		a(f"  description = GEN {r.get('description') or name}")
		a("")
		deps = r.get("depends", [])
		a(f"build {' '.join(_ninja(o) for o in r['outputs'])}: "
		  f"gen_{_mk_ident(name)} "
		  f"{' '.join(_ninja(i) for i in r['inputs'])}"
		  + (" | " + " ".join(_ninja(d) for d in deps) if deps else ""))
		gen_outs += r["outputs"]
	if gen_rules:
		a("")

	every = {}
	for t in targets:
		for u in closures[t].link:
			if not u.archive:       # prebuilt: there is nothing to compile
				every[u.rel] = u

	uic = uic or {}
	uic_jobs = uic.get("jobs") or []
	if uic_jobs:
		a('# Selected by `#include "ui_*.h"` in the source, not by a list.')
		a(f"uic = {uic['exe']}")
		a("")
		a("rule uic")
		a("  command = $uic $in -o $out")
		a("  description = UIC $in")
		a("")
		for j in uic_jobs:
			a(f"build {_ninja(_eject_src(j['out']))}: uic {_ninja(j['src'])}")
		a("")

	rcc = rcc or {}
	rcc_jobs = [j for j in (rcc.get("jobs") or []) if j["out"] in every]
	if rcc_jobs:
		a("# Selected by what the source opens, not by a list.")
		a(f"rcc = {rcc['exe']}")
		a("")
		a("rule rcc")
		a("  command = $rcc --name $resname $in -o $out")
		a("  description = RCC $in")
		a("")
		for j in rcc_jobs:
			a(f"build {_ninja(_eject_src(j['out']))}: rcc {_ninja(j['src'])}")
			a(f"  resname = {j['name']}")
		a("")

	moc = moc or {}
	moc_jobs = [j for j in (moc.get("jobs") or [])
	            if (j["src"] if j["inline"] else j["out"]) in every]
	if moc_jobs:
		a("# Selected by Q_OBJECT in the source, not by a list.")
		a(f"moc = {moc['exe']}")
		a(f"mocflags = {' '.join(_eject_flags(moc.get('flags', []), root))}")
		a("")
		a("rule moc")
		a("  command = $moc $mocflags $in -o $out")
		a("  description = MOC $in")
		a("")
		for j in moc_jobs:
			a(f"build {_ninja(_eject_src(j['out']))}: moc {_ninja(j['src'])}")
		a("")
	# The uic headers and .moc bodies are #included rather than compiled, so
	# nothing declares a dependency on them until a depfile exists.
	gen_outs = gen_outs + [_eject_src(j["out"]) for j in uic_jobs] \
	           + [_eject_src(j["out"]) for j in moc_jobs if j["inline"]]

	# Order-only: a generated header must exist before anything compiles,
	# but the depfiles decide when a change to it forces a rebuild.
	after = (" || " + " ".join(_ninja(g) for g in gen_outs)) if gen_outs else ""
	for rel in sorted(every):
		u = every[rel]
		a(f"build $build_dir/{_ninja(_eject_obj(rel))}.o: "
		  f"{'cxx' if u.cxx else 'cc'} {_ninja(_eject_src(rel))}{after}")
		if u.own:
			a(f"  extra = {' '.join(_eject_flags(u.own, root))}")
	a("")

	for t in targets:
		objs = " ".join(f"$build_dir/{_ninja(_eject_obj(u.rel))}.o"
		                for u in closures[t].link if not u.archive)
		arcs = [] if t.kind == "static" else \
		       [u.rel for u in closures[t].link if u.archive]
		rule = {"static": "archive", "shared": "solink"}.get(t.kind, "link")
		# Implicit inputs so a changed archive relinks; the command line
		# places them after the objects and groups them when there is more
		# than one, neither of which an input list can express.
		after = (" | " + " ".join(_ninja(x) for x in arcs)) if arcs else ""
		a(f"build {_ninja(t.filename)}: {rule} {objs}{after}")
		if t.kind != "static":
			a(f"  driver = ${'cxx' if any(u.cxx for u in closures[t].link) else 'cc'}")
			if t.kind == "shared":
				a(f"  soname = {t.filename}")
			if arcs:
				txt = " ".join(arcs)
				if len(arcs) > 1:
					txt = f"-Wl,--start-group {txt} -Wl,--end-group"
				a(f"  arcs = {txt}")
			res = resolutions.get(t)
			if res and res["ldflags"]:
				a(f"  libs = {' '.join(_eject_flags(res['ldflags'], root))}")
	a("")
	# Same split as the Makefile: `ninja` builds the programs, `ninja test`
	# builds and runs the test binaries. Ninja has no recipe for a phony
	# beyond its inputs, so running them is a rule of its own.
	plain = [t for t in targets if not t.test]
	by_group = {}
	for t in targets:
		if t.test:
			by_group.setdefault(t.test_group, []).append(t)
	a(f"default {' '.join(_ninja(t.filename) for t in plain)}")
	for g in sorted(by_group):
		members = sorted(by_group[g], key=lambda x: x.name)
		a("")
		cmds = " && ".join(
		    "./" + " ".join(shlex.quote(x) for x in [t.filename]
		                    + list(t.conf.get("test-args", [])))
		    for t in members)
		a(f"rule run_{_mk_ident(g)}")
		a(f"  command = {cmds}")
		a(f"  description = RUN {g}")
		a("  pool = console")
		a(f"build run-{g}: run_{_mk_ident(g)} | "
		  f"{' '.join(_ninja(t.filename) for t in members)}")
		a(f"build {g}: phony run-{g}")
	return "\n".join(L) + "\n"

# ---------------------------------------------------------------------------
# Install
#
# The one thing @headers is for. Which headers form a library's public
# interface is the header question that genuinely is not inferable -- the
# #include scan knows what a TU consumes, not what the project means to
# publish -- so it has to be declared, and this is what declaring it buys.
# ---------------------------------------------------------------------------

INSTALL_DEFAULTS = {"prefix": "/usr/local", "bindir": "bin",
                    "libdir": "lib", "includedir": "include"}


def install_paths(conf, args):
	p = dict(INSTALL_DEFAULTS)
	p.update({k: v for k, v in conf.install.items() if v})
	if args.prefix:
		p["prefix"] = args.prefix
	dest = args.destdir or ""
	out = {}
	for key in ("bindir", "libdir", "includedir"):
		sub = p[key]
		full = sub if os.path.isabs(sub) else os.path.join(p["prefix"], sub)
		out[key] = os.path.join(dest, full.lstrip("/")) if dest else full
	out["prefix"] = p["prefix"]
	return out


def do_install(targets, closures, root, outdir, conf, args):
	paths = install_paths(conf, args)
	planned = []

	for t in targets:
		built = os.path.join(outdir, t.filename)
		if not os.path.exists(built):
			die(f"{t.filename} has not been built")
		where = paths["bindir"] if t.kind == "exe" else paths["libdir"]
		planned.append((built, os.path.join(where, t.filename),
		                0o755 if t.kind != "static" else 0o644))

		# @headers is gathered only for libraries: a program does not
		# publish an API, and the file carrying the directive is often
		# linked into one of the tree's programs as well, which would
		# otherwise install the same header twice under two owners.
		# An explicit list in fmake.toml is honoured for any kind, since
		# naming it outright is a decision rather than an inference.
		heads = list(t.conf.get("headers", []))
		if t.kind != "exe":
			for u in closures[t].link:
				heads += u.ann.items("headers")
		for h in dict.fromkeys(heads):
			src = os.path.join(root, h)
			if not os.path.isfile(src):
				die(f"@headers {h!r} does not exist (named for {t.name})")
			planned.append((src,
			                os.path.join(paths["includedir"],
			                             os.path.basename(h)), 0o644))

	seen, unique = set(), []
	for item in planned:
		if item[1] not in seen:
			seen.add(item[1])
			unique.append(item)
	planned = unique

	if not planned:
		info("nothing to install")
		return 0

	for src, dst, mode in planned:
		rel = _rel(src, root)
		if args.dry_run:
			print(f"install -m {mode:o} {rel} {dst}")
			continue
		os.makedirs(os.path.dirname(dst), exist_ok=True)
		shutil.copy2(src, dst)
		os.chmod(dst, mode)
		print(f"{GREEN('->')} {dst}")

	if not args.dry_run:
		info(f"installed {len(planned)} file(s) under {paths['prefix']}")
	return 0

# ---------------------------------------------------------------------------
# Housekeeping
# ---------------------------------------------------------------------------

def ensure_gitignore(root):
	if not os.path.isdir(os.path.join(root, ".git")):
		return
	path = os.path.join(root, ".gitignore")
	try:
		with open(path) as fh:
			if any(l.strip().rstrip("/") == STATE_DIR for l in fh):
				return
	except OSError:
		pass
	try:
		with open(path, "a") as fh:
			fh.write(f"{STATE_DIR}/\n")
	except OSError:
		pass


def do_clean(root):
	"""Remove the state directory, having checked it is the state directory.

	This is the one shape a wholesale removal is allowed to take: a
	directory the tool itself created, and which holds nothing else. Even
	then the path is verified rather than trusted, because the way a clean
	target eats something it should not is always a variable that did not
	contain what everyone assumed.

	A symlink is refused rather than followed -- `shutil.rmtree` declines a
	symlink anyway, but saying so is better than the traceback.
	"""
	state = os.path.join(root, STATE_DIR)
	if os.path.basename(state.rstrip(os.sep)) != STATE_DIR:
		die(f"refusing to clean {state!r}: that is not {STATE_DIR}/")
	if os.path.islink(state):
		die(f"refusing to clean {state!r}: it is a symlink, and what it "
		    f"points at is not fmake's to remove")
	if not os.path.isdir(state):
		info("nothing to clean")
		return 0
	count = sum(len(fs) for _d, _sub, fs in os.walk(state))
	shutil.rmtree(state)
	info(f"removed {STATE_DIR}/ ({count} file(s))")
	return 0

# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def parse_args(argv):
	p = argparse.ArgumentParser(
	    prog="fmake",
	    description="Build C and C++ programs with no build file.",
	    formatter_class=argparse.RawDescriptionHelpFormatter,
	    epilog="The link set is computed from object symbol tables, not from "
	           "the #include graph. Run --explain to see every decision.")
	p.add_argument("targets", nargs="*",
	               help="program(s) to build (default: all)")
	p.add_argument("-C", "--directory", default=".",
	               help="build the tree rooted here (default: .)")
	p.add_argument("-j", "--jobs", type=int, default=0,
	               help="parallel compile jobs (default: cpu count)")
	p.add_argument("--run", default=None, metavar="FILE",
	               help="build FILE and run it, passing everything after it "
	                    "as its arguments; for a C or C++ file used as a "
	                    "script, by shebang or binfmt_misc")
	p.add_argument("-o", "--output", default=None,
	               help="where to put the binaries (default: project root)")
	p.add_argument("--explain", action="store_true",
	               help="print the inferred build and exit")
	p.add_argument("-n", "--dry-run", action="store_true",
	               help="print commands without running them")
	p.add_argument("-B", "--always-make", action="store_true",
	               help="ignore the object cache and rebuild everything")
	p.add_argument("--clean", action="store_true",
	               help=f"remove {STATE_DIR}/ and exit")
	# One shell-quoted string rather than nargs="+", so that flags starting
	# with a dash are not mistaken for fmake's own options. $CFLAGS and
	# $LDFLAGS are honoured too, as make does.
	p.add_argument("--cflags", action="append", default=[], metavar="'FLAGS'",
	               help=f"replace the default compile flags "
	                    f"({' '.join(DEFAULT_CFLAGS)}); also read from $CFLAGS")
	p.add_argument("--ldflags", action="append", default=[], metavar="'FLAGS'",
	               help="extra link flags, e.g. --ldflags='-lm -lcmocka'; "
	                    "also read from $LDFLAGS")
	p.add_argument("--force-link", action="append", default=[],
	               metavar="SRC",
	               help="compile and link these files regardless of whether "
	                    "any symbol reaches them (constructor-registered "
	                    "plugins, dlopen targets)")
	p.add_argument("--widen-all", action="store_true",
	               help="compile every source in the tree before closing, "
	                    "instead of filtering candidates by symbol name")
	p.add_argument("--eject", nargs="?", const="make", default=None,
	               choices=("make", "make-fragment", "ninja"),
	               metavar="make|make-fragment|ninja",
	               help="write a build file to stdout and exit; needs no "
	                    "fmake to run afterwards. make-fragment is the same "
	                    "rules for an existing Makefile to include, with no "
	                    "default goal and FM_-prefixed variables")
	p.add_argument("-p", "--profile", default=None, metavar="NAME",
	               help=f"build profile from [profile.NAME] in {CONF_FILE}")
	p.add_argument("--install", action="store_true",
	               help="build, then install the artifacts and their "
	                    "@headers")
	p.add_argument("--prefix", default=None,
	               help="install prefix (default /usr/local, or [install])")
	p.add_argument("--destdir", default=None,
	               help="staging root prepended to every install path")
	p.add_argument("--doxygen-aliases", action="store_true",
	               help="print an ALIASES block for your Doxyfile, so Doxygen "
	                    "renders the directives instead of warning about them")
	p.add_argument("--man", action="store_true",
	               help="print this manual as a roff page, for packaging")
	p.add_argument("--no-libs", action="store_true",
	               help="do not resolve external symbols to libraries; pass "
	                    "every -l and -I yourself")
	# -V rather than -v: the lower case is taken by --verbose, and a build
	# tool uses that one far more often than it reports its own version.
	p.add_argument("-V", "--version", action="version",
	               version=f"fmake {VERSION}\n{AUTHOR}\n{LICENCE}")
	p.add_argument("-v", "--verbose", action="store_true")
	p.add_argument("-q", "--quiet", action="store_true")
	# argparse refuses a value that looks like an option, so `--ldflags -lm`
	# fails where `--ldflags=-lm` works. Since -l is exactly what anyone will
	# type, rewrite the separated form into the joined one first.
	# Everything after `--run FILE` belongs to the program, not to fmake.
	# An interpreter is invoked as `fmake --run script.c a b -c`, and -c is
	# the script's business. So the split is positional and the rule is
	# simple to state: fmake's own options come before --run.
	run_args = []
	if "--run" in argv:
		at = argv.index("--run")
		if at + 1 >= len(argv):
			die("--run needs a file")
		run_args = argv[at + 2:]
		argv = argv[:at] + ["--run", argv[at + 1]]

	joined, i = [], 0
	while i < len(argv):
		a = argv[i]
		if a in ("--cflags", "--ldflags") and i + 1 < len(argv):
			joined.append(f"{a}={argv[i + 1]}")
			i += 2
			continue
		joined.append(a)
		i += 1

	args = p.parse_args(joined)
	# Kept so --man can describe the options from the parser that defines
	# them, rather than from a second list that would go stale.
	parse_args.parser = p

	def flags(given, env):
		out = []
		for chunk in ([os.environ[env]] if env in os.environ else []) + given:
			out += shlex.split(chunk)
		return out

	args.cflags     = flags(args.cflags,  "CFLAGS")
	args.ldflags    = flags(args.ldflags, "LDFLAGS")
	args.force_link = [f for chunk in args.force_link
	                   for f in shlex.split(chunk)]
	args.run_args = run_args
	return args


def _locked_build(args):
	"""Hold the tree lock for the whole build.

    Only at the outermost level: the nested build a `uses` generator triggers
    runs inside this one and must not wait for it.
    """
	# Checked here rather than in build(), which is where the same test used
	# to live: the lock is taken first, and creating .fmake under a path that
	# is a file -- or under a directory nobody may write to -- raised an
	# OSError from os.makedirs with a traceback attached. A traceback is
	# never the right answer to a mistyped argument.
	root = os.path.abspath(args.directory)
	if not os.path.exists(root):
		die(f"no such directory: {args.directory}")
	if not os.path.isdir(root):
		die(f"not a directory: {args.directory}")
	with TreeLock(os.path.join(root, STATE_DIR)):
		return build(args)


def main(argv):
	global VERBOSE, PROGRESS
	args = parse_args(argv)
	VERBOSE = args.verbose
	if args.eject:
		PROGRESS = sys.stderr
	if args.doxygen_aliases:
		sys.stdout.write(doxygen_aliases())
		return 0
	if args.man:
		sys.stdout.write(man_page(parse_args.parser))
		return 0
	if args.run:
		# The script's own directory, so its siblings are in the tree and
		# the closure can reach them: `--run` builds a program, not a file.
		# Unless nobody may write there, in which case a cache of its own.
		if args.directory == ".":
			args.directory, args.run_with_siblings = run_root(args.run)
			os.makedirs(args.directory, exist_ok=True)
		else:
			args.run_with_siblings = True
		# A script's output is the script's. Progress belongs on stderr at
		# most, and only when asked for.
		if not args.verbose:
			args.quiet = True
	root = os.path.abspath(args.directory)
	if args.clean:
		return do_clean(root)
	ensure_gitignore(root)
	if args.run:
		if not os.path.isfile(args.run):
			die(f"--run: no such file: {args.run}")
		PROGRESS = sys.stderr
		rc = _locked_build(args)
		if rc:
			return rc
		exe = os.path.join(root, RUN_DIR,
		                   default_name(
		                       stage_run_source(
		                           root, args.run,
		                           alone=not args.run_with_siblings),
		                       root))
		if not os.path.exists(exe):
			die(f"--run: {args.run} built nothing to run")
		# exec rather than run: the program inherits this process, so its
		# exit status, its signals and its terminal are its own, and fmake
		# is not sitting between it and the shell.
		try:
			os.execv(exe, [args.run] + args.run_args)
		except OSError as exc:
			die(f"--run: {exc}")
	return _locked_build(args)


if __name__ == "__main__":
	try:
		sys.exit(main(sys.argv[1:]))
	except KeyboardInterrupt:
		print(f"\n{RED('!!!')} Interrupted.")
		sys.exit(130)
	except BrokenPipeError:
		os._exit(0)
