def _switch(name, env=None):
	"""An on/off environment variable, read the way a person means it.

    Make's `ifdef` calls any set variable true, so `DEBUG=0` enables it --
    which the sibling Makefiles document as a footgun they cannot avoid,
    because `ifdef` genuinely cannot tell "0" from "on". Nothing forces
    that here, and `0` meaning off is what the person typing it means.
    """
	value = (env if env is not None else os.environ).get(name, "")
	return bool(value) and value != "0"


def debug_wanted(env=None):
	"""Whether $DEBUG asks for a debuggable build."""
	return _switch("DEBUG", env)


def sanitize_wanted(env=None):
	"""Whether $SANITIZE asks for the address and UB sanitizers."""
	return _switch("SANITIZE", env)


def default_cflags(env=None):
	return list(DEBUG_CFLAGS if debug_wanted(env) else DEFAULT_CFLAGS)


def default_rustflags(env=None):
	return list(DEBUG_RUSTFLAGS if debug_wanted(env) else DEFAULT_RUSTFLAGS)
