# --explain
# ---------------------------------------------------------------------------

def _rel(path, root):
	"""Shorten absolute paths for display; commands stay copy-pasteable."""
	try:
		r = os.path.relpath(path, root)
	except ValueError:
		return path
	return path if r.startswith("..") else r


def _col(text, width):
	"""Left-justify into a column, but never let a long name touch its text.

	A generated moc path is longer than the column, and `:<{W}}` simply
	stops padding when it overflows -- so the filename and its explanation
	run together with no separator. On a Qt tree that is most of the
	report: one project counted 547 such lines.
	"""
	return text.ljust(width) if len(text) < width else text + " "


def _show_cmd(cmd, root):
	out = []
	for a in cmd:
		if os.path.isabs(a):
			out.append(_rel(a, root))
		elif a[:2] in ("-I", "-L") and os.path.isabs(a[2:]):
			out.append(a[:2] + _rel(a[2:], root))
		else:
			out.append(a)
	return " ".join(out)


def explain(t, cl, cfg, incflags, outdir, all_units, root, other_roots=(),
            res=None, excluded=None, conf=None, moc=None, uic=None,
            rcc=None):
	W = 36
	name = t.filename
	if t.conf.get("name") or t.conf.get("kind") or t.conf.get("sources"):
		named = f"[target.*] in {CONF_FILE}"
	elif t.ann.scalar("target"):
		named = "@target"
	else:
		named = "no @target"
	print(f"{BOLD('target')} {BOLD(name)} ({t.kind})  {DIM('[' + named + ']')}")

	# Where the kind came from, and -- when nothing said -- that something
	# could. A tree of library sources with one test beside it is the shape
	# a build system is most annoying for, and fmake builds it correctly
	# today: the library units link into the test and there is no archive,
	# which is right for that binary and not what the project ships. One
	# project declined over this without finding @kind, having read --help
	# and found nothing that says these translation units are a library.
	# The line costs nothing and is printed where the question is asked.
	if t.conf.get("kind"):
		how = f"[target.*] in {CONF_FILE} says so"
	elif t.ann.scalar("kind"):
		how = f"@kind in {t.rel}"
	elif cl.root.crate_exe:
		# @kind does not decide this one. A crate with a `fn main()' is a
		# program and one without is a library, because that is what rustc
		# will accept -- a staticlib built from a crate whose main() is not
		# `#[no_mangle]' exports no entry point and links to nothing.
		how = f"{t.rel} is a crate root defining main()"
	elif t.kind == "exe":
		how = f"{t.rel} defines main(); @kind static builds an archive instead"
	else:
		how = "nothing here defines main()"
	print(f"  {_col(CYAN('kind'), W)}{DIM(f'{t.kind}: {how}')}")
	if t.test:
		role = (f"{t.test_why}; not built by default, "
		        f"`fmake {t.test_group}` builds and runs it")
		print(f"  {_col(CYAN('test'), W)}{DIM(role)}")

	if t.members is not None:
		print(f"  {_col(CYAN('membership'), W)}"
		      f"{DIM('declared, so the closure is not consulted')}")

	# Directives are reported per file, because an unknown one is ignored in
	# silence and this is the only place a typo becomes visible.
	seen = [(u.rel, u.ann) for u in cl.link if u.ann]
	if seen:
		print(f"  {CYAN('directives')}")
		for rel, ann in seen:
			for d in ann.names():
				# Read each directive the way it is declared, not uniformly.
				vals = (ann.scalar(d, "") if d in DIRECTIVE_SCALAR
				        else " ".join(ann.items(d))) or "(no arguments)"
				head = f"@{d} {vals}"
				if len(head) > W - 5:
					head = head[:W - 8] + "..."
				print(f"    {_col(head, W-4)}"
				      f"{DIM(rel + ':' + str(ann.line(d)))}")

	if conf:
		print(f"  {CYAN('configuration')}")
		print(f"    {_col(CONF_FILE, W-4)}"
		      f"{DIM('profile: ' + (conf.profile_name or 'none'))}")
		if cfg.os != host_os() or cfg.arch != host_arch():
			where = (cfg.os + "/" + cfg.arch + "  (host is "
			         + host_os() + "/" + host_arch() + ")")
			print(f"    {_col('building for', W-4)}{DIM(where)}")

	# Which moc, not just that one ran. Two Qt versions on one machine is
	# ordinary, their moc output is not interchangeable, and the failure when
	# the wrong one is picked is an undefined symbol that names none of this.
	if moc and moc.get("jobs"):
		n = len(moc["jobs"])
		print(f"  {CYAN('moc')}")
		print(f"    {_col(_rel(moc['exe'], root), W-4)}"
		      f"{DIM(f'{n} file(s) declare Q_OBJECT; found via pkg-config')}")
	if uic and uic.get("jobs"):
		n = len(uic["jobs"])
		print(f"  {CYAN('uic')}")
		print(f"    {_col(_rel(uic['exe'], root), W-4)}"
		      f"{DIM(f'{n} ui_*.h header(s) included; found via pkg-config')}")
	if rcc and rcc.get("jobs"):
		linked = {u.rel for u in cl.link}
		print(f"  {CYAN('resources')}")
		for j in rcc["jobs"]:
			why = next((f"{w} in {f}" for f, w in sorted(j["users"].items())),
			           "")
			mark = why if j["out"] in linked else "not opened by this program"
			print(f"    {_col(j['src'], W-4)}{DIM(mark)}")

	if excluded:
		print(f"  {CYAN('excluded here')}")
		for rel, why in sorted(excluded.items()):
			print(f"    {_col(rel, W-4)}{DIM(why)}")
	if cl.root.crate_exe:
		how = "[the crate; rustc resolves the rest from crate metadata]"
	elif t.members is not None:
		how = f"[declared in {CONF_FILE}]"
	elif t.kind != "exe":
		how = "[every TU in the tree; a library is not pruned]"
	else:
		how = "[symbol closure from " + _rel(cl.root.obj, root) + "]"
	print(f"  {_col(CYAN('link set'), W)}{DIM(how)}")
	if cl.root.crate_exe:
		# The members are the crate, so they are listed. They are not link
		# set entries and saying "<- some symbol" about one would be a
		# claim nothing measured: rustc read them from the root.
		print(f"    {_col(cl.root.rel, W-4)}{DIM('crate root: defines main()')}")
		for m in sorted(crate_inputs(cl.root, root)):
			m = _rel(m, root)
			if m != cl.root.rel:
				print(f"    {_col(m, W-4)}{DIM('module of the crate')}")
	for u in cl.link if not cl.root.crate_exe else []:
		if u is cl.root and t.kind == "exe":
			print(f"    {_col(u.rel, W-4)}{DIM('root: defines main()')}")
		elif u is cl.root:
			print(f"    {_col(u.rel, W-4)}{DIM('part of the library')}")
		else:
			sym, by = cl.why.get(u.rel, ("?", "?"))
			why = sym if not by else f"<- {sym}  ({by})"
			print(f"    {_col(u.rel, W-4)}{DIM(why)}")

	# Other programs' roots are compiled but obviously not part of this one;
	# listing them as unreachable reads like a problem when it isn't.
	linked = {u.rel for u in cl.link}
	spare = [u for u in all_units
	         if u.rel not in linked and u.rel not in other_roots]
	if spare:
		print(f"  {CYAN('compiled, not linked')}")
		for u in spare:
			print(f"    {_col(u.rel, W-4)}{DIM('defines nothing reachable')}")

	if res and (res["chosen"] or res["unresolved"] or res["unused"]):
		print(f"  {_col(CYAN('libraries'), W)}"
		      f"{DIM('[from the external symbols above]')}")
		for lib in res["chosen"]:
			syms = res["why"].get(lib, [])
			shown = ", ".join(syms[:3]) + (" ..." if len(syms) > 3 else "")
			src = res["proposed"].get(lib)
			tag = f"[also {src[2]} at {src[1]}]" if src else ""
			print(f"    -l{lib:<{W-6}}{DIM(shown)}")
			if tag:
				print(f"    {_col('', W-4)}{DIM(tag)}")
			for alt in res["alts"].get(lib, [])[:3]:
				print(f"    {_col('', W-4)}{DIM('could also come from -l' + alt)}")
		for lib, (module, where, header) in sorted(res["unused"].items()):
			if lib in res.get("compiled_away", {}):
				why = (f"{header} at {where} suggests {module}, but the "
				       f"preprocessor never opened it")
			else:
				why = (f"{header} at {where} suggests {module}, but no "
				       f"symbol needs it")
			print(f"    {_col('(not linked)', W-4)}{DIM(why)}")
		for lib in res.get("declared", []):
			print(f"    {_col('-l' + lib, W-4)}"
			      f"{DIM('declared with @libs / @pkg; linked regardless')}")
		for w in res.get("wrap", []):
			print(f"    {_col('-Wl,--wrap=' + w, W-4)}"
			      f"{DIM('the link set defines __wrap_' + w)}")
		if res["unresolved"]:
			print(f"    {_col('(unresolved)', W-4)}"
			      f"{DIM(', '.join(res['unresolved'][:6]))}")
			says = ("no " + describe_identity(res.get("ident"))
			        + " library exports these -- name it with --ldflags")
			print(f"    {_col('', W-4)}{DIM(says)}")

	if VERBOSE:
		print(f"  {_col(CYAN('library search'), W)}"
		      f"{DIM(describe_identity((res or {}).get('ident')) + ' only')}")
		for d in cfg.libdirs:
			shown = os.path.normpath(_rel(d, root))
			if len(shown) > W - 5:
				shown = "..." + shown[-(W - 8):]
			print(f"    {_col(shown, W-4)}"
			      f"{DIM(str(len(linkable_libs([d]))) + ' linkable')}")

	if cl.external:
		implicit = len(res["implicit"]) if res else 0
		named = sum(len(v) for v in (res["why"].values() if res else []))
		tally = (f"[{len(cl.external)} total, {implicit} in libc, "
		         f"{named} from the libraries above]")
		print(f"  {_col(CYAN('external symbols'), W)}{DIM(tally)}")
		for sym in sorted(cl.external)[:12]:
			print(f"    {_col(sym, W-4)}"
			      f"{DIM('referenced by ' + cl.external[sym][0])}")
		if len(cl.external) > 12:
			print(f"    {DIM('... and %d more (-v for all)' % (len(cl.external) - 12))}")

	ldflags = (res["ldflags"] if res else []) + cfg.link_flags()
	print(f"  {CYAN('flags')}")
	if cl.root.crate_exe:
		# The C bands say nothing about this target: rustc never sees them.
		print(f"    {' '.join(cfg.rustflags)}")
	else:
		print(f"    {' '.join(cfg.cflags + ['-I' + _rel(f[2:], root) if f.startswith('-I') else f for f in incflags] + cfg.override)}")
		if ldflags:
			print(f"    {' '.join(ldflags)}")
	print(f"  {CYAN('argv')}")
	# Prebuilt archives have no compile command to show, only a place on the
	# link line below -- and a crate program has none either, because the
	# one command below is the whole of its build.
	built = [u for u in cl.link if not u.prebuilt and u.obj]
	for u in built[:2]:
		print(f"    {DIM(_show_cmd(compile_cmd(u, cfg, incflags), root))}")
	if len(built) > 2:
		print(f"    {DIM('... %d more' % (len(built) - 2))}")
	# The same call the linker gets, not a second rendering of it.
	shown = link_cmd(t, cl, cfg, outdir, res["ldflags"] if res else [])
	print(f"    {DIM(_show_cmd(shown, root))}")

	# What ships. The packaging evaluation asked for exactly this: "which
	# files are products, which are intermediates, which are meant to
	# ship -- knowledge fmake has and currently keeps". It has it in
	# install_plan, which is the same list --install and both ejected
	# builds read, so this cannot drift from what actually happens.
	#
	# Directories as the variables rather than resolved paths, because a
	# packager stages under a different prefix than the one a plain build
	# would use, and the names are what a debian/rules is written against.
	if conf is not None:
		plan = [p for p in install_plan([t], {t: cl}, root)]
		if plan:
			print(f"  {CYAN('installs')}")
			for origin, source, directory, name, _mode in plan:
				var = "$" + directory.upper()[:-3] + "DIR" \
				    if directory != "pkgconfigdir" else "$PKGCONFIGDIR"
				arrow = "->" if origin != "symlink" else "->(link)"
				print(f"    {name:<{W}}{arrow} {var}"
				      + (f"   [{source}]" if origin == "symlink" else ""))
	print()

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------

def build(args, _bootstrapping=False):
	root = os.path.abspath(args.directory)
	if not os.path.isdir(root):
		die(f"no such directory: {args.directory}")

	state  = os.path.join(root, STATE_DIR)
	cache  = Cache(os.path.join(state, CACHE_FILE))
	conf   = Conf(load_conf(root), args.profile)
	# fmake.mk may carry project-scope directives beside its rules. They fold
	# into [project], so the two files say the same things the same way and
	# a project needing both a rule and a flag needs only one of them.
	for name, args_ in mk_directives(root).items():
		key = {"define": "define"}.get(name, name)
		conf.project[key] = list(conf.project.get(key, [])) + args_
		if name == "std" and args_:
			conf.project["std"] = args_[-1]
	if getattr(args, "use_build_toolchain", False):
		# A tool built to run here is a separate build for a separate
		# machine, so it takes none of the target's flags. Inheriting them
		# is not a small inaccuracy: -march=armv8-a, or a --sysroot pointing
		# at the target's filesystem, simply will not compile here.
		bt = conf.build_tool_conf
		conf.tool = bt
		conf.project = {k: v for k, v in bt.items()
		                if k in ("cflags", "defines", "std")}
		conf.profile = {}
	cfg    = Config(args, conf)
	# Built here rather than where the -I flags are worked out, because moc
	# has to run before the tree is complete and it is pkg-config that knows
	# where moc lives.
	pkg    = PkgConfig(cfg.pkgexe, cfg.sysroot, cfg.triplet)
	# Before anything resolves a header, so that every Qt answer in this
	# build comes from the one major -- including the moc outputs, whose
	# includes are the ones that gave the disagreement away.
	pkg.qt_order = qt_preference(cfg.moc, pkg)
	outdir = os.path.abspath(args.output) if args.output else root
	if args.run and not args.output:
		# Nothing appears beside the script. The answer to "does it clean
		# up" is that it never dirties: the binary and its objects live
		# under the state directory, which is also what makes the second
		# run of a script instant rather than a rebuild.
		outdir = os.path.join(root, RUN_DIR)
		os.makedirs(outdir, exist_ok=True)
	jobs   = args.jobs or (os.cpu_count() or 4)

	bootstrapped = []

	def build_tool(name):
		"""Build a target from this tree so a generator can run it.

        A nested build restricted to that one target, into a scratch
        directory. The tool is an ordinary program as far as fmake is
        concerned -- closure, libraries and all -- it just happens to be
        built first and consumed rather than shipped.
        """
		if _bootstrapping:
			die(f"{CONF_FILE}: [generate.*] uses = {name!r}, but that is "
			    f"itself being built to run a generator. A tool cannot "
			    f"depend on its own output.")
		tooldir = os.path.join(state, "tools")
		os.makedirs(tooldir, exist_ok=True)
		sub = argparse.Namespace(**vars(args))
		sub.targets, sub.output = [name], tooldir
		sub.explain = sub.install = False
		sub.eject, sub.dry_run = None, False
		sub.quiet = not VERBOSE
		# A generator runs here, on the machine doing the building, so it must
		# not be compiled with the toolchain aimed at the target. That is what
		# [build-toolchain] is for, and without it a cross build would produce
		# a tool it cannot execute.
		sub.use_build_toolchain = True
		sub.cflags, sub.ldflags = [], []
		say(f"{YELLOW('TOOL')} {name}")
		bootstrapped.append(name)
		if build(sub, _bootstrapping=True) != 0:
			die(f"could not build {name!r}, which a generator needs")
		for cand in (name, f"lib{name}.so", f"lib{name}.a"):
			path = os.path.join(tooldir, cand)
			if not os.path.exists(path):
				continue
			# Checked rather than inferred: whatever came out has to run on
			# this machine, whatever anyone declared.
			want, got = host_elf_machine(), elf_identity(path)
			if want is not None and got is not None and got[2] != want:
				die(f"{name!r} was built for {describe_identity(got)} and "
				    f"cannot run here.\nA generator runs on the build "
				    f"machine, so give it a [build-toolchain] in "
				    f"{CONF_FILE}.")
			return path
		die(f"built {name!r} but found no artifact in {_rel(tooldir, root)}")

	# Generators run before anything looks at the tree, so their output is
	# an ordinary source from here on -- seen by the include graph, the
	# closure and the symbol tables alike, with no special case anywhere.
	# A file that cannot be read is set aside rather than fatal. One
	# unreadable stray in a directory should not stop a tree from building,
	# and if it was actually needed the closure says so in its own terms --
	# an undefined symbol naming what is missing, rather than a traceback
	# naming a file nobody asked about.
	scans, unreadable = {}, {}

	def scan_all(files):
		for rel in files:
			if rel in scans or rel in unreadable:
				continue
			try:
				scans[rel] = cache.scan(os.path.join(root, rel), rel)
			except OSError as exc:
				unreadable[rel] = f"unreadable: {exc.strerror or exc}"

	# Scanned before generating, because @rule lives in a comment and cannot
	# be read any other way -- and again afterwards, because generating adds
	# files nobody has looked at. The two-pass scan section 7 once said was
	# unnecessary turns out to be exactly what putting rules in comments
	# costs.
	srcs, hdrs = walk_tree(root)
	if args.run:
		# Staged like a generated source, and for the same reason: from
		# here on it is an ordinary source that the include graph, the
		# closure and the symbol tables see with no special case.
		run_rel = stage_run_source(root, args.run,
		                           alone=not args.run_with_siblings)
		if run_rel not in srcs:
			srcs.append(rel_ := run_rel)
			srcs.sort()
		# The original carries the shebang the copy exists to remove, so it
		# must not also be compiled -- two mains, and one of them will not
		# parse.
		original = os.path.relpath(os.path.abspath(args.run), root)
		if run_rel != original and original in srcs:
			srcs.remove(original)
		args.targets = [default_name(run_rel, root)]
	scan_all(srcs + hdrs)

	generated = run_generators(root, conf, cache, args.dry_run,
	                           None if _bootstrapping else build_tool,
	                           [r for r in srcs if r in scans], scans)
	if bootstrapped:
		# A nested build wrote object entries to the same cache file. Merge
		# them in rather than replacing this cache, which still holds the
		# generator freshness keys that were just written and are not on
		# disk yet.
		disk = Cache(os.path.join(state, CACHE_FILE))
		for section in ("files", "objects"):
			merged = dict(disk.data.get(section, {}))
			merged.update(cache.data.get(section, {}))
			cache.data[section] = merged
		cache.files = cache.data["files"]
		cache.objects = cache.data["objects"]

	if generated:
		srcs, hdrs = walk_tree(root)
		for rel in generated:
			ext = os.path.splitext(rel)[1]
			if ext in SRC_EXTS and rel not in srcs:
				srcs.append(rel)
			elif ext in HDR_EXTS and rel not in hdrs:
				hdrs.append(rel)
		srcs.sort()
		hdrs.sort()
		scan_all(srcs + hdrs)

	gen_dirs = sorted({os.path.dirname(g) for g in generated
	                   if os.path.splitext(g)[1] in HDR_EXTS})
	if not srcs:
		die("no C, C++, assembly or Rust source files found here")

	for rel in list(unreadable):
		if rel in srcs:
			srcs.remove(rel)
		elif rel in hdrs:
			hdrs.remove(rel)
	if unreadable:
		for rel, why in sorted(unreadable.items())[:5]:
			warn(f"{rel}: {why}")
		if len(unreadable) > 5:
			note(f"... and {len(unreadable) - 5} more")

	# ---- platform filtering -------------------------------------------
	# A TU excluded here never exists as far as the rest of the build is
	# concerned. This is what makes win32_sys.c and posix_sys.c coexist:
	# without it they are two definitions of the same symbol and section 3 refuses
	# to guess, which is the right answer to the wrong question.
	def exclude_pattern(rel):
		"""The [project] exclude pattern matching a path, or None.

        Wanted for headers too, not just sources: an excluded subtree must
        not have its Q_OBJECT classes moc'd or its .ui files generated, or
        the work fmake was told to skip comes back as generated code.
        """
		for pat in conf.project.get("exclude", []):
			if fnmatch.fnmatch(rel, pat) or rel.startswith(pat.rstrip("/*") + "/"):
				return pat
		return None

	excluded = dict(unreadable)
	by_name = []
	for rel in list(srcs):
		pat = exclude_pattern(rel)
		if pat:
			excluded[rel] = f"[project] exclude = {pat!r}"
		else:
			ann = Ann(scans[rel].get("dirs"))
			why = platform_excludes(ann, cfg.os, cfg.arch)
			from_name = False
			if not why:
				why = filename_excludes(rel, ann, cfg.os, cfg.arch)
				from_name = bool(why)
			if not why:
				continue
			excluded[rel] = why
			# Which branch decided, recorded rather than read back out of
			# the sentence. Sniffing the message for "named _" tied the
			# summary to a wording, and rewording it -- which happened one
			# commit later -- silently stopped the summary being printed.
			if from_name:
				by_name.append(rel)
		srcs.remove(rel)
	if not srcs:
		# Name what did it. The bare sentence was true and sent the reader
		# to the wrong place: a mistyped `@os windwos' reads as a platform
		# problem, so somebody checks [toolchain] and the machine they are
		# on, and the one thing that cannot be wrong is the thing that is.
		# fmake recorded the reason per file while excluding it, so this
		# costs nothing but printing what it already knows -- the same move
		# as naming the include directory in section 68 rather than
		# offering to install a package.
		lines = [f"    {rel}: {why}" for rel, why in sorted(excluded.items())]
		die(f"every source file is excluded when building for "
		    f"{cfg.os}/{cfg.arch}\n"
		    + "\n".join(lines[:LINK_ERR_LINES])
		    + (f"\n    ... and {len(lines) - LINK_ERR_LINES} more"
		       if len(lines) > LINK_ERR_LINES else ""))
	# Said out loud, because a file that stops being compiled is a file
	# whose symbols stop existing, and the link error that follows names
	# neither the file nor the reason. @os or @arch in the file overrides
	# the name if it was wrong.
	if by_name:
		n = len(by_name)
		info(f"{n} source{'' if n == 1 else 's'} named for another platform "
		     f"({', '.join(os.path.basename(r) for r in sorted(by_name)[:3])}"
		     f"{', ...' if n > 3 else ''}) not built for "
		     f"{cfg.os}/{cfg.arch}")

	# Headers under an excluded subtree are excluded too. srcs was filtered
	# above; hdrs is not filtered in place because include resolution may
	# still legitimately reach into such a directory.
	gen_hdrs = [h for h in hdrs if not exclude_pattern(h)]

	# ---- uic ----------------------------------------------------------
	# Before moc, so a widget header that includes its ui_ header is moc'd
	# against the real thing rather than against a missing include. Nothing
	# here depends on that -- moc does not fail on an include it cannot find
	# -- but it costs nothing to be right about the order.
	ui_jobs, ui_outs = [], []
	uic_exe = None
	ui_jobs = uic_plan(srcs + gen_hdrs, hdrs, scans, root)
	if not args.dry_run:
		prune_generated(root, UI_DIR, [j["out"] for j in ui_jobs])
	if ui_jobs:
		uic_exe = find_qt_tool("uic", cfg.uic, pkg)
		if not uic_exe:
			die("this tree includes a ui_*.h header generated from a .ui "
			    "file, which needs Qt's uic.\nInstall the Qt development "
			    f"package, or name it with [toolchain] uic in {CONF_FILE}.")
		ui_outs = run_uic(root, ui_jobs, uic_exe, cache, args.dry_run)
		for rel in ui_outs:
			if rel not in hdrs:
				hdrs.append(rel)
		hdrs.sort()
		scan_all(hdrs)

	# ---- rcc ----------------------------------------------------------
	# A resource registers itself from a static constructor, so nothing in
	# any object refers to the generated one and section 3 alone would always drop
	# it. What the source does say is which resources it opens -- a
	# ":/icons/..." literal, or Q_INIT_RESOURCE naming one outright -- and
	# that is per file, so it survives into a per-program answer rather than
	# linking every resource into every binary.
	qrc_jobs, qrc_outs = [], []
	rcc_exe = None
	qrc_jobs = rcc_plan(srcs + gen_hdrs, scans, root)
	# A .qrc that nothing names is dropped, and unlike every other omission
	# here that one is invisible twice over: the link succeeds, and the
	# program only finds out when it asks for the file. An unreferenced
	# *source* is already reported, so this is the same courtesy for the one
	# input where the evidence is textual rather than a symbol.
	#
	# Collected beside the plan rather than inside it, because rcc_plan
	# returns the work to do and a list of what it declined is a different
	# question asked of the same glob.
	_qrc_named = {j["src"] for j in qrc_jobs}
	qrc_unused = sorted(
	    os.path.relpath(p, root)
	    for p in glob.glob(os.path.join(root, "**", "*.qrc"), recursive=True)
	    if os.path.relpath(p, root) not in _qrc_named)
	# A source that defines a version macro for itself when the build did
	# not is not a compile failure, and that is the whole problem: the tree
	# builds, the program links, it runs, and it reports a version it made
	# up. bbq-predictor prints `bbq-predictor unknown' this way and
	# raidcfgd `unknown (built without a version)'. What makes it
	# answerable rather than merely true is the VERSION file beside it.
	try:
		with open(os.path.join(root, "VERSION")) as _vfh:
			version_says = _vfh.read().strip()
	except OSError:
		version_says = ""
	version_fallen = []
	if version_says:
		_supplied = " ".join(cfg.cflags)
		for scanned in sorted(scans):
			own = " ".join(Ann(scans[scanned].get("dirs")).items("define"))
			for macro in scans[scanned].get("verfall", ()):
				if f"-D{macro}" in _supplied or macro in own:
					continue
				version_fallen.append((scanned, macro))

	if not args.dry_run:
		prune_generated(root, QRC_DIR, [j["out"] for j in qrc_jobs])
	if qrc_jobs:
		rcc_exe = find_qt_tool("rcc", cfg.rcc, pkg)
		if not rcc_exe:
			die("this tree refers to a Qt resource, which needs Qt's rcc.\n"
			    "Install the Qt development package, or name it with "
			    f"[toolchain] rcc in {CONF_FILE}.")
		qrc_outs = run_rcc(root, qrc_jobs, rcc_exe, cache, args.dry_run)
		for rel in qrc_outs:
			if rel not in srcs:
				srcs.append(rel)
		srcs.sort()
		scan_all(srcs)

	# A directive one letter away from a real one, said out loud. Read from
	# the scan records rather than warned about while scanning, so it
	# survives the scan cache -- and sorted, so the order is the tree's
	# rather than the walk's.
	for rel in sorted(scans):
		for line, written, meant in scans[rel].get("typos", []):
			warn(f"{rel}:{line}: @{written} is not a directive; "
			     f"did you mean @{meant}?")

	# Where each generated file came from, so a compile error in one can
	# name a file somebody is able to edit. Built from the plans rather
	# than derived from the paths: the plans are what actually decided,
	# and a rule guessing `moc_x.cpp' came from `x.h' is wrong for the
	# `Q_OBJECT in a .cpp' shape and for anything ejected elsewhere.
	generated_from = {}
	for job in ui_jobs:
		generated_from[job["out"]] = job["src"]
	for job in qrc_jobs:
		generated_from[job["out"]] = job["src"]

	# ---- moc ----------------------------------------------------------
	# After the generators, so a generated header carrying Q_OBJECT is moc'd
	# like any other, and before everything else, so what moc writes is an
	# ordinary source from here on -- seen by the include graph, the closure
	# and the symbol tables with no special case, exactly as section "Generated
	# sources" has it.
	moc_jobs, moc_outs, moc_flags, moc_own = [], [], [], {}
	moc_incflags, src_set = [], set(srcs)
	moc_exe = None
	moc_jobs, moc_unreachable = moc_plan(srcs, gen_hdrs, scans)
	for job in moc_jobs:
		generated_from[job["out"]] = job["src"]
	# Swept before the guard, not inside it: a tree that stops using Qt
	# altogether is exactly the case where every moc output is stale, and a
	# check for Q_OBJECT is the one thing that would skip it.
	if not args.dry_run:
		prune_generated(root, MOC_DIR, [j["out"] for j in moc_jobs])
	if moc_jobs:
		moc_exe = find_qt_tool("moc", cfg.moc, pkg)
		if not moc_exe:
			die("this tree declares Q_OBJECT classes, which need Qt's moc.\n"
			    "Install the Qt development package, or name it with "
			    f"[toolchain] moc in {CONF_FILE}.")
		moc_flags = moc_cflags(root, hdrs, conf)
		moc_outs = run_moc(root, moc_jobs, moc_exe, moc_flags, cache,
		                   args.dry_run, tool_origin("moc", cfg.moc))
		done = set(moc_outs)
		for j in moc_jobs:
			if j["out"] not in done:
				continue
			if j["inline"]:
				# An included moc output is text, not a translation unit, and
				# `#include "foo.moc"` is unqualified. Putting its directory
				# on the global include path means two local.cpp in different
				# directories each find whichever .moc sorts first -- so it
				# goes on the include path of the files that actually pull it
				# in, and nowhere else. Per-TU flags are already part of the
				# object's cache key, so this costs nothing extra.
				flag = "-I" + os.path.join(root, os.path.dirname(j["out"]))
				for who in j["includers"]:
					if who in src_set:
						moc_own.setdefault(who, []).append(flag)
					elif flag not in moc_incflags:
						# A header did the including, so every TU reaching it
						# needs the path and there is no one TU to give it
						# to. Rare, and worth being conservative about.
						moc_incflags.append(flag)
			elif j["out"] not in srcs:
				srcs.append(j["out"])
		srcs.sort()
		scan_all(srcs)

	proj = Project(root, srcs, hdrs, scans)

	# ---- crates -------------------------------------------------------
	# Rust before targets, because it decides which .rs files can root one.
	# A module file is not a translation unit and must not become a target
	# or a candidate: handed to rustc alone it is a crate, and a binary
	# crate with no main() is an error rather than a piece of a program.
	crates, crate_of, crate_orphans = crate_plan(root, srcs, scans)
	crate_members = {m for r, ms in crates.items() for m in ms[1:]}
	if crates and not shutil.which(cfg.rustc):
		die(f"this tree has {len(crates)} Rust crate(s) and {cfg.rustc} is "
		    f"not installed.\n"
		    f"Install rustc, or name it with [toolchain] rustc in "
		    f"{CONF_FILE}.")

	# ---- targets ------------------------------------------------------
	# A TU roots an artifact if it defines main() or carries @kind. A tree
	# with neither is a library named after its directory, which is the only
	# thing it could sensibly be. fmake.toml can also declare a target that
	# no file roots, and can override anything a file said.
	# A file whose main() the compiler did not agree with, remembered so the
	# disagreement is reported once rather than every build. The scan reads
	# text and cannot evaluate #if, so a main() behind one is seen; the
	# object settles it, and the answer only changes if the file changes or
	# the configuration does. Both are in the stamp. Same shape as moc's
	# negative result for a Q_OBJECT the preprocessor never reaches.
	nomain = cache.data.setdefault("nomain", {})

	def main_stamp(rel):
		"""What the answer depends on: the file, and the configuration.

        Computed in one place because the store and the check have to agree
        exactly -- two copies that drift merely never match, which looks like
        the feature being off rather than broken.
        """
		return sha((cache.hash_of(os.path.join(root, rel), rel) or "?")
		           + cfg.key)

	def main_is_a_mirage(rel):
		return nomain.get(rel) == main_stamp(rel)

	# A main() in a vendored subtree is that project's own program -- its
	# test runner, its fuzzers, its example tools -- and not something this
	# tree asked for. The sources around it usually are: both projects that
	# reported this build a library out of the submodule and want nothing
	# else from it. So the file stops rooting a target and stays in the pool
	# like any other source; `[target.x] root = ...` still builds it for
	# anyone who does want it, which is the only way to ask, and vendored
	# code cannot be annotated by a project that treats it as read-only.
	vendored = vendored_dirs(root, srcs)
	passed_over = []

	targets, claimed = [], set()
	for rel in srcs:
		# A module file is not a program even when it has a `fn main()' in
		# it: rustc compiles the root, and the root is what says so.
		if rel in crate_members:
			continue
		ann = Ann(scans[rel].get("dirs"))
		if ann.scalar("kind") is None and scans[rel]["has_main"] \
		        and main_is_a_mirage(rel):
			continue
		if scans[rel]["has_main"] and not ann.scalar("kind") \
		        and not ann.scalar("target"):
			owner = vendor_of(rel, vendored)
			if owner:
				passed_over.append((owner, rel))
				continue
		if scans[rel]["has_main"] or ann.scalar("kind"):
			name = ann.scalar("target") or default_name(rel, root)
			t = Target(rel, root, ann, conf.target(name))
			# Both names are spoken for: the one the section was found under,
			# and whatever it renamed the target to. Otherwise a section that
			# renames looks unconsumed and gets built a second time.
			claimed.add(name)
			claimed.add(t.name)
			if t.kind not in KINDS:
				die(f"{rel}: kind {t.kind!r} is not one of "
				    f"{', '.join(KINDS)}")
			if t.kind == "exe" and not scans[rel]["has_main"]:
				die(f"{rel}:{ann.line('kind')}: @kind exe needs a main()")
			targets.append(t)
		elif ann.scalar("target"):
			warn(f"{rel}:{ann.line('target')}: @target on a file that defines "
			     f"no main() and no @kind is ignored")

	# Targets declared only in fmake.toml. These need explicit sources or a
	# root, since nothing in the tree points at them.
	for name in sorted(conf.targets):
		if name in claimed:
			continue
		section = conf.targets[name]
		rel = section.get("root")
		if rel is None:
			if not section.get("sources"):
				# A section is keyed by the target's *default* name, which
				# is not always the directory it came from -- src/main.cpp
				# is called after the project, since `src` names nothing. So
				# [target.src] is the obvious guess and the wrong one, and
				# the message that only says "declares no root" sends the
				# reader to add a root rather than to fix the key.
				found = sorted(t.name for t in targets)
				hint = (f"\nTargets discovered here: {', '.join(found)}. A "
				        f"section is keyed by the name a target already has;"
				        f" `name = ...` inside it renames one."
				        if found else "")
				die(f"{CONF_FILE}: [target.{name}] declares no root and no "
				    f"sources, so fmake cannot tell what is in it{hint}")
			rel = None
		elif rel not in proj.src_set:
			die(f"{CONF_FILE}: [target.{name}] root = {rel!r} is not a "
			    f"source file in this tree")
		t = Target(rel or "", root, Ann(), section)
		t.name = section.get("name", name)
		if not rel:
			# No root: the first named source stands in, so the closure and
			# the link have something concrete to start from.
			hits = _expand_sources(section["sources"], root, proj, name)
			t.rel, t.members = hits[0], hits
		if t.kind not in KINDS:
			die(f"{CONF_FILE}: [target.{name}] kind = {t.kind!r} is not one "
			    f"of {', '.join(KINDS)}")
		targets.append(t)

	# Said once per subtree rather than once per file: libvterm contributes
	# four and miniz ten, and a list of ten is noise where the directory is
	# the whole finding. Visible without --verbose, because a program that
	# was not built is worth a line even when not building it is right.
	rooted = {t.rel for t in targets}
	skipped = {}
	for owner, rel in passed_over:
		if rel not in rooted:
			skipped.setdefault(owner, []).append(rel)
	for owner in sorted(skipped):
		names = sorted(skipped[owner])
		shown = ", ".join(os.path.basename(n) for n in names[:3])
		if len(names) > 3:
			shown += f", and {len(names) - 3} more"
		n = len(names)
		info(f"{owner} is a separate checkout; leaving its own "
		     f"{n} program{'' if n == 1 else 's'} to it ({shown})")

	# Explicit membership is resolved once, here, so a bad glob is reported
	# before anything is compiled.
	for t in targets:
		if t.members is not None and t.conf.get("sources"):
			t.members = _expand_sources(t.conf["sources"], root, proj, t.name)

	# A tree whose only programs are tests is a library with tests beside
	# it, and a plain build should produce the library. Before tests were
	# held back the test binary was the only target and got built, so
	# nothing noticed; afterwards the default build had nothing left and
	# said "no target could be built" about a directory whose whole purpose
	# is an archive. Found by running fmake on the project that declined
	# over exactly this shape.
	# Sources that are test material rather than a program: a helper, a
	# fixture, or something a generator wrote for the tests to compile.
	test_material = {r for r in srcs if looks_like_a_test(r)}
	library_only = targets and all(t.test for t in targets)
	whole_tree_library = not targets or library_only
	if whole_tree_library:
		ann = Ann()
		name = conf.project.get("name") or os.path.basename(root) or "lib"
		# Not srcs[0]: a test's own source must not root the library, and
		# with tests present srcs[0] may well be one.
		body = [r for r in srcs
		        if r not in {t.rel for t in targets if t.test}]
		t = Target(body[0] if body else srcs[0], root, ann,
		           conf.target(name))
		t.rel = body[0] if body else srcs[0]
		t.kind = t.conf.get("kind", "static")
		t.name = t.conf.get("name", name)
		targets.append(t)
		vinfo(f"{'only tests define' if library_only else 'no main() anywhere;'}"
		      f" building the tree as {t.filename}")

	# tests/main.cpp wants to be called `tests`, which is the directory it
	# came from. Two of five projects hit this on their first run and both
	# had to write a config file for it. `src` is already skipped as a name
	# that names nothing, but skipping `tests` too would land on the project
	# name and collide with the program.
	#
	# So a name nobody chose gets qualified rather than refused. This cannot
	# change a build that worked: the only trees affected are the ones that
	# stopped with an error. A name somebody *did* choose is still refused,
	# because renaming what an author asked for is worse than declining.
	project_name = conf.project.get("name") or os.path.basename(root) or ""
	for t in targets:
		if not os.path.isdir(os.path.join(outdir, t.filename)):
			continue
		chosen = (t.ann.scalar("target") or t.conf.get("name")
		          or t.conf.get("target"))
		# `startswith` was a bare prefix test, and a prefix is not a name.
		# The guard exists so a target already carrying the project's name
		# is not given it twice -- `hydra` must not become `hydra_hydra`,
		# and `hydra_test` must not become `hydra_hydra_test`. What it
		# actually asked was whether the target's name BEGINS with the
		# project's, which is true of every unrelated word that happens to
		# share those letters: a project called `t` swallowed `test`, `q`
		# would swallow `qtty`, `si` would swallow `situ`. The target was
		# then left unqualified and fell through to the refusal below, so
		# the effect of the guard was to turn the rename into a fatal
		# error for exactly the trees it was written to rescue.
		#
		# Measured 2026-09-01: a project named `t` with a `test/main.c`
		# dies; the same tree named `proj` builds `proj_test`.
		if (chosen or not project_name or t.name == project_name
		        or t.name.startswith(project_name + "_")):
			continue
		alt = f"{project_name}_{t.name}"
		if os.path.isdir(os.path.join(outdir, alt)):
			continue
		was = t.filename
		t.name = alt
		info(f"{t.rel} would be built as {was}, which is a directory; "
		     f"calling it {t.filename} instead (@target or {CONF_FILE} "
		     f"picks the name)")

	# A target is a name, which is what @target and [target.*] name are
	# documented to take -- `-o' is how output moves elsewhere. Nothing
	# checked it, and a path went through as one: `@target ../../thing'
	# built outside the tree, and an absolute one ignored the tree
	# entirely. The install side is where it stops being merely surprising,
	# because the path is joined onto the destination as written --
	#
	#     install -m 755 ../../thing $(DESTDIR)$(BINDIR)/../../thing
	#
	# -- so a comment in a source file relocates an install out of its own
	# prefix, and out of a staging root that packaging depends on. A build
	# tool cannot promise much about a tree it was pointed at, but it can
	# promise that a name in a comment stays a name.
	for t in targets:
		name = t.conf.get("name") or t.ann.scalar("target") or ""
		if not name or (os.sep not in name and not os.path.isabs(name)
		                and name not in (os.curdir, os.pardir)):
			continue
		die(f"target name {name!r} (from {t.rel or f'[target.{t.name}]'}) "
		    f"is a path, and a target is a name.\n"
		    f"    it would be built at that path rather than in the tree, "
		    f"and installed to it as written\n"
		    f"    use -o to put artifacts somewhere else, and keep the "
		    f"name a name")

	clash = {}
	for t in targets:
		clash.setdefault(t.filename, []).append(t.rel or f"[target.{t.name}]")
	for fn, rels in sorted(clash.items()):
		if len(rels) > 1:
			die(f"two targets are both called {fn!r}:\n    "
			    + "\n    ".join(rels) + "\n"
			    f"give one of them a different @target, or a name in "
			    f"{CONF_FILE}.")
	refuse_ident_collisions("targets", [t.name for t in targets])
	for t in targets:
		if os.path.isdir(os.path.join(outdir, t.filename)):
			die(f"target {t.filename!r} (from {t.rel}) would be written over "
			    f"a directory of that name.\n"
			    f"name it with @target, or with "
			    f"[target.{t.name}] name = \"...\" in {CONF_FILE}.")

	phony = phony_rules(root)
	asked_phony = [n for n in args.targets if n in phony]

	# A plain build produces the library and the programs; `fmake test`
	# produces and runs the test binaries. The convention buys a fast
	# default build, and it is paid for by the object cache being keyed on
	# the whole configuration -- otherwise "build only what you asked for"
	# is how a stale binary gets tested. Naming a test outright still builds
	# it: the rule is about what a bare `fmake` does, not about permission.
	held = [t for t in targets if t.test]
	wanted = [t for t in targets if not t.test]
	groups = sorted({t.test_group for t in held})
	for g in groups:
		if not RE_TEST_GROUP.match(g):
			die(f"test group {g!r} is not a name: lowercase, starting with "
			    f"a letter, then letters, digits, - or _")
	# A group becomes a Make variable, and `-` is not legal in one, so it is
	# replaced -- which makes `slow-net` and `slow_net` two groups sharing
	# one variable. The ejected Makefile then assigns it twice and every
	# rule builds whichever group came last, silently. fmake refuses two
	# targets with one name and two definitions of one symbol; this is the
	# same ambiguity and gets the same answer.
	refuse_ident_collisions("test groups", groups)
	run_groups, named = [], []
	if args.eject:
		# An ejected build file describes the project, not this invocation.
		# Leaving the tests out would produce a Makefile that cannot build
		# them at all, which is a worse answer than the one the convention
		# is about: there, `test` is a target that `all` does not depend on.
		held, wanted = [], targets
	if args.targets:
		by_name = {}
		for t in targets:
			by_name[t.name] = t
			by_name[t.filename] = t
		wanted = []
		for name in args.targets:
			if name in phony:
				# Its prerequisites are what has to be built; the action
				# itself runs after.
				wanted += [by_name[p] for p in phony[name]["inputs"]
				           if p in by_name]
				continue
			if name in by_name:
				wanted.append(by_name[name])
				named.append(by_name[name])
				continue
			# Last, so a project that has its own `test` -- a phony rule in
			# fmake.mk, or a program actually called that -- keeps it.
			if name in groups:
				run_groups.append(name)
				continue
			known = set(by_name) | set(phony)
			if held:
				known.add("test")
			# `--run` names its target after the file, so a file with no
			# main() reaches here as a target nobody declared. Answering
			# with a list of other targets is the wrong conversation
			# entirely: the reader asked to run one file, and the fact
			# fmake has -- and was discarding -- is that the file is not a
			# program. This is the front end a newcomer meets first.
			if args.run and name == default_name(run_rel, root):
				die(f"--run: {_rel(args.run, root)} defines no main() at "
				    f"file scope, so there is nothing to run.\n"
				    f"A file used as a script has to be a program.")
			die(f"no target {name!r}. Available: "
			    f"{', '.join(sorted(known)) or '(none)'}")
		# `fmake test foo bar` runs those and no others -- re-running one
		# test out of sixty-six is the commonest thing anybody does with a
		# suite, and naming it on its own only ever built it. Naming
		# something that is not a test alongside `test` still builds it and
		# does not make it a test.
		picked = [t for t in named if t.test_group in run_groups]
		if run_groups and not picked:
			wanted += [t for t in held
			           if t.test_group in run_groups and t not in wanted]
		if not wanted and asked_phony:
			wanted = []         # an action with nothing of ours to build
		# A test told where the program is has to have the program. Their
		# Makefiles say this outright -- bbq-predictor's `test' depends on
		# $(ARTIFACT) -- and without it `fmake test' on a clean tree hands
		# a test the path of something nobody built. So naming a target in
		# test-env asks for it, which is the same rule as naming it on the
		# command line.
		if run_groups:
			asked_bin = set()
			for src_list in [conf.project.get("test-env", [])] + [
			        t.conf.get("test-env", []) for t in wanted]:
				for item in src_list:
					asked_bin |= set(RE_BIN_REF.findall(item))
			for nm in sorted(asked_bin):
				dep = by_name.get(nm.strip())
				if dep is not None and dep not in wanted:
					wanted.append(dep)

		if run_groups and not held:
			warn("no test programs here: nothing is in a test directory, "
			     "named as a test, or marked @test")
			return 0
	elif held:
		n = len(held)
		how = " or ".join(f"`fmake {g}`" for g in groups)
		info(f"{n} test program{'' if n == 1 else 's'} not built by "
		     f"default ({', '.join(sorted(t.name for t in held)[:3])}"
		     f"{', ...' if n > 3 else ''}); {how} builds and runs them")

	# ---- candidate set from the include graph -------------------------
	units = {}

	def unit(rel):
		if rel not in units:
			units[rel] = Unit(rel, root, objdir, scans[rel],
			                  members=crates.get(rel, [])[1:])
		return units[rel]

	# Shared objects need position-independent code, and mixing PIC objects
	# into an executable is harmless, so one setting covers the whole tree.
	# Decided here, before the object directory is named, because -fPIC has
	# to be part of the configuration identity: building only the program and
	# then building the library as well must not reuse the non-PIC objects.
	if any(t.kind == "shared" for t in wanted):
		cfg.cflags = cfg.cflags + ["-fPIC"]
		cfg.refresh_key()
	objdir = os.path.join(state, "obj", cfg.key)

	# @sources, resolved next to the file that asked for them, then from the
	# project root. Same semantics as --force-link: the files nothing
	# references but that must be in the link anyway.
	forced_rels, forced_why = list(args.force_link), {}
	for f in forced_rels:
		forced_why[f] = "--force-link"
	for rel in srcs:
		ann_s = Ann(scans[rel].get("dirs"))
		for pat in ann_s.items("sources"):
			# recursive=True everywhere, so ** means the same thing in
			# @sources as it does in fmake.toml. Two spellings of "all the
			# files under here" is the kind of difference nobody discovers
			# except by having a pattern quietly match nothing.
			hits = (glob.glob(os.path.join(root, os.path.dirname(rel), pat),
			                  recursive=True)
			        or glob.glob(os.path.join(root, pat), recursive=True))
			matched = [os.path.relpath(h, root) for h in sorted(hits)]
			# A prebuilt .o is never in src_set and naming one is the
			# supported way to link a vendored blob -- see prebuilt_units.
			got = [g for g in matched
			       if g in proj.src_set
			       or (g.endswith(".o")
			           and os.path.isfile(os.path.join(root, g)))]
			if not got:
				# "matched no source file" about a pattern that matched a
				# file, which is what happens when the platform rules or a
				# [project] exclude took it out. Reading that as a typo
				# costs somebody the afternoon, and the glob already knows
				# the difference: `matched' is what is on disk, `got' is
				# what survived. The [target.*] sibling of this message
				# carries the same warning.
				die(f"{rel}: @sources {pat!r} matched no source file"
				    + (f" ({', '.join(matched[:3])} matched but is not "
				       f"in the build)" if matched else ""))
			for g in got:
				forced_why[g] = f"@sources in {rel}:{ann_s.line('sources')}"
			forced_rels += got

	candidates = set()
	for t in wanted:
		if t.members is not None:
			candidates |= set(t.members)
		elif t.kind != "exe":
			candidates |= set(srcs)
		else:
			candidates |= proj.candidates(t.rel)
	# A named .o is a prebuilt object rather than something to compile, so
	# it is taken out here and linked as a unit of its own further down.
	forced_objs = [r for r in forced_rels if r.endswith(".o")]
	forced_rels = [r for r in forced_rels if r not in forced_objs]
	for rel in forced_objs:
		if not os.path.isfile(os.path.join(root, rel)):
			die(f"{rel!r} is named as a prebuilt object and is not there")
	for rel in forced_rels:
		if rel not in proj.src_set:
			die(f"{rel!r} is not a source file in this tree")
		candidates.add(rel)
	# A file you wrote a generator for is obviously worth compiling, so
	# generated sources join the candidate set outright. This is not forcing
	# them into the link -- the closure still decides that -- but it means
	# their symbols exist to be closed over. Without it flex output goes
	# unbuilt, since yylex arrives through a macro that the definition-scanning
	# widening filter cannot see.
	candidates |= {g for g in generated if g in proj.src_set}
	# Same for moc output, and it needs saying separately because nothing
	# includes a moc_foo.cpp -- that is the whole reason moc is hard in an
	# include-graph build. Widening is not a substitute here: it picks its
	# extra files by scanning for apparent definitions, which finds
	# Foo::staticMetaObject but can never find a vtable, since _ZTV4Base is
	# not a string any source spells. A class whose only debt to moc is its
	# vtable would fail to link having compiled everything it was asked to.
	# Compiling is still not linking: the closure decides, so the object of
	# a class no program constructs is simply never reached.
	candidates |= {m for m in moc_outs if m in proj.src_set}
	candidates |= {q for q in qrc_outs if q in proj.src_set}
	# Whatever widening discovered last time is a far better starting guess
	# than the include graph, so start from it. Widening still corrects it if
	# the tree has changed.
	candidates |= {r for r in cache.data["units"] if r in proj.src_set}
	if args.widen_all or any(t.kind != "exe" and t.members is None
	                         for t in wanted):
		# A library with no declared membership is everything, so there is
		# nothing to narrow down to.
		candidates = set(srcs)

	# Last, because a library with no declared membership resets the set to
	# the whole tree and would otherwise put these back. A held-back test's
	# root is not worth compiling for somebody else's sake: without this the
	# objects for thirty-five test binaries are still built on a plain build
	# and merely not linked, which is most of the cost the convention was
	# traded for. They cannot be used either way -- an exe root is excluded
	# from every library closure by construction.
	candidates -= {t.rel for t in held} - {t.rel for t in wanted}
	# A crate is one unit whatever the candidate set says. Only a root is
	# a unit -- rustc reads the rest from it -- and the root is always
	# built, because a library crate's symbol table is the only thing that
	# can say whether anything here needs it. That is the same bargain a
	# vendored archive makes, one step earlier: built first, linked only
	# if the closure reaches it.
	#
	# Every other .rs is taken out, members and orphans alike. `--widen-all`
	# and a library with no declared membership both reset the candidate
	# set to the whole tree, and either would otherwise compile a module as
	# a crate of its own -- which rustc will do for a staticlib, quietly,
	# producing a second 50MB archive of the same code.
	candidates -= {r for r in srcs
	               if os.path.splitext(r)[1] in CRATE_EXTS
	               and r not in crates}
	candidates |= set(crates)

	base_incflags = ["-I" + os.path.join(root, d) if d != "." else "-I" + root
	                 for d in sorted(proj.incdirs | {"."})]
	# uic output is flat and its includes are unqualified, so one -I covers
	# it. Added explicitly rather than left to the include graph to discover,
	# because a header nothing has walked to yet still has to be findable.
	for d in gen_dirs + ([UI_DIR] if ui_outs else []):
		flag = "-I" + os.path.join(root, d) if d else "-I" + root
		if flag not in base_incflags:
			base_incflags.append(flag)
	for flag in moc_incflags:
		if flag not in base_incflags:
			base_incflags.append(flag)
	for d in conf.project.get("include-dirs", []):
		flag = "-I" + (d if os.path.isabs(d) else os.path.join(root, d))
		if flag not in base_incflags:
			base_incflags.append(flag)

	for rel in sorted(candidates):
		unit(rel)

	hdr_store = cache.data.setdefault("headers", {})
	incflags, proposed = list(base_incflags), {}
	pkg_sig = pkg.signature()

	def own_flags(u):
		"""The compile flags a TU asked for, plus any fmake owes it.

        Wanted wherever a Unit enters the pool, not just here: a Unit is
        created with no flags of its own, and widening adds units after this
        point. A file the include graph missed would otherwise be compiled
        without its @define, @cflags or @std -- silently, since nothing
        downstream reads the annotations again, and a wrong -D produces a
        program that builds and answers differently.

        A crate takes none of them. Every directive here spells a C flag --
        -D, -std, and whatever pkg-config hands back -- and rustc would
        refuse the first one it saw. @ldflags still applies, since that
        belongs to whatever contains the unit rather than to the compile.
        """
		if u.lang.unit == "crate":
			return []
		for group in u.ann.groups("pkg"):
			# Checked up front rather than at the compiler's "no such file",
			# which is a much worse way to learn a package is missing.
			if pkg.satisfies(group) is False:
				die(f"{u.rel}:{u.ann.line('pkg')}: @pkg {' '.join(group)} is "
				    f"not satisfied (installed: {pkg.version(group[0])})")
		for group in u.ann.groups("pkg_optional"):
			# Malformed is fatal where missing is not. The whole directive
			# is about a feature that vanishes quietly, so one that fmake
			# silently ignored because the keyword was misspelt would be
			# the same failure wearing the fix as a disguise.
			if optional_pkg(group) is None:
				die(f"{u.rel}:{u.ann.line('pkg_optional')}: @pkg_optional "
				    f"{' '.join(group)} is not "
				    f"'@pkg_optional NAME defines MACRO'")
		return unit_cflags(u, pkg, hdr_store, pkg_sig) + moc_own.get(u.rel, [])

	for rel in sorted(units):
		units[rel].own = own_flags(units[rel])

	# Which optional features this build has, and which it does not. Said
	# once per package rather than per file, and said whether the answer is
	# yes or no: "built without keyring support" is the sentence hydra's
	# browser needed and did not get, and it is only trustworthy if the
	# other half is printed too.
	optional = {}
	for rel in sorted(units):
		for group in units[rel].ann.groups("pkg_optional"):
			spec = optional_pkg(group)
			if spec:
				optional.setdefault(spec, []).append(rel)
	for (module, macro), users in sorted(optional.items()):
		if pkg.for_module(module, hdr_store, pkg_sig):
			vinfo(f"{module} found: -D{macro} for "
			      f"{len(users)} file{'' if len(users) == 1 else 's'}")
		else:
			info(f"{module} is not installed, so {macro} is undefined and "
			     f"whatever {users[0]} guards with it is not in this build")


	vinfo(f"{len(srcs)} sources, {len(candidates)} candidates, "
	      f"{len(wanted)} target(s)"
		  # Not "by platform": this set also holds the files [project]
		  # exclude named and the ones that could not be read, and saying
		  # otherwise sends anyone looking for the reason to @os first.
		  # --explain gives the reason per file.
	      + (f", {len(excluded)} excluded" if excluded else ""))

	if args.always_make:
		# Links too, or -B recompiles everything, finds the objects came out
		# byte-identical, and reports the target up to date -- which is true,
		# and not what anyone typing --always-make is asking for.
		cache.objects.clear()
		cache.data.pop("links", None)

	# ---- vendored archives --------------------------------------------
	# Anything fmake builds itself is not one of these. A static target
	# writes lib<name>.a into the output directory, which is the tree root
	# unless -o says otherwise, so without this the second build would find
	# the first build's output and offer it back as a dependency of itself.
	ours = {t.filename for t in targets if t.kind == "static"}
	out_prefix = os.path.join(os.path.abspath(outdir), "")
	vendored = []
	for a in find_archives(root):
		# `[project] exclude` reaches archives too, and did not. It is the
		# one lever for "this subtree is not for this build", and beerssh
		# ships prebuilt libcrypto.a for two Android ABIs beside the
		# desktop sources: they define the same symbols, section 3 refuses
		# to choose, and the only remedy fmake could suggest was the one
		# thing that had no effect on them.
		if exclude_pattern(a):
			continue
		if os.path.basename(a) in ours:
			continue        # something this tree builds, not something it ships
		# And anything already sitting in the output directory, unless that
		# is the tree itself -- which it is by default, so this test has to
		# be conditional or it excludes every archive there is.
		if outdir != root and \
		        os.path.abspath(os.path.join(root, a)).startswith(out_prefix):
			continue
		vendored.append(a)
	prebuilt = prebuilt_units(sorted(set(forced_objs)), root, cfg, jobs)
	if prebuilt:
		vinfo(f"{len(prebuilt)} prebuilt object(s): "
		      + ", ".join(u.rel for u in prebuilt[:4]))
	archives = archive_units(vendored, root, cfg, jobs)
	if archives:
		vinfo(f"{len(archives)} vendored archive(s): "
		      + ", ".join(a.rel for a in archives[:4]))

	# ---- compile, close, widen ----------------------------------------
	tried, broken = set(), set()
	closures = {}
	target_ident, vetted = None, False
	# Computed once, over every source in the tree rather than over the
	# evolving candidate pool. Recomputing per pass looks thriftier, but the
	# flags then depend on how far widening has got: a file compiled before
	# some later file contributed an -I was built with a different include
	# path than fmake believes it used, and its cache key -- which contains
	# the flags -- disagrees with the final one, so the next build recompiles
	# it for no reason. Stable inputs, stable keys, idempotent builds.
	if not args.no_libs:
		every_unit = [units.get(rel) or Unit(rel, root, objdir, scans[rel])
		              for rel in srcs if rel not in crate_members]
		pkg_cflags, _ = propose_from_headers(every_unit, pkg, hdr_store, proj)
		incflags = base_incflags + [f for f in pkg_cflags
		                            if f not in base_incflags]

	# Wherever the packages resolved so far said their libraries live. section 5
	# recovers -L from where a library was actually found rather than from
	# pkg-config, which is what makes libraries found by symbol alone work
	# -- but it can only find one in a directory it looks in, and a package
	# under /opt or a home prefix is in none of them. This is pkg-config
	# proposing, exactly as it proposes the -I; the symbols still decide.
	if pkg.libdirs:
		cfg.extra_libdirs += [d for d in pkg.libdirs
		                      if d not in cfg.extra_libdirs]
		cfg._libdirs = None         # recomputed with the new directories

	while True:
		pool = [units[r] for r in sorted(units)]
		compile_units(pool, cfg, cache, root, incflags, jobs, args.dry_run,
		              broken, tree_headers=hdrs, quiet=args.quiet,
		              origins=generated_from)
		# The architecture to require is whatever fmake just compiled. Asking
		# the objects avoids having to know anything about toolchain
		# triplets, and is right by construction -- but it means waiting
		# until something has been compiled, which is why this is here and
		# not where the archives were found.
		if target_ident is None:
			for u in pool:
				# A crate program has no object to ask, and an archive is
				# not an ELF file. Either way there is nothing here to
				# read, and a tree that is only Rust simply never sets
				# this -- correctly, since rustc chose the architecture.
				if not u.obj or u.archive:
					continue
				target_ident = elf_identity(u.obj)
				if target_ident:
					break

		# Archives join the pool only after compiling, which is the whole
		# difference between them and a source: they are already built. And
		# being already built, they have an architecture of their own, which
		# nothing else here does: a host archive left in the tree during a
		# cross build reads perfectly well -- binutils nm will happily list
		# symbols from a foreign object -- so it is offered, chosen, and then
		# refused by the linker with `file in wrong format`, which names
		# neither architecture nor whose decision it was.
		if archives and not vetted:
			vetted, keep = True, []
			for a in archives:
				got = elf_identity(a.obj)
				if target_ident and got and got != target_ident:
					warn(f"{a.rel} is {describe_identity(got)}, but this "
					     f"build is {describe_identity(target_ident)}")
					note("not using it; anything it defines will be reported "
					     "as missing")
					continue
				keep.append(a)
			archives = keep
		pool = pool + archives + prebuilt

		# confirm main() against the symbol tables now that objects exist
		if not args.dry_run:
			for t in list(wanted):
				if t.rel in broken:
					warn(f"{t.name} skipped: {t.rel} did not compile")
					wanted.remove(t)
					continue
				# A Rust program has no object here to disagree with: it
				# is one rustc call from source to binary, and rustc is
				# the thing that decides whether main() is there. It says
				# so loudly -- `main function not found in crate' -- and
				# that arrives from the link step below.
				if (t.kind == "exe" and not units[t.rel].crate_exe
				        and "main" not in units[t.rel].strong):
					warn(f"{t.rel} looked like it defined main() but the "
					     f"object does not export it; skipping")
					# Remembered against the file and the configuration, so
					# the next build does not propose it, compile it, link
					# nothing and say this again.
					nomain[t.rel] = main_stamp(t.rel)
					wanted.remove(t)
			if not wanted:
				die("no target could be built")

		forced = [units[f] for f in forced_rels if f in units]
		# The vendored main()s too. They stopped rooting a target, which is
		# the point, but the reason a library must not contain them did not
		# change with it -- an archive carrying a second entry point is section 28,
		# and it would now arrive by the one path that no longer names it.
		other_roots = {t.rel for t in targets if t.kind == "exe"}
		other_roots |= {rel for _, rel in passed_over} - {t.rel for t in targets}
		closures = {}
		for t in wanted:
			# @sources cannot reach a library, and saying nothing about it
			# costs the reader a compile and a wrong belief. The directive
			# means "force this into the link that no symbol reaches", and
			# it is collected tree-wide and handed to close_over_symbols,
			# which only an exe goes through -- so a file named this way is
			# compiled and then not in the archive, with nothing said.
			#
			# Reported against the head, because that is the file somebody
			# annotates when they mean to describe the library. Where a
			# declared list exists it is the answer and the directive would
			# be a second opinion on membership, which is the thing that
			# list exists to stop; where there is none the library already
			# holds everything reachable and the directive has nothing to
			# add. Neither case wants it honoured, and both want it said.
			if t.kind in ("static", "shared"):
				head = Ann(scans.get(t.rel, {}).get("dirs"))
				if list(head.items("sources")):
					where = ("membership is [target."
					         f"{t.name}] sources in {CONF_FILE}"
					         if t.members is not None else
					         "a library already holds everything reachable")
					note(f"@sources in {t.rel} does not reach the library "
					     f"it heads: {where}")
			if t.members is not None:
				# Declared membership is the answer, not a starting point.
				# Nothing in the source says which of two libraries a shared
				# file belongs to, so the closure must not be consulted.
				#
				# It decides which of *the tree's own* sources belong, though,
				# not which generated ones do. A moc output lives under the
				# state directory and is named after an implementation detail:
				# it is not something anyone can list, and it is not a choice
				# either -- a class's meta-object is part of that class, not a
				# second opinion about it. So declared members bring their
				# generated companions with them, found by symbol.
				chosen = [units[r] for r in t.members if r in units]
				owned = companions(t.members,
				                   proj.reachable_headers(t.members),
				                   moc_jobs, qrc_jobs)
				chosen += [units[o] for o in sorted(owned)
				           if o in units and units[o] not in chosen]
				closures[t] = close_over_library(chosen, units[t.rel])
			elif units[t.rel].crate_exe:
				# The link set of a Rust program is the crate, and nothing
				# else is fmake's to decide. rustc resolves the rest from
				# crate metadata -- which is why this is not a closure that
				# came out empty but one that was never fmake's to compute.
				closures[t] = Closure(units[t.rel])
			elif t.kind == "exe":
				closures[t] = close_over_symbols(units[t.rel], pool, forced,
				                                 forced_why)
				# A resource is asserted, not deduced -- nothing references
				# the object. Which program gets it comes from which of its
				# files opened it, so the closure has to exist before the
				# question can be asked, and is then recomputed with the
				# answer. One extra pass: rcc output refers to Qt and to
				# nothing in the tree, so it cannot widen anything.
				have = {u.rel for u in closures[t].link}
				add = {}
				for job in qrc_jobs:
					if job["out"] in have or job["out"] not in units:
						continue
					for who, why in job["users"].items():
						if who in have:
							add[job["out"]] = f"{why} in {who}"
							break
				if add:
					extra_why = dict(forced_why)
					extra_why.update(add)
					closures[t] = close_over_symbols(
					    units[t.rel], pool,
					    forced + [units[o] for o in sorted(add)], extra_why)
			else:
				members = [u for u in pool
				           if u.rel == t.rel or u.rel not in other_roots]
				# Test sources are not part of a library. situ shipped a
				# generated codec from tests/generated/ inside libsitu.a,
				# because the tests convention classifies programs and
				# this asked about files; it knows where tests live
				# either way.
				#
				# Every library computed from the tree, not only the
				# whole-tree one: a `whole_tree_library and` here failed
				# no case, and a guard nothing justifies is a guess about
				# a situation nobody has. A library declared with
				# `sources` never reaches this branch, so naming a test
				# file outright still works.
				if t.rel not in test_material:
					members = [u for u in members
					           if u.rel not in test_material]
				closures[t] = close_over_library(members, units[t.rel])

		unresolved = set()
		for cl in closures.values():
			unresolved |= set(cl.external)
		fresh = unresolved - tried
		if not fresh or args.widen_all or args.dry_run:
			break
		tried |= fresh

		rest = [Unit(rel, root, objdir, scans[rel])
		        for rel in srcs
		        if rel not in units and rel not in crate_members]
		extra = widen_candidates(fresh, rest)
		if not extra:
			break
		vinfo(f"widening: {len(extra)} more file(s) may define "
		      f"{len(fresh)} unresolved symbol(s)")
		for u in extra:
			u.own = own_flags(u)
			units[u.rel] = u

	# ---- report ambiguity ---------------------------------------------
	# Every affected target at once, not the first one and then exit. A tree
	# of sibling programs that each define a `Window` produces the same
	# complaint once per program, and fixing them one build at a time is a
	# bad way to spend an afternoon.
	trouble = [(t, sym, providers) for t, cl in closures.items()
	           for sym, providers in cl.ambiguous]
	if trouble:
		first_sym, first_providers = trouble[0][1], trouble[0][2]
		shown = first_providers[:6]
		listing = "\n    ".join(shown)
		if len(first_providers) > len(shown):
			listing += f"\n    ... and {len(first_providers) - len(shown)} more"
		lines = [f"symbol {first_sym!r} is defined by more than one file:",
		         "    " + listing,
		         "fmake will not guess which one belongs in "
		         + ", ".join(sorted({t.name for t, _s, _p in trouble})) + "."]
		# git has usually known the answer all along: one of them is build
		# output somebody left in the tree. Said before the guessing starts,
		# because it is the one part of this message that is not a guess.
		ignored = sorted(git_ignored(root, first_providers))
		if ignored and len(ignored) < len(first_providers):
			lines += ["",
			          "git is told to ignore "
			          + ", ".join(ignored[:3])
			          + (f", and {len(ignored) - 3} more" if len(ignored) > 3
			             else "")
			          + ", so "
			          + ("they are" if len(ignored) > 1 else "it is")
			          + " probably build output rather than source. "
			          + f"[project] exclude in {CONF_FILE} keeps "
			          + ("them" if len(ignored) > 1 else "it")
			          + " out."]

		# The include graph must not decide this -- section 3 exists because it is
		# not good enough to -- but it is good enough to *suggest*, and a
		# suggestion costs nothing if it is labelled as one. Where it reaches
		# exactly one of the providers from a target's own root, that is
		# almost always the right answer, and the stanza below is the thing
		# the user would otherwise write out by hand.
		# `trouble` is one entry per (target, symbol), and a file that
		# collides with another collides on everything it defines -- eight
		# meta-objects in the tree that found this. The stanza depends only
		# on the target, so writing one per symbol printed the same block
		# eight times and turned a readable refusal into 252 lines of
		# identical text. Said once each.
		advice, stanzas = [], []
		seen_advice, seen_stanza = set(), set()
		for t, _sym, providers in trouble:
			reach = proj.candidates(t.rel)
			mine = [p for p in providers if p in reach]
			if len(mine) != 1:
				continue
			if (t.name, mine[0]) not in seen_advice:
				seen_advice.add((t.name, mine[0]))
				advice.append(f"    {t.name:<20} {mine[0]}")
			if t.name in seen_stanza:
				continue
			seen_stanza.add(t.name)
			members = sorted(r for r in reach if r in proj.src_set)
			stanzas.append(f"[target.{t.name}]\nsources = ["
			               + ", ".join(f'"{m}"' for m in members) + "]")
		if advice:
			lines += ["",
			          "The include graph reaches exactly one of them from "
			          "each program's own root:",
			          *advice,
			          "",
			          "which is a guess, not a decision. To make it the "
			          f"answer, put this in {CONF_FILE} -- the source lists "
			          "are that same guess and are worth checking:",
			          ""]
			lines += ["    " + s.replace("\n", "\n    ") for s in stanzas]
		elif len(first_providers) > 3:
			# Two very different causes, and the wrong hint sends people the
			# wrong way. A handful of files is usually one implementation per
			# platform; dozens is usually a directory of programs that each
			# supply the same entry point, expecting to be linked separately.
			lines.append(f"\n{len(first_providers)} files define it, which "
			             f"usually means they are separate programs sharing "
			             f"an entry point rather than one library.\nGive each "
			             f"a [target.*] with its own sources in {CONF_FILE}, "
			             f"or drop them with [project] exclude.")
		# `scans.get`, not `scans[...]`: a provider can be a vendored archive,
		# which has no scan because it was never a source -- section 18 gives
		# those units an empty one and keeps them out of the scan map. Found
		# by running beerssh, where two Android archives under deps/ define
		# the same symbols and the ambiguity report tracebacked instead of
		# printing. Section 32's class, in the code written to explain a
		# failure rather than in the failure itself.
		elif any(scans.get(p, {}).get("dirs", {}).get("os")
		         for p in first_providers):
			lines.append("\nOne of them has @os; the others may need one too.")
		elif all(p.endswith(".a") for p in first_providers):
			# A directive cannot be written on an archive: there is no
			# source to put it in. Section 101's shape, in the same
			# message -- advice that cannot be followed is worse than
			# none, and the remedy that does work is the one that names
			# paths rather than files.
			lines.append(f"\nThese are prebuilt archives, so @os and @arch "
			             f"have nowhere to go. Keep the ones that are not "
			             f"for this build out with [project] exclude in "
			             f"{CONF_FILE}.")
		else:
			lines.append("\n@os or @arch on the platform-specific one will "
			             "settle it, or name the sources of each target in "
			             f"{CONF_FILE}.")
		die("\n".join(lines))

	# ---- one program's root inside another's link set -----------------
	# Every exe root defines main(), so a closure that reaches a second one
	# cannot link -- and the linker says so in terms of object paths under
	# .fmake, several steps from the cause. Worse, fmake's own summary then
	# offered to name the missing libraries, when nothing is missing at all.
	# section 3 excludes other roots when assembling a library and does not when
	# closing over a program, deliberately: a function defined next to a
	# main() is still a function, and refusing to link it would be its own
	# kind of guess. So this reports rather than resolves.
	# Every root in the tree, not just the ones asked for. Narrowing by name
	# is what hid this: `fmake app' drops tool from `wanted', so the root it
	# collides with is not in the set to notice, and the reader gets the
	# linker's multiple-definition error under the advice this check exists
	# to replace -- the one offering to name missing libraries when nothing
	# is missing. The collision is a property of the tree rather than of
	# what was asked for.
	roots = {t.rel: t.name for t in targets if t.kind == "exe"}
	intruders = []
	for t, cl in closures.items():
		if t.kind != "exe":
			continue
		for u in cl.link:
			# Its object, not the target list. A file whose main() the
			# preprocessor removes is proposed as a root and then dropped
			# once the symbol table disagrees -- and linking it is then
			# perfectly safe, because there is no second main() to collide
			# with. Reading every root rather than only the wanted ones
			# reinstated exactly those false roots, which the suite caught.
			if (u.rel != t.rel and u.rel in roots
			        and "main" in u.strong):
				sym, by = cl.why.get(u.rel, ("", ""))
				intruders.append((t.name, u.rel, roots[u.rel], sym, by))
	if intruders:
		lines = ["a program's own file was pulled into another program:"]
		for name, rel, owner, sym, by in intruders:
			lines.append(f"    {name} links {rel}, which roots {owner}"
			             + (f"\n        <- {sym}" + (f"  ({by})" if by else "")
			                if sym else ""))
		lines += ["",
		          "Both define main(), so this cannot link. What is shared "
		          "belongs in a file of its own:",
		          "move it out of " + ", ".join(sorted({r for _n, r, *_ in intruders}))
		          + " and both programs can reach it.",
		          "Naming each program's sources in " + CONF_FILE
		          + " settles it too."]
		die("\n".join(lines))

	# Two .qrc files with the same stem, in one program. rcc namespaces the
	# *file* it writes by directory, so a/res.qrc and b/res.qrc do not
	# overwrite each other -- and it derives the *symbols* from the stem, so
	# both define qInitResources_res and the link fails with a multiple
	# definition. The paths are distinct and the names are not, which is the
	# collision of sections 65 and 66 one level down, in a rewriting rcc
	# does rather than fmake.
	#
	# Reported here for the same reason the block above exists: left to the
	# linker it arrives as an error about generated paths under the state
	# directory, and fmake's own summary then offers to name the missing
	# libraries when nothing is missing.
	by_out = {j["out"]: j for j in qrc_jobs}
	for t, cl in closures.items():
		seen = {}
		for u in cl.link:
			job = by_out.get(u.rel)
			if job:
				seen.setdefault(job["name"], []).append(job["src"])
		for name, srcs_with_name in sorted(seen.items()):
			if len(srcs_with_name) > 1:
				die(f"{t.name} links resources that would define the same "
				    f"symbols:\n    "
				    + "\n    ".join(sorted(srcs_with_name))
				    + f"\nrcc names them after the file, so each defines "
				    f"qInitResources_{name}(). Rename one so the stems "
				    f"differ.")

	# ---- resolve external symbols to libraries ------------------------
	resolutions = {}
	if not args.no_libs and not args.dry_run:
		every = set()
		for t in wanted:
			every |= set(closures[t].external)
		# target_ident was settled in the compile loop, from the first object
		# that had one -- the same question, asked once.
		providers, paths = scan_providers(cfg, every, cache, jobs,
		                                  target_ident)
		for t in wanted:
			resolutions[t] = resolve_libraries(t, closures[t], cfg, pkg,
			                                   hdr_store, providers, paths,
			                                   target_ident, proj)

		# Said outside --explain, because the build that needs to hear it is
		# the one nobody is inspecting. A feature guarded by a macro fmake
		# was not given compiles to nothing, needs no library, and links --
		# so the program is built, is smaller than it should be, and says
		# so nowhere. There is no error to notice and no symbol to miss.
		told, told_files = set(), set()
		for t in wanted:
			gone = resolutions[t].get("compiled_away") or {}
			for lib, (module, where, header) in sorted(gone.items()):
				if (where, header) in told:
					continue
				told.add((where, header))
				told_files.add(where.rsplit(":", 1)[0])
				warn(f"{where}: {header} is behind a conditional the "
				     f"preprocessor did not take, so {module} was not "
				     f"linked -- if a feature macro should have turned it "
				     f"on, say so next to the include with "
				     f"'@pkg_optional {module} defines MACRO', or pass "
				     f"-DMACRO with --cflags")

		# The same finding for a header no package could be attributed to.
		# Reported second and worded differently, because there is no
		# module name to offer: the reader knows which package ships the
		# header and fmake does not.
		incdirs = [f[2:] for f in incflags if f.startswith("-I")]
		incdirs += default_include_dirs(cfg)
		# One line per file, not per include. A guarded block opens with
		# fourteen headers from the same package in hydra's case, and
		# fourteen lines saying the same thing is how a real finding gets
		# skimmed past.
		grouped = {}
		for t in wanted:
			for where, header in compiled_away_includes(
			        closures[t], preprocessed_headers(closures[t]), incdirs):
				# A file already named with its package is the same
				# finding said better; saying it twice in two wordings
				# reads as two problems.
				src = where.rsplit(":", 1)[0]
				if (where, header) in told or src in told_files:
					continue
				told.add((where, header))
				grouped.setdefault(src, []).append((where, header))
		for src in sorted(grouped):
			hits = grouped[src]
			where, header = hits[0]
			more = (f" and {len(hits) - 1} other header"
			        f"{'' if len(hits) == 2 else 's'}" if len(hits) > 1
			        else "")
			warn(f"{where}: {header}{more} on this machine but behind a "
			     f"conditional the preprocessor did not take -- if a "
			     f"feature macro should have turned it on, say so with "
			     f"'@pkg_optional PACKAGE defines MACRO', or pass "
			     f"-DMACRO with --cflags")

	# ---- explain or link ----------------------------------------------
	# What widening discovered, to start from next time -- but not what it
	# discovered was useless. A file that failed to compile defines nothing,
	# so it can never be why anything links; remembering it only guarantees
	# compiling it again, and failing again, on every future build. If it is
	# genuinely reachable the include graph or widening proposes it afresh
	# and the error comes back, which is the difference between forgetting it
	# and hiding it.
	#
	# --widen-all is not remembered at all. Its set is every file in the tree
	# rather than a discovery about this program, and inheriting it would
	# leave the flag switched on for every later build by a route nobody
	# would think to look for.
	if not args.widen_all:
		cache.data["units"] = sorted(r for r in units if r not in broken)

	if args.eject:
		emit = eject_ninja if args.eject == "ninja" else eject_make
		done = set(moc_outs)
		extra = ({"fragment": True} if args.eject == "make-fragment" else {})
		sys.stdout.write(emit(wanted, closures, resolutions, cfg, incflags,
		                      root, conf,
		                      all_generate_rules(root, conf, srcs, scans),
		                      {"exe": moc_exe, "flags": moc_flags,
		                       "jobs": [j for j in moc_jobs
		                                if j["out"] in done]},
		                      {"exe": uic_exe, "jobs": ui_jobs},
		                      {"exe": rcc_exe, "jobs": qrc_jobs}, **extra))
		cache.save()
		# Same answer the build path gives, and for a sharper reason. A
		# build that drops targets leaves no binaries, which the next
		# command notices. An eject that drops them writes a build file
		# that looks complete and is not, and it goes on being wrong every
		# time it is used -- one project's generated object-set file was
		# regenerated from a tree in this state and was wrong for a week.
		# The artifact is still written, because the part that worked is
		# worth having and worth inspecting; the status is what stops a
		# caller adopting it without looking.
		return 1 if broken else 0

	all_units = [units[r] for r in sorted(units)]
	if args.explain:
		for t in wanted:
			explain(t, closures[t], cfg, incflags, outdir, all_units, root,
			        {x.rel for x in targets} - {t.rel}, resolutions.get(t),
			        excluded, conf,
			        {"exe": moc_exe, "jobs": moc_jobs} if moc_exe else None,
			        {"exe": uic_exe, "jobs": ui_jobs} if uic_exe else None,
			        {"exe": rcc_exe, "jobs": qrc_jobs} if rcc_exe else None)
		cache.save()
		return 0

	# Targets are discovered, not requested, so one of them failing must not
	# discard the others -- you did not ask for the test binary that needs a
	# library fmake cannot resolve yet.
	built, failed, changed = [], [], False
	for t in wanted:
		res = resolutions.get(t)
		out, did, ok = link_target(t, closures[t], cfg, outdir,
		                           args.dry_run,
		                           res["ldflags"] if res else [],
		                           cache, root, quiet=args.quiet)
		changed = changed or did
		(built if ok else failed).append((t.filename, closures[t], res))

	cache.save()
	if args.dry_run and not (args.install or args.uninstall):
		if not args.no_libs:
			note("libraries are not resolved in a dry run: nothing was "
			     "compiled, so there are no symbols to resolve. The link "
			     "lines above are missing their -l flags.")
		if any(u.crate and not u.crate_exe for u in units.values()):
			# Same cause, and worth saying separately because this one is
			# a file in the tree rather than a package on the machine. A
			# crate joins a link set through its archive's symbol table,
			# and in a dry run the archive was never built.
			note("a Rust library crate is missing from the link lines for "
			     "the same reason: it joins a link set through the symbol "
			     "table of an archive nothing has built yet.")
		return 0
	if args.dry_run and args.install:
		return do_install(wanted, closures, root, outdir, conf, args)
	# `--uninstall -n' is the one anybody should run first, so it has to
	# reach the plan rather than stopping at the dry-run gate above.
	if args.dry_run and args.uninstall:
		return do_uninstall(wanted, closures, root, conf, args)

	if not args.quiet:
		if changed:
			# Only worth saying when something was actually rebuilt; on a
			# no-op build it is the same notice every time.
			# A held-back test is not unreachable, it was not asked
			# for, and saying the wrong one of those sends the reader to
			# --force-link for a file that needs `fmake test`.
			# A crate member is not uncompiled, it is not a unit: rustc
			# read it from the root, and `--force-link' on one would ask
			# fmake to compile a module on its own, which is an error.
			# A .rs nothing reaches was already named, at the point the
			# crates were worked out, with the remedy that fits it.
			ignored = sorted(set(srcs) - set(units)
			                 - {t.rel for t in held}
			                 - crate_members
			                 - set(crate_orphans))
			for rel in ignored[:5]:
				note(f"{rel} not compiled: nothing reaches it "
				     f"(--force-link if it is needed anyway)")
			if len(ignored) > 5:
				note(f"... and {len(ignored) - 5} more")
			# The same answer, for a .rs no crate draws in -- and asked
			# after the build rather than before it, because the scan is
			# not the authority on what a crate contains. `mod' is what
			# the scan reads; `include!("extra.rs")' is a macro and reads
			# as nothing at all, so a file that is genuinely part of the
			# crate looked exactly like one nothing reached. rustc's
			# depfile settles it, and only exists once rustc has run.
			read_by_crates = set()
			for u in units.values():
				if u.crate:
					read_by_crates |= {
					    os.path.relpath(f, root)
					    for f in crate_inputs(u, root)}
			for rel in [r for r in crate_orphans
			            if r not in read_by_crates][:5]:
				note(f"{rel} is reached by no crate root: nothing declares "
				     f"it with `mod', and only "
				     f"{' or '.join(sorted(CRATE_ROOTS))} roots a crate")
			# The remedy names Q_INIT_RESOURCE rather than --force-link,
			# which was what the documentation said and does not work: a
			# .qrc is not a source file, so --force-link refuses it by
			# name, and the generated qrc_*.cpp does not exist to be named
			# until rcc has already been decided on.
			for rel in qrc_unused[:5]:
				stem = os.path.splitext(os.path.basename(rel))[0]
				note(f"{rel} not built: no source names a path it declares "
				     f"(Q_INIT_RESOURCE({stem}) says so outright)")
			if len(qrc_unused) > 5:
				note(f"... and {len(qrc_unused) - 5} more resource(s)")
		# Outside `if changed', unlike everything above it. Those report
		# what THIS build decided, and repeating them on a no-op run is
		# the noise that guard exists to stop. This reports what the
		# ARTIFACT says, which does not stop being true because nothing
		# was rebuilt -- and under the guard it printed once and never
		# again, which is exactly how a binary saying "unknown" gets
		# shipped by somebody who saw the warning a week ago. Measured:
		# three runs, one message.
		for rel, name in version_fallen[:3]:
			note(f"{rel} defines {name} itself because the build did "
			     f"not, so this binary reports a version it made up")
			note(f"VERSION here says {version_says}; [project] cflags "
			     f"= ['-D{name}=\"{version_says}\"'] supplies it")
		if len(version_fallen) > 3:
			note(f"... and {len(version_fallen) - 3} more")

		names = ", ".join(n for n, _, _ in built)
		if built:
			info(f"built {names}" if changed else f"{names} up to date")

	# Written beside the artifacts, so from here on it is an ordinary built
	# file: install_plan picks it up, --clean names it, and the ejected
	# builds emit a rule for it. Not written in a dry run, which promises
	# to touch nothing.
	if not args.dry_run:
		for t in wanted:
			text = pc_text(t, conf)
			if text is None:
				continue
			path = os.path.join(outdir, t.name + ".pc")
			old_text = None
			try:
				with open(path) as fh:
					old_text = fh.read()
			except OSError:
				pass
			# Byte-stable for the same reason the ejected build is: this is
			# a file somebody may commit, and rewriting it on every build
			# makes it churn.
			if old_text != text:
				with open(path, "w") as fh:
					fh.write(text)

	if args.install and not failed:
		say()
		return do_install(wanted, closures, root, outdir, conf, args)

	if args.uninstall and not failed:
		say()
		return do_uninstall(wanted, closures, root, conf, args)

	if asked_phony and not failed:
		made = {}
		for t in wanted:
			made[t.name] = made[t.filename] = os.path.join(outdir, t.filename)
		for name in asked_phony:
			rc = run_phony(name, phony[name], root, made, args.dry_run)
			if rc:
				return rc
		return 0

	# After the build, and only if the build produced them. A test binary
	# that did not relink is a test binary that answers a question about
	# some earlier version of the code, which is the failure this whole
	# convention was traded against.
	if run_groups and not failed:
		if broken:
			say()
			warn(f"{len(broken)} file(s) did not compile; not running tests")
			return 1
		say()
		return run_tests_now([t for t in wanted
		                      if t.test_group in run_groups],
		                     root, outdir, conf, args.dry_run,
		                     known=targets)

	if broken:
		say()
		warn(f"{len(broken)} file(s) did not compile")
		for rel in sorted(broken)[:5]:
			note(rel)
		if len(broken) > 5:
			note(f"... and {len(broken) - 5} more")

	if failed:
		say()
		hidden_moc = set()
		for name, cl, res in failed:
			warn(f"{name} did not link")
			if cl.root.crate_exe:
				# Nothing below applies. rustc compiled and linked this in
				# one command, so there is no link line fmake assembled
				# and no library it could have failed to find -- and the
				# ending that offers --ldflags would send the reader to
				# install something that has nothing to do with it.
				others = sorted(r for r in crates
				                if r != cl.root.rel
				                and not scans[r].get("has_main"))
				if others:
					# The common Rust layout is a main.rs beside a lib.rs,
					# and they are two crates. Cargo makes one available
					# to the other through a dependency graph in a build
					# file; fmake has none to read, so `use thing::x' in
					# the program is an undeclared crate. Said here
					# because rustc's own `unresolved import' names the
					# crate and not the reason.
					note(f"{cl.root.rel} and {', '.join(others)} are "
					     f"separate crates, and fmake does not make one "
					     f"available to the other: that is a dependency "
					     f"graph, and it lives in a build file fmake does "
					     f"not read")
					note("`mod' draws a file into this crate; `use "
					     "othercrate::' needs Cargo")
				continue
			if res and res["chosen"]:
				note(f"resolved to: {' '.join(res['ldflags'])}")
			missing = res["unresolved"] if res else sorted(cl.external)
			if missing:
				note(f"no {describe_identity(res.get('ident') if res else None)}"
				     f" library exports: {', '.join(missing[:6])}"
				     + (" ..." if len(missing) > 6 else ""))
			# A file fmake was told to leave out is the commonest reason a
			# symbol in this tree has nowhere to come from, and the exclusion
			# is invisible here: @os with a typo removes a file on every
			# platform, and a stray [project] exclude pattern removes
			# whatever it happens to match. --explain has always said so;
			# the failure never did, and the failure is what people read.
			toks = set()
			for s in missing:
				toks |= symbol_tokens(s)
			for rel, why in sorted(excluded.items()):
				if toks.intersection(scans.get(rel, {}).get("defs") or []):
					note(f"{rel} is excluded ({why}) and appears to define "
					     f"one of them")
			# A meta-object this tree was supposed to generate is not a
			# missing library, and offering --ldflags for one sends the
			# reader to install something. The warning above already said
			# it; the failure is what gets read, so it says it too.
			#
			# Matched on the link set rather than on the symbol, because
			# tying a mangled name to a class means demangling and the
			# connection is exact without it: this program links a source
			# that declares a Q_OBJECT class whose moc output was never
			# generated.
			blamed = [u.rel for u in cl.link if u.rel in moc_unreachable]
			for rel in blamed:
				note(f"{rel} declares a Q_OBJECT class and does not "
				     f'#include "{moc_unreachable[rel]}", so its '
				     f"meta-object was never generated")
			# The other half of the same failure, and the one the scan
			# cannot see at all: a header whose Q_OBJECT arrives through
			# another macro carries no token, so no job was planned and
			# nothing above blames it. Only asked when Qt is actually
			# being linked, and only on a link that has already failed.
			if not blamed and res and any(
			        f.startswith("-lQt") for f in res.get("ldflags") or []):
				for rel in unscanned_moc_inputs(root, cl.link, scans, hdrs,
				                                {j["src"] for j in moc_jobs},
				                                cfg, conf, pkg):
					hidden_moc.add(rel)
					note(f"{rel} needs moc -- it spells Q_OBJECT through "
					     f"another macro, which the scan cannot see, so no "
					     f"meta-object was generated for it")
		# Three endings, because there are three causes and only one of them
		# is a missing library. Offering --ldflags for a meta-object this
		# tree was supposed to generate sends the reader to install
		# something that does not exist.
		if hidden_moc:
			note("write Q_OBJECT in the class rather than reaching it "
			     "through another macro: moc's preprocessor finds it either "
			     "way, but what decides to run moc is a token search")
		elif any(u.rel in moc_unreachable
		         for _n, c, _r in failed for u in c.link):
			note('add the missing #include of the .moc file above; if that '
			     "is not it, name the missing libraries with --ldflags")
		elif all(c.root.crate_exe for _n, c, _r in failed):
			# Every failure here was rustc's, and rustc has already said
			# what was wrong in its own words.
			pass
		else:
			note("name the missing libraries with --ldflags, or build only "
			     "the targets you want")
		return 1
	return 1 if broken else 0

# ---------------------------------------------------------------------------
# --eject
#
# The exit. Everything fmake worked out -- link sets, per-file flags, resolved
# libraries, wrap flags -- written as a build file that needs no fmake to run.
# A tool this opinionated has to be leaveable, and a promise to be leaveable is
# worth nothing unless it is exercised.
#
# It is also the cheapest independent check on the whole model. If the emitted
# build produces working binaries, the link sets and flags were right, verified
# by a second implementation that shares no code with the first.
#
# Goes to stdout rather than to a file. Writing Makefile by default would mean
# clobbering the hand-written Makefile that fmake was very likely run beside --
# the udp-echo project used to develop this has exactly that -- and a build
# tool that eats build files is not a good neighbour.
# ---------------------------------------------------------------------------

EJECT_BUILD_DIR = "build"
# Where fmake's generated trees land inside an ejected build's object
# directory. A standalone build file should not write into the bookkeeping of
# the tool it no longer needs, and `fmake --clean` must not be able to delete
# something an ejected build depends on.
EJECT_GENDIRS = ((MOC_DIR, "moc"), (UI_DIR, "ui"), (QRC_DIR, "qrc"))


def _eject_gen(rel):
	"""Remap a generated path out of the state directory, or None.

    Matches the directory itself as well as what is under it: an -I naming a
    generated root is exactly what flat uic output produces, and a prefix
    test that misses it emits a build compiling against a directory only
    fmake creates.
    """
	for src_dir, dst in EJECT_GENDIRS:
		if rel == src_dir or rel.startswith(src_dir + os.sep):
			return os.path.normpath(os.path.join(dst,
			                                     os.path.relpath(rel, src_dir)))
	return None


def _eject_src(rel):
	"""Where a source file lives in an ejected build."""
	sub = _eject_gen(rel)
	return os.path.join(EJECT_BUILD_DIR, sub) if sub else rel


def _eject_obj(rel):
	"""A source's object path, relative to the ejected object directory."""
	return _eject_gen(rel) or rel


def _eject_flags(flags, root):
	"""Make in-tree paths relative so the emitted build is portable."""
	out = []
	for f in flags:
		for prefix in ("-I", "-L"):
			if f.startswith(prefix) and os.path.isabs(f[2:]):
				rel = _rel(f[2:], root)
				out.append(prefix + (_eject_src(rel) if rel != root else "."))
				break
		else:
			out.append(f)
	return out


def _mk_ident(name):
	return re.sub(r"[^A-Za-z0-9_]", "_", name)


def refuse_ident_collisions(what, names):
	"""Refuse names a Make identifier cannot tell apart.

    `-` is not legal in a Make variable, so `my-app` and `my_app` both
    become MY_APP. The emitted file then assigns MY_APP_OBJS twice and every
    rule using it takes the second, so one artifact is built from another's
    objects and nothing says so. Valid Makefile, wrong program.

    Two callers and the same failure, which is why this is one function: any
    name rewritten to suit a consumer with a narrower alphabet can collide,
    and the next one will too.
    """
	spelt = {}
	for name in names:
		spelt.setdefault(_mk_ident(name).upper(), []).append(name)
	for ident, clashing in sorted(spelt.items()):
		if len(clashing) > 1:
			die(f"{what} {' and '.join(repr(c) for c in sorted(clashing))} "
			    f"are the same Make variable ({ident}_...): give one of "
			    f"them a different name")


RE_NINJA_ESCAPE = re.compile(r"([ :$])")


def _ninja(path):
	"""Ninja escapes a space, colon or dollar in a path with `$`."""
	return RE_NINJA_ESCAPE.sub(r"$\1", path)


def _refuse_whitespace(targets, closures, root):
	"""Make cannot express a filename containing whitespace.

    Not a limitation worth working around: Make splits prerequisites on
    spaces and has no escaping that survives every position one can appear
    in. Emitting something that looks like a build file and silently means
    something else is worse than saying so -- and ninja can express it, so
    there is somewhere to send people.
    """
	bad = set()
	for t in targets:
		if any(c.isspace() for c in t.filename):
			bad.add(t.filename)
		for u in closures[t].link:
			if any(c.isspace() for c in u.rel):
				bad.add(u.rel)
	# The install rule names @headers, which no other part of the emitted
	# file mentions -- so a header with a space in it would slip past a
	# check that only looked at sources and reach the recipe as two
	# arguments to install(1).
	for _, source, _, name, _ in install_plan(targets, closures, root):
		if any(c.isspace() for c in source) or any(c.isspace() for c in name):
			bad.add(source)
	if bad:
		die("cannot eject a Makefile for paths containing whitespace:\n    "
		    + "\n    ".join(sorted(bad)[:5])
		    + ("\n    ..." if len(bad) > 5 else "")
		    + "\nMake splits prerequisites on spaces and cannot express "
		      "these.\nUse `--eject ninja`, which can.")


def eject_make(targets, closures, resolutions, cfg, incflags, root, conf,
               gen_rules=None, moc=None, uic=None, rcc=None,
               fragment=False):
	"""A standalone Makefile, or a fragment for an existing one to include.

    The fragment exists because replacing a build system is not the only way
    to adopt one. A project whose Makefile also patches a submodule,
    cross-builds for two Android ABIs and produces two .debs does not want
    fmake to own any of that -- and the compile step, which is the part
    fmake is actually better at, is a small share of what that Makefile
    does. Ejecting a fragment lets the hand-written one keep everything else
    and stop maintaining object rules.

    So the fragment differs only where inclusion demands it: it sets no
    default goal, its aggregate rules are `fmake-all` and `fmake-clean`, and
    every variable it owns carries FM_. That prefix is not tidiness. A
    parent Makefile setting CFLAGS -- which is the most ordinary thing a
    Makefile does -- would otherwise replace every flag fmake worked out,
    and nothing about the result would look wrong until a build failed for
    an unrelated-looking reason. CC, CXX and AR stay unprefixed and become
    conditional, because those the parent *should* control.
    """
	# Both ejected forms run their tests from the tree root, so $bin(NAME)
	# resolves to the same relative path the recipe below invokes.
	eject_bins = {x.name: "./" + x.filename for x in targets}
	eject_files = {x.name: x.filename for x in targets}
	P = "FM_" if fragment else ""
	_refuse_whitespace(targets, closures, root)
	any_crate = any(u.crate for t in targets for u in closures[t].link)
	common = _eject_flags(cfg.base_cflags() + incflags, root)
	override = _eject_flags(cfg.override, root)
	L = []
	a = L.append

	a(f"# Generated by `fmake --eject "
	  f"{'make-fragment' if fragment else 'make'}`.")
	a("#")
	a("# This file is yours: fmake is not needed to build it, and nothing here")
	a("# refers back to fmake. Every flag was worked out from the source -- the")
	a("# link sets come from object symbol tables, not from the #include graph")
	a("# -- so editing by hand is fine, but re-ejecting will not preserve it.")
	a("#")
	# Said here because it is invisible everywhere else. A project that
	# ejects and commits the result silently adopts fmake's defaults in
	# place of whatever its own build passed -- a language standard, a
	# warning set its Makefile's own comments called "not decoration".
	# Neither shows up as an error, and the diff is the only place it exists.
	a("# The flags below are what fmake worked out, not what your previous")
	a("# build system passed. If you are replacing one, diff the flags first:")
	a("# a dropped -std= or -W set is silent, and shows up as behaviour.")
	a("#")
	# The staleness contract, said in the artifact rather than only in
	# project.md, because project.md is not where the reader is. It is a
	# snapshot of one closure: there is one explicit rule per object and no
	# way to recompute which objects there should be.
	#
	# Both halves are worth naming because only one of them is loud. A new
	# call into a file this build does not know gives an undefined
	# reference, which nobody can miss. A file nothing refers to -- a
	# constructor-registered plugin, a test registered by a macro -- is
	# simply never compiled, and that is silent: the build succeeds and the
	# code is not in it.
	a("# This is a snapshot of one closure, not a translation of the tree.")
	a("# Adding a source file, or a call that reaches a file this build does")
	a("# not already name, means running --eject again. A new reference gives")
	a("# an undefined symbol, which is loud; a file nothing refers to is just")
	a("# never compiled, which is not.")
	a("#")
	# None is needed, and the reason is worth writing down because the
	# obvious helpful edit is the one that reintroduces the hazard.
	a("# There are no pattern rules here -- one explicit rule per object, so")
	a("# per-file flags survive -- which means nothing is an intermediate and")
	a("# .SECONDARY has nothing to do. Do not add a bare `.SECONDARY:': it")
	a("# would cover every pattern-matched target, and Make does not rebuild")
	a("# a missing secondary when the thing needing it already exists.")
	a("#")
	if fragment:
		a("# Include this from your own Makefile:")
		a("#")
		a("#     include fmake.mk")
		a("#     all: $(FM_TARGETS) my-other-thing")
		a("#")
		a("# It sets no default goal, so include it *after* your own default")
		a("# target -- or accept `fmake-all', the first rule below, which")
		a("# builds everything and is the least surprising thing to land on.")
		a("# Every variable it owns is FM_-prefixed so your CFLAGS cannot")
		a("# silently replace the flags above; CC, CXX and AR are yours, and")
		a("# use ?= so what you set wins.")
		a("#")
	a(f"# Built for: {cfg.os}/{cfg.arch}"
	  + (f"    profile: {conf.profile_name}" if conf.profile_name else ""))
	a("")
	assign = "?=" if fragment else "="
	# Aligned on the longest name rather than on a column somebody counted
	# once. BUILD_DIR replacing OBJDIR is two characters longer and put
	# three assignments out of line, which is what a hand-spaced table does
	# the first time a name changes.
	width = len(P) + len("CFLAGS_LAST")

	def var(name, value, how="=", own=True):
		"""One assignment, padded to the widest name this file emits.

        `own` is false for the three the parent controls: they keep their
        conventional spellings in a fragment, so FM_ must not reach them.
        """
		# The operator is right-aligned in two columns so that `=` and `?=`
		# end at the same one. Aligning on the name alone puts every plain
		# assignment a column left of every conditional, which is only
		# invisible in a file that has one kind or the other.
		head = f"{(P if own else '') + name:<{width}} {how:>2} "
		if not isinstance(value, list):
			return (head + str(value)).rstrip()
		# Wrapped, because a Qt project's CXXFLAGS is eighteen hundred
		# characters on one line and this file's header invites editing it.
		# Make joins a continuation with a space, so the value is unchanged
		# -- which the symbol-for-symbol comparison is what proves.
		lines, cur = [], head
		for item in value:
			if cur != head and len(cur) + len(item) + 3 > 78:
				lines.append(cur + " \\")
				cur = " " * (width + 4)
			cur += ("" if cur.endswith(" ") or cur == head else " ") + item
		lines.append(cur)
		return "\n".join(lines).rstrip() if lines else head.rstrip()

	a(var("CC", cfg.cc, assign, own=False))
	a(var("CXX", cfg.cxx, assign, own=False))
	a(var("AR", cfg.ar_name, assign, own=False))
	a(var("CFLAGS", common))
	a(var("CXXFLAGS", common))
	# Emitted separately so it stays after each file's own flags, which is
	# what makes it an override rather than just another default.
	a(var("CFLAGS_LAST", override))
	# `$(CFLAGS)' rather than a snapshot of them, which is what the sibling
	# Makefiles mean by `LDFLAGS ?= $(CFLAGS)'. It is what carries --coverage
	# and -pg and -fopenmp to the link, and it is also what makes the DEBUG
	# and SANITIZE conditionals below reach the link without being written
	# out a second time -- a recursive `=' expands when the recipe runs, by
	# which point every conditional in this file has been decided.
	a(var("LDFLAGS", [f"$({P}CFLAGS)", f"$({P}CFLAGS_LAST)"]
	      + _eject_flags(cfg.ldflags, root)))
	if any_crate:
		# rustc has no CC/CFLAGS convention to inherit, so both are ours
		# and both are plain assignments even in a fragment: a parent
		# Makefile that had a RUSTFLAGS would be talking about a build
		# fmake did not compute.
		a(var("RUSTC", cfg.rustc, assign, own=False))
		a(var("RUSTFLAGS", ["--edition", cfg.rust_edition] + cfg.rustflags))
	a(var("BUILD_DIR", EJECT_BUILD_DIR, assign))
	a("")

	# DEBUG and SANITIZE survive the exit.
	#
	# Baking them in would leave a Makefile that answers `make DEBUG=1' by
	# building a release and saying nothing, which is worse than never
	# having offered the switch -- and it would hand back something less
	# capable than the hand-written Makefile it replaced, since the sibling
	# projects all carry these.
	#
	# They are the *plan* in no sense: which files, which link sets and
	# which libraries are all unchanged by them, so nothing here needs
	# re-ejecting to switch. That is what separates them from the snapshot
	# limit in section 15.
	#
	# `$(filter-out 0,$(VAR))' rather than `ifdef VAR', which is the idiom
	# everyone reaches for and is wrong here: ifdef calls DEBUG=0 set, so
	# the emitted file would contradict the tool that emitted it. filter-out
	# is empty for unset, for empty and for exactly 0, and non-empty for
	# anything else, which is fmake's rule exactly.
	if cfg.opt_flags:
		a("# Set DEBUG=1 for a debug build. 0 and empty are off, matching")
		a("# the tool this came from -- note that is not what ifdef would do.")
		a("#")
		a("# `:=' and not `=': these prepend to the variable they assign, and")
		a("# a recursive assignment referring to itself is an error Make")
		a("# reports rather than a loop it runs.")
		a("ifeq ($(filter-out 0,$(DEBUG)),)")
		for name in ("CFLAGS", "CXXFLAGS"):
			a(var(name, _eject_flags(DEFAULT_CFLAGS, root)
			      + [f"$({P}{name})"], ":="))
		a("else")
		for name in ("CFLAGS", "CXXFLAGS"):
			a(var(name, _eject_flags(DEBUG_CFLAGS, root)
			      + [f"$({P}{name})"], ":="))
		a("endif")
		a("")
	a("# Set SANITIZE=1 for AddressSanitizer and UndefinedBehaviorSanitizer.")
	a("# Both sides: a sanitizer is a runtime as well as an instrumentation,")
	a("# so compiling with it and linking without leaves __asan_report_*")
	a("# undefined and the link fails naming none of this.")
	a(f"ifneq ($(filter-out 0,$(SANITIZE)),)")
	san = " ".join(_eject_flags(SANITIZE_CFLAGS, root))
	a(var("CFLAGS", san, "+="))
	a(var("CXXFLAGS", san, "+="))
	# No LDFLAGS line: it is defined as $(CFLAGS) above, so adding one here
	# would put the sanitizer on the link twice.
	a("endif")
	a("")
	# The default target does not build tests, and a separate one builds
	# and runs them. That is what three of the projects that read this
	# output already do by hand, and what their conventions require of any
	# Makefile -- including a generated one, since a generated Makefile is
	# still a Makefile someone will edit.
	tests = [t for t in targets if t.test]
	by_group = {}
	for t in tests:
		by_group.setdefault(t.test_group, []).append(t)
	group_names = sorted(by_group)
	names = " ".join(t.filename for t in targets if not t.test)

	def group_var(g):
		return ("FM_" if fragment else "") + _mk_ident(g).upper() + "_TARGETS"

	def group_rule(g):
		return ("fmake-" + g) if fragment else g

	if fragment:
		a(f"FM_TARGETS = {names}")
	for g in group_names:
		a(f"{group_var(g)} = "
		  + " ".join(t.filename for t in sorted(by_group[g],
		                                        key=lambda x: x.name)))
	a("")
	phonies = " ".join(group_rule(g) for g in group_names)
	if fragment:
		a(".PHONY: fmake-all fmake-clean"
		  + (" " + phonies if phonies else ""))
		a("fmake-all: $(FM_TARGETS)")
	else:
		a(".PHONY: all clean" + (" " + phonies if phonies else ""))
		a(f"all: {names}")
	a("")
	for g in group_names:
		_dep = bin_deps(conf, by_group[g], eject_files)
		a(f"{group_rule(g)}: $({group_var(g)})"
		  + ("".join(" " + d for d in _dep) if _dep else ""))
		for t in sorted(by_group[g], key=lambda x: x.name):
			argv = " ".join(shlex.quote(x)
			                for x in t.conf.get("test-args", []))
			env = " ".join(shlex.quote(p)
			               for p in test_env_pairs(conf, t, eject_bins))
			a(f"\t{env + ' ' if env else ''}./{t.filename}"
			  + (f" {argv}" if argv else ""))
		a("")

	gen_rules = gen_rules if gen_rules is not None else {}
	gen_outs = [o for n in _gen_order(gen_rules)
	            for o in gen_rules[n]["outputs"]]
	if gen_rules:
		a("# ---- generated sources " + "-" * 40)
		a("")
		a(f"{P}GENERATED = {' '.join(gen_outs)}")
		a("")
		for name in _gen_order(gen_rules):
			r = gen_rules[name]
			outs, ins = r["outputs"], r["inputs"]
			deps = r.get("depends", [])
			a(f"{outs[0]}: {' '.join(ins + deps)}")
			a("\t@mkdir -p $(@D)")
			for c in (r.get("commands") or [r["command"]]):
				line, quiet, ignore = _recipe_prefix(c)
				line = _gen_command(line, ins, outs, None, r.get("stem"))
				# Whatever $ survives substitution is the shell's, and Make
				# would read $(x) as its own function call and expand it to
				# nothing -- a recipe that runs, succeeds, and produces an
				# empty file.
				a("\t" + ("@" if quiet else "") + ("-" if ignore else "")
				  + line.replace("$", "$$"))
			# Secondary outputs hang off the first, which is the portable way
			# to say one command produces several files.
			for extra in outs[1:]:
				a(f"{extra}: {outs[0]}")
				a("\t@:")
			a("")

	every, crate_libs, crate_deps = {}, {}, {}
	for t in targets:
		for u in closures[t].link:
			if u.prebuilt:          # nothing fmake compiled, nothing to emit
				continue
			# A crate is not a translation unit and gets no object rule.
			# Its members are not rules at all: rustc reads them from the
			# root, so they are prerequisites of one command.
			if u.crate:
				crate_deps[u.rel] = u
				if not u.crate_exe:
					crate_libs[u.rel] = u
				continue
			every[u.rel] = u

	# Only the moc outputs this build actually reaches. The caller has
	# already dropped the inputs that produced nothing -- a rule promising a
	# file that never appears would stall a build rather than fail it -- and
	# what is left still includes the classes no target links, which belong
	# in fmake's own report but not in a Makefile that would never run them.
	moc = moc or {}
	moc_jobs = [j for j in (moc.get("jobs") or [])
	            if (j["src"] if j["inline"] else j["out"]) in every]
	# Every uic job was triggered by an include that some file makes, so
	# unlike moc there is nothing to filter -- a header nothing wanted would
	# never have been generated.
	uic = uic or {}
	uic_jobs = uic.get("jobs") or []

	# The generated files that are #included rather than compiled: the uic
	# headers and the .moc bodies. They must exist before anything compiles,
	# and nothing declares that until a depfile does, so they are an
	# order-only prerequisite of every object.
	genhdrs = ([_eject_src(j["out"]) for j in uic_jobs]
	           + [_eject_src(j["out"]) for j in moc_jobs if j["inline"]])
	if genhdrs:
		a(f"{P}GENHDRS = {' '.join(genhdrs)}")
		a("")

	if uic_jobs:
		a("# ---- uic " + "-" * 54)
		a("#")
		a('# Selected by `#include "ui_*.h"` in the source, not by a list.')
		a("")
		a(f"{P}UIC      = {uic['exe']}")
		a("")
		for j in uic_jobs:
			a(f"{_eject_src(j['out'])}: {j['src']}")
			a("\t@mkdir -p $(@D)")
			a(f"\t$({P}UIC) $< -o $@")
			a("")
	rcc = rcc or {}
	rcc_jobs = [j for j in (rcc.get("jobs") or []) if j["out"] in every]
	if rcc_jobs:
		a("# ---- rcc " + "-" * 54)
		a("#")
		a("# Selected by what the source opens, not by a list.")
		a("")
		a(f"{P}RCC      = {rcc['exe']}")
		a("")
		for j in rcc_jobs:
			a(f"{_eject_src(j['out'])}: {j['src']}")
			a("\t@mkdir -p $(@D)")
			a(f"\t$({P}RCC) --name {j['name']} $< -o $@")
			a("")

	if moc_jobs:
		a("# ---- moc " + "-" * 54)
		a("#")
		a("# Selected by Q_OBJECT in the source, not by a list. Override MOC")
		a("# if Qt lives elsewhere on the machine doing the building.")
		a("")
		a(f"{P}MOC      = {moc['exe']}")
		a(f"{P}MOCFLAGS = {' '.join(_eject_flags(moc.get('flags', []), root))}")
		a("")
		for j in moc_jobs:
			a(f"{_eject_src(j['out'])}: {j['src']}")
			a("\t@mkdir -p $(@D)")
			a(f"\t$({P}MOC) $({P}MOCFLAGS) $< -o $@")
			a("")

	# One rule per object, because per-file flags are the point: @cflags and
	# @define belong to a translation unit, so a single pattern rule cannot
	# express them.
	a("# ---- objects " + "-" * 50)
	a("")
	for rel in sorted(every):
		u = every[rel]
		obj = f"$({P}BUILD_DIR)/{_eject_obj(rel)}.o"
		# CC pairs with CFLAGS, not CCFLAGS. Getting this wrong expands to an
		# undefined variable, so every compile silently loses its flags and
		# only a project that actually needs an -I notices.
		var, flags = ("CXX", "CXXFLAGS") if u.cxx else ("CC", "CFLAGS")
		own = " ".join(_eject_flags(u.own, root))
		after = ([f"$({P}GENERATED)"] if gen_outs else []) \
		        + ([f"$({P}GENHDRS)"] if genhdrs else [])
		order_only = (" | " + " ".join(after)) if after else ""
		a(f"{obj}: {_eject_src(rel)}{order_only}")
		a("\t@mkdir -p $(@D)")
		# -MP as well as -MD: it emits a phony target for every header, so
		# deleting one leaves `No rule to make target` behind instead of a
		# build. fmake's own depfiles are read by fmake, which simply skips a
		# prerequisite that is gone; a Makefile has no such luxury, and an
		# ejected Makefile is a Makefile someone will edit.
		dep = " ".join(u.lang.dep_flags("$(@:.o=.d)", phony=True))
		a(f"\t$({var}) $({P}{flags}){' ' + own if own else ''} $({P}CFLAGS_LAST) "
		  f"-c $< -o $@ {dep}")
		a("")

	if crate_libs:
		a("# ---- crates " + "-" * 52)
		a("#")
		a("# One rustc call per crate. The members are prerequisites and not")
		a("# rules: rustc is handed the root and reads the rest itself, so a")
		a("# module compiled on its own would be a crate with no main().")
		a("")
		for rel in sorted(crate_libs):
			u = crate_libs[rel]
			out = f"$({P}BUILD_DIR)/{_eject_obj(rel)}.a"
			deps = " ".join([_eject_src(rel)]
			                + [_eject_src(m) for m in sorted(u.members)])
			a(f"{out}: {deps}")
			a("\t@mkdir -p $(@D)")
			a(f"\t$({P}RUSTC) $({P}RUSTFLAGS) --crate-type=staticlib \\")
			a(f"\t    -o $@ --emit=link,dep-info=$(@:.a=.d) {_eject_src(rel)}")
			a("")

	a("# ---- targets " + "-" * 50)
	a("")
	for t in targets:
		ident = _mk_ident(t.name).upper()
		root_unit = closures[t].root
		if root_unit.crate_exe:
			# The whole build of a Rust program is this one command, so
			# there is no object list and no link line. Its prerequisites
			# are the crate's files, which is what keeps it honest here --
			# a Makefile has no closure to recompute.
			deps = " ".join([_eject_src(root_unit.rel)]
			                + [_eject_src(m)
			                   for m in sorted(root_unit.members)])
			a(f"{t.filename}: {deps}")
			a(f"\t@mkdir -p $({P}BUILD_DIR)")
			a(f"\t$({P}RUSTC) $({P}RUSTFLAGS) -o $@ \\")
			a(f"\t    --emit=link,dep-info=$({P}BUILD_DIR)/"
			  f"{_eject_obj(root_unit.rel)}.d {_eject_src(root_unit.rel)}")
			a("")
			continue
		objs = [f"$({P}BUILD_DIR)/{_eject_obj(u.rel)}.o" for u in closures[t].link
		        if not u.prebuilt and not u.crate]
		a(f"{P}{ident}_OBJS = \\")
		for i, o in enumerate(objs):
			a(f"\t{o}" + (" \\" if i < len(objs) - 1 else ""))
		a("")
		res = resolutions.get(t)
		libs = " ".join(_eject_flags(res["ldflags"], root)) if res else ""
		driver = "CXX" if any(u.cxx for u in closures[t].link) else "CC"
		# Vendored archives are prerequisites, so a changed one relinks, but
		# they are named on the command line rather than taken from $^: they
		# have to come after every object, and a group cannot be expressed by
		# a prerequisite list at all. A static target takes none of them,
		# matching what fmake itself does.
		arcs = [] if t.kind == "static" else \
		       [f"$({P}BUILD_DIR)/{_eject_obj(u.rel)}.a" if u.crate else u.rel
		        for u in closures[t].link if u.archive]
		# Asked separately, because `arcs' is empty for a static target by
		# design -- an archive is not nested inside another one. The crate
		# archives are still there, and for a tree that is only a library
		# crate they are the whole of the answer.
		crate_arcs = [f"$({P}BUILD_DIR)/{_eject_obj(u.rel)}.a"
		              for u in closures[t].link if u.archive and u.crate]
		# A prebuilt .o is an ordinary object: named with the rest rather
		# than after them, and never inside the group, since a group is for
		# things the linker searches and an object is not searched.
		blobs = [u.rel for u in closures[t].link
		         if u.prebuilt and not u.archive]
		objs_txt = f"$({P}{ident}_OBJS)" + (
		    " " + " ".join(blobs) if blobs else "")
		arcs_txt = " ".join(arcs)
		if len(arcs) > 1:
			arcs_txt = f"-Wl,--start-group {arcs_txt} -Wl,--end-group"
		tail = ((f" {arcs_txt}" if arcs_txt else "")
		        + (f" {libs}" if libs else "") + f" $({P}LDFLAGS)")
		a(f"{t.filename}: $({P}{ident}_OBJS)"
		  + (f" {' '.join(blobs)}" if blobs else "")
		  + (f" {' '.join(arcs or crate_arcs)}"
		     if (arcs or crate_arcs) else ""))
		if t.kind == "static" and not objs and len(crate_arcs) == 1:
			# The crate's staticlib is the library. Copied rather than
			# assembled, for the reason link_cmd gives: `ar` over no
			# objects writes an empty archive and reports success.
			a(f"\tcp {crate_arcs[0]} $@")
		elif t.kind == "static":
			a("\trm -f $@")
			a("\t$(AR) rcs $@ $^")
		elif t.kind == "shared":
			a(f"\t$({driver}) -shared -Wl,-soname,{t.soname} -o $@ {objs_txt}{tail}")
		else:
			a(f"\t$({driver}) -o $@ {objs_txt}{tail}")
		a("")

	# ---- install
	#
	# An ejected build that cannot install is only half an exit. A project
	# adopting fmake and then leaving with the Makefile still had to
	# hand-write this one rule, which is the gap the packaging evaluation
	# named as the thing standing between it and adoption.
	#
	# The plan comes from install_plan, the same function --install uses, so
	# the two cannot disagree about what a project publishes. What differs
	# is only that a directory stays a variable here.
	plan = install_plan(targets, closures, root)
	if plan:
		a("# ---- install " + "-" * 46)
		a("")
		a("# GNU names, and yours to set exactly as CC and AR are: a")
		a("# distribution sets DESTDIR and PREFIX and the rest follow. `?='")
		a("# throughout, so setting one on the command line or in a parent")
		a("# Makefile wins without editing this file.")
		defaults = dict(INSTALL_DEFAULTS)
		defaults.update({k: v for k, v in conf.install.items() if v})
		a(f"PREFIX ?= {defaults['prefix']}")
		for key in ("bindir", "libdir", "includedir"):
			sub = defaults[key]
			a(f"{key.upper()} ?= "
			  + (sub if os.path.isabs(sub) else f"$(PREFIX)/{sub}"))
		a("PKGCONFIGDIR ?= $(LIBDIR)/pkgconfig")
		a("")
		# The .pc files, written by the ejected build rather than copied
		# out of the tree: a clean checkout of a project that committed
		# this Makefile has no .pc in it, and an install rule naming a
		# file nothing produces fails on the one machine that matters.
		pcs = [(t, pc_text(t, conf)) for t in targets]
		pcs = [(t, text) for t, text in pcs if text]
		for t, text in pcs:
			a(f"{t.name}.pc:")
			# `${prefix}` is a pkg-config variable and a Make variable
			# reference, and Make wins: unescaped, the recipe runs,
			# succeeds, and writes a .pc with empty paths. Section 26
			# records the same trap for fmake.mk recipes -- a surviving
			# dollar has to be doubled or the output is quietly wrong.
			args_ = " ".join(shlex.quote(l.replace("$", "$$"))
			                 for l in text.rstrip("\n").split("\n"))
			a(f"\tprintf '%s\\n' {args_} > $@")
			a("")

		rule = "fmake-install" if fragment else "install"
		# Depends on the build: installing what was not built is how a
		# stale artifact reaches a package, and fmake's own --install
		# refuses for the same reason.
		a(f".PHONY: {rule}")
		a(f"{rule}: {'fmake-all' if fragment else 'all'}"
		  + ("".join(f" {t.name}.pc" for t, _x in pcs)))
		for directory in ("bindir", "libdir", "includedir",
		                  "pkgconfigdir"):
			items = [p for p in plan if p[2] == directory]
			if not items:
				continue
			var = f"$(DESTDIR)$({directory.upper()})"
			a(f"\tinstall -d {var}")
			for origin, source, _, name, mode in items:
				if origin == "symlink":
					a(f"\tln -sf {source} {var}/{name}")
					continue
				src = source if origin == "built" else _eject_src(source)
				a(f"\tinstall -m {mode:o} {src} {var}/{name}")
		a("")
		# The inverse, named file by file for the reason `clean' is: a
		# target everybody runs without reading must not be able to remove
		# something it did not put there. No wildcard, no directory.
		# `-f' so that uninstalling twice, or after a partial install, is
		# the ordinary thing it looks like rather than an error.
		undo = "fmake-uninstall" if fragment else "uninstall"
		a(f".PHONY: {undo}")
		a(f"{undo}:")
		for directory in ("bindir", "libdir", "includedir",
		                  "pkgconfigdir"):
			for _origin, _source, d, name, _mode in plan:
				if d == directory:
					a(f"\trm -f $(DESTDIR)$({directory.upper()})/{name}")
		a("")

	all_objs = sorted({f"$({P}BUILD_DIR)/{_eject_obj(rel)}.o" for rel in every})
	# Every file this build creates, named. Not `rm -rf $(BUILD_DIR)`: BUILD_DIR
	# is an ordinary Make variable and overriding it is expected usage, so
	# an empty or mistyped one removes something else entirely -- and this
	# file is handed to people to edit, with a header telling them fmake is
	# not needed to read it, so nobody reviews it. Three projects reported
	# that shape independently, two having written it themselves.
	#
	# Naming them is possible because fmake knows them: it listed every
	# object to -include the depfiles a line below. A generator that cannot
	# say what it made has no business deleting by pattern, and one that can
	# has no need to.
	#
	# The directories are left behind. Removing them would mean removing
	# something this rule did not name, which is the whole point.
	# A generate rule may name an output anywhere, and one that names it
	# outside the tree is still built -- that is the author's instruction.
	# It does not get *deleted*, which is a different promise: --clean
	# already refuses to remove anything above the root, and an ejected
	# clean that removed what fmake's would not is the two disagreeing
	# about the one rule everybody runs without reading.
	def _within(rel):
		full = os.path.normpath(os.path.join(root, rel))
		return full.startswith(os.path.join(root, ""))

	a(f"{P}CLEAN = \\")
	leavings = ([f"$({P}BUILD_DIR)/{_eject_obj(rel)}.o" for rel in sorted(every)]
	            + [f"$({P}BUILD_DIR)/{_eject_obj(rel)}.d" for rel in sorted(every)]
	            + [f"$({P}BUILD_DIR)/{_eject_obj(rel)}.a"
	               for rel in sorted(crate_libs)]
	            + [f"$({P}BUILD_DIR)/{_eject_obj(rel)}.d"
	               for rel in sorted(crate_deps)]
	            + [t.filename for t in targets]
	            + [t.name + ".pc" for t in targets if pc_text(t, conf)]
	            + [_eject_src(j["out"]) for j in uic_jobs]
	            + [_eject_src(j["out"]) for j in moc_jobs]
	            + [_eject_src(j["out"]) for j in rcc_jobs]
	            + [o for o in gen_outs if _within(o)])
	# Said, not silently dropped. A build that quietly stops cleaning
	# something it makes is the shape a stale artifact hides in, and the
	# reader is the only one who can decide whether that file matters.
	for o in sorted(o for o in gen_outs if not _within(o)):
		note(f"{o} is outside the tree, so the ejected clean leaves it "
		     f"alone -- as fmake --clean does")
	for i, item in enumerate(leavings):
		a(f"\t{item}" + (" \\" if i < len(leavings) - 1 else ""))
	a("")
	a("fmake-clean:" if fragment else "clean:")
	a(f"\trm -f $({P}CLEAN)")
	a("")
	# One named list rather than every object spelled out again on the
	# -include line. That line worked and was unpleasant to hand-edit, in a
	# file whose header invites hand-editing.
	a(f"{P}OBJS = \\")
	for n, o in enumerate(all_objs):
		a(f"\t{o}" + (" \\" if n < len(all_objs) - 1 else ""))
	a("")
	a("# Depfiles the compiler writes as a side effect, so a changed header")
	a("# rebuilds what includes it.")
	a(f"-include $({P}OBJS:.o=.d)")
	if crate_deps:
		a("")
		a("# rustc writes an ordinary Make depfile naming the whole module")
		a("# graph, so a crate goes stale on a member the `mod' scan above")
		a("# never saw -- which is the half that would have rotted quietly.")
		a(f"{P}CRATE_DEPS = \\")
		names = [f"$({P}BUILD_DIR)/{_eject_obj(rel)}.d"
		         for rel in sorted(crate_deps)]
		for n, o in enumerate(names):
			a(f"\t{o}" + (" \\" if n < len(names) - 1 else ""))
		a(f"-include $({P}CRATE_DEPS)")
	return "\n".join(L) + "\n"


def eject_ninja(targets, closures, resolutions, cfg, incflags, root, conf,
                gen_rules=None, moc=None, uic=None, rcc=None):
	"""A standalone build.ninja."""
	# Both ejected forms run their tests from the tree root, so $bin(NAME)
	# resolves to the same relative path the recipe below invokes.
	eject_bins = {x.name: "./" + x.filename for x in targets}
	eject_files = {x.name: x.filename for x in targets}
	common = " ".join(_eject_flags(cfg.cflags + incflags, root))
	override = " ".join(_eject_flags(cfg.override, root))
	L = []
	a = L.append

	a("# Generated by `fmake --eject ninja`.")
	a("#")
	a("# Standalone: fmake is not needed to build this. Link sets were")
	a("# computed from object symbol tables rather than from the #include")
	a("# graph, so they are exact rather than inferred.")
	a("#")
	# The same staleness contract the Make backend carries. A build.ninja is
	# a snapshot for the same reason and in the same way, and saying it in
	# one artifact and not the other would leave whichever backend a reader
	# chose deciding whether they were told.
	a("# This is a snapshot of one closure, not a translation of the tree.")
	a("# Adding a source file, or a call that reaches a file this build does")
	a("# not already name, means running --eject again. A new reference gives")
	a("# an undefined symbol, which is loud; a file nothing refers to is just")
	a("# never compiled, which is not.")
	a("#")
	a(f"# Built for: {cfg.os}/{cfg.arch}"
	  + (f"    profile: {conf.profile_name}" if conf.profile_name else ""))
	a("")
	# 1.7 where a crate is present, for the implicit outputs the rustc
	# rules below need. Not raised otherwise: a tree with no Rust in it has
	# no reason to demand a newer ninja than it did yesterday.
	a("ninja_required_version = "
	  + ("1.7" if any(u.crate for t in targets for u in closures[t].link)
	     else "1.5"))
	a("")
	a(f"cc = {cfg.cc}")
	a(f"cxx = {cfg.cxx}")
	a(f"ar = {cfg.ar_name}")
	a(f"cflags = {common}")
	a(f"cflags_last = {override}")
	# Ninja has no conditionals, so this is baked -- but it is baked from
	# link_flags(), so --coverage and friends reach the link here too.
	a(f"ldflags = {' '.join(_eject_flags(cfg.link_flags(), root))}")
	a(f"build_dir = {EJECT_BUILD_DIR}")
	a("")
	# `deps = gcc` lets ninja read the depfile and then discard it, which is
	# what makes header dependencies free here too.
	a("rule cc")
	a("  command = $cc $cflags $extra $cflags_last -c $in -o $out -MD -MF $out.d")
	a("  depfile = $out.d")
	a("  deps = gcc")
	a("  description = CC $in")
	a("")
	a("rule cxx")
	a("  command = $cxx $cflags $extra $cflags_last -c $in -o $out -MD -MF $out.d")
	a("  depfile = $out.d")
	a("  deps = gcc")
	a("  description = CXX $in")
	a("")
	# Assembly the preprocessor never sees. The depfile is the assembler's,
	# so `deps = gcc' is wrong here -- that tells ninja to read the compiler
	# own dependency stream, which gas does not write. The plain
	# `depfile' form reads the file itself, which is what --MD leaves.
	a("rule as")
	a("  command = $cc $cflags $extra $cflags_last -c $in -o $out "
	  "-Wa,--MD,$out.d")
	a("  depfile = $out.d")
	a("  description = AS $in")
	a("")
	a("rule link")
	a("  command = $driver -o $out $in $arcs $libs $ldflags")
	a("  description = LD $out")
	a("")
	a("rule solink")
	a("  command = $driver -shared -Wl,-soname,$soname -o $out $in $arcs $libs $ldflags")
	a("  description = LD $out")
	a("")
	a("rule archive")
	a("  command = rm -f $out && $ar rcs $out $in")
	a("  description = AR $out")
	a("")
	a("rule copy")
	a("  command = cp $in $out")
	a("  description = CP $out")
	a("")
	if any(u.crate for t in targets for u in closures[t].link):
		a(f"rustc = {cfg.rustc}")
		a(f"rustflags = --edition {cfg.rust_edition} "
		  + " ".join(_eject_flags(cfg.rustflags, root)))
		a("")
		# `$in' is the crate root alone. Its members are implicit inputs,
		# because rustc takes one file and reads the rest -- naming them on
		# the command line would compile each as a crate of its own.
		# rustc's dep-info carries a rule per emitted artifact -- one for
		# the link output and one for the depfile itself -- and **the
		# order is not stable across rustc versions**. 1.85 writes the
		# link rule first; 1.98 writes the depfile's. Ninja takes the
		# first target as authoritative and refuses anything else:
		#
		#     ninja explain: expected depfile 'build/x.d' to mention
		#                    'build/x.a', got 'build/x.d'
		#
		# so a build that is incremental on one toolchain rebuilds for
		# ever on another, on the second run, after a first that looks
		# fine. Make is unaffected -- it attaches the extra rule to a
		# target it has never heard of and ignores it.
		#
		# So the rule keeps only the line naming what this edge builds,
		# and depends on no ordering at all. The `-MP'-style phony
		# targets go with it, which costs nothing: ninja handles a
		# vanished prerequisite itself, and it is make that needs them.
		for name, kind in (("rustlib", "--crate-type=staticlib "),
		                   ("rustbin", "")):
			a(f"rule {name}")
			a(f"  command = $rustc $rustflags {kind}-o $out "
			  f"--emit=link,dep-info=$dep.all $in"
			  f" && grep -F \"$out: \" $dep.all > $dep")
			a("  depfile = $dep")
			a(f"  description = RS {'$in' if name == 'rustlib' else '$out'}")
			a("")

	gen_rules = gen_rules if gen_rules is not None else {}
	gen_outs = []
	for name in _gen_order(gen_rules):
		r = gen_rules[name]
		cmds = []
		for c in (r.get("commands") or [r["command"]]):
			line, _quiet, ignore = _recipe_prefix(c)
			line = _gen_command(line, r["inputs"], r["outputs"], None,
			                    r.get("stem"))
			# Ninja reads $ as its own escape, so the shell's must be doubled.
			cmds.append(line.replace("$", "$$") + (" || true" if ignore else ""))
		a(f"rule gen_{_mk_ident(name)}")
		a(f"  command = {' && '.join(cmds)}")
		a(f"  description = GEN {r.get('description') or name}")
		a("")
		deps = r.get("depends", [])
		a(f"build {' '.join(_ninja(o) for o in r['outputs'])}: "
		  f"gen_{_mk_ident(name)} "
		  f"{' '.join(_ninja(i) for i in r['inputs'])}"
		  + (" | " + " ".join(_ninja(d) for d in deps) if deps else ""))
		gen_outs += r["outputs"]
	if gen_rules:
		a("")

	every, ninja_crates = {}, {}
	for t in targets:
		for u in closures[t].link:
			if u.prebuilt:          # nothing fmake compiled, nothing to emit
				continue
			if u.crate:
				if not u.crate_exe:
					ninja_crates[u.rel] = u
				continue
			every[u.rel] = u

	uic = uic or {}
	uic_jobs = uic.get("jobs") or []
	if uic_jobs:
		a('# Selected by `#include "ui_*.h"` in the source, not by a list.')
		a(f"uic = {uic['exe']}")
		a("")
		a("rule uic")
		a("  command = $uic $in -o $out")
		a("  description = UIC $in")
		a("")
		for j in uic_jobs:
			a(f"build {_ninja(_eject_src(j['out']))}: uic {_ninja(j['src'])}")
		a("")

	rcc = rcc or {}
	rcc_jobs = [j for j in (rcc.get("jobs") or []) if j["out"] in every]
	if rcc_jobs:
		a("# Selected by what the source opens, not by a list.")
		a(f"rcc = {rcc['exe']}")
		a("")
		a("rule rcc")
		a("  command = $rcc --name $resname $in -o $out")
		a("  description = RCC $in")
		a("")
		for j in rcc_jobs:
			a(f"build {_ninja(_eject_src(j['out']))}: rcc {_ninja(j['src'])}")
			a(f"  resname = {j['name']}")
		a("")

	moc = moc or {}
	moc_jobs = [j for j in (moc.get("jobs") or [])
	            if (j["src"] if j["inline"] else j["out"]) in every]
	if moc_jobs:
		a("# Selected by Q_OBJECT in the source, not by a list.")
		a(f"moc = {moc['exe']}")
		a(f"mocflags = {' '.join(_eject_flags(moc.get('flags', []), root))}")
		a("")
		a("rule moc")
		a("  command = $moc $mocflags $in -o $out")
		a("  description = MOC $in")
		a("")
		for j in moc_jobs:
			a(f"build {_ninja(_eject_src(j['out']))}: moc {_ninja(j['src'])}")
		a("")
	# The uic headers and .moc bodies are #included rather than compiled, so
	# nothing declares a dependency on them until a depfile exists.
	gen_outs = gen_outs + [_eject_src(j["out"]) for j in uic_jobs] \
	           + [_eject_src(j["out"]) for j in moc_jobs if j["inline"]]

	# The Makefile side drops an out-of-tree generated output from its
	# clean list, because that rule is fmake's to write. Here it cannot:
	# `ninja -t clean' is ninja's own tool over the outputs the file
	# declares, and an output has to be declared or ninja will not build
	# it. So the difference is real and stated rather than papered over --
	# `ninja -t clean' removes what `fmake --clean' would not.
	for o in sorted(o for o in gen_outs
	                if not os.path.normpath(os.path.join(root, o))
	                .startswith(os.path.join(root, ""))):
		note(f"{o} is outside the tree; `ninja -t clean' will remove it, "
		     f"which fmake --clean does not. ninja cleans by output and "
		     f"an output has to be declared to be built.")

	# Order-only: a generated header must exist before anything compiles,
	# but the depfiles decide when a change to it forces a rebuild.
	after = (" || " + " ".join(_ninja(g) for g in gen_outs)) if gen_outs else ""
	for rel in sorted(every):
		u = every[rel]
		a(f"build $build_dir/{_ninja(_eject_obj(rel))}.o: "
		  f"{u.lang.rule} {_ninja(_eject_src(rel))}{after}")
		if u.own:
			a(f"  extra = {' '.join(_eject_flags(u.own, root))}")
	# One edge per crate, with the members as implicit inputs. The depfile
	# ninja reads afterwards is rustc's own and names the real module
	# graph, so a member the `mod' scan missed still forces a rebuild.
	for rel in sorted(ninja_crates):
		u = ninja_crates[rel]
		mods = (" | " + " ".join(_ninja(_eject_src(m))
		                         for m in sorted(u.members))) if u.members else ""
		dep = f"$build_dir/{_ninja(_eject_obj(rel))}.d"
		a(f"build $build_dir/{_ninja(_eject_obj(rel))}.a | {dep} "
		  f"{dep}.all: rustlib {_ninja(_eject_src(rel))}{mods}")
		a(f"  dep = {dep}")
	a("")

	for t in targets:
		root_unit = closures[t].root
		if root_unit.crate_exe:
			mods = (" | " + " ".join(_ninja(_eject_src(m))
			                         for m in sorted(root_unit.members))) \
			       if root_unit.members else ""
			# In the build directory rather than beside the binary: a
			# program's depfile is an intermediate, and the tree root is
			# where the program goes.
			dep = f"$build_dir/{_ninja(_eject_obj(root_unit.rel))}.d"
			a(f"build {_ninja(t.filename)} | {dep} {dep}.all: rustbin "
			  f"{_ninja(_eject_src(root_unit.rel))}{mods}")
			a(f"  dep = {dep}")
			continue
		objs = " ".join(f"$build_dir/{_ninja(_eject_obj(u.rel))}.o"
		                for u in closures[t].link
		                if not u.prebuilt and not u.crate)
		# A prebuilt .o is an ordinary input, beside the objects fmake
		# compiled rather than after them with the archives.
		blobs = [u.rel for u in closures[t].link
		         if u.prebuilt and not u.archive]
		if blobs:
			objs = objs + " " + " ".join(_ninja(b) for b in blobs)
		# Escaped here rather than at each use. A built crate's path
		# starts with `$build_dir', which is ninja's own variable and must
		# not be escaped a second time -- doing so asks ninja for a file
		# called `$build_dir/...' and it reports no rule to make it.
		arcs = [] if t.kind == "static" else \
		       [f"$build_dir/{_ninja(_eject_obj(u.rel))}.a" if u.crate
		        else _ninja(u.rel)
		        for u in closures[t].link if u.archive]
		crate_arcs = [f"$build_dir/{_ninja(_eject_obj(u.rel))}.a"
		              for u in closures[t].link if u.archive and u.crate]
		if t.kind == "static" and not objs.strip() and len(crate_arcs) == 1:
			a(f"build {_ninja(t.filename)}: copy {crate_arcs[0]}")
			continue
		rule = {"static": "archive", "shared": "solink"}.get(t.kind, "link")
		# Implicit inputs so a changed archive relinks; the command line
		# places them after the objects and groups them when there is more
		# than one, neither of which an input list can express.
		after = (" | " + " ".join(arcs)) if arcs else ""
		a(f"build {_ninja(t.filename)}: {rule} {objs}{after}")
		if t.kind != "static":
			a(f"  driver = ${'cxx' if any(u.cxx for u in closures[t].link) else 'cc'}")
			if t.kind == "shared":
				a(f"  soname = {t.soname}")
			if arcs:
				txt = " ".join(arcs)
				if len(arcs) > 1:
					txt = f"-Wl,--start-group {txt} -Wl,--end-group"
				a(f"  arcs = {txt}")
			res = resolutions.get(t)
			if res and res["ldflags"]:
				a(f"  libs = {' '.join(_eject_flags(res['ldflags'], root))}")
	a("")
	# Same split as the Makefile: `ninja` builds the programs, `ninja test`
	# builds and runs the test binaries. Ninja has no recipe for a phony
	# beyond its inputs, so running them is a rule of its own.
	plain = [t for t in targets if not t.test]
	by_group = {}
	for t in targets:
		if t.test:
			by_group.setdefault(t.test_group, []).append(t)
	a(f"default {' '.join(_ninja(t.filename) for t in plain)}")
	for g in sorted(by_group):
		members = sorted(by_group[g], key=lambda x: x.name)
		a("")
		cmds = " && ".join(
		    " ".join([shlex.quote(p)
		              for p in test_env_pairs(conf, t, eject_bins)]
		             + ["./" + " ".join(shlex.quote(x) for x in [t.filename]
		                                + list(t.conf.get("test-args", [])))])
		    for t in members)
		a(f"rule run_{_mk_ident(g)}")
		a(f"  command = {cmds}")
		a(f"  description = RUN {g}")
		a("  pool = console")
		_dep = [_ninja(d) for d in bin_deps(conf, members, eject_files)]
		a(f"build run-{g}: run_{_mk_ident(g)} | "
		  f"{' '.join([_ninja(t.filename) for t in members] + _dep)}")
		a(f"build {g}: phony run-{g}")

	# ---- install
	#
	# Ninja has no `install' convention and no way to set a variable on the
	# command line, which is why this was recorded as not worth inventing.
	# It does pass the environment through to a command, and that is enough:
	# the recipe reads PREFIX, BINDIR, LIBDIR, INCLUDEDIR and DESTDIR from
	# the environment with the same defaults the Makefile uses, so
	#
	#     DESTDIR=$PWD/stage PREFIX=/usr ninja install
	#
	# means what the Makefile means by the same words. `:=' in the parameter
	# expansions supplies the default only when the caller left it unset.
	#
	# The plan is install_plan, the same list --install and the Makefile
	# read, so all three install the same set.
	plan = install_plan(targets, closures, root)
	if plan:
		defaults = dict(INSTALL_DEFAULTS)
		defaults.update({k: v for k, v in conf.install.items() if v})
		steps = ["set -e", f': "$${{PREFIX:={defaults["prefix"]}}}"']
		for key in ("bindir", "libdir", "includedir"):
			sub = defaults[key]
			value = sub if os.path.isabs(sub) else f"$$PREFIX/{sub}"
			steps.append(f': "$${{{key.upper()}:={value}}}"')
		steps.append(': "$${PKGCONFIGDIR:=$$LIBDIR/pkgconfig}"')
		for directory in ("bindir", "libdir", "includedir",
		                  "pkgconfigdir"):
			items = [p for p in plan if p[2] == directory]
			if not items:
				continue
			var = f'"$$DESTDIR$${directory.upper()}"'
			steps.append(f"install -d {var}")
			for origin, source, _, name, mode in items:
				if origin == "symlink":
					steps.append(f"ln -sf {shlex.quote(source)} "
					             f'"$$DESTDIR$${directory.upper()}/"'
					             f"{shlex.quote(name)}")
					continue
				src = source if origin == "built" else _eject_src(source)
				# Shell-quoted rather than ninja-escaped: this is a command
				# line, and ninja can express a path with a space in it, so
				# one can reach here.
				steps.append(f"install -m {mode:o} -- {shlex.quote(src)} "
				             f'"$$DESTDIR$${directory.upper()}/"'
				             f"{shlex.quote(name)}")
		# Same reason as the Makefile: a clean checkout has no .pc, so
		# the build has to write one. `$$` for a literal dollar here too,
		# ninja's escape rather than Make's.
		pcs = [(t, pc_text(t, conf)) for t in targets]
		pcs = [(t, text) for t, text in pcs if text]
		for t, text in pcs:
			body = " ".join(shlex.quote(l)
			                for l in text.rstrip("\n").split("\n"))
			a("")
			a(f"rule pc_{_mk_ident(t.name)}")
			a(f"  command = printf '%s\\n' {body.replace('$', '$$')} > $out")
			a(f"  description = PC {t.name}.pc")
			a(f"build {_ninja(t.name)}.pc: pc_{_mk_ident(t.name)}")

		a("")
		a("rule install")
		a("  command = " + "; ".join(steps))
		a("  description = INSTALL")
		a("  pool = console")
		deps = " ".join(sorted({_ninja(t.filename) for t in targets}
		                       | {_ninja(t.name) + ".pc" for t, _x in pcs}))
		a(f"build install: install | {deps}")

		# The parameter lines only -- `set -e' and the five `: "${VAR:=...}"'
		# defaults -- so uninstall reads the same environment install does.
		undo = [step for step in steps
		        if step.startswith((": ", "set -e"))]
		for directory in ("bindir", "libdir", "includedir",
		                  "pkgconfigdir"):
			for _origin, _source, d, name, _mode in plan:
				if d == directory:
					undo.append(f'rm -f "$$DESTDIR$${directory.upper()}/"'
					            f"{shlex.quote(name)}")
		a("")
		a("rule uninstall")
		a("  command = " + "; ".join(undo))
		a("  description = UNINSTALL")
		a("  pool = console")
		a("build uninstall: uninstall")
	return "\n".join(L) + "\n"

# ---------------------------------------------------------------------------
# Install
#
# The one thing @headers is for. Which headers form a library's public
# interface is the header question that genuinely is not inferable -- the
# #include scan knows what a TU consumes, not what the project means to
# publish -- so it has to be declared, and this is what declaring it buys.
# ---------------------------------------------------------------------------

INSTALL_DEFAULTS = {"prefix": "/usr/local", "bindir": "bin",
                    "libdir": "lib", "includedir": "include"}


def pc_text(t, conf):
	"""The pkg-config file for a library, or None if none was asked for.

    fmake resolves libraries *through* pkg-config -- a header proposes a
    module, the module's .pc supplies the flags. A library fmake installs
    was findable by none of that: it had headers in `includedir` and an
    archive in `libdir` and nothing tying the two together, so the next
    project had to be told with `@pkg` or `@libs` what fmake would have
    worked out on its own. Generating the .pc closes that loop, and the
    consumer it most obviously helps is fmake.

    Declaring a `version` is the opt-in. There is no default, because a .pc
    without a Version is one pkg-config refuses to read, and inventing one
    would publish a number nobody chose into a file other projects then
    depend on.

    `${prefix}` and friends are written as pkg-config variables rather than
    resolved, because a package built with one prefix and installed under
    another -- which is what DESTDIR staging and every distribution do -- is
    the ordinary case, and a .pc with baked paths is wrong the moment it is
    relocated.
    """
	if t.kind == "exe" or not t.version:
		return None
	p = dict(INSTALL_DEFAULTS)
	p.update({k: v for k, v in conf.install.items() if v})
	def var(key):
		sub = p[key]
		return sub if os.path.isabs(sub) else "${prefix}/" + sub
	lines = [
	    "prefix=" + p["prefix"],
	    "libdir=" + var("libdir"),
	    "includedir=" + var("includedir"),
	    "",
	    "Name: " + t.name,
	    "Description: " + (t.description or f"{t.name}, built by fmake"),
	    "Version: " + t.version,
	    "Libs: -L${libdir} -l" + t.name,
	    "Cflags: -I${includedir}",
	]
	return "\n".join(lines) + "\n"


def install_paths(conf, args):
	p = dict(INSTALL_DEFAULTS)
	p.update({k: v for k, v in conf.install.items() if v})
	if args.prefix:
		p["prefix"] = args.prefix
	dest = args.destdir or ""
	out = {}
	for key in ("bindir", "libdir", "includedir"):
		sub = p[key]
		full = sub if os.path.isabs(sub) else os.path.join(p["prefix"], sub)
		out[key] = os.path.join(dest, full.lstrip("/")) if dest else full
	# Where every distribution puts them, and where pkg-config looks
	# without being told: under libdir, not beside it.
	out["pkgconfigdir"] = os.path.join(out["libdir"], "pkgconfig")
	out["prefix"] = p["prefix"]
	return out


def install_plan(targets, closures, root):
	"""What this project installs, and into which of the three directories.

    Shared by `--install` and by the install rule `--eject` emits, and the
    sharing is the point rather than a tidiness. Two implementations of
    "what does this project install" is precisely the pair that drifts
    silently: the ejected build would go on working while installing a
    different set, and nothing would look wrong until somebody's package was
    missing a header.

    Only the last step differs between the callers, and it is the one step
    that has to. fmake resolves a directory to a path; the Makefile leaves
    it as a variable, because a build file with its install paths baked in
    is not one a distribution can package.

    Returns `(origin, source, directory, name, mode)`, deduplicated on where
    each file lands. `origin` is "built" for something this build produces
    and "tree" for a file that was already there -- the difference between
    looking in the output directory and looking in the source.
    """
	planned = []
	for t in targets:
		where = "bindir" if t.kind == "exe" else "libdir"
		mode = 0o755 if t.kind != "static" else 0o644
		if t.kind == "shared" and t.version:
			# The chain every distribution ships. The real file carries the
			# full version; the soname link is what consumers recorded and
			# what the loader opens; the plain name is what `-lfoo` finds at
			# link time and is the one a development package adds.
			#
			# Built as lib<name>.so in the tree and installed under the
			# versioned name. The tree does not need the chain, and renaming
			# the artifact would mean teaching clean, the link rules and both
			# emitters a second name for one thing.
			real = "%s.%s" % (t.filename, t.version)
			planned.append(("built", t.filename, where, real, mode))
			planned.append(("symlink", real, where, t.soname, None))
			planned.append(("symlink", t.soname, where, t.filename, None))
		else:
			planned.append(("built", t.filename, where, t.filename, mode))

		# @headers is gathered only for libraries: a program does not
		# publish an API, and the file carrying the directive is often
		# linked into one of the tree's programs as well, which would
		# otherwise install the same header twice under two owners.
		# An explicit list in fmake.toml is honoured for any kind, since
		# naming it outright is a decision rather than an inference.
		heads = list(t.conf.get("headers", []))
		if t.kind != "exe":
			for u in closures[t].link:
				heads += u.ann.items("headers")
		for h in dict.fromkeys(heads):
			if not os.path.isfile(os.path.join(root, h)):
				die(f"@headers {h!r} does not exist (named for {t.name})")
			planned.append(("tree", h, "includedir",
			                os.path.basename(h), 0o644))

		# The .pc is written beside the artifacts at build time, so it is
		# a built file and needs no special case anywhere downstream.
		if t.kind != "exe" and t.version:
			planned.append(("built", t.name + ".pc", "pkgconfigdir",
			                t.name + ".pc", 0o644))

	seen, unique = set(), []
	for item in planned:
		lands = (item[2], item[3])
		if lands not in seen:
			seen.add(lands)
			unique.append(item)
	return unique


def unpublished_headers(targets, closures, root):
	"""`@headers` that were written down and then not installed.

    Gathering for libraries only is the rule and it is right -- section 7 -- but
    being right is not the same as being understood. Somebody who writes
    `@headers api.h` next to a program's source runs `--install`, is told
    it installed one file, and gets no header and no word about why. The
    directive was read, understood, and discarded in silence, which is the
    same shape as a typo that does nothing.

    So: every header named by a file that only ever lands in a program, and
    which no library published either. The second half matters -- the file
    carrying the directive is usually linked into one of the tree's
    programs *as well*, and reporting that would be crying wolf on the
    normal case.
    """
	published = {source for _, source, directory, _, _
	             in install_plan(targets, closures, root)
	             if directory == "includedir"}
	orphans = {}
	for t in targets:
		if t.kind != "exe":
			continue
		for u in closures[t].link:
			for h in u.ann.items("headers"):
				if h not in published:
					orphans.setdefault(h, set()).add(u.rel)
	return {h: sorted(where) for h, where in sorted(orphans.items())}


def do_uninstall(targets, closures, root, conf, args):
	"""Remove exactly what `--install` would place, and nothing else.

    The same rule `clean` follows, for the same reason: a target everybody
    runs without reading must not be able to remove something it did not
    put there. So there is no manifest and no pattern. The list comes from
    `install_plan`, which is the same list `--install`, the ejected
    Makefile and the ejected ninja read -- a fourth caller rather than a
    fifth idea about what this project publishes.

    That has one consequence worth stating rather than discovering: it
    removes what the tree says *today*. Rename a target, uninstall, and the
    old name stays behind, because nothing in the tree names it any more.
    A manifest would fix that and would be a file recording what a previous
    run did, which is a different and much larger promise -- and the wrong
    one to make quietly.

    Directories are left alone. Removing a directory means removing
    something this list did not name, and `bin` was not ours to begin with.
    """
	paths = install_paths(conf, args)
	planned = [os.path.join(paths[directory], name)
	           for _origin, _source, directory, name, _mode
	           in install_plan(targets, closures, root)]
	if not planned:
		info("nothing to uninstall")
		return 0

	removed, absent = 0, 0
	for dst in planned:
		if args.dry_run:
			print(f"rm {dst}")
			continue
		try:
			os.remove(dst)
		except FileNotFoundError:
			# Not an error. Uninstalling twice, or after a partial install,
			# is an ordinary thing to do and the end state is the one asked
			# for either way.
			absent += 1
			vinfo(f"not there: {dst}")
			continue
		except OSError as exc:
			die(f"cannot remove {dst}: {exc}")
		removed += 1
		print(f"{GREEN('rm')} {dst}")

	if not args.dry_run:
		info(f"removed {removed} file(s) from {paths['prefix']}"
		     + (f", {absent} already gone" if absent else ""))
	return 0


def do_install(targets, closures, root, outdir, conf, args):
	paths = install_paths(conf, args)
	planned = []

	for origin, source, directory, name, mode in install_plan(
			targets, closures, root):
		dst = os.path.join(paths[directory], name)
		if origin == "symlink":
			# The target stays a bare name. An absolute one points into
			# whichever tree happened to build it, which is gone by the
			# time anybody installs the package -- and a staged install
			# has a different prefix than the final one by definition.
			planned.append((source, dst, None))
			continue
		src = os.path.join(outdir if origin == "built" else root, source)
		if origin == "built" and not os.path.exists(src):
			die(f"{source} has not been built")
		planned.append((src, dst, mode))

	# Before anything is copied, say what was asked for and will not be.
	# A directive that is read and then discarded without comment is the
	# failure this reports, not the rule that discards it -- which is
	# right, and stays.
	for header, sources in unpublished_headers(targets, closures,
	                                           root).items():
		warn(f"@headers {header!r} is not installed: "
		     f"{', '.join(sources)} reaches only a program, and a program "
		     f"publishes no API. Put the directive on the library's source, "
		     f"or name it in [target.NAME] headers to publish it anyway")

	if not planned:
		info("nothing to install")
		return 0

	for src, dst, mode in planned:
		rel = _rel(src, root)
		if mode is None:
			# A relative target, so the chain still resolves when the whole
			# prefix moves -- which is what a staged install is.
			if args.dry_run:
				print(f"ln -sf {src} {dst}")
				continue
			os.makedirs(os.path.dirname(dst), exist_ok=True)
			if os.path.islink(dst) or os.path.exists(dst):
				os.remove(dst)
			os.symlink(src, dst)
			print(f"{GREEN('->')} {dst} -> {src}")
			continue
		if args.dry_run:
			print(f"install -m {mode:o} {rel} {dst}")
			continue
		os.makedirs(os.path.dirname(dst), exist_ok=True)
		shutil.copy2(src, dst)
		os.chmod(dst, mode)
		print(f"{GREEN('->')} {dst}")

	if not args.dry_run:
		info(f"installed {len(planned)} file(s) under {paths['prefix']}")
	return 0

