# Symbols the linker itself provides. No library exports them, so reporting
# them as unresolved dependencies is a false alarm -- and on a PIC build
# _GLOBAL_OFFSET_TABLE_ can be the only thing listed, which makes the whole
# report read as a failure when nothing is wrong.
# Symbols nothing in the tree defines and no library exports, because the
# linker itself supplies them. Undefined references to these are not
# missing dependencies, and reporting them as such sends the reader looking
# for a package that does not exist.
#
# Hand-written, which section 15 names as a load-bearing list -- so
# `linker_symbols_cover_what_the_linker_provides` checks it against `ld
# --verbose` on the machine running the suite. It found six missing the
# first time it was run, `end` and `edata` among them, which are the
# oldest names on the list and still referenced by real code.
#
# The suite probes and the tool does not, deliberately. Reading the default
# linker script on every build is a subprocess for a question whose answer
# changes when binutils does, and section 17 is explicit that fmake does not
# probe features. A checked list is the middle: still a list, no longer
# unexamined.
#
# The last six on it came from that check rather than from anybody reading:
# the bare BSD-era `edata` and `end`, the second spelling of etext, the
# IRELATIVE relocation bounds a static PIE walks, and the TLS start.
LINKER_SYMBOLS = {
    "_GLOBAL_OFFSET_TABLE_", "_DYNAMIC", "__dso_handle", "__ehdr_start",
    "_edata", "_end", "__bss_start", "etext", "_etext", "__data_start",
    "__gmon_start__", "_init", "_fini", "__init_array_start",
    "__init_array_end", "__fini_array_start", "__fini_array_end",
    "__preinit_array_start", "__preinit_array_end", "__executable_start",
    "__start___libc_atexit", "__stop___libc_atexit",
    "edata", "end", "__etext", "__rela_iplt_start", "__rela_iplt_end",
    "__tdata_start",
}


def _stdout(cmd):
	try:
		r = subprocess.run(cmd, capture_output=True, text=True, errors="replace")
		return r.stdout if r.returncode == 0 else ""
	except OSError:
		return ""


def _stderr(cmd):
	"""Some questions are only answered on stderr. `cpp -Wp,-v` prints its
	search path there and exits non-zero doing nothing else, so the status
	is not evidence about the output.
	"""
	try:
		return subprocess.run(cmd, capture_output=True, text=True, errors="replace").stderr
	except OSError:
		return ""


# e_machine values worth naming. Only for messages -- the comparison is on the
# raw triple, so an architecture missing from here still works.
ELF_MACHINES = {
    0x03: "x86", 0x3E: "x86_64", 0x28: "arm", 0xB7: "aarch64",
    0xF3: "riscv", 0x08: "mips", 0x14: "ppc", 0x15: "ppc64",
    0x02: "sparc", 0x32: "ia64", 0x16: "s390",
}


# What an unreadable file is, as distinct from one that is not ELF. Both
# used to come back as None, and every caller reads None as "no opinion" --
# which is right for a linker script and wrong for a file that could not be
# opened. At the one site where the answer decides whether a library may be
# linked, "no opinion" means the host's zlib is offered to a cross build.
#
# A tuple, so it can never equal a real identity, and never None.
UNREADABLE = ("unreadable",)


def elf_identity(path, unreadable=None):
	"""(class, byte order, machine) from an ELF header, or None.

    This is what makes cross builds honest. A cross compiler's own search
    path contains /usr/lib -- the host's -- so no arrangement of directory
    names separates the target's libraries from the host's. The ELF header
    does, exactly, for any architecture, without fmake knowing anything
    about triplets.
    """
	try:
		with open(path, "rb") as fh:
			head = fh.read(64)
			if head[:8] == b"!<arch>\n":
				# An archive: identify it by its first ELF member.
				blob = head + fh.read(1 << 16)
				at = blob.find(b"\x7fELF")
				if at < 0:
					return None
				head = blob[at:at + 20]
	except OSError:
		# Not "this is not an ELF file". Callers that only want an opinion
		# pass nothing and still get None; the one that decides whether a
		# library may be linked asks to be told, and refuses.
		return unreadable
	if len(head) < 20 or head[:4] != b"\x7fELF":
		return None
	order = "little" if head[5] == 1 else "big"
	return (head[4], head[5], int.from_bytes(head[18:20], order))


def bitcode_object(path):
	"""True if this is LLVM bitcode rather than an object file.

    `clang -flto` emits bitcode where gcc -flto emits an ELF object carrying
    extra sections, so a file that is not ELF is not necessarily a file that
    went wrong. Whether binutils nm can read it depends on LLVMgold.so being
    installed as a BFD plugin, which is a property of the machine and not of
    the tree -- so this exists to tell the two failures apart rather than to
    reject anything.

    Two spellings: raw bitcode, and the wrapper Darwin uses.
    """
	try:
		with open(path, "rb") as fh:
			head = fh.read(4)
	except OSError:
		return False
	return head in (b"BC\xc0\xde", b"\xde\xc0\x17\x0b")


def describe_identity(ident):
	if not ident:
		return "unknown"
	bits = {1: "32", 2: "64"}.get(ident[0], "?")
	end = {1: "le", 2: "be"}.get(ident[1], "?")
	return f"{ELF_MACHINES.get(ident[2], 'machine-0x%x' % ident[2])}/{bits}{end}"


def host_elf_machine():
	"""The e_machine value this machine runs, or None if it is not known."""
	want = host_arch()
	for code, name in ELF_MACHINES.items():
		if name == want:
			return code
	return None


def compiler_lib_dirs(cfg):
	"""Where this compiler's linker looks. Authoritative, and correct for a
    cross compiler, which is why it comes before any guess."""
	out = []
	for line in _stdout([cfg.cc, "-print-search-dirs"]).splitlines():
		if line.startswith("libraries:"):
			for d in line.split(":", 1)[1].lstrip(" =").split(":"):
				if d and os.path.isdir(d):
					out.append(d)
	return out


def lib_search_dirs(cfg):
	"""Where the linker will look, in the order it looks."""
	triplet = _stdout([cfg.cc, "-print-multiarch"]).strip()
	cands = list(cfg.extra_libdirs)

	# A sysroot is the unambiguous statement that the target's filesystem is
	# elsewhere, so its directories come before anything native.
	if cfg.sysroot:
		for base in ("/usr/local/lib", "/usr/lib", "/lib"):
			if triplet:
				cands.append(os.path.join(cfg.sysroot, base.lstrip("/"),
				                          triplet))
			cands.append(os.path.join(cfg.sysroot, base.lstrip("/")))

	cands += compiler_lib_dirs(cfg)

	for base in ("/usr/local/lib", "/usr/lib", "/lib"):
		if triplet:
			cands.append(os.path.join(base, triplet))
		cands.append(base)
	cands += [d for d in os.environ.get("LIBRARY_PATH", "").split(":") if d]

	out, seen = [], set()
	for d in cands:
		rp = os.path.realpath(d)
		if os.path.isdir(d) and rp not in seen:
			seen.add(rp)
			out.append(d)
	return out


def linkable_libs(dirs):
	"""Map -lNAME to a file, for names that will actually link.

    Only the development symlink counts. A machine can carry
    libSDL2-2.0.so.0 for programs that already exist while having no
    libSDL2.so at all, and offering -lSDL2 there produces a link error --
    which is right, because without the dev package the headers are missing
    too and the compile would have failed first.
    """
	out = {}
	# Shared libraries first, across every directory, before any archive is
	# considered. Otherwise glibc's own static halves -- libm-2.41.a and
	# friends -- get offered as link names, and linking one drags in
	# internals like _dl_x86_cpu_features that no program can resolve.
	for suffix in (".so", ".a"):
		for d in dirs:
			try:
				entries = sorted(os.listdir(d))
			except OSError:
				continue
			for f in entries:
				if not f.startswith("lib") or not f.endswith(suffix):
					continue
				name = f[3:-len(suffix)]
				if name and name not in out:
					out[name] = os.path.join(d, f)
	return out


# Non-greedy and DOTALL: ld comments are C-style and routinely span lines,
# which is how glibc writes the one at the top of libc.so.
RE_LD_SCRIPT_COMMENT = re.compile(r"/\*.*?\*/", re.S)
RE_LD_SCRIPT_GROUP = re.compile(r"\b(?:INPUT|GROUP|AS_NEEDED)\s*\(([^)]*)\)")
RE_LD_SCRIPT_TOKEN = re.compile(r"(-l\S+|[\w./+-]+\.(?:so[0-9.]*|a))")


def elf_targets(path, dirs=(), _depth=0):
	"""The real objects behind a linkable name.

    libc.so, libm.so and libncurses.so are GNU ld scripts, not ELF files, and
    nm cannot read them. Their contents come in three forms, all of which
    occur in practice on one machine:

        GROUP ( /lib/x86_64-linux-gnu/libm.so.6 AS_NEEDED ( ... ) )
        INPUT ( libncurses.so.6 -ltinfo )

    An absolute path, a bare name relative to the script, and a plain -l.
    Handling only the first -- which is the obvious one to write, since it is
    what glibc uses -- silently drops every symbol ncurses exports.
    """
	try:
		with open(path, "rb") as fh:
			magic = fh.read(8)
	except OSError:
		return []
	if magic[:4] == b"\x7fELF" or magic[:8] == b"!<arch>\n":
		return [path]
	if _depth > 3:
		return []
	try:
		with open(path, "r", errors="replace") as fh:
			text = fh.read(8192)
	except OSError:
		return []
	# Comments go before anything is matched, and they are the only part of
	# the ld script language that is worth the trouble. Everything else
	# unhandled here is *inert*: OUTPUT_FORMAT, SECTIONS and the rest carry
	# no filename this scan would take, so not understanding them costs
	# nothing. A comment is the one construct that can make the scan believe
	# something the script disowns, and missing a library is a link error
	# somebody can read while linking a commented-out one is a wrong answer.
	#
	# Not hypothetical, though the damage would be: four of the ten linker
	# scripts among lib*.so on the machine this was written on carry a
	# comment, `libc.so' and `libm.so' among them. None of them currently
	# holds a token this would take -- glibc's are prose -- so nothing was
	# being misparsed. That is a dependency on somebody else's comments
	# staying prose, which is not a thing to rely on for two lines.
	text = RE_LD_SCRIPT_COMMENT.sub(" ", text)

	here = os.path.dirname(path)
	search = [here] + [d for d in dirs if d != here]
	out = []
	for group in RE_LD_SCRIPT_GROUP.findall(text):
		for tok in RE_LD_SCRIPT_TOKEN.findall(group):
			if tok.startswith("-l"):
				names = [f"lib{tok[2:]}{ext}" for ext in (".so", ".a")]
				cands = [os.path.join(d, n) for d in search for n in names]
			elif os.path.isabs(tok):
				cands = [tok]
			else:
				cands = [os.path.join(d, tok) for d in search]
			for c in cands:
				if os.path.exists(c):
					# A script can name another script.
					out += elf_targets(c, dirs, _depth + 1)
					break
	return out


def lib_exports(cfg, path):
	"""Symbols a library offers to a link.

    Unlike an object file, every name in a dynamic symbol table is exported,
    so the lowercase-is-local rule does not apply here -- glibc exports cos
    as an ifunc, type `i`. Version suffixes (cos@@GLIBC_2.2.5) are stripped.
    """
	dyn = not path.endswith(".a")
	cmd = [cfg.nm, "--defined-only", "--format=posix"]
	if dyn:
		cmd.append("-D")
	r = subprocess.run(cmd + [path], capture_output=True, text=True, errors="replace")
	out = set()
	for line in r.stdout.splitlines():
		parts = line.split()
		if parts:
			out.add(parts[0].split("@")[0])
	return out


def find_providers(cfg, wanted, jobs, want_ident=None):
	"""Which installed libraries define each of these symbols.

    Scanned on demand rather than kept as a persistent index: the whole sweep
    is about a second, only the wanted symbols are retained, and the answer is
    cached per target against the external set, so a normal incremental build
    never gets here at all. No index means no staleness.
    """
	libs = {n: p for n, p in linkable_libs(lib_search_dirs(cfg)).items()
	        if n not in INTERPOSER_LIBS}
	want = set(wanted)
	if not want or not libs:
		return {}, {}

	dirs = cfg.libdirs

	def scan(item):
		name, path = item
		syms = set()
		for t in elf_targets(path, dirs):
			# Architecture first: a 20-byte header read is far cheaper than
			# an nm, and on a cross build most of what is on the machine is
			# the wrong architecture and must not contribute a single symbol.
			if want_ident and elf_identity(t, UNREADABLE) not in (
			        None, want_ident):
				continue
			syms |= lib_exports(cfg, t)
		return name, syms & want

	found = {}
	with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as pool:
		for name, hits in pool.map(scan, sorted(libs.items())):
			for s in hits:
				found.setdefault(s, []).append(name)
	return found, libs


def default_include_dirs(cfg):
	"""Where the preprocessor already looks.

    Same shape as default_link_dirs and for the same reason: the compiler
    is the authority on its own search path, and hardcoding /usr/include is
    wrong on every cross build. The list arrives on stderr between two
    marker lines, which is the only interface cpp offers for it.
    """
	out, inside = [], False
	txt = _stderr([cfg.driver(True), "-E", "-Wp,-v", "-xc++", os.devnull])
	for line in txt.splitlines():
		if line.startswith("#include <...>"):
			inside = True
			continue
		if inside:
			if not line.startswith(" "):
				break
			d = line.strip().split(" (")[0]
			if os.path.isdir(d):
				out.append(d)
	return out


def default_link_dirs(cfg):
	"""Where the linker already looks, so -L is only added when it is needed."""
	out = set()
	for line in _stdout([cfg.cc, "-print-search-dirs"]).splitlines():
		if line.startswith("libraries:"):
			for d in line.split(":", 1)[1].lstrip(" =").split(":"):
				if d:
					out.add(os.path.realpath(d))
	return out


def choose_libs(providers, wanted, proposed):
	"""Smallest set of -l flags covering the unresolved symbols.

    Unlike a header naming two packages, a symbol offered by several
    libraries is ordinary -- glibc merged libm into libc, and distributions
    ship libcurl beside libcurl-gnutls -- so this picks rather than refuses,
    and --explain shows what else could have supplied it.
    """
	remaining = set(wanted)
	implicit = set()
	for s in list(remaining):
		if IMPLICIT_LIBS.intersection(providers.get(s, ())):
			implicit.add(s)
			remaining.discard(s)

	chosen, why = [], {}
	while remaining:
		counts = {}
		for s in remaining:
			for lib in providers.get(s, ()):
				if lib not in IMPLICIT_LIBS:
					counts.setdefault(lib, set()).add(s)
		if not counts:
			break
		# Most symbols covered, then a library the headers already asked for,
		# then the shorter name -- libm-2.41 is a private glibc artefact and
		# libm is the real thing -- then alphabetical, so the choice never
		# depends on directory scan order.
		best = max(counts, key=lambda l: (len(counts[l]), l in proposed,
		                                  -len(l), [-ord(c) for c in l]))
		chosen.append(best)
		why[best] = sorted(counts[best])
		remaining -= counts[best]

	return chosen, why, implicit, sorted(remaining)


class PkgConfig:
	"""pkg-config, for the -I flags a library's own headers need."""

	def __init__(self, configured=None, sysroot=None, triplet=None):
		self.exe = (shutil.which(configured) if configured else None) \
		           or shutil.which("pkg-config") or shutil.which("pkgconf")
		self._flags = {}
		self._vars = {}
		# Every -L a resolved package named. A library under /opt or a home
		# prefix is not in any directory the linker searches by default, so
		# without these it is invisible: the header resolves, the -l is
		# chosen, and nothing can find the file.
		#
		# Kept per module as well as in one list, because the answer is
		# cached across builds: collecting it only as a side effect of
		# running pkg-config means it is collected on the first build and
		# never again, and the second build silently loses the directory.
		self.libdirs = []
		self._dirs = {}
		self._by_incdir = None
		# Which Qt to answer for when more than one can. Newest first, the
		# same order and for the same reason find_qt_tool takes the tool in
		# -- set here so a header resolved before anything has looked at the
		# configuration still gets the default rather than no answer, and
		# replaced by qt_preference() once a named moc is known.
		self.qt_order = tuple(m[:len("Qt0")] for m in QT_CORE_MODULES)
		self.sysroot = sysroot

		# Left alone, pkg-config answers for the host: host .pc files, host
		# include paths. These two variables are the standard way to point it
		# at a sysroot instead, and without them a cross build silently
		# collects the build machine's flags.
		self.env = dict(os.environ)
		if sysroot:
			libdirs = []
			for base in ("usr/lib", "usr/share", "lib"):
				if triplet and base == "usr/lib":
					libdirs.append(os.path.join(sysroot, base, triplet,
					                            "pkgconfig"))
				libdirs.append(os.path.join(sysroot, base, "pkgconfig"))
			self.env["PKG_CONFIG_SYSROOT_DIR"] = sysroot
			self.env["PKG_CONFIG_LIBDIR"] = ":".join(libdirs)

	def _run(self, args):
		return subprocess.run([self.exe] + args, capture_output=True,
		                      text=True, errors="replace", env=self.env)

	@staticmethod
	def _consumer_flags(module, cflags):
		"""Flags a module needs from anything including it, that it does
        not say so itself.

        Qt configured with `-reduce-relocations` refuses to be included by
        code that is not position independent:

            #error "You must build your code with position independent code
                    if Qt was configured with -reduce-relocations. Compile
                    your code with -fPIC (and not with -fPIE)."

        The guard passes whenever `__PIC__` is defined, and `-fPIE` defines
        it too -- so this is invisible on a distribution whose gcc defaults
        to PIE and fires on *every* Qt translation unit on one whose gcc
        does not. Reported from a build of hydra where 113 moc outputs
        failed at once, on a machine where nothing else was different.

        Qt states it nowhere fmake can read: its `.pc` files carry only -I
        and -D. CMake's Qt6 puts POSITION_INDEPENDENT_CODE on consumers and
        qmake's mkspec adds it for libraries -- every other Qt build system
        *supplies* this rather than discovering it, because there is
        nothing to discover from. section 17 says fmake does not probe features,
        so it does the same thing they do: compiling against Qt means
        -fPIC.

        Here rather than at either call site, because @pkg and a header
        proposal are two ways to reach one module and a flag the module
        needs is not a property of how it was named.
        """
		if module.startswith("Qt") and "-fPIC" not in cflags:
			return list(cflags) + ["-fPIC"]
		return cflags

	def flags(self, module):
		"""(cflags, libs) for a module, or None if it is not installed.

        -L belongs to neither: it is a link path, and putting it in the
        compile flags -- which is what dropping everything that is not -l
        into cflags does -- silently loses it. The library search paths are
        recovered from where the library actually lives instead, which also
        covers libraries found by symbol alone.
        """
		if module in self._flags:
			return self._flags[module]
		res = None
		if self.exe:
			r = self._run(["--cflags", "--libs", module])
			if r.returncode == 0:
				args = shlex.split(r.stdout)
				res = ([a for a in args
				        if not a.startswith(("-l", "-L"))],
				       [a for a in args if a.startswith("-l")])
				self._dirs[module] = [a[2:] for a in args
				                      if a.startswith("-L") and a[2:]
				                      and os.path.isdir(a[2:])]
				self._note_dirs(self._dirs[module])
		self._flags[module] = res
		return res

	def _note_dirs(self, dirs):
		for d in dirs or ():
			if d not in self.libdirs:
				self.libdirs.append(d)

	def variable(self, module, name):
		"""A .pc file's own variable, for the directories Qt records in its.

        Not every package defines every variable, and pkg-config answers an
        undefined one with success and an empty string, so emptiness has to
        read as absence here rather than as a directory called "".
        """
		if not self.exe:
			return None
		key = (module, name)
		if key not in self._vars:
			r = self._run([f"--variable={name}", module])
			self._vars[key] = (r.stdout.strip() or None) \
			                  if r.returncode == 0 else None
		return self._vars[key]

	def _search_path(self):
		"""Where .pc files live, in pkg-config's own order.

        $PKG_CONFIG_PATH first, then either $PKG_CONFIG_LIBDIR or the
        built-in path -- which is what pkg-config does, and what the two
        variables mean: one adds, the other replaces.

        Asking `--variable=pc_path` gives only the built-in list; it does not
        include $PKG_CONFIG_PATH, and that omission is invisible until it
        matters. A package installed under /opt or a home prefix answers
        `pkg-config --cflags` perfectly well, because the subprocess inherits
        the environment, while being absent from the header-to-package map
        that decides anything is ever asked about it. The symptom is a
        missing include for a library that is plainly installed.
        """
		extra = [d for d in self.env.get("PKG_CONFIG_PATH", "").split(":") if d]
		if "PKG_CONFIG_LIBDIR" in self.env:
			return extra + [d for d in self.env["PKG_CONFIG_LIBDIR"].split(":")
			                if d]
		p = self._run(["--variable", "pc_path", "pkg-config"]).stdout.strip()
		dirs = [d for d in p.split(":") if d] if p else []
		return extra + (dirs or ["/usr/lib/pkgconfig", "/usr/share/pkgconfig"])

	def signature(self):
		"""Stamp that changes when a package is installed or removed."""
		parts = []
		for d in (self._search_path() if self.exe else []):
			try:
				parts.append(f"{d}:{os.stat(d).st_mtime_ns}")
			except OSError:
				pass
		return sha("|".join(parts))

	def for_module(self, module, store, sig):
		"""(module, cflags, libs) for a module named outright by @pkg."""
		key = sig + "|pkg|" + module
		if key in store:
			self._note_dirs((store[key] or [None, None, None, []])[3])
			return store[key]
		got = self.flags(module)
		store[key] = (None if got is None else
		              [module, self._consumer_flags(module, got[0]), got[1],
		               self._dirs.get(module, [])])
		return store[key]

	def satisfies(self, spec):
		"""Check a `@pkg name >= 1.2` constraint. None if pkg-config is gone."""
		if not self.exe:
			return None
		return self._run(["--exists", " ".join(spec)]).returncode == 0

	def version(self, module):
		return self._run(["--modversion", module]).stdout.strip() or "?"

	def for_header(self, name, store, sig):
		"""(module, cflags, libs) for a system header, or None.

        Cached in the project cache, because resolving a header means reading
        every .pc file on the machine and running pkg-config, and a no-op
        build should not pay for that.
        """
		# The Qt preference is part of the answer, so a cache written under
		# one must not be read back under another: naming a moc changes what
		# every Qt header resolves to.
		key = sig + "|" + ",".join(self.qt_order) + "|" + name
		if key in store:
			self._note_dirs((store[key] or [None, None, None, []])[3])
			return store[key]
		module = HEADER_PKG.get(name)
		if module is None:
			incdirs = self.by_includedir()
			hits = []
			for inc, mod in incdirs.items():
				real = inc
				if self.sysroot and not inc.startswith(self.sysroot):
					real = os.path.join(self.sysroot, inc.lstrip("/"))
				# A file, not merely something that exists. Qt keeps every
				# module under one parent directory with a directory per
				# module, so <QtWidgets> tested against that parent finds the
				# *directory* QtWidgets and stops -- attributing the header
				# to whichever .pc happened to claim the parent, whose flags
				# do not carry the module's own -I. The include then does not
				# resolve at all, which is a strange way to be told a package
				# was misidentified. Six of Qt's own examples are written
				# this way.
				if os.path.isfile(os.path.join(real, name)):
					hits.append((inc, mod))
					if not mod.startswith(self.qt_order):
						break     # only Qt has a major to choose between
			if hits:
				inc, mod = _preferred_qt(hits, self.qt_order)
				module = _deepest_owner(incdirs, inc, name, mod)
		got = self.flags(module) if module else None
		store[key] = (None if got is None else
		              [module, self._consumer_flags(module, got[0]), got[1],
		               self._dirs.get(module, [])])
		return store[key]

	def by_includedir(self):
		"""Map an include directory to the module that owns it.

        Only useful for libraries that keep their headers in a subdirectory,
        which is exactly the case where an -I is needed. Packages installing
        straight into /usr/include are ambiguous and are skipped -- they need
        no -I either, so nothing is lost.
        """
		if self._by_incdir is not None:
			return self._by_incdir
		self._by_incdir = {}
		if not self.exe:
			return self._by_incdir
		for d in self._search_path():
			try:
				names = sorted(os.listdir(d))
			except OSError:
				continue
			for f in names:
				if not f.endswith(".pc"):
					continue
				for inc in _pc_includedirs(os.path.join(d, f)):
					if inc.rstrip("/") in ("/usr/include", "/usr/local/include"):
						continue
					self._by_incdir.setdefault(inc.rstrip("/"), f[:-3])
		return self._by_incdir


RE_PC_VAR = re.compile(r"\$\{([^}]+)\}")


def _pc_includedirs(path):
	"""The -I directories a .pc file advertises, with variables expanded."""
	variables, cflags = {}, ""
	try:
		with open(path, errors="replace") as fh:
			for line in fh:
				line = line.strip()
				if line.startswith("Cflags:"):
					cflags = line.split(":", 1)[1]
				elif "=" in line and ":" not in line.split("=", 1)[0]:
					k, v = line.split("=", 1)
					variables[k.strip()] = v.strip()
	except OSError:
		return []

	def expand(s, depth=0):
		if depth > 8:
			return s
		return RE_PC_VAR.sub(
		    lambda m: expand(variables.get(m.group(1), ""), depth + 1), s)

	return [a[2:] for a in shlex.split(expand(cflags)) if a.startswith("-I")]


def _deepest_owner(incdirs, inc, name, found_in):
	"""The module owning the deepest include directory the header sits in.

    A project keeping several modules under one parent has every module's
    .pc advertise two directories: its own, and the shared parent. Qt is
    the case here -- `Qt5Core.pc' carries `-I${includedir}/QtCore' and
    `-I${includedir}', and so does every sibling. The parent therefore
    belongs to whichever .pc was read first, which is alphabetical and so
    arbitrary: `QtCore/qmetatype.h' resolved under the parent and was
    attributed to Qt5Concurrent, whose -D and -l then joined a build that
    never mentioned QtConcurrent.

    Matching on the directory alone cannot see this, because the header's
    own prefix makes up the difference -- `QtCore/qmetatype.h' is a file
    under the parent and is not one under `.../qt5/QtCore'. So ask where
    the file that was found actually lies, and take the deepest claimant
    of it.

    The neighbouring comment in for_header fixed the other half of this,
    for a bare `<QtWidgets>' naming a directory rather than a file. A
    prefixed include is a real file under the parent and walks straight
    through that test, which is why it survived it.
    """
	found = os.path.normpath(os.path.join(inc, name))
	owner, depth = found_in, len(inc.rstrip("/"))
	for d, mod in incdirs.items():
		d = d.rstrip("/")
		if len(d) > depth and found.startswith(d + os.sep):
			owner, depth = mod, len(d)
	return owner


def _preferred_qt(hits, order):
	"""The hit belonging to the Qt this build is for.

    Two Qt majors installed side by side spell their headers identically,
    so a header that both provide is answered by both and something has to
    choose. Nothing did: the tool was taken newest-first and the flags were
    taken from whichever .pc sorted first, which is Qt 5, so a tree got Qt
    6's moc and Qt 5's headers. moc emits its own major's includes --
    <QtCore/qtmochelpers.h> exists only in Qt 6 -- and those resolved to Qt
    6 while the tree's own <QObject> resolved to Qt 5, putting both majors
    on one command line. Qt then refuses it in as many words:

        error: Qt major version not 6 or 7

    So the choice is made once and both sides read it. `order' is
    newest-first by default, which is what §17 already argued for and what
    find_qt_tool has always done, and it moves when a moc is named so that
    the escape hatch moves the flags with the tool rather than leaving them
    to disagree.

    A header only one major provides is unaffected: nothing else claims it,
    and it is answered by the major that has it whatever the preference.
    """
	for want in order:
		for inc, mod in hits:
			if mod.startswith(want):
				return inc, mod
	return hits[0]


def propose_from_headers(units, pkg, store, proj=None):
	"""Packages the system includes suggest, with the -I flags they need.

    Runs before compiling, since that is when -I is needed. What comes back
    is a proposal only: the symbol evidence settles whether a package is
    really linked.
    """
	sig = pkg.signature()
	cflags, proposed, seen = [], {}, set()
	for u in units:
		for kind, name, line in (u.scan.get("incs") or []):
			if kind != "<" or name in seen:
				continue
			seen.add(name)
			if proj is not None and proj.resolve_header(name, u.rel):
				continue        # a project header that happens to use <>
			got = pkg.for_header(name, store, sig)
			if got is None:
				continue
			module, mod_cflags, mod_libs = got[0], got[1], got[2]
			for f in mod_cflags:
				if f not in cflags:
					cflags.append(f)
			for l in mod_libs:
				proposed.setdefault(l[2:], (module, f"{u.rel}:{line}", name))
	return cflags, proposed

RE_WRAP = re.compile(r"^__wrap_(.+)$")


def wrap_flags(cl):
	"""-Wl,--wrap=X for every __wrap_X the link set defines.

    A symbol named __wrap_socket exists for exactly one reason: GNU ld's
    --wrap, which redirects calls to socket into it. Defining one and not
    passing the flag produces a binary that silently ignores the wrapper --
    the failure mode that makes mocked unit tests pass against the real
    syscall. Nothing but the symbol name is needed to know the intent, and
    only the closure knows which objects are actually in the link.
    """
	needed = set()
	for u in cl.link:
		needed |= u.undef
	out = []
	for u in cl.link:
		for sym in sorted(u.strong):
			m = RE_WRAP.match(sym)
			if m and m.group(1) in needed:
				out.append(m.group(1))
	return sorted(set(out))


def libdir_signature(cfg):
	"""Stamp that changes when any linkable library does.

    Directory mtimes are not enough. A directory's mtime moves when an entry
    is added, removed or renamed -- so a package manager that installs by
    rename is caught -- but not when a file is rewritten in place, which is
    what `install` and a plain redirect both do. Rebuild a library into
    /usr/local/lib and fmake would go on believing the symbols it had before.

    Stat-ing every candidate instead costs about 3ms for ~900 libraries,
    which is less than one compiler invocation and is only paid when the
    resolution cache is consulted at all.
    """
	parts = []
	for name, path in sorted(linkable_libs(cfg.libdirs).items()):
		try:
			st = os.stat(path)
			parts.append(f"{name}:{path}:{st.st_size}:{st.st_mtime_ns}")
		except OSError:
			parts.append(f"{name}:{path}:gone")
	return sha("|".join(parts))


def scan_providers(cfg, externals, cache, jobs, want_ident=None):
	"""One sweep of the installed libraries for every target's symbols.

    Shared deliberately: a repo with four programs would otherwise scan the
    system four times over, and the sweep is the only expensive part of
    resolution. Cached against the union of the symbols and a stamp of the
    library directories, so an ordinary incremental build never sweeps.
    """
	want = sorted(externals)
	if not want:
		return {}, {}
	key = sha("|".join(want) + "#" + libdir_signature(cfg)
	          + "#" + str(want_ident))
	store = cache.data.setdefault("providers", {})
	if key in store:
		return store[key]["providers"], store[key]["paths"]
	vinfo(f"resolving {len(want)} external symbol(s) against "
	      f"{describe_identity(want_ident)} libraries in "
	      f"{len(cfg.libdirs)} directory(ies)")
	providers, libs = find_providers(cfg, want, jobs, want_ident)
	paths = {n: p for n, p in libs.items()
	         if any(n in v for v in providers.values())}
	store[key] = {"providers": providers, "paths": paths}
	return providers, paths


def preprocessed_headers(cl):
	"""Every header the compiler actually opened, keyed by source.

    The scan reads text and cannot evaluate `#if`, so an include sitting in
    a conditional that is false still looks like one. The depfile is the
    compiler's answer to the same question and it is exact: `-MD` lists
    every file the preprocessor opened, system headers included.

    A source with no depfile is simply absent rather than empty. "Nobody
    asked the compiler" and "the compiler opened nothing" would otherwise
    read the same, and only one of them means anything.
    """
	out = {}
	for u in cl.link:
		# A prebuilt archive in the tree has no depfile because it has no
		# preprocessor step -- `dep` is None for exactly that reason. It
		# proposes no headers either, so it has nothing to say here.
		if u.archive or not u.dep or not os.path.isfile(u.dep):
			continue
		out[u.rel] = {d.replace(os.sep, "/") for d in parse_depfile(u.dep)}
	return out


def compiled_away_includes(cl, opened, incdirs):
	"""System includes the scan saw, the preprocessor never opened, and the
	machine actually has. Returns [(where, header)].

    section 40 reported this only for headers it could attribute to a package,
    because the report was keyed on a *proposal*, and a proposal comes from
    pkg-config. A package whose headers sit in a default include directory
    emits no `-I`, so nothing attributes it, so nothing was proposed and
    nothing was said -- and hydra's third optional feature was exactly that
    shape: libtorrent, found by pkg-config, headers in /usr/include, and a
    browser silently built without torrent support.

    Existence is what keeps this quiet. `#ifdef _WIN32` guarding
    `<windows.h>` names a header this machine does not have, so there is
    nothing to report; a header that *is* here and was compiled out is a
    feature that could have been on.
    """
	out, seen = [], set()
	for u in cl.link:
		deps = opened.get(u.rel)
		if deps is None:
			continue
		for kind, name, line in (u.scan.get("incs") or []):
			if kind != "<":
				continue
			key = (u.rel, name)
			if key in seen:
				continue
			tail = "/" + name.replace(os.sep, "/")
			if any(d.endswith(tail) for d in deps):
				continue
			if not any(os.path.isfile(os.path.join(d, name))
			           for d in incdirs):
				continue
			seen.add(key)
			out.append((f"{u.rel}:{line}", name))
	return out


def resolve_libraries(t, cl, cfg, pkg, hdr_store, providers, paths,
                      want_ident=None, proj=None):
	"""Turn one target's external symbols into link flags."""
	# Proposals are recomputed from this target's own link set, so the
	# provenance names a file that is actually in this program. Everything
	# it needs is cached by now, so this costs nothing.
	_, proposed = propose_from_headers(cl.link, pkg, hdr_store, proj)
	want = sorted(cl.external)

	# Qt 5 and Qt 6 define a great many of the same mangled names --
	# QBoxLayout::addSpacing is one spelling in both -- while each also has
	# names the other lacks, QWidget::enterEvent taking a QEnterEvent only
	# in 6. So a cover free to take either picks one of each on symbol
	# count alone, and the program links two Qts. Nothing downstream
	# notices: the compile is clean, the link succeeds, and it is the
	# runtime that pays.
	keep = link_qt_major(proposed, pkg.qt_order)
	if keep:
		providers = {s: [l for l in libs
		                 if (qt_major_of(l) or keep) == keep]
		             for s, libs in providers.items()}

	chosen, why, implicit, unresolved = choose_libs(
	    providers, want, set(proposed))
	ident = want_ident

	# A library outside the linker's own search path needs -L, whether it
	# came from pkg-config or from the symbol scan.
	defaults = default_link_dirs(cfg)
	ldirs = []
	for lib in chosen:
		d = os.path.dirname(paths.get(lib, ""))
		if d and os.path.realpath(d) not in defaults and d not in ldirs:
			ldirs.append(d)

	alts = {}
	for lib in chosen:
		other = set()
		for s in why.get(lib, []):
			other |= set(providers.get(s, ()))
		# libm-2.41 beside libm is the same library under a private name,
		# not a second source worth reporting.
		alts[lib] = sorted(a for a in other - {lib} - IMPLICIT_LIBS
		                   if not a.startswith(lib + "-"))
	res = {
	    "chosen": chosen, "why": why, "alts": alts, "ldirs": ldirs,
	    "implicit": sorted(implicit), "unresolved": unresolved,
	    "ident": ident,
	    # Which of them are archives. The scan already knows -- it read the
	    # file to get its symbols -- and it is the one fact the link line
	    # needs that a `-l' flag cannot carry.
	    "archives": sorted(l for l in chosen
	                       if paths.get(l, "").endswith(".a")),
	}

	# Not cached: these depend on the header proposals, which are cheap.
	res = dict(res)
	res["proposed"] = {k: v for k, v in proposed.items()
	                   if k in res["chosen"]}
	# A package is only "unused" when *none* of its libraries were needed.
	# pkg-config routinely lists more than a program calls into -- ncursesw
	# brings tinfo, and linking only what is needed is the entire point --
	# so reporting each surplus -l would be noise, and naming the module by
	# one of them reads as a contradiction when the module was linked.
	used_modules = {v[0] for k, v in proposed.items() if k in res["chosen"]}
	seen_mod = set()
	res["unused"] = {}
	for k, v in proposed.items():
		if v[0] in used_modules or v[0] in seen_mod:
			continue
		seen_mod.add(v[0])
		res["unused"][k] = v
	# Two reasons a proposal is declined, and they are not the same finding.
	# "This header suggested a library the code does not call into" is a note
	# -- the symbol evidence disagreed with the include, which is section 3 working.
	# "This header sits behind a conditional the preprocessor did not take"
	# is a different sentence: the code that would have called into it was
	# removed before the compiler saw it, so there is no symbol to find and
	# never was. Every step of the reasoning is right and the answer is
	# wrong, which is the shape that gets shipped.
	opened = preprocessed_headers(cl)
	res["compiled_away"] = {}
	for k, (module, where, header) in res["unused"].items():
		deps = opened.get(where.rsplit(":", 1)[0])
		if deps is None:
			continue
		# The proposal is an include *text*; the depfile holds resolved
		# paths. Matching on the suffix is the -I search run backwards, and
		# the leading separator is load-bearing: without it a local
		# xzlib.h answers for <zlib.h> and the finding disappears.
		tail = "/" + header.replace(os.sep, "/")
		if not any(d.endswith(tail) for d in deps):
			res["compiled_away"][k] = (module, where, header)
	# Declared dependencies are not proposals to be weighed -- the author
	# said the library is needed, so it is linked whether or not a symbol
	# happens to require it. @ldflags propagates for the same reason @cflags
	# does not: it is a property of whatever the TU ends up inside.
	declared, extra_ld = [], []
	for lib in t.conf.get("libs", []):
		if lib not in declared:
			declared.append(lib)
	for spec in t.conf.get("pkg", []):
		got = pkg.for_module(spec.split()[0], hdr_store, pkg.signature())
		for l in (got[2] if got else []):
			if l[2:] not in declared:
				declared.append(l[2:])
	extra_ld += t.conf.get("ldflags", [])
	for u in cl.link:
		for lib in u.ann.items("libs"):
			if lib not in declared:
				declared.append(lib)
		for group in u.ann.groups("pkg"):
			got = pkg.for_module(group[0], hdr_store, pkg.signature())
			for l in (got[2] if got else []):
				if l[2:] not in declared:
					declared.append(l[2:])
		for f in u.ann.items("ldflags"):
			if f not in extra_ld:
				extra_ld.append(f)

	res["declared"] = [d for d in declared if d not in res["chosen"]]
	res["wrap"] = wrap_flags(cl)
	# Two or more resolved archives get a group, for the reason
	# archive_flags gives about archives in the tree: ld searches an archive
	# only for what is undefined when it reaches it, so an archive needing a
	# symbol from one listed earlier contributes nothing, and the cover has
	# no reason to have ordered them usefully. A group makes the order among
	# them irrelevant and resolves a cycle without naming either twice.
	#
	# One archive needs no group. Shared libraries are not order-sensitive
	# as providers, and libc is implicit and last regardless -- so a single
	# archive has nothing it could be on the wrong side of.
	found = ["-l" + l for l in res["chosen"]]
	if len(res.get("archives", [])) > 1:
		found = ["-Wl,--start-group"] + found + ["-Wl,--end-group"]
	res["ldflags"] = (["-Wl,--wrap=" + w for w in res["wrap"]]
	                  + ["-L" + d for d in res.get("ldirs", [])]
	                  + found
	                  + ["-l" + l for l in res["declared"]]
	                  + extra_ld)
	return res

