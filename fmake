# Tree walk
# ---------------------------------------------------------------------------

def walk_tree(root):
    """Return (sources, headers) as root-relative paths."""
    srcs, hdrs = [], []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames
                       if d not in SKIP_DIRS and not d.startswith(".")]
        for f in filenames:
            ext = os.path.splitext(f)[1]
            rel = os.path.relpath(os.path.join(dirpath, f), root)
            if ext in SRC_EXTS:
                srcs.append(rel)
            elif ext in HDR_EXTS:
                hdrs.append(rel)
    return sorted(srcs), sorted(hdrs)


def is_cxx(rel):
    return os.path.splitext(rel)[1] in CXX_EXTS

# ---------------------------------------------------------------------------
# Include resolution and candidate sets
#
# This produces a *guess* at what is worth compiling. Being wrong here costs
# extra compilation or a widening pass, never a wrong link set.
# ---------------------------------------------------------------------------

class Project:
    def __init__(self, root, srcs, hdrs, scans):
        self.root  = root
        self.srcs  = srcs
        self.hdrs  = hdrs
        self.scans = scans
        # basename -> [relative header paths], for unqualified include lookup
        self.hdr_by_name = {}
        for h in hdrs:
            self.hdr_by_name.setdefault(os.path.basename(h), []).append(h)
        # header stem -> sibling source with the same stem, if any
        self.src_set = set(srcs)
        self.src_by_stem = {}
        for s_ in srcs:
            self.src_by_stem.setdefault(
                os.path.basename(os.path.splitext(s_)[0]), []).append(s_)
        self.incdirs = set()

    def resolve_header(self, inc_name, from_rel):
        """Resolve an include to a tree-relative header path, or None."""
        base = os.path.dirname(from_rel)
        cand = os.path.normpath(os.path.join(base, inc_name))
        if cand in self.hdr_by_name.get(os.path.basename(cand), []) or \
           os.path.isfile(os.path.join(self.root, cand)):
            self.incdirs.add(os.path.dirname(cand) or ".")
            return cand
        cand = os.path.normpath(inc_name)
        if os.path.isfile(os.path.join(self.root, cand)):
            self.incdirs.add(".")
            return cand
        matches = self.hdr_by_name.get(os.path.basename(inc_name), [])
        if len(matches) == 1:
            self.incdirs.add(os.path.dirname(matches[0]) or ".")
            return matches[0]
        return None

    def sibling_source(self, hdr_rel):
        """The source that probably implements a header.

        A true sibling first -- foo.h next to foo.c. Failing that, a source
        with the same stem anywhere in the tree, because splitting headers
        into include/ and sources into src/ is one of the commonest C++
        layouts there is, and under a strict sibling rule the include graph
        finds nothing at all in such a project. Measured on a 292-file game:
        5 headers had a sibling, 256 had a same-stem source elsewhere.

        Ambiguity is left alone. Several sources sharing a stem says nothing
        about which one a header means, and compiling all of them could
        introduce duplicate definitions the closure would then refuse to
        resolve. Widening still finds the right one from the symbols.
        """
        stem = os.path.splitext(hdr_rel)[0]
        for ext in SRC_EXTS:
            if stem + ext in self.src_set:
                return stem + ext
        matches = self.src_by_stem.get(os.path.basename(stem), ())
        return matches[0] if len(matches) == 1 else None

    def candidates(self, root_src):
        """Include-graph reachable TUs from a root. A guess, nothing more.

        Angle brackets are followed as well as quotes. Punctuation does not
        decide whether a header belongs to the project -- whether it resolves
        inside the tree does. Putting include/ on the -I path and writing
        <Bullet.h> is standard practice, and it is what CMake encourages; a
        quotes-only rule sees none of it. Measured on a 292-file game: 2342
        of its own headers were included with <> against 425 with "".

        A name that resolves to nothing in the tree is a system header, and
        falls through to library resolution untouched.
        """
        seen_h, out = set(), {root_src}
        queue = [root_src]
        while queue:
            cur = queue.pop()
            scan = self.scans.get(cur)
            if not scan:
                continue
            for _kind, name, _line in scan["incs"]:
                h = self.resolve_header(name, cur)
                if not h or h in seen_h:
                    continue
                seen_h.add(h)
                # headers can include headers; follow those too
                queue.append(h)
                src = self.sibling_source(h)
                if src and src not in out:
                    out.add(src)
                    queue.append(src)
        return out

