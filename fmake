class Unit:
	# `archive' is about where a unit goes on the link line; `prebuilt' is
	# about whether fmake made it. They were the same fact until a loose .o
	# arrived, which fmake did not build and which is not searched like an
	# archive either.
	__slots__ = ("rel", "abs", "cxx", "lang", "obj", "dep", "scan", "ann",
	             "own", "prebuilt", "members",
	             "undef", "strong", "weak", "compiled", "archive")

	def __init__(self, rel, root, objdir, scan, members=None):
		self.rel  = rel
		self.abs  = os.path.join(root, rel)
		self.lang = LANGS.get(os.path.splitext(rel)[1], _C)
		self.cxx  = self.lang.cxx
		# `members' is the rest of the crate: files that are inputs and
		# never units, because rustc is handed the root and reads them
		# itself. Empty for every other language, where the unit is the
		# file.
		self.members = list(members or [])
		self.obj  = os.path.join(objdir, rel + ".o")
		self.dep  = os.path.join(objdir, rel + ".d")
		self.scan = scan
		self.ann  = Ann(scan.get("dirs"))
		self.own  = []            # compile flags this TU asked for itself
		self.undef = self.strong = self.weak = None
		self.compiled = False
		# A prebuilt archive shipped in the tree rather than a TU fmake
		# builds. It provides symbols like any object, but it is never
		# compiled and it goes in a different place on the link line.
		# `archive' is where it goes on the link line and `prebuilt' is
		# whether fmake made it. A crate library is the first thing to be
		# one and not the other -- built here, and searched like a vendored
		# .a -- which is why the two flags were worth separating.
		self.archive = False
		self.prebuilt = False
		if self.lang.unit == "crate":
			if scan.get("has_main"):
				# A crate with a main() is a program rustc links, so this
				# unit produces nothing on its own and there is no object
				# to read. Marked compiled with empty tables so that
				# nothing tries to build it or ask nm about it; what it
				# needs is settled by rustc, from crate metadata a symbol
				# table does not carry.
				self.obj = None
				self.undef = self.strong = self.weak = set()
				self.compiled = True
			else:
				self.obj = os.path.join(objdir, rel + ".a")
				self.archive = True

	@property
	def crate(self):
		return self.lang.unit == "crate"

	@property
	def crate_exe(self):
		"""A crate rustc links itself, rather than one fmake links."""
		return self.crate and self.obj is None


def optional_pkg(group):
	"""(module, macro) from `@pkg_optional NAME defines MACRO`, or None.

    The keyword is required rather than inferred from the argument count.
    `@pkg_optional libsecret-1 HAVE_SECRET` would read as two packages to
    anyone who had not memorised the order, and the failure is silent in
    exactly the way this directive exists to prevent.
    """
	if len(group) == 3 and group[1] == "defines":
		return group[0], group[2]
	return None


def unit_cflags(u, pkg, store, sig):
	"""Compile flags a TU asked for, in @std @define @cflags @pkg order.

    Per-TU by design: a compile flag is a property of the translation unit.
    Link flags are not -- they belong to whatever the TU ends up inside --
    and that asymmetry is what makes declaring a dependency next to the code
    that uses it work at all.
    """
	out = []
	std = u.ann.scalar("std")
	if std:
		out.append("-std=" + std)
	out += ["-D" + d for d in u.ann.items("define")]
	out += u.ann.items("cflags")
	for group in u.ann.groups("pkg"):
		got = pkg.for_module(group[0], store, sig)
		if got:
			out += [f for f in got[1] if f not in out]
	# "Found means defined": the pattern every optional dependency in every
	# C project uses, and the one thing fmake could not see. What it adds is
	# the macro, not the library -- once the macro is defined the guarded
	# code is there and its symbols ask for the library on their own, so section 3
	# still decides the link. A package that is not installed adds nothing,
	# which is the same answer the configure step would have given.
	for group in u.ann.groups("pkg_optional"):
		spec = optional_pkg(group)
		if not spec:
			continue
		got = pkg.for_module(spec[0], store, sig)
		if got:
			out += [f for f in got[1] if f not in out]
			if "-D" + spec[1] not in out:
				out.append("-D" + spec[1])
	return out


def compile_cmd(u, cfg, incflags):
	if u.lang.unit == "crate":
		return crate_cmd(u, cfg, u.obj)
	cc = cfg.driver(u.cxx)
	return ([cc, "-c", u.abs, "-o", u.obj] + u.lang.dep_flags(u.dep)
	        + incflags + cfg.cflags + u.own + cfg.override)


def crate_cmd(u, cfg, out, exe=False):
	"""The one rustc call that builds a crate.

    Both halves of a crate build are this command with a different
    `--crate-type': a library becomes a staticlib the closure can read with
    nm and the linker can search, and a program is linked by rustc itself.

    The second is not a choice. Debian's rustc ships `std' as .rlib files
    and no shared object at all, so there is nothing for fmake to put on a
    link line -- resolving a Rust program's own dependencies means walking
    rustc's crate metadata, which is rustc's job and not a symbol table's.

    The output is named with `-o' and the depfile inside `--emit'. That is
    not a style choice and it was measured: writing the link path inside
    --emit instead -- `--emit=link=PATH,dep-info=PATH' -- puts the *crate
    name* in the depfile's target line, so every lib.rs in every tree
    produces `liblib.a: ...'. Make silently attaches those prerequisites to
    a target it has never heard of and drops them, which is a depfile
    written and never read; ninja is stricter and calls the output
    perpetually dirty, rebuilding it on every run for ever. With `-o' the
    target line names the real artifact and both backends read it.

    dep-info is otherwise an ordinary Make depfile naming the whole module
    graph, so staleness needs nothing that -MD did not already give C.
    """
	return ([cfg.rustc, "--edition", cfg.rust_edition]
	        + ([] if exe else ["--crate-type=staticlib"])
	        + ["-o", out, f"--emit=link,dep-info={u.dep}"]
	        + cfg.rustflags + u.own + [u.abs])


# One entry per distinct header, not one per (header, object) pair. A
# depfile names every header its object saw, so across a tree the same
# Qt header is turned into a relative path once per object that includes
# it -- on hydra, 93,478 calls for a few thousand distinct paths. `root'
# is fixed for the run, so the answer cannot change.
_REL_CACHE = {}


def object_key(u, cfg, cache, root, incflags):
	"""Cache key: source content, every prerequisite's content, and config.

    The include flags are part of the config: gaining an -I can change which
    header a name resolves to, so an object built without it is not reusable.
    So are the TU's own flags, since @define changes what the file means.
    """
	# Include flags are not part of a crate's identity: rustc never sees
	# them, so keying on them would rebuild a 50MB staticlib every time a
	# -I moved somewhere else in the tree.
	inc = [] if u.lang.unit == "crate" else incflags
	parts = [cfg.key, sha("\0".join(inc)), sha("\0".join(u.own))]
	src_h = cache.hash_of(u.abs, u.rel)
	if src_h is None:
		return None
	parts.append(src_h)
	for dep in parse_depfile(u.dep):
		rel = _REL_CACHE.get((root, dep))
		if rel is None:
			rel = _REL_CACHE[(root, dep)] = os.path.relpath(dep, root)
		dh = cache.hash_of(dep, rel)
		if dh:
			parts.append(rel + ":" + dh)
	return sha("|".join(parts))


RE_NO_HEADER = re.compile(
    r"^(.+?):\s*(?:No such file or directory|file not found)\s*$")


def _missing_header(msg):
	"""The header name out of a compiler's not-found diagnostic, or None.

    gcc says `X: No such file or directory`, clang says `'X' file not
    found`. Both put the name first, which is the only part worth quoting
    back -- the rest of the line is the compiler repeating itself.
    """
	m = RE_NO_HEADER.match(msg.strip())
	if not m:
		return None
	return m.group(1).strip().strip("'\"")


# gcc quotes an identifier with U+2018/U+2019 and clang with an
# apostrophe, so the class carries all three. Written as escapes because
# this file is ASCII: the characters are the compiler's, not ours.
_QUOTE = "['\u2018\u2019]"
_Q = _QUOTE

# Four spellings, one per way the three real instances failed. gcc says
# `undeclared' for C and `was not declared in this scope' for C++; clang
# says `use of undeclared identifier'; and a source that guards itself
# says so with #error, which openmlx4 does and which never reaches the
# other three because the preprocessor stops first.
RE_VERSION_MISSING = tuple(re.compile(p) for p in (
    "^" + _Q + r"([A-Za-z_]\w*)" + _Q + r" undeclared",
    "^" + _Q + r"([A-Za-z_]\w*)" + _Q + r" was not declared in this scope",
    "^use of undeclared identifier " + _Q + r"([A-Za-z_]\w*)" + _Q,
    r'^#error\s+.*?\b([A-Za-z_]\w*VERSION)\b',
))


def _undeclared_version(msg, root):
	"""A version macro a build system was expected to inject, or None.

    An undeclared identifier is nearly always a fault in the source, and
    answering every one of them with "define it on the command line" would
    be advice that is wrong more often than right. So this answers for one
    shape only: a name ending in VERSION, in a tree that carries a VERSION
    file. That is a build system's macro rather than the program's, and the
    file is the value.

    Three have been met in two projects. beerssh spells it
    BSSH_VERSION_STRING and hands it to QStringLiteral, where the failure
    is a parse error inside a Qt macro and names the macro rather than the
    cause; openmlx4 spells it OMLX4_VERSION. In each the source cannot be
    compiled by anything that does not already know the convention, which
    is exactly what a second build system does not.
    """
	name = None
	for pattern in RE_VERSION_MISSING:
		m = pattern.match(msg.strip())
		if m:
			name = m.group(1)
			break
	if not name or not name.endswith("VERSION"):
		return None
	try:
		with open(os.path.join(root, "VERSION")) as fh:
			value = fh.read().strip()
	except OSError:
		return None
	return (name, value) if value else None


def _headers_in_tree(name, headers):
	"""Where this tree holds the header the compiler could not find.

    Matched on whole path components, the same rule as everywhere else
    here: `time.h` must not be answered by `datetime.h`. Shortest path
    first, so a header at the root comes before one buried under a
    vendored copy of itself.

    Every match, not the best one. The resolver declines to resolve a
    basename that more than one file answers -- that is why the compile
    failed at all -- and an advice that then picks the shortest and
    states it as *the* location has guessed exactly where the tool
    refused to. Naming both costs a line and cannot send anybody to the
    wrong file.
    """
	want = "/" + name.replace(os.sep, "/")
	hits = [h for h in headers
	        if h == name or h.replace(os.sep, "/").endswith(want)]
	return sorted(hits, key=lambda h: (h.count("/"), len(h)))


_ARCH_CHECKED = set()


def check_object_arch(u, cfg):
	"""Refuse an object built for a machine the tree did not ask for.

    The C++ compiler not deriving from the toolchain prefix produced an
    x86-64 binary for a tree declaring aarch64, with `built prog' as the
    only output. Deriving it fixes that instance; this closes the class,
    because the next one will be a compiler named by hand, a `[toolchain]
    arch' that does not match the `cc', or a `$CXX' left over in a shell.

    The evidence is the same one section 23 uses on a vendored archive --
    the ELF header, which is exact for any architecture and needs no
    knowledge of triplets. Once per architecture per run, so the cost is
    one 20-byte read rather than one per object.

    Silent when it cannot know: an architecture missing from ELF_MACHINES,
    a non-ELF object, an unreadable file. A guard that guesses is worse
    than none, and this one only ever speaks when both sides are certain.
    """
	# A generator is compiled for the build machine on purpose, so its
	# objects do not match the target and must not be judged against it.
	# The artifact is checked separately, against *this* machine, with a
	# message that names [build-toolchain] -- which is the better one, and
	# firing here first would replace it with a worse one.
	if cfg.for_build_machine:
		return
	want = None
	for code, name in ELF_MACHINES.items():
		if name == cfg.arch:
			want = code
			break
	if want is None or want in _ARCH_CHECKED:
		return
	ident = elf_identity(u.obj)
	if ident is None:
		return
	_ARCH_CHECKED.add(want)
	if ident[2] != want:
		# Two fixes, and which one is right depends on what was intended.
		# Naming only the compiler reads as "you chose the wrong one",
		# which is wrong for the cross build that is going fine and simply
		# has not said so: a compiler told to target another machine by a
		# flag rather than by its name -- clang's --target, and every
		# unprefixed toolchain -- looks exactly like a mistake from here.
		die(f"{u.rel} compiled for {describe_identity(ident)}, but this "
		    f"tree is being built for {cfg.os}/{cfg.arch}\n"
		    f"    the compiler used was {cfg.driver(u.cxx)!r}\n"
		    f"    name the right one with [toolchain] "
		    f"{'cxx' if u.cxx else 'cc'}, or $"
		    f"{'CXX' if u.cxx else 'CC'}\n"
		    f"    or, if a cross build is what was wanted, declare it: "
		    f"[toolchain] arch = {describe_identity(ident).split('/')[0]!r}")


def compile_units(units, cfg, cache, root, incflags, jobs, dry_run,
                  broken=None, tree_headers=(), quiet=False, origins=None):
	"""Compile what is stale. Returns True if anything was actually built.

    `broken` collects the files that would not compile, so the caller can
    drop the targets that depended on them and build the rest.
    """
	broken = set() if broken is None else broken
	origins = origins or {}
	todo = []
	for u in units:
		if u.compiled:
			continue
		ent = cache.objects.get(u.rel)
		key = object_key(u, cfg, cache, root, incflags)
		if (ent and ent.get("key") == key and key is not None
		        and os.path.exists(u.obj)):
			u.undef  = set(ent["u"])
			u.strong = set(ent["s"])
			u.weak   = set(ent["w"])
			u.compiled = True
			vinfo(f"cached {u.rel}")
			continue
		todo.append(u)

	if not todo:
		return False

	for u in todo:
		os.makedirs(os.path.dirname(u.obj), exist_ok=True)

	width = len(str(len(todo)))
	done = [0]
	failures = []

	def run_one(u):
		cmd = compile_cmd(u, cfg, incflags)
		if dry_run:
			print(" ".join(cmd))
			return u, 0, ""
		r = subprocess.run(cmd, capture_output=True, text=True, errors="replace")
		return u, r.returncode, r.stderr

	with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as pool:
		for u, rc, err in pool.map(run_one, todo):
			done[0] += 1
			tag = u.lang.tag
			if rc != 0:
				failures.append((u, err))
				if not quiet:
					say(f"[{done[0]:>{width}}/{len(todo)}] {RED(tag)} {u.rel}")
			elif not dry_run:
				if not quiet:
					say(f"[{done[0]:>{width}}/{len(todo)}] {BLUE(tag)} {u.rel}")
				if err.strip():
					PROGRESS.write(err)
				# An archive is not an ELF file, so the 20-byte header read
				# has nothing to read. Its members are checked where it
				# matters anyway -- the link refuses a foreign object.
				if not u.archive:
					check_object_arch(u, cfg)

	if failures:
		# One missing system header fails every file that includes it, and
		# printing the same diagnostic hundreds of times buries anything
		# else. Group by the message, not by the file.
		groups, need_dirs = {}, []
		for u, err in failures:
			first = ""
			for line in err.splitlines():
				if "error:" in line:
					first = line.split("error:", 1)[1].strip()
					break
			groups.setdefault(first or err.strip()[:200], []).append((u, err))
		say()
		for msg, hit in sorted(groups.items(), key=lambda kv: -len(kv[1])):
			first_unit, first_err = hit[0]
			warn(f"{msg}" if msg else "compilation failed")
			note(f"in {first_unit.rel}"
			     + (f" and {len(hit) - 1} other file(s)" if len(hit) > 1
			        else ""))
			# A header that is not here is the symptom of two different
			# things, and the compiler cannot tell them apart. One project
			# spent an evaluation concluding "no flag fixes it, because the
			# question is which files belong in this build" -- which was
			# right, and the answer was four comments. Naming both causes
			# beats naming the likelier one: fmake does not know which.
			# A generated file is not a file anybody can annotate. moc,
			# uic and rcc outputs land under .fmake/, and the remedy below
			# -- @os or @arch on the file -- is an instruction to edit
			# something fmake wrote and will overwrite. Reported from a
			# hydra build, where the advice named
			# .fmake/moc/src/moc_qtwebengine_interceptor.cpp and the file
			# to act on was src/qtwebengine_interceptor.cpp, listed
			# further down among the others.
			#
			# fmake knows where every generated file came from -- the moc,
			# uic and rcc plans are built from exactly that -- so it says
			# so, and blames the source.
			blame = origins.get(first_unit.rel, first_unit.rel)
			if blame != first_unit.rel:
				note(f"generated from {blame}")

			# Before the header advice, because a tree using modules will
			# not be fixed by any of it. `module 'hello' not found' looks
			# like a missing include path, and every remedy below is about
			# include paths -- so a reader following them is being sent to
			# adjust flags for a build that cannot work whatever the flags
			# say.
			imported = first_unit.scan.get("modimp") or []
			if imported:
				note(f"{first_unit.rel} imports {', '.join(imported)}, and "
				     f"fmake does not build C++20 modules")
				# The reason, because "not supported" invites the obvious
				# wrong guess that a flag or a wider candidate set is all
				# it needs. A module interface has to be compiled into a
				# BMI *before* anything importing it, and the importer has
				# to be handed that BMI by name; fmake compiles
				# translation units in no particular order and passes no
				# such flag. Measured: --widen-all fails identically, so
				# the usual escape is not one here.
				note("a module interface must be compiled before the files "
				     "that import it, and fmake compiles in no order")
				note("--widen-all does not help: the ordering is the "
				     "problem, not which files were chosen")

			miss = _missing_header(msg)
			if miss:
				# The third remedy, and the only exact one when it applies:
				# the header is in this tree and nothing put its directory
				# on the include path. A vendored library included as
				# <vterm.h> from vterm/include is not a missing package and
				# not a file for another platform, and being told to
				# install something is worse than being told nothing.
				found = _headers_in_tree(miss, tree_headers)
				note(f"{miss} is on no include path here")
				if len(found) > 1:
					# More than one answer is why nothing resolved it.
					# Saying which are candidates is the honest form of
					# the same help; picking one would be the guess the
					# resolver already declined to make.
					note(f"{len(found)} files in this tree could be it, "
					     f"which is why it was not resolved:")
					for cand in found:
						note(f"    {cand}   [project] include-dirs = "
						     f"[{include_root_for(cand, miss)!r}]")
				elif found:
					here = found[0]
					note(f"it is in this tree, at {here}")
					want = include_root_for(here, miss)
					note(f"[project] include-dirs = "
					     f"[{want!r}] would find it")
					if want not in need_dirs:
						need_dirs.append(want)
				else:
					note(f"if it comes from a package, install it or name "
					     f"it with @pkg")
					note(f"if {blame} belongs to another platform, "
					     f"@os NAME or @arch NAME keeps it out of this build")
			found_version = _undeclared_version(msg, root)
			if found_version:
				# Same shape as the header remedy above: name the exact
				# line rather than the class of problem. The value is read
				# from the tree rather than guessed, so it is either right
				# or the file is wrong, and both are worth knowing.
				vname, vvalue = found_version
				note(f"{vname} is defined by no file in this tree, which is "
				     f"what a build system injecting a version looks like")
				note(f"VERSION here says {vvalue}")
				note(f"[project] cflags = ['-D{vname}=\"{vvalue}\"'] "
				     f"would define it")

			if VERBOSE or len(groups) == 1 and len(hit) == 1:
				PROGRESS.write(first_err)
			elif len(hit) > 1:
				for u, _e in hit[1:4]:
					note(f"   {u.rel}")
				if len(hit) > 4:
					note(f"   ... and {len(hit) - 4} more")
		# One line for all of them. A vendored library with its own include
		# layout produces a group per header -- thorvg gave ten -- and
		# collecting them by hand to re-run is work fmake has already done.
		if len(need_dirs) > 1:
			shown = ", ".join(repr(d) for d in need_dirs)
			note(f"all of those together: [project] include-dirs = "
			     f"[{shown}]")
		if not VERBOSE:
			note("-v for the full compiler output")
		say()

		# Not fatal on its own. Targets are discovered rather than requested,
		# so a test binary whose dependency is missing must not stop the
		# program next to it from building -- the same argument that makes
		# link failures per-target. A file that failed simply has no symbols,
		# so nothing can close over it, and whoever needed it fails alone.
		for u, _err in failures:
			u.undef, u.strong, u.weak = set(), set(), set()
			u.compiled = True
			broken.add(u.rel)
			cache.objects.pop(u.rel, None)

	if dry_run:
		for u in todo:
			u.undef, u.strong, u.weak = set(), set(), set()
			u.compiled = True
		return True

	# Symbol tables, and the cache entries that go with them. Only for what
	# actually compiled: a failed unit has no object file, and asking nm to
	# read one that is not there is a different error from the one the user
	# needs to see.
	made = [u for u in todo if u.rel not in broken]
	read_symbols(made, cfg, jobs)
	for u in made:
		cache.objects[u.rel] = {
		    "key": object_key(u, cfg, cache, root, incflags),
		    "u": sorted(u.undef), "s": sorted(u.strong), "w": sorted(u.weak),
		}
	return True

# ---------------------------------------------------------------------------
# Symbol tables
#
# The classification matters more than it looks. Lowercase nm types are
# file-local and invisible to other objects, so they neither provide nor
# conflict.
#
# Weak and common symbols are providers of last resort. C++ emits a weak
# definition of every template instantiation and inline function into every
# object that uses one, so treating them as strong would report duplicate
# definitions across perfectly ordinary files. But ignoring them entirely is
# wrong too: `extern template` leaves a plain undefined reference that only a
# weak definition elsewhere satisfies. So a strong provider wins if there is
# one, a weak provider is used if there is not, and several weak providers is
# normal rather than ambiguous.
# ---------------------------------------------------------------------------

def find_archives(root):
	"""Prebuilt .a files shipped in the tree, as relative paths."""
	out = []
	for dirpath, _dirnames, filenames in _walk(root):
		for f in filenames:
			if f.endswith(".a"):
				out.append(os.path.relpath(os.path.join(dirpath, f), root))
	return sorted(out)


def prebuilt_units(rels, root, cfg, jobs):
	"""Prebuilt `.o` files, named rather than discovered.

    section 18 closed the same question for `.a` and guessed the rest would follow.
    It does, mechanically -- nm reads a loose object exactly as it reads an
    archive -- but **discovering** them would be a regression rather than a
    feature. A `.o` beside its `.c` is what a hand-compile leaves behind,
    and it is ordinary litter: a kernel tree has dozens. Picking those up
    turns a tree that builds today into one reporting two providers for
    every symbol, and the second provider is a stale object nobody meant to
    keep.

    So a prebuilt object has to be asked for, in `@sources` or in
    `[target.*] sources`, which are already the two ways of saying "link
    this whatever the symbols think". Naming it is the whole difference
    between a vendored blob and a leftover.

    Unlike an archive it goes on the link line as an ordinary object rather
    than inside the group: a group is for things searched member by member,
    and an object is not searched at all.
    """
	made = []
	for rel in rels:
		u = Unit(rel, root, "", {})
		u.obj, u.dep, u.archive = os.path.join(root, rel), None, False
		u.prebuilt, u.compiled = True, True
		made.append(u)
	if made:
		read_symbols(made, cfg, jobs)
	return made


def archive_units(rels, root, cfg, jobs):
	"""Vendored archives as providers of symbols.

    section 15 guessed this would fall out of the model, and it does: nm reads an
    archive the same way it reads an object, posix format puts each member on
    its own header line, and a line with one field is already skipped. So the
    closure needs nothing new. An archive defining a symbol nothing else does
    is linked; one nothing needs is never mentioned again.

    What it does not get is a compile step or an object directory, so the
    unit is marked and its `obj` is the archive itself.
    """
	made = []
	for rel in rels:
		u = Unit(rel, root, "", {})
		u.obj, u.dep, u.archive = os.path.join(root, rel), None, True
		u.prebuilt = True
		made.append(u)
	if made:
		read_symbols(made, cfg, jobs)
	return made


# bfd names itself before the message, and prints it through the ordinary
# error handler on to *stdout*, where a parser reading two fields a line
# takes `plugin:' for a symbol type and discards it as file-local. Matched
# on the prefix rather than on the wording: bfd reaches this handler only
# when the plugin path has gone wrong, and a pattern tuned to one release's
# sentence is a check that stops firing when the sentence changes.
_PLUGIN_FAIL = re.compile(r"^(?:[^\n]*: )?bfd plugin: (.*)$", re.M)
_PLUGIN_PRODUCER = re.compile(r"Producer: '\s*LLVM ?(\d+)")


def plugin_failure(*streams):
	"""What a BFD plugin said when it claimed a file and could not read it.

    Returns (message, suggested nm) or None. The suggestion is named only
    when the plugin says which compiler wrote the file, because an nm named
    on a guess is the advice section 113 is about.
    """
	for text in streams:
		hit = _PLUGIN_FAIL.search(text or "")
		if not hit:
			continue
		major = _PLUGIN_PRODUCER.search(hit.group(1))
		want = f"llvm-nm-{major.group(1)}" if major else None
		if want and not shutil.which(want):
			want = f"an nm from LLVM {major.group(1)}"
		return hit.group(1), want or "llvm-nm"
	return None


def read_symbols(units, cfg, jobs):
	def one(u):
		r = subprocess.run([cfg.nm, "--format=posix", u.obj],
		                   capture_output=True, text=True, errors="replace")
		# An object nm could not read yields no symbols, and an object with
		# no symbols is invisible to the closure: it defines nothing so it is
		# never linked, and needs nothing so it reports no externals. The
		# file would compile, appear in the build, and simply be absent from
		# the result. A cross toolchain with the wrong nm gets here.
		if r.returncode != 0:
			said = (r.stderr.strip().splitlines()[0] if r.stderr.strip()
			        else "no output")
			# What the file actually is decides the advice. A cross build
			# with a host nm wants a different nm; -flto with clang wants
			# llvm-nm or the LLVM plugin, and telling that reader to name an
			# nm that understands "unknown" objects sends them looking for a
			# toolchain problem they do not have.
			if bitcode_object(u.obj):
				die(f"{cfg.nm} could not read {u.rel}'s object:\n"
				    f"    {said}\n"
				    f"That object is LLVM bitcode, which -flto with clang "
				    f"emits instead of ELF.\n"
				    f"Set [toolchain] nm in {CONF_FILE}, or $NM, to "
				    f"llvm-nm -- or install LLVMgold.so into "
				    f"/usr/lib/bfd-plugins, which teaches binutils nm to "
				    f"read it.")
			die(f"{cfg.nm} could not read {u.rel}'s object:\n"
			    f"    {said}\n"
			    f"Set [toolchain] nm in {CONF_FILE}, or $NM, to one that "
			    f"understands {describe_identity(elf_identity(u.obj))} "
			    f"objects.")
		# Exiting 0 is not the same as having read the file. A plugin that
		# claims an object and then fails leaves nm reporting no symbols
		# and exiting 0, so the file reads as *empty* rather than as
		# unread -- which is the failure the comment above describes,
		# arriving by the one route the exit status cannot show. Believing
		# it is worse than a link error: fmake goes on to say confidently
		# where each symbol came from, and it is wrong.
		bad = plugin_failure(r.stdout, r.stderr)
		if bad:
			said, want = bad
			# Which file it is decides how much of this a reader has to
			# work out. A crate is one fmake built a moment ago, out of
			# rustc's own std objects -- and every one of those carries an
			# embedded-bitcode section, so this is not an unlucky vendored
			# blob but the ordinary case for Rust on this machine.
			what = (f"{u.rel} is a Rust crate, and the staticlib fmake "
			        f"built from it holds rustc's std objects, which carry "
			        f"embedded bitcode.\n"
			        if u.crate else "")
			die(f"{cfg.nm} could not read {u.rel}'s symbols:\n"
			    f"    bfd plugin: {said}\n"
			    + what +
			    f"A plugin claimed that file and then failed, and nm "
			    f"reports that as no symbols and exit 0 rather than as "
			    f"an error -- so it reads as an object defining nothing "
			    f"and needing nothing, which the closure cannot see "
			    f"past. Which plugin nm loads is a property of this "
			    f"machine rather than of the tree.\n"
			    f"Set [toolchain] nm in {CONF_FILE}, or $NM, to "
			    f"{want}, which reads the file the plugin could not.")
		undef, strong, weak = set(), set(), set()
		for line in r.stdout.splitlines():
			parts = line.split()
			if len(parts) < 2:
				continue
			name, typ = parts[0], parts[1]
			if typ == NM_UNDEF:
				undef.add(name)
			elif typ in NM_WEAK or typ in NM_COMMON:
				weak.add(name)
			elif typ.isupper():
				strong.add(name)
			# lowercase: file-local, ignored
		return u, undef, strong, weak

	with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as pool:
		for u, undef, strong, weak in pool.map(one, units):
			u.undef, u.strong, u.weak = undef, strong, weak
			u.compiled = True

# ---------------------------------------------------------------------------
# Symbol closure -- the link set
# ---------------------------------------------------------------------------

class Closure:
	__slots__ = ("root", "link", "why", "external", "ambiguous")

	def __init__(self, root):
		self.root      = root
		self.link      = [root]
		self.why       = {}      # unit rel -> (symbol, needed-by rel)
		self.external  = {}      # symbol -> [unit rels referencing it]
		self.ambiguous = []      # (symbol, [providers])


def companions(members, reachable, moc_jobs, qrc_jobs):
	"""Generated outputs belonging to a declared member list.

    Only for targets whose membership is declared. The list a user writes
    names their own files; a moc or rcc output is neither theirs to name --
    it lives under the state directory -- nor theirs to decline, since a
    class's meta-object is part of that class rather than a second opinion
    about it.

    Ownership is by provenance, not by symbol. Matching on symbols looks
    equivalent and is not: three sibling programs each with a `RenderArea`
    produce three moc outputs defining the same names, and a symbol match
    hands all three to whichever target asked first. What settles it is which
    file moc read -- a member, or a header a member includes.
    """
	mine, owned = set(members), set()
	for j in moc_jobs:
		if j["src"] in mine or j["src"] in reachable:
			owned.add(j["out"])
	for j in qrc_jobs:
		if mine.intersection(j["users"]):
			owned.add(j["out"])
	return owned


def close_over_library(units, root_unit):
	"""A library is everything the tree defines, not a closure.

    There is no entry point to close from, and pruning would be wrong anyway:
    a library exists to be linked against code that has not been written yet,
    so which symbols matter is not knowable here. The consumer's linker prunes
    a static archive at its own link, and a shared object keeps everything by
    design. Other programs' roots are excluded -- an archive with two main()s
    in it is not useful to anyone.
    """
	cl = Closure(root_unit)
	cl.link = list(units)
	for u in units:
		if u is not root_unit:
			cl.why[u.rel] = ("part of the library", "")

	# A library is not exempt from section 3's refusal to guess. Two strong
	# definitions of one symbol in an archive is resolved by member order,
	# silently, and the consumer inherits the coin flip with no way to see
	# it -- so it is caught here, where the cause is. Weak definitions are
	# excluded as everywhere else: C++ libraries are full of them by design.
	strong_by_sym = {}
	for u in units:
		for sym in u.strong:
			strong_by_sym.setdefault(sym, []).append(u.rel)
	for sym, where in sorted(strong_by_sym.items()):
		if len(where) > 1:
			cl.ambiguous.append((sym, where))

	defined = set()
	for u in units:
		defined |= u.strong | u.weak
	for u in units:
		for sym in u.undef:
			if sym not in defined and sym not in LINKER_SYMBOLS:
				cl.external.setdefault(sym, []).append(u.rel)
	return cl


def close_over_symbols(root_unit, units, forced=(), forced_why=None):
	"""Transitive closure from a root object over undefined symbols.

    `forced` units seed the closure alongside the root. They are what nothing
    references -- constructor-registered plugins and dlopen targets -- so they
    have to be asserted, but once seeded their own dependencies resolve
    normally."""
	strong_by_sym, weak_by_sym = {}, {}
	for u in units:
		for s in u.strong:
			strong_by_sym.setdefault(s, []).append(u)
		for s in u.weak:
			weak_by_sym.setdefault(s, []).append(u)

	cl = Closure(root_unit)
	seeds = [root_unit] + [u for u in forced if u is not root_unit]
	for u in seeds[1:]:
		cl.link.append(u)
		cl.why[u.rel] = ((forced_why or {}).get(u.rel, "--force-link"), "")
	linked = set(seeds)
	# The symbols the link set defines, maintained alongside it. Asking
	# `any(sym in o.strong for o in linked)' walks the whole link set for
	# every symbol considered, and the link set is the thing that grows --
	# so the work is quadratic in exactly the dimension that gets bigger.
	# Section 79 recorded this as a suspicion it declined to act on, since
	# the profiler that raised it over-reports cheap functions called often.
	# It was right: measured on hydra, a third of the wall clock. Keeping
	# these two in step with `linked` is the whole cost.
	linked_strong = set()
	linked_weak = set()
	for u in seeds:
		linked_strong |= u.strong
		linked_weak |= u.weak
	frontier = list(seeds)

	while frontier:
		cur = frontier.pop()
		for sym in sorted(cur.undef):
			# Only a *strong* definition already in the link set ends the
			# search. Accepting a weak one here would let whichever object
			# happened to be linked first shadow a strong definition
			# elsewhere -- and which comes first depends on the alphabetical
			# order of some unrelated symbol, so the same program could link
			# two different ways. Strong beats weak has to hold globally,
			# not just at the moment a provider is chosen.
			if sym in linked_strong:
				continue

			providers = strong_by_sym.get(sym, [])
			if len(providers) > 1:
				cl.ambiguous.append((sym, [p.rel for p in providers]))
				continue

			if not providers:
				# No strong definition anywhere in the pool, so a weak one is
				# the answer -- this is how a separately instantiated
				# template is reached, since `extern template` leaves a plain
				# undefined reference that only vague linkage satisfies.
				# A weak copy already linked is as good as any other: vague
				# linkage means they are interchangeable.
				if sym in linked_weak:
					continue
				weak = weak_by_sym.get(sym, [])
				if not weak:
					continue
				providers = [min(weak, key=lambda u: u.rel)]

			p = providers[0]
			if p not in linked:
				linked.add(p)
				linked_strong |= p.strong
				linked_weak |= p.weak
				cl.link.append(p)
				cl.why[p.rel] = (sym, cur.rel)
				frontier.append(p)

	for u in cl.link:
		for sym in u.undef:
			if sym in LINKER_SYMBOLS:
				continue
			if sym not in linked_strong and sym not in linked_weak:
				cl.external.setdefault(sym, []).append(u.rel)

	return cl

# ---------------------------------------------------------------------------
# Widening
#
# An unresolved symbol should widen the compiled set, not fail the build.
#
# Candidates are the unbuilt files that appear to *define* the symbol. The
# distinction matters: filtering on any mention instead would match every
# file that merely calls printf, and widening would drag in most of the tree
# to chase a libc symbol it can never resolve. Definitions that this misses
# -- functions generated by macros, mostly -- need --widen-all or
# --force-link.
# ---------------------------------------------------------------------------

def symbol_tokens(sym):
	"""Plausible source identifiers for a symbol, including Itanium mangling."""
	if sym.startswith("_Z"):
		toks = set()
		for m in re.finditer(r"(\d+)", sym):
			n = int(m.group(1))
			name = sym[m.end():m.end() + n]
			if n and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
				toks.add(name)
		return toks
	return {sym.lstrip("_")}


def widen_candidates(symbols, pool_units):
	toks = set()
	for s in symbols:
		toks |= symbol_tokens(s)
	if not toks:
		return []
	out = []
	for u in pool_units:
		if toks.intersection(u.scan.get("defs") or []):
			out.append(u)
	return out

# ---------------------------------------------------------------------------
# Library resolution
#
# Two signals, and the closure hands over the better one for free.
#
#   includes   Cheap and available before compiling, which is when the -I
#              flags are needed. But including a header only proves that a
#              declaration was wanted, not that anything from the library is
#              called.
#
#   symbols    The external set left over from the closure is a direct
#              statement of what the program needs from outside the tree. If
#              SDL_Init is undefined then SDL_Init is genuinely called. This
#              is strictly better evidence, and it is what picks the -l flags.
#
# They are combined rather than ranked: includes propose and supply -I,
# symbols confirm or contradict. A library proposed by a header that no
# symbol needs is a header included out of habit -- fmake declines to link
# it and says so, which is a thing no other build system reports.
# ---------------------------------------------------------------------------

# Headers whose package cannot be worked out by looking at where they live,
# because they sit directly in /usr/include alongside everything else. Only
# the cases where the reverse lookup below is ambiguous need to be here.
