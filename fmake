class Lang:
	"""One source language: how to compile it and what its text means.

    A table rather than a pair of sets, because what varies between
    languages is more than a name. C and C++ differ by driver; assembly
    differs by whether the preprocessor runs at all, and therefore by who
    writes the depfile -- cpp does it for everything it preprocesses, and
    for a raw `.s' it is the assembler or nobody. Left as a boolean the
    third language had nowhere to put that, and the fourth would have had
    nowhere either.

    Nothing downstream of the object file needs to know any of this. Symbol
    closure reads `nm' output, so an assembled object joins a link set on
    exactly the terms a compiled one does, and section 3 needed no change
    to admit a language it had never heard of.
    """
	__slots__ = ("name", "tag", "cxx", "cpp", "dep_via_as", "unit")

	def __init__(self, name, tag, cxx=False, cpp=True, dep_via_as=False,
	             unit="object"):
		self.name = name              # what to call it in a message
		self.tag  = tag               # the progress column, three wide
		self.cxx  = cxx               # $CXX rather than $CC, and c++ to link
		self.cpp  = cpp               # the preprocessor runs, so #include means something
		self.dep_via_as = dep_via_as  # gas writes the depfile, cpp having not run
		# What one unit of this language is. "object": a file becomes an
		# object, which every language here assumed until Rust. "crate": a
		# root file plus the files it draws in become one artifact, and the
		# members are never compiled on their own. Section 127 predicted
		# this would be a second unit kind and not a fifth row; it is both,
		# because the row is where the unit kind has anywhere to live.
		self.unit = unit

	def dep_flags(self, dep, phony=False):
		"""Flags that make this language's compiler write `dep'.

        `-MP' emits a phony target per prerequisite so a deleted header does
        not wedge Make. gas has no equivalent, which costs nothing: the
        assembler's prerequisites are `.include' files, and a Makefile that
        loses one reports it the ordinary way.
        """
		if self.dep_via_as:
			return ["-Wa,--MD," + dep]
		return ["-MD", "-MP", "-MF", dep] if phony else ["-MD", "-MF", dep]

	@property
	def rule(self):
		"""The ninja rule name this language compiles under."""
		if self.unit == "crate":
			return "rustc"
		return "cxx" if self.cxx else ("as" if self.dep_via_as else "cc")


