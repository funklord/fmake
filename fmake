def _expand_sources(patterns, root, proj, who):
	"""Resolve a [target.*] sources list to tree-relative files."""
	out = []
	for pat in patterns:
		hits = sorted(glob.glob(os.path.join(root, pat), recursive=True))
		rels = [os.path.relpath(h, root) for h in hits]
		rels = [r for r in rels if r in proj.src_set]
		if not rels:
			die(f"{CONF_FILE}: [target.{who}] sources {pat!r} matched no "
			    f"source file (excluded ones do not count)")
		out += [r for r in rels if r not in out]
	return out


# Directory names that say "sources live here" rather than naming anything.
GENERIC_SRC_DIRS = {"src", "srcs", "source", "sources", "app", "apps",
                    "cmd", "prog", "programs", "code"}


def default_name(rel, root):
	"""What to call the artifact a file roots, absent @target.

    main.c is named after its directory, since "main" names nothing. But
    src/main.cpp must not produce a binary called `src`: that is not a name,
    and writing it into the project root collides with the directory it came
    from. Conventional source-directory names are skipped in favour of
    whatever encloses them, ending at the project's own name.
    """
	stem = os.path.splitext(os.path.basename(rel))[0]
	if stem != "main":
		return stem
	d = os.path.dirname(rel)
	while d:
		base = os.path.basename(d)
		if base.lower() not in GENERIC_SRC_DIRS:
			return base
		d = os.path.dirname(d)
	return os.path.basename(os.path.abspath(root)) or "a.out"


TEST_DIRS = {"test", "tests"}


def looks_like_a_test(rel):
	"""Why this file roots a test program, or None.

    Two conventions, both named by the projects that asked for this: a
    directory called `test` or `tests`, and a file called `foo_test.c` or
    `test_foo.c`. Nothing else -- a guess that a program is a test costs it
    its place in the default build, which is a worse failure than the one
    this feature exists to fix, so the net is deliberately narrow and the
    reason is reported rather than assumed.
    """
	parts = rel.replace(os.sep, "/").split("/")
	for p in parts[:-1]:
		if p.lower() in TEST_DIRS:
			return f"{p}/ is a test directory"
	stem = os.path.splitext(parts[-1])[0].lower()
	if stem.startswith("test_") or stem.endswith(("_test", "_tests")):
		return f"{parts[-1]} is named as a test"
	return None


DEFAULT_TEST_GROUP = "test"

RE_TEST_GROUP = re.compile(r"^[a-z][a-z0-9_-]*$")


def _ann_test(ann, rel=""):
	"""What `@test` said: None if absent, False if no, else a group name.

    A group is how a tree separates tests that differ in what they need
    rather than in what they check. hydra has 66 test programs of which 26
    are live drivers wanting a network, and a directory name cannot say
    which is which -- `tests/` holds both, correctly, because both are
    tests.

    Present with no argument means the default group, which is how anyone
    writes it when there is only one.
    """
	if "test" not in ann.raw:
		return None
	# One word, because the scalar form takes the first and would drop the
	# rest -- so `@test Live Drivers` would quietly become the group `live`.
	# A directive whose whole purpose is to classify must not classify
	# differently from how it reads.
	line, args = ann.raw["test"][-1]
	if len(args) > 1:
		die(f"{rel}:{line}: @test {' '.join(args)} takes one word: a group "
		    f"name, or `no`")
	value = str(ann.scalar("test", "yes")).lower()
	if value in ("no", "false", "0"):
		return False
	if value in ("yes", "true", "1"):
		return DEFAULT_TEST_GROUP
	return value


class Target:
	"""One artifact: what roots it, what it is called, and what kind it is."""

	__slots__ = ("rel", "name", "kind", "ann", "conf", "members",
	             "test_group", "test_why")

	def __init__(self, rel, root, ann, conf=None):
		self.rel  = rel
		self.ann  = ann
		self.kind = ann.scalar("kind", "exe")
		self.name = ann.scalar("target") or default_name(rel, root)
		self.conf = {}
		# Explicit membership, when fmake.toml gives it. This is the answer
		# to two libraries built from one overlapping tree: the closure
		# cannot separate them, because nothing in the source says which
		# file belongs to which, and that is a fact about the project rather
		# than about any file in it.
		self.members = None
		# A role, not a kind. A test is still an ordinary exe -- what
		# changes is only whether a plain build produces it.
		said = _ann_test(ann, rel)
		found = looks_like_a_test(rel) if rel else None
		if said is False:
			self.test_group, self.test_why = None, ""
		elif said:
			self.test_group, self.test_why = said, f"@test in {rel}"
		elif found:
			self.test_group, self.test_why = DEFAULT_TEST_GROUP, found
		else:
			self.test_group, self.test_why = None, ""
		self.apply_conf(conf or {})

	def apply_conf(self, section):
		"""fmake.toml sits above annotations, so it overrides them."""
		if not section:
			return
		self.conf = section
		self.kind = section.get("kind", self.kind)
		self.name = section.get("target", section.get("name", self.name))
		if "test" in section:
			on = bool(section["test"])
			self.test_group = DEFAULT_TEST_GROUP if on else None
			self.test_why = f"[target.*] test = {str(on).lower()}"
		if section.get("test-group"):
			self.test_group = section["test-group"]
			self.test_why = f"[target.*] test-group = {self.test_group!r}"
		if section.get("sources"):
			self.members = list(section["sources"])

	@property
	def test(self):
		"""Whether a plain build skips this, whatever group it is in."""
		return self.test_group is not None

	@property
	def filename(self):
		if self.kind == "shared":
			return "lib%s.so" % self.name
		if self.kind == "static":
			return "lib%s.a" % self.name
		return self.name


def link_cmd(t, cl, cfg, outdir, libflags=()):
	"""The exact command that produces this artifact.

    One implementation, used both to link and to report. Two would drift, and
    a drifted --explain is worse than none: principle 4 is that every decision
    is inspectable, which is only true if what is shown is what is run.
    """
	objs = [u.obj for u in cl.link if not u.archive]
	out = os.path.join(outdir, t.filename)
	# A shared library says its own name, because otherwise the consumer
	# decides it. Without DT_SONAME the linker records whatever it was given:
	# `-lgreet` leaves the bare name and works, but linking the file by path
	# -- which is what CMake does by default, and what any DESTDIR staging
	# flow produces -- records that absolute path, so the program breaks the
	# moment the library is installed where it actually belongs, and no
	# LD_LIBRARY_PATH can repair an absolute DT_NEEDED.
	if t.kind == "static":
		# An archive is assembled, not linked: no libraries, no entry point.
		# Whatever it leaves undefined is the consumer's problem to resolve.
		# A vendored archive is left out rather than nested inside this one,
		# which `ar` would happily do and no linker would then understand.
		return [cfg.ar, "rcs", out] + objs
	cxx = any(u.cxx for u in cl.link)
	# Resolved libraries first, then whatever the user named, so an explicit
	# --ldflags always has the last word.
	return ([cfg.driver(cxx)]
	        + (["-shared", "-Wl,-soname," + t.filename]
	           if t.kind == "shared" else [])
	        + ["-o", out] + objs + archive_flags(cl)
	        + list(libflags) + cfg.ldflags)


def archive_flags(cl):
	"""Vendored archives, placed where a static archive has to go.

    After every object, because ld resolves left to right and an archive is
    searched only for what is undefined at the point it is reached -- listed
    first it contributes nothing at all. More than one gets a group, which
    makes the order among them irrelevant and is the only thing that resolves
    a cycle between two archives without naming one of them twice.
    """
	arcs = [u.obj for u in cl.link if u.archive]
	if len(arcs) < 2:
		return arcs
	return ["-Wl,--start-group"] + arcs + ["-Wl,--end-group"]


def link_target(t, cl, cfg, outdir, dry_run, libflags=(), cache=None,
                root=None, quiet=False):
	name, objs = t.filename, [u.obj for u in cl.link]
	out = os.path.join(outdir, name)
	cmd = link_cmd(t, cl, cfg, outdir, libflags)

	# `-o dist` names somewhere to put the artifacts, not somewhere that must
	# already exist. Without this the linker fails with "cannot open output
	# file", which says nothing about the directory being the problem.
	if not dry_run:
		os.makedirs(os.path.dirname(out) or ".", exist_ok=True)

	if dry_run:
		print(" ".join(cmd))
		return out, True, True

	# The whole command, plus the contents of everything it consumes. Object
	# mtimes alone miss every change that is not a recompile -- a different
	# library resolved, a --wrap added, an explicit --ldflags -- and the
	# binary is then silently left as it was. Same rule as objects: if the
	# inputs and the invocation are unchanged, the output is too.
	key = None
	if cache is not None and root is not None:
		parts = list(cmd)
		for o in objs:
			parts.append(cache.hash_of(o, os.path.relpath(o, root)) or "?")
		key = sha("|".join(parts))
		store = cache.data.setdefault("links", {})
		if store.get(name) == key and os.path.exists(out):
			vinfo(f"up to date {name}")
			return out, False, True

	if t.kind == "static" and os.path.exists(out):
		os.remove(out)          # ar appends; a stale member would survive
	if not quiet:
		say(f"{GREEN('AR ' if t.kind == 'static' else 'LD ')} {BOLD(name)}")
	r = subprocess.run(cmd, capture_output=True, text=True)
	if r.stderr.strip():
		# A missing library produces one linker line per call site, which
		# buries everything else. fmake already knows the unresolved symbols
		# and reports them itself, so the raw spew is truncated.
		lines = r.stderr.rstrip().splitlines()
		if VERBOSE or len(lines) <= LINK_ERR_LINES:
			PROGRESS.write(r.stderr)
		else:
			PROGRESS.write("\n".join(lines[:LINK_ERR_LINES]) + "\n")
			note(f"... {len(lines) - LINK_ERR_LINES} more linker lines (-v "
			     f"for all)")
	if key is not None and r.returncode == 0:
		cache.data.setdefault("links", {})[name] = key
	return out, True, r.returncode == 0

