RE_ROFF_DASH = re.compile(r"(^|\s)-")


def _roff(s):
	"""Escape text for roff.

    Backslashes, a leading dot or quote -- which would start a macro -- and
    the hyphens that begin an option, which roff would otherwise typeset as
    a hyphenation point rather than the minus a reader is meant to type.
    """
	s = s.replace("\\", "\\e")
	s = RE_ROFF_DASH.sub(lambda m: m.group(1) + "\\-", s)
	return "\\&" + s if s.startswith((".", "'")) else s


def completion_script(parser):
	"""A bash completion, built from the parser that defines the options.

    Generated for the same reason the manual page is: a second list of flags
    is a list that goes stale, and a completion is exactly where nobody
    would notice -- a stale one offers a flag that no longer exists and
    omits the one you wanted, and neither is an error.

    Options with a fixed set of values complete to those values. Everything
    else falls back to filenames, which is right for a tool whose arguments
    are targets, directories and source files.
    """
	opts, choices = [], []
	for act in parser._actions:
		if not act.option_strings:
			continue
		opts += act.option_strings
		if act.choices:
			for flag in act.option_strings:
				choices.append((flag, " ".join(str(c) for c in act.choices)))
	body = ["# Generated by `fmake --completion bash`.",
	        "#",
	        "# Built from the parser that defines the options, so it cannot",
	        "# offer a flag fmake does not accept. Re-generate it when fmake",
	        "# changes; the packaged copy is written at build time.",
	        "_fmake() {",
	        "\tlocal cur prev",
	        '\tcur="${COMP_WORDS[COMP_CWORD]}"',
	        '\tprev="${COMP_WORDS[COMP_CWORD-1]}"',
	        "",
	        "\tcase \"$prev\" in"]
	for flag, values in choices:
		body += [f"\t{flag})",
		         f'\t\tCOMPREPLY=($(compgen -W "{values}" -- "$cur"))',
		         "\t\treturn",
		         "\t\t;;"]
	body += ["\tesac",
	         "",
	         '\tif [[ "$cur" == -* ]]; then',
	         f'\t\tCOMPREPLY=($(compgen -W "{" ".join(sorted(set(opts)))}" '
	         '-- "$cur"))',
	         "\telse",
	         '\t\tCOMPREPLY=($(compgen -f -- "$cur"))',
	         "\tfi",
	         "}",
	         "complete -F _fmake fmake"]
	return "\n".join(body) + "\n"


def man_page(parser):
	"""The manual page, built from the parser that defines the options.

    Written here rather than kept as a file for the same reason
    --doxygen-aliases exists: a second copy of the option list is a copy that
    goes stale, and the packaging is exactly where nobody would notice. Every
    flag below is the one argparse will accept, because it is the one
    argparse was given.
    """
	out = [f'.TH FMAKE 1 "" "fmake {VERSION}" "User Commands"',
	       ".SH NAME", "fmake \\- build C, C++, assembly and Rust programs with no build file",
	       ".SH SYNOPSIS", ".B fmake",
	       ".RI [ options ]",
	       ".RI [ targets ]",
	       ".SH DESCRIPTION",
	       _roff("fmake works out what to build by reading the source. "
	             "A translation unit defining main() at file scope is a "
	             "program, named after the file, or after its directory when "
	             "the file is main.c."),
	       ".PP",
	       _roff("The link set is not guessed. Objects are compiled, their "
	             "symbol tables read with nm, and the link set is the "
	             "transitive closure from the root's object over undefined "
	             "symbols -- the same computation the linker performs when "
	             "deciding which members to pull out of an archive."),
	       ".PP",
	       _roff("Libraries are chosen the same way. An undefined SDL_Init "
	             "proves SDL is called; including SDL.h only proves a "
	             "declaration was wanted. Includes supply the -I flags, "
	             "symbols decide the -l flags."),
	       ".PP",
	       _roff("Run fmake --explain to see every decision and the evidence "
	             "for it, down to the command line."),
	       ".SH OPTIONS"]

	for act in parser._actions:
		if not act.option_strings:
			continue
		names = ", ".join("\\fB" + o.replace("-", "\\-") + "\\fR"
		                  for o in act.option_strings)
		if act.metavar:
			names += " \\fI" + _roff(str(act.metavar)) + "\\fR"
		elif act.nargs != 0 and act.dest != "help":
			names += " \\fI" + act.dest.upper() + "\\fR"
		out.append(".TP")
		out.append(names)
		out.append(_roff(" ".join((act.help or "").split())))

	out += [".SH FILES", ".TP", "\\fBfmake.mk\\fR",
	        _roff("Build rules in Makefile syntax, and flags for the whole "
	              "project."),
	        ".TP", "\\fBfmake.toml\\fR",
	        _roff("The facts that belong to no single file: targets, "
	              "profiles, install paths, toolchains."),
	        ".TP", "\\fB.fmake/\\fR",
	        _roff("Cache, objects and generated sources. Removed by "
	              "--clean; safe to delete."),
	        ".SH EXAMPLES", ".TP", "\\fBfmake\\fR",
	        _roff("Build every program in this tree."),
	        ".TP", "\\fBfmake \\-\\-explain\\fR",
	        _roff("Print what it would do and why, and stop."),
	        ".TP", "\\fBfmake \\-\\-eject > Makefile\\fR",
	        _roff("Write a standalone build file and stop needing fmake."),
	        ".SH ENVIRONMENT",
	        _roff("CC, CXX, AR, NM, CFLAGS and LDFLAGS are honoured and take "
	              "precedence over fmake.toml. MOC, UIC and RCC name Qt's "
	              "tools when the ones pkg-config reports are not wanted."),
	        ".SH EXIT STATUS",
	        _roff("Zero when everything asked for was built. Non-zero when a "
	              "file did not compile, a target did not link, or the tree "
	              "could not be understood."),
	        ".SH AUTHOR", _roff(AUTHOR),
	        ".SH COPYRIGHT", _roff(COPYRIGHT + "."),
	        _roff("Licensed under " + LICENCE + "."),
	        ".SH SEE ALSO",
	        ".BR make (1),",
	        ".BR ninja (1),",
	        ".BR pkg-config (1)"]
	return "\n".join(out) + "\n"


def doxygen_aliases():
	"""An ALIASES block, so Doxygen renders the directives instead of
    warning about unknown commands."""
	out = [
	    "# fmake directives, for Doxygen.",
	    "#",
	    "# Save as fmake.doxygen-aliases and add to your Doxyfile:",
	    "#     @INCLUDE = fmake.doxygen-aliases",
	    "#",
	    "# Without this, Doxygen reports each directive as an unknown command.",
	    "",
	]
	for name in sorted(DIRECTIVES):
		label = DOXYGEN_ALIAS_TEXT.get(name, name)
		out.append(f'ALIASES += "{name}=\\par {label}:\\n"')
	return "\n".join(out) + "\n"

# ---------------------------------------------------------------------------
# Tree walk
# ---------------------------------------------------------------------------

def _walk(root):
	"""os.walk, following symlinked directories exactly once each.

    Not following them means a tree laid out as `src/common -> ../shared` --
    which is how a pair of sibling projects usually share code -- is missing
    that whole subtree, and says nothing about it: the build fails much later
    on an undefined symbol, with no hint that a directory was skipped.

    Following them needs the cycle guard, because a link pointing at an
    ancestor makes os.walk descend forever. Keyed on the real path, so two
    links to one directory are walked once rather than producing two names
    for every file in it -- which would be two definitions of every symbol,
    and section 3 refusing to choose between them.
    """
	seen = set()
	for dirpath, dirnames, filenames in os.walk(root, followlinks=True):
		real = os.path.realpath(dirpath)
		if real in seen:
			dirnames[:] = []
			continue
		seen.add(real)
		# Sorted, and it is not cosmetic. When a directory is reachable
		# twice -- once directly and once through a link -- the guard above
		# keeps whichever the walk reached *first*, and os.walk descends in
		# readdir order, which is the filesystem's hash order and differs
		# between machines. So the same tree gave its files different names
		# on different machines: a different `exclude' match, a different
		# object path, and a different ejected build file. Section 12 claims
		# that file is byte-stable, and for a tree with a linked directory
		# in it that was true only per-machine.
		#
		# Sorting does not make the choice principled -- it is still the
		# first name in walk order -- but it makes it the same everywhere,
		# which is the part anybody can rely on.
		dirnames[:] = sorted(d for d in dirnames
		                     if d not in SKIP_DIRS and not d.startswith("."))
		yield dirpath, dirnames, filenames


def run_root(path):
	"""Where to build a `--run` script, and whether its siblings come too.

    Beside the script when that directory is writable: its siblings are then
    in the tree, so a script that grew into several files keeps working, and
    the cache lives next to what it caches.

    A script in a directory nobody may write to -- installed in
    /usr/local/bin, or a checkout mounted read-only -- would otherwise not
    run at all, which is the one place a scripting front end has to work. So
    it falls back to a cache of its own, keyed on the script's path, and
    builds the file alone.
    """
	here = os.path.dirname(os.path.abspath(path)) or "."
	if os.access(here, os.W_OK):
		return here, True
	base = (os.environ.get("XDG_CACHE_HOME")
	        or os.path.join(os.path.expanduser("~"), ".cache"))
	return os.path.join(base, "fmake", "run",
	                    sha(os.path.abspath(path))[:16]), False


def stage_run_source(root, path, alone=False):
	"""The source to build for `--run`, and the target it roots.

    A shebang is not C: gcc rejects `#!` on line 1 as an invalid
    preprocessing directive, and so does g++, and no compiler here has a
    flag to overlook it. So a file that carries one is compiled from a copy
    with that line replaced -- by a `#line` directive rather than by a
    blank, so every diagnostic still names the original file and the right
    line number.

    `alone` is the read-only case: the copy is the whole tree, so it is made
    whether or not there is a shebang to remove.
    """
	try:
		with open(path, "rb") as fh:
			first = fh.readline()
	except OSError as exc:
		die(f"--run: {exc}")
	if not alone:
		rel = os.path.relpath(os.path.abspath(path), root)
		if not first.startswith(b"#!"):
			return rel
	staged = (os.path.basename(path) if alone
	          else os.path.join(RUN_DIR, os.path.basename(path)))
	full = os.path.join(root, staged)
	os.makedirs(os.path.dirname(full) or root, exist_ok=True)
	with open(path, "rb") as fh:
		body = fh.read()
	cut = (body.index(b"\n") + 1 if first.startswith(b"#!") and b"\n" in body
	       else 0)
	# The path is quoted for the compiler, so a quote or backslash in it
	# would end the directive early and take the rest of the line with it.
	shown = os.path.abspath(path).replace("\\", "\\\\").replace('"', '\\"')
	head = (f'#line 2 "{shown}"\n'.encode() if cut else
	        f'#line 1 "{shown}"\n'.encode())
	new = head + body[cut:]
	if not os.path.exists(full) or open(full, "rb").read() != new:
		with open(full, "wb") as fh:
			fh.write(new)
	return staged


def walk_tree(root):
	"""Return (sources, headers) as root-relative paths."""
	srcs, hdrs = [], []
	for dirpath, dirnames, filenames in _walk(root):
		for f in filenames:
			ext = os.path.splitext(f)[1]
			if ext not in SRC_EXTS and ext not in HDR_EXTS:
				continue
			path = os.path.join(dirpath, f)
			# os.walk lists everything that is not a directory, and a
			# source extension on something that is not a file does not
			# make it one. Both of the ways that goes wrong are hangs
			# rather than errors, which is why this is a guard and not a
			# tidiness: reading a FIFO blocks until somebody writes to it,
			# and a device like /dev/zero never stops producing. fmake read
			# whatever it found, so either one meant a build that never
			# returned and never said why.
			#
			# isfile() follows symlinks, so a symlinked source still
			# builds, which trees do rely on.
			#
			# The exists() half is what keeps a *dangling* symlink out of
			# this: it is a broken link rather than a thing that is not a
			# file, which is somebody's mistake and is reported downstream
			# by name. Dropping it silently here looked like the same
			# case and is not, and the suite said so -- odd_trees_do_not_
			# crash exists because a dangling link once raised KeyError,
			# and it requires the report that replaced the crash.
			if os.path.exists(path) and not os.path.isfile(path):
				vinfo(f"{os.path.relpath(path, root)} is not a regular "
				      f"file; not treating it as source")
				continue
			rel = os.path.relpath(path, root)
			if ext in SRC_EXTS:
				srcs.append(rel)
			else:
				hdrs.append(rel)
	return sorted(srcs), sorted(hdrs)


def vendored_dirs(root, srcs):
	"""Subtrees that are a checkout of some other project.

    Two signals, and neither is a guess: `.gitmodules` is this repository
    stating that a path belongs to someone else, and a `.git` inside a
    subdirectory is git having put a checkout there. A tree merely copied in
    carries neither and is indistinguishable from the project's own code,
    which is the right answer -- nobody tracked it separately, so nothing
    says it is separate.

    Only directories that lead to a source are examined, so this costs a
    handful of stat calls rather than a second walk, and a vendored tree
    with nothing to compile in it does not need naming.
    """
	out, seen = set(), set()
	gm = os.path.join(root, ".gitmodules")
	if os.path.isfile(gm):
		try:
			with open(gm, encoding="utf-8", errors="replace") as f:
				text = f.read()
		except OSError:
			text = ""
		for m in re.finditer(r"(?m)^[ \t]*path[ \t]*=[ \t]*(.+?)[ \t]*$", text):
			p = m.group(1).strip().strip('"').strip("/")
			# A path out of the tree is not ours to reason about, and an
			# absolute one is not a subtree at all.
			if p and not p.startswith("/") and ".." not in p.split("/"):
				out.add(os.path.normpath(p))
	for rel in srcs:
		d = os.path.dirname(rel)
		while d and d not in seen:
			seen.add(d)
			if os.path.exists(os.path.join(root, d, ".git")):
				out.add(d)
			d = os.path.dirname(d)
	return out


def vendor_of(rel, dirs):
	"""The vendored subtree this file is in, or None.

    Nearest first, so a submodule inside a submodule is attributed to the
    one that actually contains the file.
    """
	if not dirs:
		return None
	d = os.path.dirname(rel)
	while d:
		if d in dirs:
			return d
		d = os.path.dirname(d)
	return None


def _mod_dir(rel):
	"""Where a file's `mod' declarations look for their members.

    Rust's rule, and it is a rule about the file's own name rather than
    about where it sits: a crate root or a `mod.rs' owns the directory it
    is in, and any other module file owns a subdirectory named after
    itself. Getting this wrong does not fail loudly -- the member is simply
    not found, and the crate builds from fewer files than it has.
    """
	d, base = os.path.dirname(rel), os.path.basename(rel)
	stem = os.path.splitext(base)[0]
	if base in CRATE_ROOTS or base == "mod.rs":
		return d
	return os.path.join(d, stem) if d else stem


def crate_plan(root, srcs, scans):
	"""Crate roots, what each draws in, and the .rs files nothing reaches.

    Returns (crates, owner, orphans). `crates' maps a root to its member
    list with the root first; `owner' maps every member back to its root;
    `orphans' is every crate-language file no root reached.

    The whole reason this exists is section 127's finding: `rustc' is handed
    one file and reads the rest itself, so a member is not a translation
    unit. Treating each .rs as a unit compiles a module on its own, which
    is an error rather than a piece of a program.
    """
	have = set(srcs)
	roots = [r for r in srcs
	         if os.path.splitext(r)[1] in CRATE_EXTS
	         and os.path.basename(r) in CRATE_ROOTS]

	def expand(start):
		members, order = {start}, [start]
		queue = [start]
		while queue:
			cur = queue.pop(0)
			base = _mod_dir(cur)
			for name, explicit in (scans.get(cur, {}).get("mods") or []):
				if explicit:
					cands = [os.path.normpath(os.path.join(base, explicit))]
				else:
					cands = [os.path.normpath(os.path.join(base, name + ".rs")),
					         os.path.normpath(os.path.join(base, name,
					                                       "mod.rs"))]
				for c in cands:
					if c in have and c not in members:
						members.add(c)
						order.append(c)
						queue.append(c)
						break
		return order

	crates = {r: expand(r) for r in roots}
	# A root drawn in by another crate is a module, not a root. `#[path]'
	# can name any file, so this is reachable rather than theoretical, and
	# a file compiled as both a crate and a module of one is two copies of
	# every symbol in it.
	drawn = {m for r, ms in crates.items() for m in ms[1:]}
	for r in list(crates):
		if r in drawn:
			del crates[r]

	owner, shared = {}, {}
	for r, ms in crates.items():
		for m in ms:
			if m in owner and m != r:
				shared.setdefault(m, [owner[m]]).append(r)
			owner.setdefault(m, r)
	# Two crates holding one file is section 3's ambiguity in another
	# language: nothing in the tree says which crate the file belongs to,
	# and compiling it into both duplicates every symbol it defines.
	for m in sorted(shared):
		die(f"{m} is a module of more than one crate: "
		    f"{', '.join(sorted(shared[m]))}\n"
		    f"A file can belong to one crate. Move it, or draw it in from "
		    f"one root and re-export it from there.")

	orphans = [r for r in srcs
	           if os.path.splitext(r)[1] in CRATE_EXTS and r not in owner]
	return crates, owner, orphans


def is_cxx(rel):
	return os.path.splitext(rel)[1] in CXX_EXTS

# ---------------------------------------------------------------------------
# Include resolution and candidate sets
#
# This produces a *guess* at what is worth compiling. Being wrong here costs
# extra compilation or a widening pass, never a wrong link set.
# ---------------------------------------------------------------------------

# Headers the toolchain owns. A tree that happens to contain a file with
# one of these names must not have it stand in for the system's: fmake
# resolves an unmatched include by basename when exactly one file in the
# tree has that name, which is a useful guess for a vendored <vterm.h> and
# a catastrophic one for <stdint.h>.
#
# fuzzypickles vendors thorvg, which vendors rapidjson, which ships an
# MSVC-only stdint.h. That was the only stdint.h in the tree, so it won the
# basename match, its directory went on the include path for every compile,
# and 54 files failed on `#error "Use this header only with Microsoft
# Visual C++ compilers!"` -- including moc output with no connection to
# thorvg. One vendored file four levels down redefined a standard header
# for the whole build.
STANDARD_HEADERS = frozenset("""
assert.h complex.h ctype.h errno.h fenv.h float.h inttypes.h iso646.h
limits.h locale.h math.h setjmp.h signal.h stdalign.h stdarg.h stdatomic.h
stdbit.h stdbool.h stdckdint.h stddef.h stdint.h stdio.h stdlib.h
stdnoreturn.h string.h tgmath.h threads.h time.h uchar.h wchar.h wctype.h
""".split())


class Project:
	def __init__(self, root, srcs, hdrs, scans):
		self.root  = root
		self.srcs  = srcs
		self.hdrs  = hdrs
		self.scans = scans
		# basename -> [relative header paths], for unqualified include lookup
		self.hdr_by_name = {}
		for h in hdrs:
			self.hdr_by_name.setdefault(os.path.basename(h), []).append(h)
		# header stem -> sibling source with the same stem, if any
		self.src_set = set(srcs)
		self.src_by_stem = {}
		for s_ in srcs:
			self.src_by_stem.setdefault(
			    os.path.basename(os.path.splitext(s_)[0]), []).append(s_)
		self.incdirs = set()

	def incdir_for(self, resolved, inc_name):
		return include_root_for(resolved, inc_name)

	def resolve_header(self, inc_name, from_rel):
		"""Resolve an include to a tree-relative header path, or None."""
		inc_name = inc_name.replace(os.sep, "/")
		base = os.path.dirname(from_rel)
		cand = os.path.normpath(os.path.join(base, inc_name))
		if cand in self.hdr_by_name.get(os.path.basename(cand), []) or \
		   os.path.isfile(os.path.join(self.root, cand)):
			self.incdirs.add(self.incdir_for(cand, inc_name))
			return cand
		cand = os.path.normpath(inc_name)
		if os.path.isfile(os.path.join(self.root, cand)):
			self.incdirs.add(".")
			return cand
		# The basename fallback is a guess, and it must not be made about a
		# name the toolchain owns. See STANDARD_HEADERS.
		if os.path.basename(inc_name) in STANDARD_HEADERS:
			return None
		matches = self.hdr_by_name.get(os.path.basename(inc_name), [])
		if len(matches) == 1:
			self.incdirs.add(self.incdir_for(matches[0], inc_name))
			return matches[0]
		return None

	def reachable_headers(self, rels):
		"""Tree headers reachable by include from these files."""
		seen, queue = set(), list(rels)
		while queue:
			cur = queue.pop()
			scan = self.scans.get(cur)
			if not scan:
				continue
			for _kind, name, _line in scan["incs"]:
				h = self.resolve_header(name, cur)
				if h and h not in seen:
					seen.add(h)
					queue.append(h)
		return seen

	def sibling_source(self, hdr_rel):
		"""The source that probably implements a header.

        A true sibling first -- foo.h next to foo.c. Failing that, a source
        with the same stem anywhere in the tree, because splitting headers
        into include/ and sources into src/ is one of the commonest C++
        layouts there is, and under a strict sibling rule the include graph
        finds nothing at all in such a project. Measured on a 292-file game:
        5 headers had a sibling, 256 had a same-stem source elsewhere.

        Ambiguity is left alone. Several sources sharing a stem says nothing
        about which one a header means, and compiling all of them could
        introduce duplicate definitions the closure would then refuse to
        resolve. Widening still finds the right one from the symbols.
        """
		stem = os.path.splitext(hdr_rel)[0]
		for ext in SRC_EXTS:
			if stem + ext in self.src_set:
				return stem + ext
		matches = self.src_by_stem.get(os.path.basename(stem), ())
		return matches[0] if len(matches) == 1 else None

	def candidates(self, root_src):
		"""Include-graph reachable TUs from a root. A guess, nothing more.

        Angle brackets are followed as well as quotes. Punctuation does not
        decide whether a header belongs to the project -- whether it resolves
        inside the tree does. Putting include/ on the -I path and writing
        <Bullet.h> is standard practice, and it is what CMake encourages; a
        quotes-only rule sees none of it. Measured on a 292-file game: 2342
        of its own headers were included with <> against 425 with "".

        A name that resolves to nothing in the tree is a system header, and
        falls through to library resolution untouched.
        """
		seen_h, out = set(), {root_src}
		queue = [root_src]
		while queue:
			cur = queue.pop()
			scan = self.scans.get(cur)
			if not scan:
				continue
			for _kind, name, _line in scan["incs"]:
				h = self.resolve_header(name, cur)
				if not h or h in seen_h:
					continue
				seen_h.add(h)
				# headers can include headers; follow those too
				queue.append(h)
				src = self.sibling_source(h)
				if src and src not in out:
					out.add(src)
					queue.append(src)
		return out

