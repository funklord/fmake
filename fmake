# ---------------------------------------------------------------------------

def _rel(path, root):
	"""Shorten absolute paths for display; commands stay copy-pasteable."""
	try:
		r = os.path.relpath(path, root)
	except ValueError:
		return path
	return path if r.startswith("..") else r


def _col(text, width):
	"""Left-justify into a column, but never let a long name touch its text.

	A generated moc path is longer than the column, and `:<{W}}` simply
	stops padding when it overflows -- so the filename and its explanation
	run together with no separator. On a Qt tree that is most of the
	report: one project counted 547 such lines.
	"""
	return text.ljust(width) if len(text) < width else text + " "


def _show_cmd(cmd, root):
	out = []
	for a in cmd:
		if os.path.isabs(a):
			out.append(_rel(a, root))
		elif a[:2] in ("-I", "-L") and os.path.isabs(a[2:]):
			out.append(a[:2] + _rel(a[2:], root))
		else:
			out.append(a)
	return " ".join(out)


def explain(t, cl, cfg, incflags, outdir, all_units, root, other_roots=(),
            res=None, excluded=None, conf=None, moc=None, uic=None,
            rcc=None):
	W = 36
	name = t.filename
	if t.conf.get("name") or t.conf.get("kind") or t.conf.get("sources"):
		named = f"[target.*] in {CONF_FILE}"
	elif t.ann.scalar("target"):
		named = "@target"
	else:
		named = "no @target"
	print(f"{BOLD('target')} {BOLD(name)} ({t.kind})  {DIM('[' + named + ']')}")

	# Where the kind came from, and -- when nothing said -- that something
	# could. A tree of library sources with one test beside it is the shape
	# a build system is most annoying for, and fmake builds it correctly
	# today: the library units link into the test and there is no archive,
	# which is right for that binary and not what the project ships. One
	# project declined over this without finding @kind, having read --help
	# and found nothing that says these translation units are a library.
	# The line costs nothing and is printed where the question is asked.
	if t.conf.get("kind"):
		how = f"[target.*] in {CONF_FILE} says so"
	elif t.ann.scalar("kind"):
		how = f"@kind in {t.rel}"
	elif t.kind == "exe":
		how = f"{t.rel} defines main(); @kind static builds an archive instead"
	else:
		how = "nothing here defines main()"
	print(f"  {_col(CYAN('kind'), W)}{DIM(f'{t.kind}: {how}')}")
	if t.test:
		role = (f"{t.test_why}; not built by default, "
		        f"`fmake {t.test_group}` builds and runs it")
		print(f"  {_col(CYAN('test'), W)}{DIM(role)}")

	if t.members is not None:
		print(f"  {_col(CYAN('membership'), W)}"
		      f"{DIM('declared, so the closure is not consulted')}")

	# Directives are reported per file, because an unknown one is ignored in
	# silence and this is the only place a typo becomes visible.
	seen = [(u.rel, u.ann) for u in cl.link if u.ann]
	if seen:
		print(f"  {CYAN('directives')}")
		for rel, ann in seen:
			for d in ann.names():
				# Read each directive the way it is declared, not uniformly.
				vals = (ann.scalar(d, "") if d in DIRECTIVE_SCALAR
				        else " ".join(ann.items(d))) or "(no arguments)"
				head = f"@{d} {vals}"
				if len(head) > W - 5:
					head = head[:W - 8] + "..."
				print(f"    {_col(head, W-4)}"
				      f"{DIM(rel + ':' + str(ann.line(d)))}")

	if conf:
		print(f"  {CYAN('configuration')}")
		print(f"    {_col(CONF_FILE, W-4)}"
		      f"{DIM('profile: ' + (conf.profile_name or 'none'))}")
		if cfg.os != host_os() or cfg.arch != host_arch():
			where = (cfg.os + "/" + cfg.arch + "  (host is "
			         + host_os() + "/" + host_arch() + ")")
			print(f"    {_col('building for', W-4)}{DIM(where)}")

	# Which moc, not just that one ran. Two Qt versions on one machine is
	# ordinary, their moc output is not interchangeable, and the failure when
	# the wrong one is picked is an undefined symbol that names none of this.
	if moc and moc.get("jobs"):
		n = len(moc["jobs"])
		print(f"  {CYAN('moc')}")
		print(f"    {_col(_rel(moc['exe'], root), W-4)}"
		      f"{DIM(f'{n} file(s) declare Q_OBJECT; found via pkg-config')}")
	if uic and uic.get("jobs"):
		n = len(uic["jobs"])
		print(f"  {CYAN('uic')}")
		print(f"    {_col(_rel(uic['exe'], root), W-4)}"
		      f"{DIM(f'{n} ui_*.h header(s) included; found via pkg-config')}")
	if rcc and rcc.get("jobs"):
		linked = {u.rel for u in cl.link}
		print(f"  {CYAN('resources')}")
		for j in rcc["jobs"]:
			why = next((f"{w} in {f}" for f, w in sorted(j["users"].items())),
			           "")
			mark = why if j["out"] in linked else "not opened by this program"
			print(f"    {_col(j['src'], W-4)}{DIM(mark)}")

	if excluded:
		print(f"  {CYAN('excluded here')}")
		for rel, why in sorted(excluded.items()):
			print(f"    {_col(rel, W-4)}{DIM(why)}")
	if t.members is not None:
		how = f"[declared in {CONF_FILE}]"
	elif t.kind != "exe":
		how = "[every TU in the tree; a library is not pruned]"
	else:
		how = "[symbol closure from " + _rel(cl.root.obj, root) + "]"
	print(f"  {_col(CYAN('link set'), W)}{DIM(how)}")
	for u in cl.link:
		if u is cl.root and t.kind == "exe":
			print(f"    {_col(u.rel, W-4)}{DIM('root: defines main()')}")
		elif u is cl.root:
			print(f"    {_col(u.rel, W-4)}{DIM('part of the library')}")
		else:
			sym, by = cl.why.get(u.rel, ("?", "?"))
			why = sym if not by else f"<- {sym}  ({by})"
			print(f"    {_col(u.rel, W-4)}{DIM(why)}")

	# Other programs' roots are compiled but obviously not part of this one;
	# listing them as unreachable reads like a problem when it isn't.
	linked = {u.rel for u in cl.link}
	spare = [u for u in all_units
	         if u.rel not in linked and u.rel not in other_roots]
	if spare:
		print(f"  {CYAN('compiled, not linked')}")
		for u in spare:
			print(f"    {_col(u.rel, W-4)}{DIM('defines nothing reachable')}")

	if res and (res["chosen"] or res["unresolved"] or res["unused"]):
		print(f"  {_col(CYAN('libraries'), W)}"
		      f"{DIM('[from the external symbols above]')}")
		for lib in res["chosen"]:
			syms = res["why"].get(lib, [])
			shown = ", ".join(syms[:3]) + (" ..." if len(syms) > 3 else "")
			src = res["proposed"].get(lib)
			tag = f"[also {src[2]} at {src[1]}]" if src else ""
			print(f"    -l{lib:<{W-6}}{DIM(shown)}")
			if tag:
				print(f"    {_col('', W-4)}{DIM(tag)}")
			for alt in res["alts"].get(lib, [])[:3]:
				print(f"    {_col('', W-4)}{DIM('could also come from -l' + alt)}")
		for lib, (module, where, header) in sorted(res["unused"].items()):
			if lib in res.get("compiled_away", {}):
				why = (f"{header} at {where} suggests {module}, but the "
				       f"preprocessor never opened it")
			else:
				why = (f"{header} at {where} suggests {module}, but no "
				       f"symbol needs it")
			print(f"    {_col('(not linked)', W-4)}{DIM(why)}")
		for lib in res.get("declared", []):
			print(f"    {_col('-l' + lib, W-4)}"
			      f"{DIM('declared with @libs / @pkg; linked regardless')}")
		for w in res.get("wrap", []):
			print(f"    {_col('-Wl,--wrap=' + w, W-4)}"
			      f"{DIM('the link set defines __wrap_' + w)}")
		if res["unresolved"]:
			print(f"    {_col('(unresolved)', W-4)}"
			      f"{DIM(', '.join(res['unresolved'][:6]))}")
			says = ("no " + describe_identity(res.get("ident"))
			        + " library exports these -- name it with --ldflags")
			print(f"    {_col('', W-4)}{DIM(says)}")

	if VERBOSE:
		print(f"  {_col(CYAN('library search'), W)}"
		      f"{DIM(describe_identity((res or {}).get('ident')) + ' only')}")
		for d in cfg.libdirs:
			shown = os.path.normpath(_rel(d, root))
			if len(shown) > W - 5:
				shown = "..." + shown[-(W - 8):]
			print(f"    {_col(shown, W-4)}"
			      f"{DIM(str(len(linkable_libs([d]))) + ' linkable')}")

	if cl.external:
		implicit = len(res["implicit"]) if res else 0
		named = sum(len(v) for v in (res["why"].values() if res else []))
		tally = (f"[{len(cl.external)} total, {implicit} in libc, "
		         f"{named} from the libraries above]")
		print(f"  {_col(CYAN('external symbols'), W)}{DIM(tally)}")
		for sym in sorted(cl.external)[:12]:
			print(f"    {_col(sym, W-4)}"
			      f"{DIM('referenced by ' + cl.external[sym][0])}")
		if len(cl.external) > 12:
			print(f"    {DIM('... and %d more (-v for all)' % (len(cl.external) - 12))}")

	ldflags = (res["ldflags"] if res else []) + cfg.ldflags
	print(f"  {CYAN('flags')}")
	print(f"    {' '.join(cfg.cflags + ['-I' + _rel(f[2:], root) if f.startswith('-I') else f for f in incflags] + cfg.override)}")
	if ldflags:
		print(f"    {' '.join(ldflags)}")
	print(f"  {CYAN('argv')}")
	# Prebuilt archives have no compile command to show, only a place on the
	# link line below.
	built = [u for u in cl.link if not u.archive]
	for u in built[:2]:
		print(f"    {DIM(_show_cmd(compile_cmd(u, cfg, incflags), root))}")
	if len(built) > 2:
		print(f"    {DIM('... %d more' % (len(built) - 2))}")
	# The same call the linker gets, not a second rendering of it.
	shown = link_cmd(t, cl, cfg, outdir, res["ldflags"] if res else [])
	print(f"    {DIM(_show_cmd(shown, root))}")
	print()

