_COLOR = sys.stdout.isatty() and os.environ.get("TERM") != "dumb" \
         and "NO_COLOR" not in os.environ

def _paint(code):
    return (lambda s: f"\033[{code}m{s}\033[0m") if _COLOR else (lambda s: str(s))

BOLD   = _paint("1")
DIM    = _paint("2")
RED    = _paint("31;1")
GREEN  = _paint("32;1")
YELLOW = _paint("33;1")
BLUE   = _paint("34;1")
