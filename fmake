# Toolchain & configuration
# ---------------------------------------------------------------------------

def tool_version(exe):
    try:
        r = subprocess.run([exe, "--version"], capture_output=True, text=True)
        return (r.stdout or r.stderr).splitlines()[0].strip()
    except (OSError, IndexError):
        return "?"


RE_TOOL_PREFIX = re.compile(r"^(.*-)(?:gcc|g\+\+|cc|c\+\+|clang(?:\+\+)?)"
                            r"(?:-\d+(?:\.\d+)*)?$")


def _tool_prefix(cc):
    """The target prefix a compiler name carries, or None.

    aarch64-linux-gnu-gcc -> "aarch64-linux-gnu-". Plain cc, gcc or clang
    carry none, which is the native case.
    """
    m = RE_TOOL_PREFIX.match(os.path.basename(cc))
    return m.group(1) if m else None


def find_nm(configured=None):
    for cand in (os.environ.get("NM"), configured, "nm", "llvm-nm", "gnm"):
        if cand and shutil.which(cand):
            return shutil.which(cand)
    die("no nm found. fmake reads object symbol tables to work out the "
        "link set; install binutils or llvm, or set $NM.")


class Config:
    def __init__(self, args, conf=None):
        conf = conf or Conf({})
        tool = conf.tool

        # $CC beats fmake.toml, per the precedence chain: the environment is
        # the outermost level, so a one-off cross build needs no edit.
        self.cc      = os.environ.get("CC")  or tool.get("cc", "cc")
        self.cxx     = os.environ.get("CXX") or tool.get("cxx", "c++")
        # aarch64-linux-gnu-gcc implies aarch64-linux-gnu-nm and -ar. Naming
        # the compiler should be enough; a host nm can often read foreign
        # objects, but relying on that is luck rather than design.
        self.prefix  = _tool_prefix(self.cc)
        self.triplet = _stdout([self.cc, "-print-multiarch"]).strip() \
                       or _stdout([self.cc, "-dumpmachine"]).strip()
        self.nm      = find_nm(tool.get("nm")
                               or self._prefixed("nm"))
        self.sysroot = tool.get("sysroot")

        # A cross build must test @os/@arch against the machine being built
        # *for*, not the one doing the building. Without this the host is
        # assumed, which is silently wrong for every cross compilation.
        self.os      = tool.get("os") or host_os()
        self.arch    = tool.get("arch") or host_arch()

        # Three bands, general to specific: defaults and fmake.toml, then
        # each file's own annotations, then the command line. Later wins at
        # the compiler, so the command line has to come last or --cflags -O0
        # cannot override a file that asked for -O2 -- which is exactly what
        # anyone reaching for the flag is trying to do.
        self.cflags   = ([] if args.cflags else list(DEFAULT_CFLAGS))
        self.cflags  += conf.cflags()
        self.override = list(args.cflags)
        self.ldflags = conf.ldflags() + list(args.ldflags)
        if self.sysroot:
            self.cflags.append("--sysroot=" + self.sysroot)
            self.ldflags.insert(0, "--sysroot=" + self.sysroot)

        if not shutil.which(self.cc):
            die(f"C compiler {self.cc!r} not found "
                f"(set $CC, or [toolchain] cc in {CONF_FILE})")
        self.ar     = (os.environ.get("AR") or tool.get("ar")
                       or self._prefixed("ar")
                       or shutil.which("ar") or shutil.which("llvm-ar"))
        # The bare name in an ejected build file: a resolved absolute path
        # would not survive being carried to another machine.
        self.ar_name = (os.environ.get("AR") or tool.get("ar")
                        or os.path.basename(self.ar or "ar"))
        self.pkgexe = tool.get("pkg-config") or self._prefixed("pkg-config")
        self.extra_libdirs = list(tool.get("lib-dirs", []))
        self.ccver  = tool_version(self.cc)
        self.cxxver = tool_version(self.cxx) if shutil.which(self.cxx) else "?"
        # The profile is in here through cflags, so switching profiles gets a
        # separate object directory rather than invalidating the old one.
        self._libdirs = None
        self.refresh_key()

    def refresh_key(self):
        """Recompute the configuration identity.

        Must be called after anything changes cflags, including flags fmake
        adds for itself. The key names the object directory, so a flag that
        is not in it is a flag that silently reuses objects built without it.
        """
        self.key = sha(" ".join([self.cc, self.cxx, self.ccver, self.cxxver,
                                 self.os, self.arch,
                                 *self.cflags, "|", *self.override]))[:12]

    def _prefixed(self, tool):
        """The toolchain's own copy of a binutil, if there is one."""
        if not self.prefix:
            return None
        return shutil.which(self.prefix + tool)

    def driver(self, cxx):
        return self.cxx if cxx else self.cc

    @property
    def libdirs(self):
        if self._libdirs is None:
            self._libdirs = lib_search_dirs(self)
        return self._libdirs

# ---------------------------------------------------------------------------
# Hashing & cache
# ---------------------------------------------------------------------------

try:
    import fcntl                   # absent off Unix; locking is then skipped
except ImportError:
    fcntl = None


class TreeLock:
    """One fmake at a time per tree.

    Two runs share .fmake/cache.json, and the loser's writes are simply lost
    -- scan results, symbol tables, resolved libraries, all recomputed next
    time. Worse, one can be reading the objects another is replacing. Waiting
    is friendlier than either, and a build is long enough that the wait is
    not the expensive part.
    """

    def __init__(self, state):
        self.path = os.path.join(state, "lock")
        self.fh = None

    def __enter__(self):
        if fcntl is None:
            return self
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        self.fh = open(self.path, "w")
        try:
            fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            info("waiting for another fmake in this tree")
            fcntl.flock(self.fh, fcntl.LOCK_EX)
        return self

    def __exit__(self, *_exc):
        if self.fh:
            try:
                fcntl.flock(self.fh, fcntl.LOCK_UN)
            finally:
                self.fh.close()
                self.fh = None
        return False

def sha(data):
    if isinstance(data, str):
        data = data.encode()
    return hashlib.blake2b(data, digest_size=16).hexdigest()


def file_hash(path):
    h = hashlib.blake2b(digest_size=16)
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 18), b""):
            h.update(chunk)
    return h.hexdigest()


class Cache:
    """Persisted file hashes, scan results and symbol tables.

    Keyed by content hash throughout, so switching branches or touching a
    file without changing it rebuilds nothing.
    """

    def __init__(self, path):
        self.path = path
        self.data = {"version": CACHE_VER, "files": {}, "objects": {},
                     "units": []}
        try:
            with open(path) as fh:
                d = json.load(fh)
            if d.get("version") == CACHE_VER:
                self.data = d
                self.data.setdefault("units", [])
        except (OSError, ValueError):
            pass
        self.files   = self.data["files"]
        self.objects = self.data["objects"]

    def save(self):
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        tmp = self.path + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(self.data, fh)
        os.replace(tmp, self.path)

    def hash_of(self, abspath, rel):
        """Content hash, avoiding the read when size+mtime are unchanged."""
        try:
            st = os.stat(abspath)
        except OSError:
            return None
        ent = self.files.get(rel)
        sig = [st.st_size, int(st.st_mtime_ns)]
        if ent and ent.get("sig") == sig:
            return ent["hash"]
        h = file_hash(abspath)
        if ent is None:
            ent = self.files[rel] = {}
        ent["sig"], ent["hash"] = sig, h
        ent.pop("scan", None)
        return h

    def scan(self, abspath, rel):
        h = self.hash_of(abspath, rel)
        if h is None:
            # hash_of returns None when the file cannot be stat'd -- a
            # dangling symlink is the usual way -- and leaves no entry
            # behind. Raising the error the caller already handles beats
            # indexing a dict that was never written to.
            raise OSError(errno.ENOENT, "no such file", abspath)
        ent = self.files[rel]
        if ent.get("scan") is not None and ent.get("scan_h") == h:
            return ent["scan"]
        ent["scan"] = scan_source(abspath)
        ent["scan_h"] = h
        return ent["scan"]

# ---------------------------------------------------------------------------
# Depfiles
# ---------------------------------------------------------------------------

def parse_depfile(path):
    """Read a `cc -MD` depfile and return the prerequisite paths."""
    try:
        with open(path) as fh:
            text = fh.read()
    except OSError:
        return []
    text = text.replace("\\\n", " ")
    _, _, rhs = text.partition(":")
    return [p for p in rhs.split() if p and p != "\\"]

# ---------------------------------------------------------------------------
# Compiling
# ---------------------------------------------------------------------------

class Unit:
    __slots__ = ("rel", "abs", "cxx", "obj", "dep", "scan", "ann", "own",
                 "undef", "strong", "weak", "compiled")

    def __init__(self, rel, root, objdir, scan):
        self.rel  = rel
        self.abs  = os.path.join(root, rel)
        self.cxx  = is_cxx(rel)
        self.obj  = os.path.join(objdir, rel + ".o")
        self.dep  = os.path.join(objdir, rel + ".d")
        self.scan = scan
        self.ann  = Ann(scan.get("dirs"))
        self.own  = []            # compile flags this TU asked for itself
        self.undef = self.strong = self.weak = None
        self.compiled = False


def unit_cflags(u, pkg, store, sig):
    """Compile flags a TU asked for, in @std @define @cflags @pkg order.

    Per-TU by design: a compile flag is a property of the translation unit.
    Link flags are not -- they belong to whatever the TU ends up inside --
    and that asymmetry is what makes declaring a dependency next to the code
    that uses it work at all.
    """
    out = []
    std = u.ann.scalar("std")
    if std:
        out.append("-std=" + std)
    out += ["-D" + d for d in u.ann.items("define")]
    out += u.ann.items("cflags")
    for group in u.ann.groups("pkg"):
        got = pkg.for_module(group[0], store, sig)
        if got:
            out += [f for f in got[1] if f not in out]
    return out


def compile_cmd(u, cfg, incflags):
    cc = cfg.driver(u.cxx)
    return ([cc, "-c", u.abs, "-o", u.obj, "-MD", "-MF", u.dep]
            + incflags + cfg.cflags + u.own + cfg.override)


def object_key(u, cfg, cache, root, incflags):
    """Cache key: source content, every prerequisite's content, and config.

    The include flags are part of the config: gaining an -I can change which
    header a name resolves to, so an object built without it is not reusable.
    So are the TU's own flags, since @define changes what the file means.
    """
    parts = [cfg.key, sha("\0".join(incflags)), sha("\0".join(u.own))]
    src_h = cache.hash_of(u.abs, u.rel)
    if src_h is None:
        return None
    parts.append(src_h)
    for dep in parse_depfile(u.dep):
        rel = os.path.relpath(dep, root)
        dh = cache.hash_of(dep, rel)
        if dh:
            parts.append(rel + ":" + dh)
    return sha("|".join(parts))


def compile_units(units, cfg, cache, root, incflags, jobs, dry_run,
                  broken=None):
    """Compile what is stale. Returns True if anything was actually built.

    `broken` collects the files that would not compile, so the caller can
    drop the targets that depended on them and build the rest.
    """
    broken = set() if broken is None else broken
    todo = []
    for u in units:
        if u.compiled:
            continue
        ent = cache.objects.get(u.rel)
        key = object_key(u, cfg, cache, root, incflags)
        if (ent and ent.get("key") == key and key is not None
                and os.path.exists(u.obj)):
            u.undef  = set(ent["u"])
            u.strong = set(ent["s"])
            u.weak   = set(ent["w"])
            u.compiled = True
            vinfo(f"cached {u.rel}")
            continue
        todo.append(u)

    if not todo:
        return False

    for u in todo:
        os.makedirs(os.path.dirname(u.obj), exist_ok=True)

    width = len(str(len(todo)))
    done = [0]
    failures = []

    def run_one(u):
        cmd = compile_cmd(u, cfg, incflags)
        if dry_run:
            print(" ".join(cmd))
            return u, 0, ""
        r = subprocess.run(cmd, capture_output=True, text=True)
        return u, r.returncode, r.stderr

    with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as pool:
        for u, rc, err in pool.map(run_one, todo):
            done[0] += 1
            tag = "CXX" if u.cxx else "CC "
            if rc != 0:
                failures.append((u, err))
                say(f"[{done[0]:>{width}}/{len(todo)}] {RED(tag)} {u.rel}")
            elif not dry_run:
                say(f"[{done[0]:>{width}}/{len(todo)}] {BLUE(tag)} {u.rel}")
                if err.strip():
                    PROGRESS.write(err)

    if failures:
        # One missing system header fails every file that includes it, and
        # printing the same diagnostic hundreds of times buries anything
        # else. Group by the message, not by the file.
        groups = {}
        for u, err in failures:
            first = ""
            for line in err.splitlines():
                if "error:" in line:
                    first = line.split("error:", 1)[1].strip()
                    break
            groups.setdefault(first or err.strip()[:200], []).append((u, err))
        say()
        for msg, hit in sorted(groups.items(), key=lambda kv: -len(kv[1])):
            first_unit, first_err = hit[0]
            warn(f"{msg}" if msg else "compilation failed")
            note(f"in {first_unit.rel}"
                 + (f" and {len(hit) - 1} other file(s)" if len(hit) > 1
                    else ""))
            if VERBOSE or len(groups) == 1 and len(hit) == 1:
                PROGRESS.write(first_err)
            elif len(hit) > 1:
                for u, _e in hit[1:4]:
                    note(f"   {u.rel}")
                if len(hit) > 4:
                    note(f"   ... and {len(hit) - 4} more")
        if not VERBOSE:
            note("-v for the full compiler output")
        say()

        # Not fatal on its own. Targets are discovered rather than requested,
        # so a test binary whose dependency is missing must not stop the
        # program next to it from building -- the same argument that makes
        # link failures per-target. A file that failed simply has no symbols,
        # so nothing can close over it, and whoever needed it fails alone.
        for u, _err in failures:
            u.undef, u.strong, u.weak = set(), set(), set()
            u.compiled = True
            broken.add(u.rel)
            cache.objects.pop(u.rel, None)

    if dry_run:
        for u in todo:
            u.undef, u.strong, u.weak = set(), set(), set()
            u.compiled = True
        return True

    # Symbol tables, and the cache entries that go with them. Only for what
    # actually compiled: a failed unit has no object file, and asking nm to
    # read one that is not there is a different error from the one the user
    # needs to see.
    made = [u for u in todo if u.rel not in broken]
    read_symbols(made, cfg, jobs)
    for u in made:
        cache.objects[u.rel] = {
            "key": object_key(u, cfg, cache, root, incflags),
            "u": sorted(u.undef), "s": sorted(u.strong), "w": sorted(u.weak),
        }
    return True

# ---------------------------------------------------------------------------
# Symbol tables
#
# The classification matters more than it looks. Lowercase nm types are
# file-local and invisible to other objects, so they neither provide nor
# conflict.
#
# Weak and common symbols are providers of last resort. C++ emits a weak
# definition of every template instantiation and inline function into every
# object that uses one, so treating them as strong would report duplicate
# definitions across perfectly ordinary files. But ignoring them entirely is
# wrong too: `extern template` leaves a plain undefined reference that only a
# weak definition elsewhere satisfies. So a strong provider wins if there is
# one, a weak provider is used if there is not, and several weak providers is
# normal rather than ambiguous.
# ---------------------------------------------------------------------------

def read_symbols(units, cfg, jobs):
    def one(u):
        r = subprocess.run([cfg.nm, "--format=posix", u.obj],
                           capture_output=True, text=True)
        # An object nm could not read yields no symbols, and an object with
        # no symbols is invisible to the closure: it defines nothing so it is
        # never linked, and needs nothing so it reports no externals. The
        # file would compile, appear in the build, and simply be absent from
        # the result. A cross toolchain with the wrong nm gets here.
        if r.returncode != 0:
            die(f"{cfg.nm} could not read {u.rel}'s object:\n"
                f"    {r.stderr.strip().splitlines()[0] if r.stderr.strip() else 'no output'}\n"
                f"Set [toolchain] nm in {CONF_FILE}, or $NM, to one that "
                f"understands {describe_identity(elf_identity(u.obj))} "
                f"objects.")
        undef, strong, weak = set(), set(), set()
        for line in r.stdout.splitlines():
            parts = line.split()
            if len(parts) < 2:
                continue
            name, typ = parts[0], parts[1]
            if typ == NM_UNDEF:
                undef.add(name)
            elif typ in NM_WEAK or typ in NM_COMMON:
                weak.add(name)
            elif typ.isupper():
                strong.add(name)
            # lowercase: file-local, ignored
        return u, undef, strong, weak

    with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as pool:
        for u, undef, strong, weak in pool.map(one, units):
            u.undef, u.strong, u.weak = undef, strong, weak
            u.compiled = True

# ---------------------------------------------------------------------------
# Symbol closure -- the link set
# ---------------------------------------------------------------------------

class Closure:
    __slots__ = ("root", "link", "why", "external", "ambiguous")

    def __init__(self, root):
        self.root      = root
        self.link      = [root]
        self.why       = {}      # unit rel -> (symbol, needed-by rel)
        self.external  = {}      # symbol -> [unit rels referencing it]
        self.ambiguous = []      # (symbol, [providers])


def close_over_library(units, root_unit):
    """A library is everything the tree defines, not a closure.

    There is no entry point to close from, and pruning would be wrong anyway:
    a library exists to be linked against code that has not been written yet,
    so which symbols matter is not knowable here. The consumer's linker prunes
    a static archive at its own link, and a shared object keeps everything by
    design. Other programs' roots are excluded -- an archive with two main()s
    in it is not useful to anyone.
    """
    cl = Closure(root_unit)
    cl.link = list(units)
    for u in units:
        if u is not root_unit:
            cl.why[u.rel] = ("part of the library", "")

    # A library is not exempt from §3's refusal to guess. Two strong
    # definitions of one symbol in an archive is resolved by member order,
    # silently, and the consumer inherits the coin flip with no way to see
    # it -- so it is caught here, where the cause is. Weak definitions are
    # excluded as everywhere else: C++ libraries are full of them by design.
    strong_by_sym = {}
    for u in units:
        for sym in u.strong:
            strong_by_sym.setdefault(sym, []).append(u.rel)
    for sym, where in sorted(strong_by_sym.items()):
        if len(where) > 1:
            cl.ambiguous.append((sym, where))

    defined = set()
    for u in units:
        defined |= u.strong | u.weak
    for u in units:
        for sym in u.undef:
            if sym not in defined and sym not in LINKER_SYMBOLS:
                cl.external.setdefault(sym, []).append(u.rel)
    return cl


def close_over_symbols(root_unit, units, forced=(), forced_why=None):
    """Transitive closure from a root object over undefined symbols.

    `forced` units seed the closure alongside the root. They are what nothing
    references -- constructor-registered plugins and dlopen targets -- so they
    have to be asserted, but once seeded their own dependencies resolve
    normally."""
    strong_by_sym, weak_by_sym = {}, {}
    for u in units:
        for s in u.strong:
            strong_by_sym.setdefault(s, []).append(u)
        for s in u.weak:
            weak_by_sym.setdefault(s, []).append(u)

    cl = Closure(root_unit)
    seeds = [root_unit] + [u for u in forced if u is not root_unit]
    for u in seeds[1:]:
        cl.link.append(u)
        cl.why[u.rel] = ((forced_why or {}).get(u.rel, "--force-link"), "")
    linked = set(seeds)
    frontier = list(seeds)

    while frontier:
        cur = frontier.pop()
        for sym in sorted(cur.undef):
            # Only a *strong* definition already in the link set ends the
            # search. Accepting a weak one here would let whichever object
            # happened to be linked first shadow a strong definition
            # elsewhere -- and which comes first depends on the alphabetical
            # order of some unrelated symbol, so the same program could link
            # two different ways. Strong beats weak has to hold globally,
            # not just at the moment a provider is chosen.
            if any(sym in o.strong for o in linked):
                continue

            providers = strong_by_sym.get(sym, [])
            if len(providers) > 1:
                cl.ambiguous.append((sym, [p.rel for p in providers]))
                continue

            if not providers:
                # No strong definition anywhere in the pool, so a weak one is
                # the answer -- this is how a separately instantiated
                # template is reached, since `extern template` leaves a plain
                # undefined reference that only vague linkage satisfies.
                # A weak copy already linked is as good as any other: vague
                # linkage means they are interchangeable.
                if any(sym in o.weak for o in linked):
                    continue
                weak = weak_by_sym.get(sym, [])
                if not weak:
                    continue
                providers = [min(weak, key=lambda u: u.rel)]

            p = providers[0]
            if p not in linked:
                linked.add(p)
                cl.link.append(p)
                cl.why[p.rel] = (sym, cur.rel)
                frontier.append(p)

    for u in cl.link:
        for sym in u.undef:
            if sym in LINKER_SYMBOLS:
                continue
            if not any(sym in o.strong or sym in o.weak for o in linked):
                cl.external.setdefault(sym, []).append(u.rel)

    return cl

# ---------------------------------------------------------------------------
# Widening
#
# An unresolved symbol should widen the compiled set, not fail the build.
#
# Candidates are the unbuilt files that appear to *define* the symbol. The
# distinction matters: filtering on any mention instead would match every
# file that merely calls printf, and widening would drag in most of the tree
# to chase a libc symbol it can never resolve. Definitions that this misses
# -- functions generated by macros, mostly -- need --widen-all or
# --force-link.
# ---------------------------------------------------------------------------

def symbol_tokens(sym):
    """Plausible source identifiers for a symbol, including Itanium mangling."""
    if sym.startswith("_Z"):
        toks = set()
        for m in re.finditer(r"(\d+)", sym):
            n = int(m.group(1))
            name = sym[m.end():m.end() + n]
            if n and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
                toks.add(name)
        return toks
    return {sym.lstrip("_")}


def widen_candidates(symbols, pool_units):
    toks = set()
    for s in symbols:
        toks |= symbol_tokens(s)
    if not toks:
        return []
    out = []
    for u in pool_units:
        if toks.intersection(u.scan.get("defs") or []):
            out.append(u)
    return out

# ---------------------------------------------------------------------------
# Library resolution
#
# Two signals, and the closure hands over the better one for free.
#
#   includes   Cheap and available before compiling, which is when the -I
#              flags are needed. But including a header only proves that a
#              declaration was wanted, not that anything from the library is
#              called.
#
#   symbols    The external set left over from the closure is a direct
#              statement of what the program needs from outside the tree. If
#              SDL_Init is undefined then SDL_Init is genuinely called. This
#              is strictly better evidence, and it is what picks the -l flags.
#
# They are combined rather than ranked: includes propose and supply -I,
# symbols confirm or contradict. A library proposed by a header that no
# symbol needs is a header included out of habit -- fmake declines to link
# it and says so, which is a thing no other build system reports.
# ---------------------------------------------------------------------------

# Headers whose package cannot be worked out by looking at where they live,
# because they sit directly in /usr/include alongside everything else. Only
# the cases where the reverse lookup below is ambiguous need to be here.
HEADER_PKG = {
    "zlib.h": "zlib", "sqlite3.h": "sqlite3", "png.h": "libpng",
    "curl/curl.h": "libcurl", "expat.h": "expat", "pcre2.h": "libpcre2-8",
    "openssl/ssl.h": "openssl", "openssl/crypto.h": "libcrypto",
    "ncurses.h": "ncursesw", "curses.h": "ncursesw", "readline/readline.h": "readline",
    "ft2build.h": "freetype2", "jpeglib.h": "libjpeg", "tiffio.h": "libtiff-4",
    "archive.h": "libarchive", "lzma.h": "liblzma", "bzlib.h": "bzip2",
    "zstd.h": "libzstd", "yaml.h": "yaml-0.1", "uuid/uuid.h": "uuid",
    "usb.h": "libusb", "libusb-1.0/libusb.h": "libusb-1.0",
    "X11/Xlib.h": "x11", "GL/gl.h": "gl", "GL/glew.h": "glew",
    "vulkan/vulkan.h": "vulkan", "alsa/asoundlib.h": "alsa",
    "pulse/pulseaudio.h": "libpulse", "sndfile.h": "sndfile",
    "ogg/ogg.h": "ogg", "vorbis/codec.h": "vorbis", "FLAC/all.h": "flac",
    "cmocka.h": "cmocka", "check.h": "check",
}

# Linked into everything already; naming them is noise, not information.
IMPLICIT_LIBS = {"c"}

# Runtimes that intercept rather than implement. They export the symbols they
# interpose on -- asan exports lgamma, memcpy, malloc -- so by symbol evidence
# alone they are perfectly good providers, and the cover could pick one purely
# because it happens to intercept more of what a program calls. Linking a
# sanitiser into an ordinary program is not a build fmake should ever choose;
# you get these by asking for -fsanitize, which is a --cflags away.
INTERPOSER_LIBS = {
    "asan", "lsan", "tsan", "msan", "ubsan", "hwasan",
    "asan_preinit", "tsan_preinit", "ubsan_standalone",
    "ubsan_standalone_cxx", "gcov", "profiler", "tcmalloc", "jemalloc",
    "efence", "duma", "mudflap", "mudflapth",
}

# Symbols the linker itself provides. No library exports them, so reporting
# them as unresolved dependencies is a false alarm -- and on a PIC build
# _GLOBAL_OFFSET_TABLE_ can be the only thing listed, which makes the whole
# report read as a failure when nothing is wrong.
LINKER_SYMBOLS = {
    "_GLOBAL_OFFSET_TABLE_", "_DYNAMIC", "__dso_handle", "__ehdr_start",
    "_edata", "_end", "__bss_start", "etext", "_etext", "__data_start",
    "__gmon_start__", "_init", "_fini", "__init_array_start",
    "__init_array_end", "__fini_array_start", "__fini_array_end",
    "__preinit_array_start", "__preinit_array_end", "__executable_start",
    "__start___libc_atexit", "__stop___libc_atexit",
}


def _stdout(cmd):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
        return r.stdout if r.returncode == 0 else ""
    except OSError:
        return ""


# e_machine values worth naming. Only for messages -- the comparison is on the
# raw triple, so an architecture missing from here still works.
ELF_MACHINES = {
    0x03: "x86", 0x3E: "x86_64", 0x28: "arm", 0xB7: "aarch64",
    0xF3: "riscv", 0x08: "mips", 0x14: "ppc", 0x15: "ppc64",
    0x02: "sparc", 0x32: "ia64", 0x16: "s390",
}


def elf_identity(path):
    """(class, byte order, machine) from an ELF header, or None.

    This is what makes cross builds honest. A cross compiler's own search
    path contains /usr/lib -- the host's -- so no arrangement of directory
    names separates the target's libraries from the host's. The ELF header
    does, exactly, for any architecture, without fmake knowing anything
    about triplets.
    """
    try:
        with open(path, "rb") as fh:
            head = fh.read(64)
            if head[:8] == b"!<arch>\n":
                # An archive: identify it by its first ELF member.
                blob = head + fh.read(1 << 16)
                at = blob.find(b"\x7fELF")
                if at < 0:
                    return None
                head = blob[at:at + 20]
    except OSError:
        return None
    if len(head) < 20 or head[:4] != b"\x7fELF":
        return None
    order = "little" if head[5] == 1 else "big"
    return (head[4], head[5], int.from_bytes(head[18:20], order))


def describe_identity(ident):
    if not ident:
        return "unknown"
    bits = {1: "32", 2: "64"}.get(ident[0], "?")
    end = {1: "le", 2: "be"}.get(ident[1], "?")
    return f"{ELF_MACHINES.get(ident[2], 'machine-0x%x' % ident[2])}/{bits}{end}"


def host_elf_machine():
    """The e_machine value this machine runs, or None if it is not known."""
    want = host_arch()
    for code, name in ELF_MACHINES.items():
        if name == want:
            return code
    return None


def compiler_lib_dirs(cfg):
    """Where this compiler's linker looks. Authoritative, and correct for a
    cross compiler, which is why it comes before any guess."""
    out = []
    for line in _stdout([cfg.cc, "-print-search-dirs"]).splitlines():
        if line.startswith("libraries:"):
            for d in line.split(":", 1)[1].lstrip(" =").split(":"):
                if d and os.path.isdir(d):
                    out.append(d)
    return out


def lib_search_dirs(cfg):
    """Where the linker will look, in the order it looks."""
    triplet = _stdout([cfg.cc, "-print-multiarch"]).strip()
    cands = list(cfg.extra_libdirs)

    # A sysroot is the unambiguous statement that the target's filesystem is
    # elsewhere, so its directories come before anything native.
    if cfg.sysroot:
        for base in ("/usr/local/lib", "/usr/lib", "/lib"):
            if triplet:
                cands.append(os.path.join(cfg.sysroot, base.lstrip("/"),
                                          triplet))
            cands.append(os.path.join(cfg.sysroot, base.lstrip("/")))

    cands += compiler_lib_dirs(cfg)

    for base in ("/usr/local/lib", "/usr/lib", "/lib"):
        if triplet:
            cands.append(os.path.join(base, triplet))
        cands.append(base)
    cands += [d for d in os.environ.get("LIBRARY_PATH", "").split(":") if d]

    out, seen = [], set()
    for d in cands:
        rp = os.path.realpath(d)
        if os.path.isdir(d) and rp not in seen:
            seen.add(rp)
            out.append(d)
    return out


def linkable_libs(dirs):
    """Map -lNAME to a file, for names that will actually link.

    Only the development symlink counts. A machine can carry
    libSDL2-2.0.so.0 for programs that already exist while having no
    libSDL2.so at all, and offering -lSDL2 there produces a link error --
    which is right, because without the dev package the headers are missing
    too and the compile would have failed first.
    """
    out = {}
    # Shared libraries first, across every directory, before any archive is
    # considered. Otherwise glibc's own static halves -- libm-2.41.a and
    # friends -- get offered as link names, and linking one drags in
    # internals like _dl_x86_cpu_features that no program can resolve.
    for suffix in (".so", ".a"):
        for d in dirs:
            try:
                entries = sorted(os.listdir(d))
            except OSError:
                continue
            for f in entries:
                if not f.startswith("lib") or not f.endswith(suffix):
                    continue
                name = f[3:-len(suffix)]
                if name and name not in out:
                    out[name] = os.path.join(d, f)
    return out


RE_LD_SCRIPT_GROUP = re.compile(r"\b(?:INPUT|GROUP|AS_NEEDED)\s*\(([^)]*)\)")
RE_LD_SCRIPT_TOKEN = re.compile(r"(-l\S+|[\w./+-]+\.(?:so[0-9.]*|a))")


def elf_targets(path, dirs=(), _depth=0):
    """The real objects behind a linkable name.

    libc.so, libm.so and libncurses.so are GNU ld scripts, not ELF files, and
    nm cannot read them. Their contents come in three forms, all of which
    occur in practice on one machine:

        GROUP ( /lib/x86_64-linux-gnu/libm.so.6 AS_NEEDED ( ... ) )
        INPUT ( libncurses.so.6 -ltinfo )

    An absolute path, a bare name relative to the script, and a plain -l.
    Handling only the first -- which is the obvious one to write, since it is
    what glibc uses -- silently drops every symbol ncurses exports.
    """
    try:
        with open(path, "rb") as fh:
            magic = fh.read(8)
    except OSError:
        return []
    if magic[:4] == b"\x7fELF" or magic[:8] == b"!<arch>\n":
        return [path]
    if _depth > 3:
        return []
    try:
        with open(path, "r", errors="replace") as fh:
            text = fh.read(8192)
    except OSError:
        return []

    here = os.path.dirname(path)
    search = [here] + [d for d in dirs if d != here]
    out = []
    for group in RE_LD_SCRIPT_GROUP.findall(text):
        for tok in RE_LD_SCRIPT_TOKEN.findall(group):
            if tok.startswith("-l"):
                names = [f"lib{tok[2:]}{ext}" for ext in (".so", ".a")]
                cands = [os.path.join(d, n) for d in search for n in names]
            elif os.path.isabs(tok):
                cands = [tok]
            else:
                cands = [os.path.join(d, tok) for d in search]
            for c in cands:
                if os.path.exists(c):
                    # A script can name another script.
                    out += elf_targets(c, dirs, _depth + 1)
                    break
    return out


def lib_exports(cfg, path):
    """Symbols a library offers to a link.

    Unlike an object file, every name in a dynamic symbol table is exported,
    so the lowercase-is-local rule does not apply here -- glibc exports cos
    as an ifunc, type `i`. Version suffixes (cos@@GLIBC_2.2.5) are stripped.
    """
    dyn = not path.endswith(".a")
    cmd = [cfg.nm, "--defined-only", "--format=posix"]
    if dyn:
        cmd.append("-D")
    r = subprocess.run(cmd + [path], capture_output=True, text=True)
    out = set()
    for line in r.stdout.splitlines():
        parts = line.split()
        if parts:
            out.add(parts[0].split("@")[0])
    return out


def find_providers(cfg, wanted, jobs, want_ident=None):
    """Which installed libraries define each of these symbols.

    Scanned on demand rather than kept as a persistent index: the whole sweep
    is about a second, only the wanted symbols are retained, and the answer is
    cached per target against the external set, so a normal incremental build
    never gets here at all. No index means no staleness.
    """
    libs = {n: p for n, p in linkable_libs(lib_search_dirs(cfg)).items()
            if n not in INTERPOSER_LIBS}
    want = set(wanted)
    if not want or not libs:
        return {}, {}

    dirs = cfg.libdirs

    def scan(item):
        name, path = item
        syms = set()
        for t in elf_targets(path, dirs):
            # Architecture first: a 20-byte header read is far cheaper than
            # an nm, and on a cross build most of what is on the machine is
            # the wrong architecture and must not contribute a single symbol.
            if want_ident and elf_identity(t) not in (None, want_ident):
                continue
            syms |= lib_exports(cfg, t)
        return name, syms & want

    found = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as pool:
        for name, hits in pool.map(scan, sorted(libs.items())):
            for s in hits:
                found.setdefault(s, []).append(name)
    return found, libs


def default_link_dirs(cfg):
    """Where the linker already looks, so -L is only added when it is needed."""
    out = set()
    for line in _stdout([cfg.cc, "-print-search-dirs"]).splitlines():
        if line.startswith("libraries:"):
            for d in line.split(":", 1)[1].lstrip(" =").split(":"):
                if d:
                    out.add(os.path.realpath(d))
    return out


def choose_libs(providers, wanted, proposed):
    """Smallest set of -l flags covering the unresolved symbols.

    Unlike a header naming two packages, a symbol offered by several
    libraries is ordinary -- glibc merged libm into libc, and distributions
    ship libcurl beside libcurl-gnutls -- so this picks rather than refuses,
    and --explain shows what else could have supplied it.
    """
    remaining = set(wanted)
    implicit = set()
    for s in list(remaining):
        if IMPLICIT_LIBS.intersection(providers.get(s, ())):
            implicit.add(s)
            remaining.discard(s)

    chosen, why = [], {}
    while remaining:
        counts = {}
        for s in remaining:
            for lib in providers.get(s, ()):
                if lib not in IMPLICIT_LIBS:
                    counts.setdefault(lib, set()).add(s)
        if not counts:
            break
        # Most symbols covered, then a library the headers already asked for,
        # then the shorter name -- libm-2.41 is a private glibc artefact and
        # libm is the real thing -- then alphabetical, so the choice never
        # depends on directory scan order.
        best = max(counts, key=lambda l: (len(counts[l]), l in proposed,
                                          -len(l), [-ord(c) for c in l]))
        chosen.append(best)
        why[best] = sorted(counts[best])
        remaining -= counts[best]

    return chosen, why, implicit, sorted(remaining)


class PkgConfig:
    """pkg-config, for the -I flags a library's own headers need."""

    def __init__(self, configured=None, sysroot=None, triplet=None):
        self.exe = (shutil.which(configured) if configured else None) \
                   or shutil.which("pkg-config") or shutil.which("pkgconf")
        self._flags = {}
        self._by_incdir = None
        self.sysroot = sysroot

        # Left alone, pkg-config answers for the host: host .pc files, host
        # include paths. These two variables are the standard way to point it
        # at a sysroot instead, and without them a cross build silently
        # collects the build machine's flags.
        self.env = dict(os.environ)
        if sysroot:
            libdirs = []
            for base in ("usr/lib", "usr/share", "lib"):
                if triplet and base == "usr/lib":
                    libdirs.append(os.path.join(sysroot, base, triplet,
                                                "pkgconfig"))
                libdirs.append(os.path.join(sysroot, base, "pkgconfig"))
            self.env["PKG_CONFIG_SYSROOT_DIR"] = sysroot
            self.env["PKG_CONFIG_LIBDIR"] = ":".join(libdirs)

    def _run(self, args):
        return subprocess.run([self.exe] + args, capture_output=True,
                              text=True, env=self.env)

    def flags(self, module):
        """(cflags, libs) for a module, or None if it is not installed.

        -L belongs to neither: it is a link path, and putting it in the
        compile flags -- which is what dropping everything that is not -l
        into cflags does -- silently loses it. The library search paths are
        recovered from where the library actually lives instead, which also
        covers libraries found by symbol alone.
        """
        if module in self._flags:
            return self._flags[module]
        res = None
        if self.exe:
            r = self._run(["--cflags", "--libs", module])
            if r.returncode == 0:
                args = shlex.split(r.stdout)
                res = ([a for a in args
                        if not a.startswith(("-l", "-L"))],
                       [a for a in args if a.startswith("-l")])
        self._flags[module] = res
        return res

    def _search_path(self):
        if "PKG_CONFIG_LIBDIR" in self.env:
            return [d for d in self.env["PKG_CONFIG_LIBDIR"].split(":") if d]
        p = self._run(["--variable", "pc_path", "pkg-config"]).stdout.strip()
        dirs = [d for d in p.split(":") if d] if p else []
        return dirs or ["/usr/lib/pkgconfig", "/usr/share/pkgconfig"]

    def signature(self):
        """Stamp that changes when a package is installed or removed."""
        parts = []
        for d in (self._search_path() if self.exe else []):
            try:
                parts.append(f"{d}:{os.stat(d).st_mtime_ns}")
            except OSError:
                pass
        return sha("|".join(parts))

    def for_module(self, module, store, sig):
        """(module, cflags, libs) for a module named outright by @pkg."""
        key = sig + "|pkg|" + module
        if key in store:
            return store[key]
        got = self.flags(module)
        store[key] = None if got is None else [module, got[0], got[1]]
        return store[key]

    def satisfies(self, spec):
        """Check a `@pkg name >= 1.2` constraint. None if pkg-config is gone."""
        if not self.exe:
            return None
        return self._run(["--exists", " ".join(spec)]).returncode == 0

    def version(self, module):
        return self._run(["--modversion", module]).stdout.strip() or "?"

    def for_header(self, name, store, sig):
        """(module, cflags, libs) for a system header, or None.

        Cached in the project cache, because resolving a header means reading
        every .pc file on the machine and running pkg-config, and a no-op
        build should not pay for that.
        """
        key = sig + "|" + name
        if key in store:
            return store[key]
        module = HEADER_PKG.get(name)
        if module is None:
            for inc, mod in self.by_includedir().items():
                real = inc
                if self.sysroot and not inc.startswith(self.sysroot):
                    real = os.path.join(self.sysroot, inc.lstrip("/"))
                if os.path.exists(os.path.join(real, name)):
                    module = mod
                    break
        got = self.flags(module) if module else None
        store[key] = None if got is None else [module, got[0], got[1]]
        return store[key]

    def by_includedir(self):
        """Map an include directory to the module that owns it.

        Only useful for libraries that keep their headers in a subdirectory,
        which is exactly the case where an -I is needed. Packages installing
        straight into /usr/include are ambiguous and are skipped -- they need
        no -I either, so nothing is lost.
        """
        if self._by_incdir is not None:
            return self._by_incdir
        self._by_incdir = {}
        if not self.exe:
            return self._by_incdir
        for d in self._search_path():
            try:
                names = sorted(os.listdir(d))
            except OSError:
                continue
            for f in names:
                if not f.endswith(".pc"):
                    continue
                for inc in _pc_includedirs(os.path.join(d, f)):
                    if inc.rstrip("/") in ("/usr/include", "/usr/local/include"):
                        continue
                    self._by_incdir.setdefault(inc.rstrip("/"), f[:-3])
        return self._by_incdir


RE_PC_VAR = re.compile(r"\$\{([^}]+)\}")


def _pc_includedirs(path):
    """The -I directories a .pc file advertises, with variables expanded."""
    variables, cflags = {}, ""
    try:
        with open(path, errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if line.startswith("Cflags:"):
                    cflags = line.split(":", 1)[1]
                elif "=" in line and ":" not in line.split("=", 1)[0]:
                    k, v = line.split("=", 1)
                    variables[k.strip()] = v.strip()
    except OSError:
        return []

    def expand(s, depth=0):
        if depth > 8:
            return s
        return RE_PC_VAR.sub(
            lambda m: expand(variables.get(m.group(1), ""), depth + 1), s)

    return [a[2:] for a in shlex.split(expand(cflags)) if a.startswith("-I")]


def propose_from_headers(units, pkg, store, proj=None):
    """Packages the system includes suggest, with the -I flags they need.

    Runs before compiling, since that is when -I is needed. What comes back
    is a proposal only: the symbol evidence settles whether a package is
    really linked.
    """
    sig = pkg.signature()
    cflags, proposed, seen = [], {}, set()
    for u in units:
        for kind, name, line in (u.scan.get("incs") or []):
            if kind != "<" or name in seen:
                continue
            seen.add(name)
            if proj is not None and proj.resolve_header(name, u.rel):
                continue        # a project header that happens to use <>
            got = pkg.for_header(name, store, sig)
            if got is None:
                continue
            module, mod_cflags, mod_libs = got
            for f in mod_cflags:
                if f not in cflags:
                    cflags.append(f)
            for l in mod_libs:
                proposed.setdefault(l[2:], (module, f"{u.rel}:{line}", name))
    return cflags, proposed

RE_WRAP = re.compile(r"^__wrap_(.+)$")


def wrap_flags(cl):
    """-Wl,--wrap=X for every __wrap_X the link set defines.

    A symbol named __wrap_socket exists for exactly one reason: GNU ld's
    --wrap, which redirects calls to socket into it. Defining one and not
    passing the flag produces a binary that silently ignores the wrapper --
    the failure mode that makes mocked unit tests pass against the real
    syscall. Nothing but the symbol name is needed to know the intent, and
    only the closure knows which objects are actually in the link.
    """
    needed = set()
    for u in cl.link:
        needed |= u.undef
    out = []
    for u in cl.link:
        for sym in sorted(u.strong):
            m = RE_WRAP.match(sym)
            if m and m.group(1) in needed:
                out.append(m.group(1))
    return sorted(set(out))


def libdir_signature(cfg):
    """Stamp that changes when any linkable library does.

    Directory mtimes are not enough. A directory's mtime moves when an entry
    is added, removed or renamed -- so a package manager that installs by
    rename is caught -- but not when a file is rewritten in place, which is
    what `install` and a plain redirect both do. Rebuild a library into
    /usr/local/lib and fmake would go on believing the symbols it had before.

    Stat-ing every candidate instead costs about 3ms for ~900 libraries,
    which is less than one compiler invocation and is only paid when the
    resolution cache is consulted at all.
    """
    parts = []
    for name, path in sorted(linkable_libs(cfg.libdirs).items()):
        try:
            st = os.stat(path)
            parts.append(f"{name}:{path}:{st.st_size}:{st.st_mtime_ns}")
        except OSError:
            parts.append(f"{name}:{path}:gone")
    return sha("|".join(parts))


def scan_providers(cfg, externals, cache, jobs, want_ident=None):
    """One sweep of the installed libraries for every target's symbols.

    Shared deliberately: a repo with four programs would otherwise scan the
    system four times over, and the sweep is the only expensive part of
    resolution. Cached against the union of the symbols and a stamp of the
    library directories, so an ordinary incremental build never sweeps.
    """
    want = sorted(externals)
    if not want:
        return {}, {}
    key = sha("|".join(want) + "#" + libdir_signature(cfg)
              + "#" + str(want_ident))
    store = cache.data.setdefault("providers", {})
    if key in store:
        return store[key]["providers"], store[key]["paths"]
    vinfo(f"resolving {len(want)} external symbol(s) against "
          f"{describe_identity(want_ident)} libraries in "
          f"{len(cfg.libdirs)} directory(ies)")
    providers, libs = find_providers(cfg, want, jobs, want_ident)
    paths = {n: p for n, p in libs.items()
             if any(n in v for v in providers.values())}
    store[key] = {"providers": providers, "paths": paths}
    return providers, paths


def resolve_libraries(t, cl, cfg, pkg, hdr_store, providers, paths,
                      want_ident=None, proj=None):
    """Turn one target's external symbols into link flags."""
    # Proposals are recomputed from this target's own link set, so the
    # provenance names a file that is actually in this program. Everything
    # it needs is cached by now, so this costs nothing.
    _, proposed = propose_from_headers(cl.link, pkg, hdr_store, proj)
    want = sorted(cl.external)

    chosen, why, implicit, unresolved = choose_libs(
        providers, want, set(proposed))
    ident = want_ident

    # A library outside the linker's own search path needs -L, whether it
    # came from pkg-config or from the symbol scan.
    defaults = default_link_dirs(cfg)
    ldirs = []
    for lib in chosen:
        d = os.path.dirname(paths.get(lib, ""))
        if d and os.path.realpath(d) not in defaults and d not in ldirs:
            ldirs.append(d)

    alts = {}
    for lib in chosen:
        other = set()
        for s in why.get(lib, []):
            other |= set(providers.get(s, ()))
        # libm-2.41 beside libm is the same library under a private name,
        # not a second source worth reporting.
        alts[lib] = sorted(a for a in other - {lib} - IMPLICIT_LIBS
                           if not a.startswith(lib + "-"))
    res = {
        "chosen": chosen, "why": why, "alts": alts, "ldirs": ldirs,
        "implicit": sorted(implicit), "unresolved": unresolved,
        "ident": ident,
    }

    # Not cached: these depend on the header proposals, which are cheap.
    res = dict(res)
    res["proposed"] = {k: v for k, v in proposed.items()
                       if k in res["chosen"]}
    # A package is only "unused" when *none* of its libraries were needed.
    # pkg-config routinely lists more than a program calls into -- ncursesw
    # brings tinfo, and linking only what is needed is the entire point --
    # so reporting each surplus -l would be noise, and naming the module by
    # one of them reads as a contradiction when the module was linked.
    used_modules = {v[0] for k, v in proposed.items() if k in res["chosen"]}
    seen_mod = set()
    res["unused"] = {}
    for k, v in proposed.items():
        if v[0] in used_modules or v[0] in seen_mod:
            continue
        seen_mod.add(v[0])
        res["unused"][k] = v
    # Declared dependencies are not proposals to be weighed -- the author
    # said the library is needed, so it is linked whether or not a symbol
    # happens to require it. @ldflags propagates for the same reason @cflags
    # does not: it is a property of whatever the TU ends up inside.
    declared, extra_ld = [], []
    for lib in t.conf.get("libs", []):
        if lib not in declared:
            declared.append(lib)
    for spec in t.conf.get("pkg", []):
        got = pkg.for_module(spec.split()[0], hdr_store, pkg.signature())
        for l in (got[2] if got else []):
            if l[2:] not in declared:
                declared.append(l[2:])
    extra_ld += t.conf.get("ldflags", [])
    for u in cl.link:
        for lib in u.ann.items("libs"):
            if lib not in declared:
                declared.append(lib)
        for group in u.ann.groups("pkg"):
            got = pkg.for_module(group[0], hdr_store, pkg.signature())
            for l in (got[2] if got else []):
                if l[2:] not in declared:
                    declared.append(l[2:])
        for f in u.ann.items("ldflags"):
            if f not in extra_ld:
                extra_ld.append(f)

    res["declared"] = [d for d in declared if d not in res["chosen"]]
    res["wrap"] = wrap_flags(cl)
    res["ldflags"] = (["-Wl,--wrap=" + w for w in res["wrap"]]
                      + ["-L" + d for d in res.get("ldirs", [])]
                      + ["-l" + l for l in res["chosen"]]
                      + ["-l" + l for l in res["declared"]]
                      + extra_ld)
    return res

