def die(m):
	PROGRESS.flush()            # keep the error after the build output
	print(f"{RED('!!!')} {m}", file=sys.stderr)
	sys.exit(1)

# ---------------------------------------------------------------------------
# Source scanning
#
# Comments are stripped before looking for anything, so that a commented-out
# #include or a main() in a disabled block is not seen. String literals are
# deliberately *kept*: #include "foo.h" is itself string-shaped, and losing
# it would lose the include graph. The scanner still has to track strings
# properly so that a "//" inside one is not mistaken for a comment.
#
# Comment bodies are returned alongside, since the annotation layer will
# need them.
# ---------------------------------------------------------------------------

def strip_comments(text):
	"""Return (code, comments). Line numbering is preserved in `code`.

    `comments` is a list of (lineno, text) for later annotation parsing."""
	out, comments = [], []
	i, n, line = 0, len(text), 1
	while i < n:
		c = text[i]

		# line comment, possibly continued with a trailing backslash
		if c == "/" and i + 1 < n and text[i + 1] == "/":
			start, j = i, i + 2
			while j < n:
				if text[j] == "\\" and j + 1 < n and text[j + 1] == "\n":
					j += 2
				elif text[j] == "\n":
					break
				else:
					j += 1
			body = text[start:j]
			comments.append((line, body))
			out.append("\n" * body.count("\n"))
			line += body.count("\n")
			i = j
			continue

		# block comment
		if c == "/" and i + 1 < n and text[i + 1] == "*":
			j = text.find("*/", i + 2)
			j = n if j < 0 else j + 2
			body = text[i:j]
			comments.append((line, body))
			out.append("\n" * body.count("\n"))
			line += body.count("\n")
			i = j
			continue

		# C++ raw string: R"delim( ... )delim"
		if c == '"' and i > 0 and text[i - 1] == "R":
			m = re.compile(r'"([^ ()\\\t\n]{0,16})\(').match(text, i)
			if m:
				close = ')' + m.group(1) + '"'
				j = text.find(close, m.end())
				j = n if j < 0 else j + len(close)
				seg = text[i:j]
				out.append(seg)
				line += seg.count("\n")
				i = j
				continue

		# ordinary string or character literal
		if c in "\"'":
			j = i + 1
			while j < n:
				if text[j] == "\\":
					j += 2
					continue
				if text[j] == c or text[j] == "\n":
					j += 1
					break
				j += 1
			seg = text[i:j]
			out.append(seg)
			line += seg.count("\n")
			i = j
			continue

		out.append(c)
		if c == "\n":
			line += 1
		i += 1

	return "".join(out), comments


RE_INCLUDE = re.compile(r'^[ \t]*#[ \t]*include[ \t]*([<"])([^>"]+)[>"]', re.M)

# A *definition* -- a name, a parameter list, then a brace. Declarations and
# calls do not match. Everything found here is confirmed later against the
# object's symbol table, so these only have to be good, not perfect.
RE_FUNC_DEF = re.compile(
    r'(?:^|[;}\s*&:])([A-Za-z_][A-Za-z0-9_]*)[ \t\n]*\([^;{)]*\)'
    r'(?:[ \t\n]*(?:const|noexcept|override|final))*[ \t\n]*\{', re.M)

# The class an out-of-line member is defined in, which is how a vtable gets
# proposed at all. `_ZTV6Widget' is not a string any source spells, so
# section 15 recorded that nothing scanning for apparent definitions reaches
# the file defining it, and that moc's output sidesteps this by joining the
# candidate set outright -- with no general mechanism for anything else.
#
# This is that mechanism, and it follows from where the compiler puts the
# thing. A vtable is emitted in the translation unit defining the class's
# key function, and a key function is by definition an out-of-line member.
# So a file defining any member of Widget is exactly a file that might carry
# Widget's vtable, and `Widget' is the token `_ZTV6Widget' already yields.
#
# It is not only generators. The shape that found this is ordinary C++: a
# class whose members are all inline except an out-of-line destructor, whose
# mangling `_ZN6WidgetD1Ev' carries no member name to match on either, in a
# file with no header of its own for the include graph to reach it by.
# The member-initialiser list is allowed for after the parameter list because
# a constructor is the same bug in a different spelling: `_ZN6WidgetC1Ev'
# carries no member name either, so a file whose only out-of-line member is a
# constructor is reachable by nothing. Covering the destructor and missing
# the constructor is the half-fix section 19 warns about, one spelling over.
RE_MEMBER_DEF = re.compile(
    r'([A-Za-z_][A-Za-z0-9_]*)[ \t]*::[ \t]*~?[A-Za-z_][A-Za-z0-9_]*'
    r'[ \t\n]*\([^;{)]*\)'
    r'(?:[ \t\n]*(?:const|noexcept|override|final))*'
    r'(?:[ \t\n]*:[^;{]*)?[ \t\n]*\{', re.M)

# File-scope data. Anchored at column zero, since file-scope definitions are
# conventionally unindented and locals are not; a miss only costs a widening
# pass, so the heuristic is allowed to be loose.
RE_DATA_DEF = re.compile(
    r'^(?:static[ \t]+|const[ \t]+|volatile[ \t]+)*'
    r'[A-Za-z_][A-Za-z0-9_]*(?:[ \t]*[\*&][ \t]*|[ \t]+)'
    r'([A-Za-z_][A-Za-z0-9_]*)[ \t]*(?:\[[^\]]*\])?[ \t]*[=;]', re.M)

# C++20 modules, recognised so that a tree using them is told so rather than
# left with the compiler's word for it. `import hello;' fails as `module
# 'hello' not found', which reads exactly like a missing include path and
# sends the reader looking for a -I that would not have helped.
#
# Keyed on the source rather than on that message on purpose: the wording is
# the compiler's and differs between vendors and releases, and only clang's
# has been measured here. What a file says about itself does not.
RE_MODULE_IFACE = re.compile(
    r'^[ \t]*export[ \t]+module[ \t]+([A-Za-z_][A-Za-z0-9_.:]*)', re.M)
RE_MODULE_IMPORT = re.compile(
    r'^[ \t]*(?:export[ \t]+)?import[ \t]+([A-Za-z_][A-Za-z0-9_.:]*)[ \t]*;',
    re.M)

RE_MAIN = re.compile(r'(?:^|[;}\s])main[ \t\n]*\([^;{)]*\)[ \t\n]*\{', re.M)

# Qt writes a test's entry point with a macro, so a QtTest translation unit
# has no main() in its text at all -- which made it root nothing, and then
# nothing reached it, and fmake reported it as defining nothing reachable
# and moved on. One project saw 547 such lines and concluded that symbol
# reachability does not work for Qt.
#
# This is the usual split, not an exception to it: the macro is a *proposal*
# that the file is a program, and the object settles it. A file whose object
# turns out to export no main() is already handled -- see the mirage cache
# in the target loop -- so a wrong guess here costs one compile.
RE_MACRO_MAIN = re.compile(
    r"(?:^|[;}\s])QTEST_(?:APPLESS_|GUILESS_)?MAIN[ \t]*\(", re.M)

# An explicit template instantiation is a definition and looks like neither
# shape above: `template struct Box<int>;` has no parameter list and no
# initialiser. It is how a project with `extern template` in its headers
# keeps one copy of each instantiation, and the file holding them is
# routinely reachable from nothing -- no header of its own, so the include
# graph never proposes it and widening had nothing to match on.
#
# The negative lookahead is what separates an instantiation from the primary
# template: `template <class T> struct Box {` declares, `template struct
# Box<int>;` defines. Anchoring at the start of a line excludes `extern
# template`, which declares too.
RE_TEMPLATE_INST = re.compile(r'^[ \t]*template[ \t]+(?![<])([^;{]*)[;{]', re.M)

# An explicit *specialization*, which the lookahead above excludes along with
# the primary template it was written to exclude -- `template <>` opens with
# the `<` that says "not an instantiation". It is a definition all the same,
# and it sits in the same place: declared in a header so users get an
# undefined reference rather than the primary's own code, defined in a file
# with no header of its own, which the include graph therefore never
# proposes.
#
# The member spelling was already caught, but only by accident -- `int
# Box<int>::twice() const {` is a name, a parameter list and a brace, so the
# function pattern matches it. The free-function spelling is not, because
# `twice<int>(` puts a `<` where that pattern needs a `(`. One of the two
# working is exactly the half-fix section 19 warned about while fixing the
# instantiation shape and missing this one.
#
# The capture stops at the parameter list rather than running to the brace,
# so a parameter's name does not become a symbol to widen on. Requiring the
# brace is what separates the definition from the declaration beside it in
# the header.
RE_TEMPLATE_SPEC = re.compile(
    r'^[ \t]*template[ \t]*<[ \t]*>([^;{(]*)\([^;{]*\)[^;{]*\{', re.M)

# Words that turn up inside a declaration and are never what a symbol is
# called. Over-proposing costs one compile the closure then ignores, so this
# only has to catch the common noise, not every keyword there is.
DECL_WORDS = {"if", "for", "while", "switch", "catch", "return", "sizeof",
              "class", "struct", "union", "enum", "typename", "template",
              "const", "constexpr", "inline", "static", "extern", "void",
              "bool", "char", "short", "int", "long", "float", "double",
              "signed", "unsigned", "auto", "operator"}

# What makes a file Qt's meta-object compiler's business. Unlike everything
# else scanned for here this is a token rather than a shape, because that is
# what Qt made it: a macro whose whole job is to mark the class. It is the
# one framework-specific name in the file, and the moc section says why it
# earns that.
RE_QOBJECT = re.compile(
    r'\bQ_(?:OBJECT|GADGET|GADGET_EXPORT|NAMESPACE|NAMESPACE_EXPORT)\b')

# Qt resource paths, as they are written in code: ":/icons/open.png", or
# "qrc:/..." when a URL is wanted. Matched against the comment-stripped text,
# which keeps string literals -- the literal is the whole point here, and a
# path named in a comment is not a use.
RE_QRC_PATH = re.compile(r'"(?:qrc)?:(/[^"\\\n]*)"')

# The other way a program says it wants a resource, and the exact one: this
# expands to a call to qInitResources_<name>, so the symbol does the rest.
RE_QRC_INIT = re.compile(
    r'\bQ_INIT_RESOURCE\s*\(\s*([A-Za-z_][A-Za-z0-9_]*)\s*\)')


# A source that supplies its own fallback for a macro the build normally
# defines. The discriminator against an include guard is the VALUE: a guard
# is `#define FZN_VERSION_H' with nothing after it, a fallback is
# `#define BBQ_VERSION_STRING "unknown"'. Matching on the name alone counts
# every version.h in the workspace, which is how the first measurement of
# this got three projects where there are two.
RE_IFNDEF_ANY = re.compile(r"^[ \t]*#[ \t]*ifndef[ \t]+([A-Za-z_]\w*)", re.M)
RE_DEFINE_VALUED = re.compile(
    r"^[ \t]*#[ \t]*define[ \t]+([A-Za-z_]\w*)[ \t]+(\S[^\n]*)", re.M)


def version_fallbacks(code):
	"""Version macros this file defines for itself when the build does not.

    Reported rather than resolved: fmake cannot know that "unknown" is wrong,
    only that the tree carries a VERSION file saying something else.
    """
	guarded = {n for n in RE_IFNDEF_ANY.findall(code) if "VERSION" in n}
	valued = {n for n, _v in RE_DEFINE_VALUED.findall(code)}
	return sorted(guarded & valued)


# What an assembly file exports. `.globl'/`.global' is the whole of it:
# a bare label is file-local until one of those names it, which is exactly
# the set another translation unit could refer to.
#
# This is needed for one reason and it is not the link. Symbol closure reads
# `nm', so a compiled object needs no help -- but widen_candidates decides
# what is worth compiling in the first place from the scan, and a language
# whose defs are always empty can never be proposed. Assembly was recognised,
# skipped as "nothing reaches it", and the link then failed naming the symbol
# it held.
RE_ASM_GLOBAL = re.compile(
    r"^[ \t]*\.(?:globl|global)[ \t]+([A-Za-z_.$][\w.$]*)", re.M)

# A crate's module declarations, which are what say the crate is more than
# one file. The semicolon is load-bearing: `mod name { ... }' is a module
# written inline and names no file at all, so matching without it would
# propose a member that does not exist. `#[path = "..."]' overrides where
# the file is, and is read because not reading it is silent -- the member
# is simply missed, and the crate then builds from fewer files than it has.
RE_RUST_MOD = re.compile(
    r'(?:#\s*\[\s*path\s*=\s*"([^"]*)"\s*\]\s*)?'
    r'(?:pub(?:\s*\([^)]*\))?\s+)?\bmod\s+([A-Za-z_]\w*)\s*;')
# `fn main()' at the outermost level. Indentation is what tells it from a
# nested one, which is crude and is what the object settles afterwards --
# the same bargain section 3 already makes for C, where a main() behind an
# #if is seen by the scan and disowned by the symbol table.
RE_RUST_MAIN = re.compile(r'(?m)^(?:pub\s+)?(?:async\s+)?fn\s+main\s*\(')


def rust_mods(code):
	"""(name, explicit path or None) for every `mod name;' in a crate file."""
	out = []
	for m in RE_RUST_MOD.finditer(code):
		out.append([m.group(2), m.group(1)])
	return out


def scan_source(path):
	"""Read one source file and return its scan record."""
	with open(path, "r", encoding="utf-8", errors="replace") as fh:
		text = fh.read()
	code, comments = strip_comments(text)
	lang = LANGS.get(os.path.splitext(path)[1], _C)

	incs = []
	if lang.cpp:
		# A `.s' is assembled as it stands, so a line beginning `#include'
		# in one is not an include -- it is a comment on most targets and a
		# syntax error on the rest. Reading it as one would put a header on
		# a candidate set for a file that cannot include anything.
		for m in RE_INCLUDE.finditer(code):
			lineno = code.count("\n", 0, m.start()) + 1
			incs.append([m.group(1), m.group(2), lineno])

	mods, rust_main = [], False
	if lang.unit == "crate":
		mods = rust_mods(code)
		rust_main = bool(RE_RUST_MAIN.search(code))

	if lang.unit == "crate":
		# Deliberately empty. `defs' exists so widen_candidates can propose
		# a file from a symbol it might define, and a crate is never
		# proposed that way: it is built up front like a vendored archive
		# and joins a link set only if the closure reaches it. Scanning for
		# `#[no_mangle]' would be a second, weaker answer to a question the
		# archive's own symbol table already answers exactly.
		defs = set()
	elif not lang.cpp or lang.tag == "AS ":
		defs = set(RE_ASM_GLOBAL.findall(code))
	else:
		defs = set(RE_FUNC_DEF.findall(code)) | set(RE_DATA_DEF.findall(code))
		defs |= set(RE_MEMBER_DEF.findall(code))
		for m in RE_TEMPLATE_INST.finditer(code):
			defs |= set(re.findall(r"[A-Za-z_][A-Za-z0-9_]*", m.group(1)))
		for m in RE_TEMPLATE_SPEC.finditer(code):
			defs |= set(re.findall(r"[A-Za-z_][A-Za-z0-9_]*", m.group(1)))
		defs -= DECL_WORDS
	_dirs_and_typos = parse_directives(comments)

	return {
	    "incs":     incs,
	    "has_main": rust_main if lang.unit == "crate" else
	                bool(RE_MAIN.search(code)
	                     or RE_MACRO_MAIN.search(code)),
	    # The crate's `mod' declarations: [name, explicit path or None].
	    # Empty for every other language, and the reason a crate root can
	    # be told from a module file before rustc has run.
	    "mods":     mods,
		# Against the stripped text, for the same reason main() is: the word
		# in a comment or a string is not a declaration.
	    "qobject":  bool(RE_QOBJECT.search(code)),
	    "modiface": sorted(set(RE_MODULE_IFACE.findall(code))),
	    "modimp":   sorted(set(RE_MODULE_IMPORT.findall(code))),
	    "qrc":      sorted(set(RE_QRC_PATH.findall(code))),
	    "qrc_init": sorted(set(RE_QRC_INIT.findall(code))),
	    "verfall":  version_fallbacks(code),
	    "defs":     sorted(defs),
	    "dirs":     _dirs_and_typos[0],
	    # Recorded with the scan rather than warned about while
	    # scanning, because a scan is cached: a warning printed here
	    # would appear once and never again, which is worse than not
	    # printing it. Reported at build time from this.
	    "typos":    _dirs_and_typos[1],
	}

# ---------------------------------------------------------------------------
# fmake.toml
#
# Optional, and absent in the common case. It exists for the facts that are
# neither inferable nor properties of a single file: what a target is called
# when no file roots it, which files belong to which of two libraries, where
# things install, and what toolchain to build with.
#
# Declarative on purpose -- no conditionals, no interpolation, no computed
# values. The premise of the project is that build configuration should be
# short enough to read at a glance, and the way tools lose that is by growing
# a language. Anything genuinely needing logic belongs in fmake.py.
#
# The split between here and annotations follows the same line as @cflags
# versus @ldflags: the compile side is a property of a file, the link side is
# a property of an artifact. So [target.*] carries link-side keys only. A
# per-target compile flag would mean the same source compiled two ways, which
# means per-target object directories, which nothing has asked for yet.
#
# Unknown keys are an error, unlike unknown directives, which are ignored.
# The difference is that a comment is shared with Doxygen and may legitimately
# contain commands that are not fmake's, whereas this file belongs to fmake
# alone -- so a key it does not recognise is a typo, every time.
# ---------------------------------------------------------------------------

CONF_FILE = "fmake.toml"

S, L = "str", "list"      # scalar string, list of strings
B = "bool"                # true/false, for a fact with two answers
N = "int"                 # a whole number, for a count or a duration

CONF_SCHEMA = {
    "project": {
        "name": S, "std": S, "profile": S,
        "cflags": L, "ldflags": L, "defines": L, "define": L,
        "libs": L, "pkg": L, "exclude": L, "include-dirs": L,
        "test-timeout": N, "test-env": L, "rustflags": L,
    },
    "profile": {"*": {
        "std": S, "cflags": L, "ldflags": L, "defines": L, "define": L,
        "rustflags": L,
    }},
	# `target` alongside `name`, because the directive is @target: the same
	# fact should not need a different word for being written in a different
	# file. Same reason [project] takes `define` beside `defines`.
    "target": {"*": {
        "name": S, "target": S, "kind": S, "root": S,
        "sources": L, "libs": L, "pkg": L, "ldflags": L, "headers": L,
        "test": B, "test-group": S, "test-args": L,
        "test-timeout": N, "test-env": L, "version": S, "description": S,
    }},
    "generate": {"*": {
        "command": S, "inputs": L, "outputs": L, "depends": L,
        "uses": S, "description": S, "depfile": S,
    }},
    "install": {
        "prefix": S, "bindir": S, "libdir": S, "includedir": S,
    },
    "toolchain": {
        "cc": S, "cxx": S, "ar": S, "nm": S, "pkg-config": S,
        "moc": S, "uic": S, "rcc": S, "rustc": S, "rust-edition": S,
        "sysroot": S, "os": S, "arch": S, "lib-dirs": L,
    },
	# The machine doing the building, as opposed to the one being built for.
	# Only generators need it: a tool named by `uses` is compiled in order to
	# be run here, so on a cross build it cannot come from [toolchain] -- and
	# it carries its own flags for the same reason, since -march=armv8-a is
	# not something the build machine's compiler will accept.
    "build-toolchain": {
        "cc": S, "cxx": S, "ar": S, "nm": S, "pkg-config": S,
        "sysroot": S, "os": S, "arch": S, "lib-dirs": L,
        "cflags": L, "defines": L, "std": S,
    },
}


def _conf_check(table, spec, where, out):
	for key, value in table.items():
		kind = spec.get(key)
		if kind is None:
			near = ", ".join(sorted(spec))
			out.append(f"{where}: unknown key {key!r}"
			           + (f" (expected one of: {near})" if near else ""))
			continue
		if kind is S:
			if not isinstance(value, str):
				out.append(f"{where}.{key}: expected a string")
		elif kind is L:
			if not (isinstance(value, list)
			        and all(isinstance(v, str) for v in value)):
				out.append(f"{where}.{key}: expected a list of strings")
		elif kind is B:
			if not isinstance(value, bool):
				out.append(f"{where}.{key}: expected true or false")
		elif kind is N:
			# bool is an int in Python and would pass silently, which is
			# how `test-timeout = true` becomes a one-second timeout.
			if isinstance(value, bool) or not isinstance(value, int):
				out.append(f"{where}.{key}: expected a whole number")
			elif value < 0:
				out.append(f"{where}.{key}: expected 0 or more "
				           f"(0 means no limit)")


def load_conf(root):
	"""Read and validate fmake.toml. Returns {} when there is no file."""
	path = os.path.join(root, CONF_FILE)
	if not os.path.isfile(path):
		return {}
	try:
		with open(path, "rb") as fh:
			data = tomllib.load(fh)
	except tomllib.TOMLDecodeError as exc:
		die(f"{CONF_FILE}: {exc}")
	except OSError as exc:
		die(f"{CONF_FILE}: {exc}")

	problems = []
	for section, value in data.items():
		spec = CONF_SCHEMA.get(section)
		if spec is None:
			problems.append(f"{CONF_FILE}: unknown section [{section}] "
			                f"(expected one of: "
			                f"{', '.join(sorted(CONF_SCHEMA))})")
			continue
		if not isinstance(value, dict):
			problems.append(f"{CONF_FILE}: [{section}] must be a table")
			continue
		if "*" in spec:
			for name, sub in value.items():
				if not isinstance(sub, dict):
					problems.append(f"{CONF_FILE}: [{section}.{name}] must "
					                f"be a table")
					continue
				_conf_check(sub, spec["*"], f"[{section}.{name}]", problems)
		else:
			_conf_check(value, spec, f"[{section}]", problems)

	if problems:
		die(f"{CONF_FILE} is not valid:\n    " + "\n    ".join(problems))
	return data


class Conf:
	"""Typed access to fmake.toml, with the selected profile folded in."""

	def __init__(self, data, profile=None):
		self.data     = data or {}
		self.project  = self.data.get("project", {})
		self.targets  = self.data.get("target", {})
		self.install  = self.data.get("install", {})
		self.tool     = self.data.get("toolchain", {})
		self.build_tool_conf = self.data.get("build-toolchain", {})
		profiles      = self.data.get("profile", {})
		self.profile_name = profile or self.project.get("profile")
		if self.profile_name and self.profile_name not in profiles:
			die(f"{CONF_FILE}: no profile {self.profile_name!r} "
			    f"(defined: {', '.join(sorted(profiles)) or 'none'})")
		self.profile = profiles.get(self.profile_name, {})

	def __bool__(self):
		"""True when this project configures anything at all.

        Careful: this makes an empty-but-real Conf falsy, so `conf or
        default` is a trap. Test `is None` when a default is wanted.
        """
		return bool(self.data or self.project or self.targets)

	def cflags(self):
		"""Project then profile, so the profile has the last word."""
		out = []
		for src in (self.project, self.profile):
			out += ["-D" + d for d in
			        src.get("defines", []) + src.get("define", [])]
			std = src.get("std")
			if std:
				out.append("-std=" + std)
			out += src.get("cflags", [])
		return out

	def ldflags(self):
		return self.project.get("ldflags", []) + self.profile.get("ldflags", [])

	def rustflags(self):
		return (self.project.get("rustflags", [])
		        + self.profile.get("rustflags", []))

	def target(self, name):
		return self.targets.get(name, {})

# ---------------------------------------------------------------------------
# Generated sources
#
# A .c produced by flex, bison or protoc does not exist when the tree is
# scanned, so nothing downstream can see it: not the include graph, not the
# closure, not the symbol tables. The fix is simply to run the generators
# first. Everything after that treats the results as ordinary sources, which
# is why this needs no second scanning pass -- the earlier guess that it would
# was wrong.
#
# Declared in fmake.toml rather than inferred, because the command is not
# recoverable from the file. A .y could be bison or byacc, with or without a
# header, and guessing wrong produces a build that fails in a way nobody can
# read.
#
#     [generate.parser]
#     command = "bison -d -o $out $in"
#     inputs  = ["src/parser.y"]
#     outputs = ["src/parser.c", "src/parser.h"]
#
# No shell, matching section 8: the command is split once and executed directly, so
# there is no quoting to get wrong and no /bin/sh in the loop. A rule that
# genuinely needs a pipe should call a script, which is also the point at which
# it has stopped being declarative.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# fmake.mk -- generator rules in Makefile syntax
#
# [generate.*] is a Makefile rule wearing TOML, and it cannot say the one
# thing Make says best: a pattern. Twenty .proto files need twenty sections,
# or one section that hands every input to a single command, which is not
# what anyone means.
#
#     gen/%.c: proto/%.msg
#     	python3 gen.py $< $@
#
# A deliberate subset, and the narrowness is the point. Full Make is
# Turing-complete -- $(shell), $(foreach), $(call) -- and adopting it whole
# would rebuild the thing fmake.py was declined for. What is here has no
# variables, no functions, no conditionals: rules, patterns, and the three
# automatic variables everyone knows. It cannot grow into a program.
#
# Recipes ARE shell, unlike everything fmake constructs for itself. The two
# cases are different: fmake knows the exact argv for a compile, so a shell
# there is a fork per file and a quoting hazard for nothing. A recipe is the
# user's own text, where a pipe or a redirect is ordinary -- and the Makefile
# --eject emits runs recipes through /bin/sh regardless, so refusing them here
# meant fmake declining to do what the build file it generates would do.
#
# Automatic variables are substituted shell-quoted, so a path with a space
# survives being interpolated into a command line.
# ---------------------------------------------------------------------------

MK_FILE = "fmake.mk"

RE_MK_RULE = re.compile(r"^([^\t#][^:=]*?)\s*:\s*([^=].*)?$")
RE_MK_UNSUPPORTED = re.compile(
    r"^\s*(?:ifeq|ifneq|ifdef|ifndef|else|endif|include|sinclude|"
    r"vpath|export|unexport|define|override)\b")

# .PHONY names a rule that produces no file and is run only when asked for by
# name. Flashing an eeprom, packaging, deploying: things a build tree needs to
# do that are not the building of a file, and that a generator cannot express
# because they are not something anything else depends on.


# Directives that mean something without a file to be about. The rest --
# @target, @kind, @sources, @os, @arch, @headers -- are facts about one
# translation unit or one artifact, and there is no such context in fmake.mk.
MK_PROJECT_DIRECTIVES = {"cflags", "ldflags", "define", "std", "libs", "pkg"}

# What [target.*] actually accepts, so a diagnostic can offer it and be
# right. Derived from the schema rather than restated, because a second copy
# is a second thing to forget when a key is added.
CONF_TARGET_DIRECTIVES = set(CONF_SCHEMA["target"]["*"]) | {"defines"}


def parse_mk(path=None, text=None, origin=None, first_line=1,
             directives=None):
	"""Parse Makefile-syntax rules from fmake.mk, or from a comment.

    The same function for both on purpose. A rule written in a `@rule`
    directive and a rule written in fmake.mk are the same language because
    they go through the same parser -- not because two parsers were kept in
    step, which is a thing that stops being true.
    """
	where = origin or MK_FILE
	if text is None:
		try:
			with open(path, errors="replace") as fh:
				text = fh.read()
		except OSError as exc:
			die(f"{where}: {exc}")

	text = text.replace("\\\n", " ")
	rules, current, phony = [], None, set()
	for n, raw in enumerate(text.split("\n"), first_line):
		line = raw.split("#", 1)[0] if not raw.startswith("\t") else raw
		if not line.strip():
			continue

		if raw.startswith("\t"):
			if current is None:
				die(f"{where}:{n}: recipe line before any rule")
			current["commands"].append(line.strip())
			continue

		# A directive line, the same spelling a comment uses. fmake.mk then
		# holds everything a simple project needs in one file, instead of
		# splitting a pattern rule and a project flag across two.
		d = RE_DIRECTIVE.match(line.strip())
		if d and directives is not None:
			dname = DIRECTIVE_ALIAS.get(d.group(1), d.group(1))
			if dname in MK_PROJECT_DIRECTIVES:
				directives.setdefault(dname, []).extend(
				    shlex.split(d.group(2)))
				current = None
				continue
			if dname in DIRECTIVES:
				# Only name a remedy that exists. @pkg_optional has no
				# [target.*] key, so offering one sends the reader to write
				# something fmake will then reject -- section 31, and this is the
				# message that would do it.
				where_else = ("Put it in the source file it is about."
				              if dname not in CONF_TARGET_DIRECTIVES else
				              f"Put it in the source file it is about, or "
				              f"in {CONF_FILE} under [target.*].")
				die(f"{where}:{n}: @{dname} is a fact about one file or one "
				    f"target, and {MK_FILE} has neither.\n{where_else}")
			die(f"{where}:{n}: unknown directive @{dname}")

		if RE_MK_UNSUPPORTED.search(line):
			die(f"{where}:{n}: {line.strip()!r}\n"
			    f"{where} is rules only -- no variables, functions or "
			    f"conditionals.\nAnything needing those is a script, and a "
			    f"rule can call one.")

		m = RE_MK_RULE.match(line)
		if m and m.group(1).strip() == ".PHONY":
			phony.update((m.group(2) or "").split())
			current = None
			continue
		if not m:
			die(f"{where}:{n}: expected `targets: prerequisites`, "
			    f"got {line.strip()!r}")

		targets = m.group(1).split()
		rest = (m.group(2) or "").split("|")
		prereqs = rest[0].split()
		order_only = rest[1].split() if len(rest) > 1 else []
		current = {"line": n, "origin": where, "outputs": targets,
		           "inputs": prereqs, "depends": order_only, "commands": []}
		rules.append(current)

	for r in rules:
		if not r["commands"]:
			die(f"{r['origin']}:{r['line']}: rule for "
			    f"{' '.join(r['outputs'])} has no recipe")
		r["phony"] = any(o in phony for o in r["outputs"])
	return rules


def expand_mk_rules(rules, root, src_set):
	"""Turn pattern rules into one concrete rule per matching file.

    `gen/%.c: proto/%.msg` becomes a rule per .msg, with the stem carried
    through. This is the capability that TOML has no way to express, and the
    reason for the file.
    """
	out = {}
	for r in rules:
		if r.get("phony"):
			continue            # run when named, never as part of a build
		pattern = [t for t in r["outputs"] + r["inputs"] if "%" in t]
		if not pattern:
			name = _mk_ident(r["outputs"][0])
			out[name] = dict(r, stem=None)
			continue
		if any(t.count("%") > 1 for t in r["outputs"] + r["inputs"]):
			die(f"{r['origin']}:{r['line']}: more than one % in a rule")
		if not any("%" in i for i in r["inputs"]):
			die(f"{r['origin']}:{r['line']}: a pattern target needs a pattern "
			    f"prerequisite to take its stem from")
		# The stem is the text between the fixed halves of the prerequisite,
		# taken by position. A `*` beside the `%` makes those halves a
		# pattern rather than text, so the slice lands in the wrong place
		# and the stem comes out as a fragment of a path -- `p/bmp` from
		# `schemas/*/%.msg`, which then failed by saying that
		# `schemas/*/p/bmp.msg` matched nothing, a path nobody wrote.
		for i in r["inputs"]:
			if "%" in i and any(c in i for c in "*?["):
				die(f"{r['origin']}:{r['line']}: {i} mixes % with a glob. "
				    f"The stem is taken by position, so the two cannot "
				    f"share a prerequisite -- write one rule per directory, "
				    f"or a rule whose fixed part is literal.")

		src = next(i for i in r["inputs"] if "%" in i)
		head, _, tail = src.partition("%")
		hits = sorted(glob.glob(os.path.join(root, head + "*" + tail),
		                        recursive=True))
		for hit in hits:
			rel = os.path.relpath(hit, root)
			stem = rel[len(head):len(rel) - len(tail)] if tail else rel[len(head):]
			sub = lambda s: s.replace("%", stem)
			name = _mk_ident(sub(r["outputs"][0]))
			out[name] = {
			    "line": r["line"], "origin": r["origin"], "stem": stem,
			    "outputs": [sub(t) for t in r["outputs"]],
			    "inputs": [sub(i) for i in r["inputs"]],
			    "depends": [sub(d) for d in r["depends"]],
			    "commands": list(r["commands"]),
			}
	return out


def _recipe_prefix(line):
	"""Strip Make's recipe prefixes and report what they meant.

    `@` suppresses the echo, `-` ignores a failure. Both are idiomatic enough
    that passing them to the shell -- which reads @echo as a program name --
    is the wrong kind of literal-mindedness.
    """
	quiet = ignore = False
	while line[:1] in ("@", "-"):
		quiet |= line[0] == "@"
		ignore |= line[0] == "-"
		line = line[1:]
	return line.lstrip(), quiet, ignore


def _gen_command(command, ins, outs, tool=None, stem=None):
	"""Substitute the automatic variables into a shell command line.

    Quoted on the way in, so a path containing a space survives being
    interpolated into text that a shell will re-split.
    """
	q = shlex.quote
	for key, val in (("$^", " ".join(q(i) for i in ins)),
	                 ("$@", " ".join(q(o) for o in outs)),
	                 ("$in", " ".join(q(i) for i in ins)),
	                 ("$out", " ".join(q(o) for o in outs)),
	                 ("$<", q(ins[0]) if ins else ""),
	                 ("$*", q(stem) if stem else ""),
	                 ("$tool", q(tool) if tool else "")):
		command = command.replace(key, val)
	return command


def _gen_argv(command, ins, outs, tool=None, stem=None):
	"""Substitute $in and $out into an argv, not into a string.

    Splitting first and substituting after means a path containing a space
    stays one argument.
    """
	# $in/$out are fmake.toml's spelling; $< $@ $^ $* are Make's. Both are
	# accepted everywhere, because a rule should not mean something different
	# for having been written in the other file.
	whole = {"$in": ins, "$out": outs, "$^": ins, "$@": outs}
	first = {"$<": ins[0] if ins else "", "$*": stem or "",
	         "$tool": tool or ""}
	argv = []
	for tok in shlex.split(command):
		if tok in whole:
			argv += whole[tok]
		elif tok == "$tool" and tool:
			argv.append(tool)
		else:
			for key, val in first.items():
				tok = tok.replace(key, val)
			tok = (tok.replace("$in", ins[0] if ins else "")
			          .replace("$out", outs[0] if outs else "")
			          .replace("$@", outs[0] if outs else "")
			          .replace("$^", " ".join(ins)))
			argv.append(tok)
	return argv


def _gen_order(rules):
	"""Rules sorted so that a generator's inputs are produced before it runs.

    Alphabetical would be deterministic but arbitrary, and one generator
    feeding another is ordinary -- protoc emitting a .cc that a second rule
    post-processes.
    """
	produced = {}
	for name, r in rules.items():
		for out in r.get("outputs", []):
			produced[out] = name

	order, state = [], {}

	def visit(name, chain):
		if state.get(name) == "done":
			return
		if state.get(name) == "busy":
			die(f"{CONF_FILE}: [generate.*] rules form a cycle: "
			    + " -> ".join(chain + [name]))
		state[name] = "busy"
		for src in (rules[name].get("inputs", [])
		            + rules[name].get("depends", [])):
			upstream = produced.get(src)
			if upstream and upstream != name:
				visit(upstream, chain + [name])
		state[name] = "done"
		order.append(name)

	for name in sorted(rules):
		visit(name, [])
	return order


def phony_rules(root):
	"""The .PHONY rules in fmake.mk, by name."""
	path = os.path.join(root, MK_FILE)
	if not os.path.isfile(path):
		return {}
	out = {}
	for r in parse_mk(path, directives={}):
		if r.get("phony"):
			for target in r["outputs"]:
				out[target] = r
	return out


def _kill_group(proc):
	"""Stop a test and everything it started, politely then not.

    SIGTERM first, because a test that installed a handler may want to
    unlink a temporary file; SIGKILL after a moment, because one that
    ignores TERM is exactly the kind that needed a deadline. The signal
    goes to the group, which is why the child was given its own.
    """
	for sig, grace in ((signal.SIGTERM, 3), (signal.SIGKILL, 3)):
		try:
			os.killpg(proc.pid, sig)
		except (ProcessLookupError, PermissionError, OSError):
			proc.kill()
		try:
			proc.wait(timeout=grace)
			return
		except subprocess.TimeoutExpired:
			continue
	# Both deadlines passed and it is still there, which after SIGKILL means
	# it is stuck in the kernel rather than ignoring us. Reap what can be
	# reaped and say the rest out loud: a child nobody waits on is a zombie
	# for the rest of the run, and a test that cannot be killed is worth a
	# line rather than a silent abandonment.
	if proc.poll() is None:
		warn(f"a test could not be stopped (pid {proc.pid}); it is left "
		     f"running and may still hold a terminal or a port")


def describe_exit(rc):
	"""What a non-zero status was.

    A test killed by SIGSEGV and one that returned 1 are different findings
    and Python reports both as a negative or positive number. Saying which
    is the difference between "the assertion failed" and "it crashed", and
    the second is not something to go looking through test output for.
    """
	if rc < 0:
		try:
			return f"killed by {signal.Signals(-rc).name}"
		except ValueError:
			return f"killed by signal {-rc}"
	return f"exit {rc}"


DEFAULT_TEST_TIMEOUT = 60


RE_BIN_REF = re.compile(r"\$bin\(([^)]*)\)")


def _sub_bin(item, where, paths):
	"""Resolve `$bin(NAME)' to where this build puts NAME.

    A test that runs the program it is testing has to be told where it is,
    and the name is the build's to know rather than the reader's to repeat.
    bbq-predictor sets BBQ_APP_BINARY to the artifact it just built; spelled
    literally that is the target's filename written twice, and the copy in
    fmake.toml is the one that goes stale when the other changes.

    The value is the path this build itself uses to reach that target, so
    the test is handed exactly what fmake would run. That is where the
    output goes -- absolute when BUILD_DIR is -- for a live run, and `./NAME'
    in an ejected build, whose recipe invokes it that way from the tree root.
    The two spellings differ and resolve to the same file, which is the same
    trade the ejected build makes everywhere else: it is a snapshot of this
    build, not a translation of it.

    An unknown name is refused rather than left as text: a literal
    `$bin(typo)' in the environment is a test looking for a file called
    `$bin(typo)', which reports as something else entirely.
    """
	if paths is None:
		return item

	def one(m):
		name = m.group(1).strip()
		if name not in paths:
			known = ", ".join(sorted(paths)) or "none"
			die(f"{where} test-env: $bin({name}) names no target here "
			    f"(this build has: {known})")
		return paths[name]

	return RE_BIN_REF.sub(one, item)


def bin_deps(conf, tests, names):
	"""Targets these tests name with `$bin()', as build prerequisites.

    A test handed the path of a program needs the program, and an ejected
    build has to say so in its own vocabulary or `make test' runs the suite
    against something nobody built. Measured before this existed: the
    ejected Makefile ran the test, the test could not open `./app', and the
    live run had been correct for a fortnight because it builds what
    test-env asks for.
    """
	want = set()
	for src_list in [conf.project.get("test-env", [])] + [
	        t.conf.get("test-env", []) for t in tests]:
		for item in src_list:
			want |= {n.strip() for n in RE_BIN_REF.findall(item)}
	return sorted({names[n] for n in want if n in names})


def test_env_pairs(conf, t, paths=None):
	"""KEY=VALUE settings for one test, project first and target after.

    A list of KEY=VALUE rather than a table because the schema has no table
    type and because `defines' is already spelled this way -- the same shape
    should not need a second syntax for being about the environment.

    It exists because a test binary's environment is part of how a project
    runs its suite, and fmake could not say it. beerssh's test target sets
    three variables: `QT_QPA_PLATFORM=offscreen', without which a widget
    test waits on an event loop that never turns, and QTest's
    `QTEST_DISABLE_STACK_DUMP' and `QTEST_DISABLE_CORE_DUMP', which stop a
    failing test attaching gdb to itself. That last pair is not a
    preference: a tracer becomes the reaping parent and a stopped process
    ignores SIGTERM, so a suite run without them leaves debuggers attached
    to binaries nobody can kill. Measured while evaluating that tree -- two
    runs, two orphans, gdb attached to both.
    """
	out = []
	for where, src in (("[project]", conf.project.get("test-env", [])),
	                   (f"[target.{t.name}]", t.conf.get("test-env", []))):
		for item in src:
			if "=" not in item:
				die(f"{where} test-env wants KEY=VALUE, not {item!r}")
			out.append(_sub_bin(item, where, paths))
	return out


def run_tests_now(targets, root, outdir, conf, dry_run=False, known=None):
	"""Build step done; now run them. Returns a process exit status.

    Sequentially and in name order, because a test suite that passes only
    on an idle machine is a test suite that will fail in CI and nowhere
    else, and because interleaved output from parallel binaries is unusable
    for the one thing anybody wants it for.

    From the project root, since that is where a test's relative paths were
    written to work -- `./tests/client_test ../doc/schema/socket.json` is
    one project's real command line, and `test-args` exists for it.

    Each test gets a deadline. hydra has 26 live drivers, and running its
    suite stopped at 47 of 66 because one of them was still fetching a real
    website several minutes in -- nothing wrong with the test, but a runner
    with no limit lets one of them suspend the whole suite and throw away
    the results already collected. Per test rather than per suite: a shared
    budget makes one slow test steal from the others and makes the outcome
    depend on the order they run in.
    """
	default = conf.project.get("test-timeout", DEFAULT_TEST_TIMEOUT)
	# Every target, not only the tests: what a test wants the path of is
	# usually the program under test, which is not itself a test.
	bin_paths = {x.name: os.path.join(outdir, x.filename)
	             for x in (known if known is not None else targets)}
	# What was built is not what is run. `fmake test myapp` builds the
	# program and the tests, and running the program as a test would report
	# its exit status as a test result -- which it did, and counted it. The
	# caller has already narrowed this to the groups asked for.
	failed = []
	# Neither a pass nor a failure, and it needs its own count for the
	# tally to stop contradicting the prose above it: fmake said "this is
	# not a test that failed" and then printed "1 of 1 failed".
	not_run = []
	for t in sorted(targets, key=lambda x: x.name):
		exe = os.path.join(outdir, t.filename)
		argv = [exe] + list(t.conf.get("test-args", []))
		limit = t.conf.get("test-timeout", default) or None
		pairs = test_env_pairs(conf, t, bin_paths)
		# Inherited and added to rather than replaced: a test needs PATH
		# and HOME like anything else, and a caller who exported something
		# meant it.
		env = None
		if pairs:
			env = dict(os.environ)
			env.update(dict(p.split("=", 1) for p in pairs))
		if dry_run:
			say(f"{CYAN('RUN')} {_show_cmd(argv, root)}")
			continue
		say(f"{CYAN('RUN')} {t.name}")
		# Ours is buffered and the child's is not, so without this the test
		# output arrives above the line naming the test that produced it --
		# and with several tests, above the wrong one.
		PROGRESS.flush()
		try:
			# Its own process group, so the deadline reaches whatever the
			# test started. A test that hangs on the network usually hangs
			# with a helper alive, and killing only the process fmake
			# launched leaves that helper holding the terminal.
			proc = subprocess.Popen(argv, cwd=root, start_new_session=True,
			                        env=env)
		except OSError as exc:
			warn(f"{t.name}: {exc}")
			# ENOEXEC is the kernel saying this binary is not for this
			# machine, which in a tree that has just built it means the
			# tests were cross-compiled along with everything else. Left
			# as the raw OSError it reads as a broken test: the reader
			# sees `Exec format error' and `1 of 1 failed' and has no
			# reason to connect either to [toolchain] arch, which may be
			# several files away in fmake.toml.
			#
			# Keyed on the errno rather than on the configuration because
			# the errno *is* the fact -- a native build cannot produce
			# one, so this cannot fire on a native tree, and it holds for
			# any target rather than only the ones fmake knows by name.
			if exc.errno == errno.ENOEXEC:
				note(f"{t.name} was built for another machine, so it was "
				     f"not run -- this is not a test that failed")
				note("a test meant to run during a cross build has to be "
				     "built for this machine, which is what "
				     "[build-toolchain] is for")
				not_run.append(t.name)
			else:
				failed.append(t.name)
			continue
		try:
			rc = proc.wait(timeout=limit)
		except subprocess.TimeoutExpired:
			_kill_group(proc)
			failed.append(t.name)
			warn(f"{t.name} timed out after {limit}s "
			     f"([target.{t.name}] test-timeout raises it, "
			     f"0 removes the limit)")
			continue
		if rc:
			failed.append(t.name)
			warn(f"{t.name} failed ({describe_exit(rc)})")
	if dry_run:
		return 0
	say()
	def _some(names):
		# Capped like every other list here. Nine names already wrap a
		# terminal; a suite where forty fail prints the one thing nobody
		# can read, and the count is the part that matters.
		shown = ", ".join(names[:6])
		return shown + (f", and {len(names) - 6} more"
		                if len(names) > 6 else "")

	if failed:
		warn(f"{len(failed)} of {len(targets)} failed: {_some(failed)}")
	if not_run:
		# Reported apart from failures because it is a different fact, and
		# non-zero all the same. A test that did not run has not failed --
		# saying so accuses code that may be perfectly good -- but it has
		# not passed either, and `fmake test' exists to say that they did.
		# Calling this a skip would make the status green over a suite that
		# verified nothing, which is the vacuous pass one level up.
		warn(f"{len(not_run)} of {len(targets)} not run: {_some(not_run)}")
	if failed or not_run:
		return 1
	n = len(targets)
	info(f"{n} test{'' if n == 1 else 's'} passed")
	return 0


def run_phony(name, rule, root, built, dry_run):
	"""Run an action the user asked for by name.

    Prerequisites naming something fmake built are substituted as paths, so
    `flash: myprog` gets the artifact rather than the word. Anything else is
    passed through and is the recipe's business.
    """
	ins = [built.get(p, p) for p in rule["inputs"]]
	missing = [p for p in rule["inputs"]
	           if p not in built and not os.path.exists(os.path.join(root, p))]
	if missing:
		die(f"{MK_FILE}:{rule['line']}: {name} needs "
		    f"{', '.join(missing)}, which is neither a target nor a file")

	if not dry_run:
		say(f"{YELLOW('RUN')} {BOLD(name)}")
		PROGRESS.flush()        # the recipe writes straight to the terminal
	for cmd in rule["commands"]:
		line, quiet, ignore = _recipe_prefix(cmd)
		line = _gen_command(line, ins, [name], None, None)
		if dry_run:
			print(line)
			continue
		if not quiet and VERBOSE:
			note(line)
		res = subprocess.run(line, shell=True, cwd=root)
		if res.returncode != 0 and not ignore:
			die(f"{name} failed ({res.returncode})")
	return 0


def rules_from_comments(root, srcs, scans):
	"""@rule blocks, parsed by the same function fmake.mk goes through.

    Same language by construction rather than by two parsers being kept in
    step, which is a thing that stops being true. A rule lives next to what
    motivated it, which is the whole argument for annotations applied to the
    one kind of fact that had nowhere to go.
    """
	out = {}
	for rel in srcs:
		ann = Ann(scans[rel].get("dirs"))
		for line, args in ann.raw.get("rule", []):
			parsed = parse_mk(text=args[0], origin=rel, first_line=line)
			for name, rule in expand_mk_rules(parsed, root, None).items():
				out[name] = rule
	return out


def mk_directives(root):
	"""Project-scope directives written in fmake.mk."""
	path = os.path.join(root, MK_FILE)
	if not os.path.isfile(path):
		return {}
	found = {}
	parse_mk(path, directives=found)
	return found


def all_generate_rules(root, conf, srcs=None, scans=None):
	"""Every generator rule, from fmake.toml and fmake.mk alike.

    One function, because three callers need the same answer: the runner,
    and both eject backends. Two of them reading only the TOML half meant an
    ejected build silently omitted the pattern rules and could not reproduce
    what fmake had done.
    """
	rules = dict(conf.data.get("generate", {}))
	path = os.path.join(root, MK_FILE)
	extra = {}
	if os.path.isfile(path):
		extra.update(expand_mk_rules(parse_mk(path, directives={}),
		                             root, None))
	if srcs is not None:
		extra.update(rules_from_comments(root, srcs, scans))
	for name, rule in extra.items():
		if name in rules:
			die(f"{_gen_where(rule, name)}: a rule for "
			    f"{rule['outputs'][0]} is also in {CONF_FILE}")
		rules[name] = rule
	return rules


def _gen_where(rule, name):
	"""Name a rule the way its author wrote it."""
	if "line" in rule:
		return f"{rule.get('origin', MK_FILE)}:{rule['line']}"
	return f"{CONF_FILE}: [generate.{name}]"


def run_generators(root, conf, cache, dry_run=False, build_tool=None,
                   srcs=None, scans=None):
	"""Run the [generate.*] rules. Returns their outputs, tree-relative.

    `build_tool` builds a target from this tree and returns its path, for
    rules that name one with `uses`. When it is None -- which is the case
    while bootstrapping such a tool -- those rules are skipped rather than
    run, since a tool cannot depend on its own output.
    """
	rules = all_generate_rules(root, conf, srcs, scans)
	if not rules:
		return []
	before, ran = set(sum(walk_tree(root), [])), False

	for name, r in sorted(rules.items()):
		if not (r.get("command") or r.get("commands")):
			die(f"{_gen_where(r, name)} needs a command")
		for key in ("inputs", "outputs"):
			if not r.get(key):
				die(f"{_gen_where(r, name)} needs {key}")

	store = cache.data.setdefault("generated", {})
	# Kept beside the keys rather than inside them: a cache written before
	# this existed simply has none, and every rule that declares a depfile
	# regenerates once to record its own.
	gen_deps = cache.data.setdefault("generated_deps", {})
	# What each rule actually wrote, so `--clean' can remove those files by
	# name later. Declared outputs would do as well and would need the
	# whole tree scanned to find the rules in source comments; this is a
	# record of what happened, which is what a clean should act on.
	gen_wrote = cache.data.setdefault("generated_outputs", {})
	produced = []

	for name in _gen_order(rules):
		r = rules[name]
		if r.get("uses") and build_tool is None:
			vinfo(f"skipping [generate.{name}] while bootstrapping")
			continue
		ins = []
		for pat in r["inputs"]:
			hits = sorted(glob.glob(os.path.join(root, pat), recursive=True))
			if not hits:
				# Not an error yet: another rule may be about to produce it.
				cand = os.path.join(root, pat)
				if not os.path.exists(cand):
					die(f"{CONF_FILE}: [generate.{name}] input {pat!r} "
					    f"matched nothing")
				hits = [cand]
			ins += hits
		deps = []
		for pat in r.get("depends", []):
			hits = sorted(glob.glob(os.path.join(root, pat), recursive=True))
			deps += hits or [os.path.join(root, pat)]
		outs = [os.path.join(root, o) for o in r["outputs"]]
		produced += list(r["outputs"])

		# Rerun when an input's contents change or the command does, not on
		# mtime, so the rest of the build stays hash-driven too.
		# What the generator itself said it read last time. `depends` is
		# the hand-written half of this and stays; a .y that %includes
		# another file can now say so once, in the generator's own
		# depfile, instead of being listed by somebody who has to
		# remember.
		recorded = [d for d in gen_deps.get(name, [])
		            if os.path.exists(os.path.join(root, d))]

		def gen_key(extra):
			"""The rule's identity: its commands, and every file it reads.

            Over a *sorted set* of paths, so the key cannot depend on the
            order they were collected in. The first version appended the
            depfile's contents to a list already built from `inputs` and
            `depends`, which put the same files in a different order on the
            run that recorded them than on the run that checked them -- and
            a rule that never matches its own stored key regenerates on
            every build, for ever, saying GEN each time.
            """
			parts = list(r.get("commands") or [r.get("command", "")])
			parts.append(r.get("uses") or "")
			# Named in the key, so declaring a depfile on an existing rule
			# regenerates once rather than staying fresh on a key computed
			# before anything was being recorded.
			parts.append("depfile:" + (r.get("depfile") or ""))
			for rel in sorted(set(extra)):
				full = os.path.join(root, rel)
				parts.append(rel + ":" + (cache.hash_of(full, rel) or "?"))
			return sha("|".join(parts))

		read_paths = [os.path.relpath(p, root) for p in ins + deps]
		key = gen_key(read_paths + recorded)

		fresh = (store.get(name) == key
		         and all(os.path.exists(o) for o in outs))
		if fresh:
			vinfo(f"generated {name} is up to date")
			continue

		# A tool built from this tree, rather than one already installed.
		# NetHack's makedefs and sqlite's lemon both work this way, and
		# neither can be expressed by a command that must already be on
		# $PATH before anything has been compiled.
		tool = build_tool(r["uses"]) if r.get("uses") else None

		cmds = [_recipe_prefix(c) for c in
		        (r.get("commands") or [r["command"]])]
		lines = [(_gen_command(c, ins, outs, tool, r.get("stem")), ig)
		         for c, _q, ig in cmds]
		for line, _ig in lines:
			if not line.strip():
				die(f"{_gen_where(r, name)} command is empty")
			# A plain command naming a program that is not installed is worth
			# catching early with a good message. Anything with shell syntax
			# in it is the shell's business to report.
			words = shlex.split(line)
			# Resolved against the tree as well as $PATH, because that is
			# where the command will run: recipes execute with cwd=root, so
			# `./mk.sh' means the script in the project, not one beside
			# whoever typed the command.
			#
			# Without this, `cd tree && fmake' accepted a build that
			# `fmake -C tree' refused, which is section 80's shape -- a
			# check whose answer depends on how it was invoked -- with
			# advice pointing at `uses', for a script sitting right there.
			here = os.path.join(root, words[0]) if words else ""
			reachable = words and (shutil.which(words[0])
			                       or (os.path.isfile(here)
			                           and os.access(here, os.X_OK)))
			if (len(words) == len(line.split()) and words
			        and not any(c in line for c in "|&;<>()$`")
			        and not reachable):
				die(f"{_gen_where(r, name)} needs {words[0]!r}, which is "
				    f"neither installed nor an executable file in this "
				    f"tree (build it from this tree with `uses`)")

		label = r.get("description") or name
		if dry_run:
			for line, _ig in lines:
				print(line)
			continue
		say(f"{YELLOW('GEN')} {label}")
		for o in outs:
			os.makedirs(os.path.dirname(o) or root, exist_ok=True)
		for line, ignore in lines:
			res = subprocess.run(line, shell=True, cwd=root,
			                     capture_output=True, text=True, errors="replace")
			if res.stdout.strip():
				PROGRESS.write(res.stdout)
			if res.stderr.strip():
				PROGRESS.write(res.stderr)
			if res.returncode != 0 and not ignore:
				die(f"{_gen_where(r, name)} failed: {line}")
		missing = [os.path.relpath(o, root) for o in outs
		           if not os.path.exists(o)]
		if missing:
			die(f"[generate.{name}] did not produce {', '.join(missing)}")

		# Read back what the generator said it opened. Same shape as the
		# compiler's -MD, and for the same reason: the tool that did the
		# reading is the only thing that knows, and a hand-written list is
		# a list somebody has to keep right.
		if r.get("depfile"):
			where = os.path.join(root, r["depfile"])
			if not os.path.exists(where):
				die(f"{_gen_where(r, name)} declares depfile "
				    f"{r['depfile']!r}, which it did not write. The command "
				    f"has to be the one asked to produce it -- bison wants "
				    f"nothing, protoc wants --dependency_out, and a script "
				    f"has to write it itself.")
			found = []
			for dep in parse_depfile(where):
				rel = os.path.relpath(os.path.join(root, dep), root)
				# Outside the tree is somebody else's business: a system
				# header changing is not this rule going stale, and
				# hashing /usr/include on every build is not free.
				if not rel.startswith("..") and rel not in r["outputs"]:
					found.append(rel)
			gen_deps[name] = sorted(set(found))
			vinfo(f"{name} reads {len(gen_deps[name])} file(s) "
			      f"by its own account")
			# Recomputed, because the key above was built from what the
			# *previous* run recorded and this run may read more. Without
			# this the first build after a new include is stale-clean:
			# fresh on a key that predates it.
			key = gen_key(read_paths + gen_deps[name])

		store[name] = key
		gen_wrote[name] = sorted(r["outputs"])
		ran = True

	# A generator that writes more than it declared. The extra file is
	# picked up by the re-walk and compiles, so the first build is fine --
	# and the rule's freshness is keyed on the outputs it named, so once
	# that file goes missing nothing re-runs the generator. The build then
	# fails on an undefined symbol, and fmake offers to name the missing
	# library, which is the wrong end of the problem entirely.
	#
	# Only after something ran. This is an optimisation and not a
	# correctness guard -- on a cached build no file appears, so the
	# comparison would find nothing either way, and no case fails without
	# it. What it buys is not walking the tree on every no-op build.
	if ran:
		after = set(sum(walk_tree(root), []))
		declared = {o for r in rules.values() for o in r["outputs"]}
		extra = sorted(after - before - declared)
		if extra:
			shown = ", ".join(extra[:4])
			if len(extra) > 4:
				shown += f", and {len(extra) - 4} more"
			warn(f"a [generate.*] rule wrote {shown} without naming "
			     f"{'them' if len(extra) > 1 else 'it'} in outputs; add "
			     f"{'them' if len(extra) > 1 else 'it'}, or a missing one "
			     f"will not re-run the rule")

	# A generated file nothing can compile is worth saying out loud. Left
	# silent it becomes a link error listing symbols, under advice about
	# naming libraries with --ldflags, when the answer is a file fmake
	# wrote itself a moment earlier. anti-avx generates a 218K .s holding
	# 233 case_N symbols and lands exactly there.
	stranded = sorted({o for o in produced
	                   if os.path.splitext(o)[1] in UNBUILT_SRC_EXTS})
	for rel in stranded[:5]:
		note(f"{rel} was generated and nothing will compile it: fmake "
		     f"builds C, C++, assembly and Rust, not "
		     f"{os.path.splitext(rel)[1]}")
	if len(stranded) > 5:
		note(f"... and {len(stranded) - 5} more")

	return produced

# ---------------------------------------------------------------------------
# Qt's meta-object compiler
#
# The only framework fmake knows by name, and it earns that by fitting section 3
# rather than working around it. moc's output is an ordinary translation unit
# whose defined symbols are exactly the undefined ones its input leaves
# behind: a class carrying Q_OBJECT compiles to an object wanting
# Foo::staticMetaObject, the signal bodies and the vtable, and moc_foo.o
# defines that set and no more. Measured on a two-class program, the set moc
# provides minus the set the class leaves undefined is empty. So the closure
# links a moc object for the same reason it links anything, and there is no
# Qt-shaped special case anywhere in the link step.
#
# Two signals, the same division as library resolution. The scan proposes:
# Q_OBJECT in a file means run moc on it. The symbols decide: output that
# nothing refers to is compiled and then dropped by the closure. A Q_OBJECT
# behind an #if 0 therefore costs one moc run and can never reach a binary,
# and a class no program constructs costs one compile -- which is already
# better than qmake, whose HEADERS list mocs and links regardless of reach.
#
# The parts of Qt that do *not* ride this rail are left out rather than
# half-supported: .ui is an include-graph dependency rather than a symbol
# one, and QML type registration is a protocol rather than a rule.
# ---------------------------------------------------------------------------

# Generated under the state directory rather than beside the source. It is a
# build artifact -- `--clean` should take it and git should not see it -- and
# the tree structure is mirrored inside so that two counter.h in different
# directories do not both want to be moc_counter.cpp.
MOC_DIR = os.path.join(STATE_DIR, "moc")

# uic output is flat, unlike moc's. `#include "ui_foo.h"` is unqualified, so
# two foo.ui in one tree are ambiguous in the C++ rather than merely awkward
# on disk; mirroring the tree would hide that instead of reporting it.
UI_DIR = os.path.join(STATE_DIR, "ui")
# Staging and output for --run, so a script leaves nothing beside
# itself and a second run finds the binary already built.
RUN_DIR = os.path.join(STATE_DIR, "run")

# rcc output is a compiled translation unit, not an include, so it mirrors
# the tree like moc's -- two resources.qrc in different directories are an
# ordinary name clash rather than an ambiguity in anybody's C++.
QRC_DIR = os.path.join(STATE_DIR, "qrc")

RE_UI_HEADER = re.compile(r"^ui_(.+)\.h$")

# The .pc files that know where Qt keeps its tools. Newest first: nothing in
# a source distinguishes Qt 5 from Qt 6 -- the include spellings are
# identical -- so when both are installed the newer is the better guess, and
# [toolchain] moc is there for when the guess is wrong.
QT_CORE_MODULES = ("Qt6Core", "Qt5Core")

RE_QT_LIB = re.compile(r"^Qt(\d+)[A-Z]\w*$")


def qt_major_of(lib):
	"""The Qt major a library name carries, or None if it carries none."""
	m = RE_QT_LIB.match(lib)
	return "Qt" + m.group(1) if m else None


def link_qt_major(proposed, order):
	"""Which Qt major the link may draw from, or None if Qt is not involved.

    Taken from what the headers already asked for, because the link has to
    agree with the compile rather than with a preference computed a second
    time. Where they named no Qt at all -- a tree whose Qt arrives through
    the symbol scan alone -- the same order both other sides use decides it,
    so all three answer to `qt_preference'.
    """
	named = {m for m in (qt_major_of(lib) for lib in proposed) if m}
	if len(named) == 1:
		return named.pop()
	return order[0] if order else None


def tool_origin(name, configured):
	"""Where a named tool came from, or None if nobody named it.

    Advice about a tool has to know whether the reader chose it. Telling
    somebody to set [toolchain] moc when [toolchain] moc is what named the
    broken tool is the same defect as section 31: the code printing the
    advice had not asked the code that knows.
    """
	if os.environ.get(name.upper()):
		return f"${name.upper()}"
	if configured:
		return f"[toolchain] {name} in {CONF_FILE}"
	return None


def find_qt_tool(name, configured, pkg):
	"""Locate one of Qt's generators, matching the Qt about to be linked.

    Deliberately not `shutil.which(name)`. Debian ships neither moc nor uic
    on $PATH at all -- they live in Qt's libexec -- and on distributions that
    do provide them, qtchooser makes which Qt they belong to a property of
    the environment rather than of the build, so a tree resolving to Qt 6 can
    be moc'd by Qt 5's moc and fail at the link on a mangling that never
    matched. The same pkg-config that will answer for the -l flags already
    knows where that Qt keeps its tools, so ask it rather than the shell's
    search path.
    """
	named = os.environ.get(name.upper()) or configured
	if named:
		got = shutil.which(named) or (named if os.path.isfile(named) else None)
		if not got:
			die(f"{name} {named!r} (from {tool_origin(name, configured)}) "
			    f"not found")
		return got
	for mod in QT_CORE_MODULES:
		for var in ("libexecdir", "host_bins", "bindir"):
			d = pkg.variable(mod, var)
			cand = os.path.join(d, name) if d else None
			if cand and os.path.isfile(cand) and os.access(cand, os.X_OK):
				return cand
	return shutil.which(name)


def qt_preference(configured, pkg):
	"""The Qt majors to answer for, most wanted first.

    Newest first by default, which is the order find_qt_tool takes the tool
    in and the order §17 argued for. The point of returning it rather than
    letting each side apply it is that both sides must apply the *same* one:
    a build whose moc is Qt 6 and whose -I is Qt 5 does not compile.

    A named moc moves it. `[toolchain] moc' exists for when newest-first is
    the wrong guess, and a hatch that moves the tool while leaving the flags
    behind swaps one disagreement for another -- so the Qt whose tool
    directory holds the named moc becomes the preferred one. Asked of
    pkg-config, which was going to be asked for those directories anyway,
    rather than of the tool: running a binary to find out which build it is
    for is a probe, and a moc that cannot run here is a case §17 already
    has. A moc from somewhere pkg-config has never heard of leaves the
    default alone, which is the honest answer rather than a guess.
    """
	default = tuple(m[:len("Qt0")] for m in QT_CORE_MODULES)
	named = os.environ.get("MOC") or configured
	if not named:
		return default
	got = shutil.which(named) or (named if os.path.isfile(named) else None)
	if not got:
		return default          # find_qt_tool reports this, and better
	got = os.path.realpath(got)
	for mod in QT_CORE_MODULES:
		for var in ("libexecdir", "host_bins", "bindir"):
			d = pkg.variable(mod, var)
			if d and os.path.realpath(os.path.join(d, "moc")) == got:
				want = mod[:len("Qt0")]
				return (want,) + tuple(p for p in default if p != want)
	return default


def moc_would_generate(root, rel, moc, flags):
	"""Whether moc produces anything for this file. Definitive, and slow."""
	probe = os.path.join(root, STATE_DIR, "moc-probe.cpp")
	os.makedirs(os.path.dirname(probe), exist_ok=True)
	try:
		r = subprocess.run([moc] + flags + [rel, "-o", probe],
		                   cwd=root, capture_output=True, text=True, errors="replace")
	except OSError:
		return False
	try:
		got = r.returncode == 0 and os.path.getsize(probe) > 0
	except OSError:
		got = False
	if os.path.exists(probe):
		os.unlink(probe)
	return got


def unscanned_moc_inputs(root, link, scans, hdrs, mocced, cfg, conf, pkg):
	"""Headers this link set includes that moc would generate for, and was
    never run on.

    The scan is a token search, and Qt's design justifies that: Q_OBJECT is
    a marker rather than a shape. It does mean a class reaching the macro
    through another macro carries no token to find --

        #define MY_OBJ Q_OBJECT           /* in macros.h */
        class G : public QObject { MY_OBJ };

    -- and moc's own preprocessor expands it and generates, while the scan
    sees nothing. The link then fails on `undefined reference to vtable for
    G', which names no Qt anything, and the advice offered was --ldflags:
    the reader is sent to install a library for a meta-object their own
    tree was supposed to generate.

    Asking moc is definitive where guessing at C++ is not, and it is
    affordable precisely here: this runs only after a link has already
    failed, and only over the headers that link set includes.
    """
	names = set()
	for u in link:
		for _kind, name, _line in scans.get(u.rel, {}).get("incs", []):
			names.add(os.path.basename(name))
	cands = [h for h in hdrs
	         if h not in mocced and os.path.basename(h) in names]
	if not cands:
		return []
	moc = find_qt_tool("moc", cfg.moc, pkg)
	if not moc:
		return []
	flags = moc_cflags(root, hdrs, conf)
	return [h for h in cands if moc_would_generate(root, h, moc, flags)]


def moc_plan(srcs, hdrs, scans):
	"""What moc must run on, and where each output goes.

    A file's own text is what counts, which splits the two cases cleanly.
    foo.cpp including foo.h does not itself carry Q_OBJECT, so the header is
    moc'd into a moc_foo.cpp that is compiled and linked like any source. A
    class declared inside foo.cpp does carry it, and Qt requires that file to
    #include "foo.moc" -- so that output is never a translation unit of its
    own, only text pulled into one.
    """
	# Who includes what, by basename. Needed because the file moc reads and
	# the file that includes its output are not always the same one: a class
	# in foo.cpp produces foo.moc which foo.cpp includes, but the
	# `#include "moc_foo.cpp"` idiom has moc read foo.h while foo.cpp does
	# the including. Whoever includes it is who needs it on their include
	# path.
	includers = {}
	for rel in sorted(scans):
		for _kind, name, _line in scans[rel]["incs"]:
			includers.setdefault(os.path.basename(name), []).append(rel)

	jobs, unreachable = [], {}
	for rel in sorted(hdrs):
		if not scans.get(rel, {}).get("qobject"):
			continue
		name = "moc_" + os.path.splitext(os.path.basename(rel))[0] + ".cpp"
		jobs.append({
		    "src": rel,
		    "out": os.path.normpath(os.path.join(MOC_DIR,
		                                         os.path.dirname(rel), name)),
			# An older idiom ends foo.cpp with `#include "moc_foo.cpp"` to
			# save a translation unit. Compiling it as well would define
			# every meta-object twice, and section 3 would report that as an
			# ambiguous provider -- a baffling way to say a file is already
			# in the build.
		    "inline": name in includers,
		    "includers": includers.get(name, []),
		})

	for rel in sorted(srcs):
		if not scans.get(rel, {}).get("qobject"):
			continue
		name = os.path.splitext(os.path.basename(rel))[0] + ".moc"
		own = {os.path.basename(i[1]) for i in scans[rel]["incs"]}
		if name not in own:
			# Generating it anyway would leave a file nothing compiles and
			# nothing includes. Qt's own rule is that this include is how a
			# class in a .cpp gets its meta-object, so the missing line is
			# the bug and naming it here beats an undefined symbol later.
			warn(f'{rel} declares a Q_OBJECT class but does not #include '
			     f'"{name}", so moc cannot reach it')
			# Remembered, not just said. The link failure that follows is
			# where people actually look, and it used to offer --ldflags --
			# advice for a missing library, about a meta-object this tree
			# was supposed to generate. Section 31's shape, in the summary
			# printed after the message written to avoid it.
			unreachable[rel] = name
			continue
		jobs.append({"src": rel, "inline": True, "includers": [rel],
		             "out": os.path.normpath(
		                 os.path.join(MOC_DIR, os.path.dirname(rel), name))})
	return jobs, unreachable


def include_root_for(resolved, inc_name):
	"""The -I that makes this include text find this file.

    Not the file's own directory, which is the obvious answer and wrong
    whenever an include carries a path. `#include "model/profile.h"`
    resolving to src/model/profile.h needs -Isrc; -Isrc/model, the
    directory the file is actually in, does nothing at all -- and
    subdirectory-qualified includes from a source root are ordinary C++,
    which is how one project lost 84 files to this in a single build.

    So the directory is whatever is left of the path once the include name
    is taken off the end of it. For a bare `#include "profile.h"` that is
    the containing directory, which is why this reads as a generalisation
    rather than a change.

    Module-level because the *diagnostic* needs the same answer and had
    its own, wrong, copy: when the resolver declines to guess -- which it
    does for any name the toolchain owns, so a project with its own
    `math.h` lands here -- the advice named the containing directory, and
    following it exactly did not fix the build.
    """
	left = (resolved[: -len(inc_name)].rstrip("/")
	        if resolved.endswith(inc_name) else os.path.dirname(resolved))
	return left or "."


def moc_cflags(root, hdrs, conf):
	"""The include path and defines moc parses with.

    Best effort on purpose, and safe to be: moc runs its own preprocessor but
    does not fail on an include it cannot resolve, so a missing -I costs an
    unexpanded macro rather than a build error. It has to be that way, since
    these flags are needed before the include graph exists -- what moc
    produces is part of the tree that graph is computed over.
    """
	dirs = {os.path.dirname(h) for h in hdrs}
	dirs |= set(conf.project.get("include-dirs", []))
	out = []
	for d in sorted(dirs):
		p = root if d in ("", ".") else (d if os.path.isabs(d)
		                                 else os.path.join(root, d))
		if "-I" + p not in out:
			out.append("-I" + p)
	for d in (list(conf.project.get("defines", []))
	          + list(conf.project.get("define", []))):
		out.append("-D" + d)
	# Whatever the configuration already says: a -D that changes what a class
	# declaration means changes what moc should read of it too.
	for f in conf.cflags():
		if f.startswith(("-D", "-I")) and f not in out:
			out.append(f)
	return out


def uic_plan(files, hdrs, scans, root):
	"""Which .ui files the source actually asks for.

    The trigger is the include, not the file extension. `#include
    "ui_foo.h"` naming a header that exists nowhere in the tree, with a
    foo.ui that would produce it, is the source asking for uic in as many
    words -- and it is the same thing CMake's AUTOUIC keys on. Three
    consequences, all of them wanted: a .ui nobody includes is not built, a
    ui_foo.h someone checked in is left alone rather than overwritten, and a
    tree with no .ui files never looks for uic at all.

    Unlike moc there is no symbol to fall back on -- a generated header is an
    include-graph dependency, so the include has to be believed.
    """
	have = {os.path.basename(h) for h in hdrs}
	wanted = {}
	for rel in sorted(files):
		for _kind, name, line in scans.get(rel, {}).get("incs", ()):
			base = os.path.basename(name)
			m = RE_UI_HEADER.match(base)
			if m and base not in have:
				wanted.setdefault(m.group(1), (rel, line))
	if not wanted:
		return []

	by_stem = {}
	for hit in sorted(glob.glob(os.path.join(root, "**", "*.ui"),
	                            recursive=True)):
		stem = os.path.splitext(os.path.basename(hit))[0]
		by_stem.setdefault(stem, []).append(os.path.relpath(hit, root))

	jobs = []
	for stem, (rel, line) in sorted(wanted.items()):
		found = by_stem.get(stem)
		if not found:
			# Not ours. Some other generator may produce it, or it is simply
			# missing -- either way the compiler names it better than a guess
			# here would.
			continue
		if len(found) > 1:
			die(f'{rel}:{line}: #include "ui_{stem}.h" is ambiguous -- '
			    f'{" and ".join(found)} would both produce it. An unqualified '
			    f'include cannot say which, so rename one.')
		jobs.append({"src": found[0], "inline": True,
		             "out": os.path.join(UI_DIR, f"ui_{stem}.h")})
	return jobs


def qrc_declares(path):
	"""The resource paths a .qrc file declares.

    Parsed as the XML it is rather than matched as text: a .qrc is small and
    machine-written, but prefixes and aliases are attributes, and getting
    quoting wrong here would silently mean a resource nothing appears to use.
    """
	try:
		tree = ET.parse(path)
	except (ET.ParseError, OSError) as exc:
		die(f"{path}: cannot read as a Qt resource file: {exc}")
	paths = set()
	for res in tree.getroot().iter("qresource"):
		prefix = ("/" + (res.get("prefix") or "").strip("/")).rstrip("/")
		for f in res.iter("file"):
			name = (f.get("alias") or (f.text or "")).strip()
			if name:
				paths.add(prefix + "/" + name.lstrip("/"))
	return paths


def qrc_used_by(scan, paths, stem):
	"""Why this TU needs this resource, or None.

    Two signals, and the exact one first. Q_INIT_RESOURCE names the resource
    outright and compiles to an undefined qInitResources_<name>, so the
    closure would find it unaided -- it is here only to decide that rcc must
    run at all. Otherwise a ":/prefix/..." literal is the evidence, matched
    on the prefix rather than the whole path because half of them are built
    up at runtime from a stem and a name.
    """
	if stem in scan.get("qrc_init", ()):
		return f"Q_INIT_RESOURCE({stem})"
	for lit in scan.get("qrc", ()):
		# `p.startswith(lit)` is what covers `":/icons/" + name`, which is
		# how most real code names a resource -- the literal that survives
		# is the directory, not the file. Comparing whole paths only would
		# miss those, silently, until the program ran.
		if lit in paths or any(p.startswith(lit) for p in paths):
			return f'"{lit}"'
	return None


def rcc_plan(files, scans, root):
	"""Which .qrc files this tree's code actually refers to.

    A resource is the one piece of Qt's tooling with no reliable symbol: it
    registers itself from a static constructor, so nothing refers to the
    generated object and the closure alone would drop it. The link decision
    therefore comes from what the source says it opens, per program -- which
    is why this returns the users and not just the file.
    """
	hits = sorted(glob.glob(os.path.join(root, "**", "*.qrc"), recursive=True))
	jobs = []
	for hit in hits:
		rel = os.path.relpath(hit, root)
		stem = os.path.splitext(os.path.basename(rel))[0]
		paths = qrc_declares(hit)
		users = {}
		for f in files:
			why = qrc_used_by(scans.get(f, {}), paths, stem)
			if why:
				users[f] = why
		if not users:
			continue
		jobs.append({
		    "src": rel, "name": stem, "users": users,
		    "out": os.path.normpath(os.path.join(QRC_DIR, os.path.dirname(rel),
		                                         f"qrc_{stem}.cpp")),
		})
	return jobs


def run_rcc(root, jobs, rcc, cache, dry_run=False):
	"""Compile the resource files. Returns the outputs."""
	store = cache.data.setdefault("rcc", {})
	produced = []
	for job in jobs:
		src, out = job["src"], job["out"]
		abs_out = os.path.join(root, out)
		# The listed files are inputs too, and rcc embeds their contents, so
		# a changed icon has to re-run it just as a changed .qrc does.
		parts = [rcc, src, job["name"]]
		for dep in sorted(qrc_inputs(os.path.join(root, src), root)):
			parts.append(dep + ":" + (cache.hash_of(os.path.join(root, dep),
			                                        dep) or "?"))
		key = sha("|".join(parts
		                   + [cache.hash_of(os.path.join(root, src), src) or "?"]))
		if store.get(out) == key and os.path.isfile(abs_out):
			produced.append(out)
			continue

		cmd = [rcc, "--name", job["name"], src, "-o", out]
		if dry_run:
			print(" ".join(shlex.quote(c) for c in cmd))
			continue
		say(f"{YELLOW('RCC')} {src}")
		os.makedirs(os.path.dirname(abs_out) or root, exist_ok=True)
		try:
			res = subprocess.run(cmd, cwd=root, capture_output=True, text=True, errors="replace")
		except OSError as exc:
			die(f"could not run rcc ({rcc}): {exc.strerror or exc}")
		if res.stderr.strip():
			PROGRESS.write(res.stderr)
		if res.returncode != 0 or not os.path.isfile(abs_out) \
		        or os.path.getsize(abs_out) == 0:
			die(f"rcc produced nothing from {src}")
		store[out] = key
		produced.append(out)
	return produced


def qrc_inputs(path, root):
	"""The files a .qrc embeds, tree-relative, for freshness."""
	try:
		tree = ET.parse(path)
	except (ET.ParseError, OSError):
		return []
	base = os.path.dirname(path)
	out = []
	for f in tree.getroot().iter("file"):
		name = (f.text or "").strip()
		if name:
			out.append(os.path.relpath(os.path.join(base, name), root))
	return out


def prune_generated(root, subdir, keep):
	"""Delete generated files whose input is gone.

    Generated output outlives its input, and for uic that is not merely
    untidy. A ui_*.h is reached through an include path rather than by being
    listed, so deleting foo.ui while another .ui keeps that -I alive leaves
    the stale header answering `#include "ui_foo.h"` -- and since nothing it
    depends on changed, the build reports itself up to date. That is a tree
    which builds here and fails on a fresh checkout, which is the worst shape
    a staleness bug can take.

    moc and rcc output cannot go wrong the same way, because it reaches the
    build only by being listed as a source and a stale one is never listed.
    Swept anyway: the rule is easier to trust when it has no exceptions.
    """
	base = os.path.join(root, subdir)
	if not os.path.isdir(base):
		return
	wanted = {os.path.join(root, k) for k in keep}
	for dirpath, _dirnames, filenames in os.walk(base, topdown=False):
		for f in filenames:
			path = os.path.join(dirpath, f)
			if path not in wanted:
				vinfo(f"removing stale {os.path.relpath(path, root)}")
				try:
					os.unlink(path)
				except OSError:
					pass
		try:
			os.rmdir(dirpath)       # only succeeds once it is empty
		except OSError:
			pass


def run_moc(root, jobs, moc, flags, cache, dry_run=False, origin=None):
	"""Run moc where its input changed. Returns the outputs that now exist.

    Keyed on content like everything else, so touching a header re-mocs it
    and recompiles only the objects whose symbols moved. An input that yields
    nothing is remembered as having yielded nothing -- the scan sees a
    Q_OBJECT behind an #if 0 and moc's preprocessor correctly does not, and
    without the negative result that disagreement costs a moc run per build
    forever.
    """
	store = cache.data.setdefault("moc", {})
	produced = []
	for job in jobs:
		src, out = job["src"], job["out"]
		abs_out = os.path.join(root, out)
		key = sha("|".join([moc, "\0".join(flags), src,
		                    cache.hash_of(os.path.join(root, src), src) or "?"]))
		stamp = store.get(out)
		if stamp == key and os.path.isfile(abs_out):
			produced.append(out)
			continue
		if stamp == key + "|none" and not os.path.exists(abs_out):
			continue

		# Run from the tree root with relative paths on both sides. moc writes
		# the #include back to its input as a path relative to its *output*,
		# so absolute arguments here would bake this machine's directory
		# layout into a generated source and defeat --eject.
		cmd = [moc] + flags + [src, "-o", out]
		if dry_run:
			print(" ".join(shlex.quote(c) for c in cmd))
			continue
		say(f"{YELLOW('MOC')} {src}")
		os.makedirs(os.path.dirname(abs_out) or root, exist_ok=True)
		try:
			res = subprocess.run(cmd, cwd=root, capture_output=True, text=True, errors="replace")
		except OSError as exc:
			# Who chose this moc decides the advice. Where pkg-config found
			# it, naming one is the fix; where the reader named it, saying so
			# is, and repeating the instruction they already followed is not.
			if origin:
				die(f"could not run moc ({moc}): {exc.strerror or exc}\n"
				    f"That moc comes from {origin} and cannot execute on "
				    f"this machine.\n"
				    f"On a cross build moc must be the build machine's, not "
				    f"the target's.")
			die(f"could not run moc ({moc}): {exc.strerror or exc}\n"
			    f"On a cross build the moc pkg-config names is the target's "
			    f"and cannot run here; name the build machine's with "
			    f"[toolchain] moc in {CONF_FILE}.")
		if res.returncode != 0:
			if res.stderr.strip():
				PROGRESS.write(res.stderr)
			die(f"moc failed on {src}")
		# Emptiness is the signal, not absence. Told to write to a real path
		# moc creates the file and then writes nothing to it, so a Q_OBJECT
		# the scan saw and moc's preprocessor did not -- one behind an #if 0
		# -- leaves a zero-byte source that would otherwise be compiled and
		# carried through every report for the life of the tree.
		if not os.path.isfile(abs_out) or os.path.getsize(abs_out) == 0:
			vinfo(f"moc found nothing to generate in {src}")
			if os.path.exists(abs_out):
				os.unlink(abs_out)
			store[out] = key + "|none"
			continue
		if res.stderr.strip():
			PROGRESS.write(res.stderr)
		store[out] = key
		produced.append(out)
	return produced


def run_uic(root, jobs, uic, cache, dry_run=False):
	"""Run uic where its input changed. Returns the outputs.

    Simpler than moc in every respect: one .ui produces exactly one header,
    always, and there is no preprocessor to disagree with the scan. An empty
    result is a failure rather than a fact about the input.
    """
	store = cache.data.setdefault("uic", {})
	produced = []
	for job in jobs:
		src, out = job["src"], job["out"]
		abs_out = os.path.join(root, out)
		key = sha("|".join([uic, src,
		                    cache.hash_of(os.path.join(root, src), src) or "?"]))
		if store.get(out) == key and os.path.isfile(abs_out):
			produced.append(out)
			continue

		cmd = [uic, src, "-o", out]
		if dry_run:
			print(" ".join(shlex.quote(c) for c in cmd))
			continue
		say(f"{YELLOW('UIC')} {src}")
		os.makedirs(os.path.dirname(abs_out) or root, exist_ok=True)
		try:
			res = subprocess.run(cmd, cwd=root, capture_output=True, text=True, errors="replace")
		except OSError as exc:
			die(f"could not run uic ({uic}): {exc.strerror or exc}")
		if res.stderr.strip():
			PROGRESS.write(res.stderr)
		if res.returncode != 0 or not os.path.isfile(abs_out) \
		        or os.path.getsize(abs_out) == 0:
			die(f"uic produced nothing from {src}")
		store[out] = key
		produced.append(out)
	return produced

# ---------------------------------------------------------------------------
# Annotations
#
# Build facts belong in the file they are about. The file that includes SDL is
# the file that needs SDL linked, and writing that down next to the #include
# means it survives the file being moved, copied into another project, or
# deleted -- which is the part a CMakeLists.txt two directories away gets
# wrong, more than the syntax is.
#
# Doxygen format, so the same comment documents and builds:
#
#   /*! @file
#    *  @target  myapp
#    *  @pkg     sdl2 >= 2.0.18
#    *  @std     c17
#    */
#
# Only Doxygen's own comment markers count -- //! /// /*! /** -- so an @ in an
# ordinary comment or an email address is never mistaken for a directive.
# Unknown commands are ignored in silence, because @brief and @param are not
# fmake's business; the cost is that a typo is silently inert, which is why
# --explain lists every directive it recognised, per file.
#
# The set is deliberately small. The failure mode of this design is directive
# sprawl until there is a configuration language living in comments, so
# anything wanting real logic belongs in fmake.toml instead.
# ---------------------------------------------------------------------------

RE_DOXY_OPEN = re.compile(r"^\s*(?://[/!]|/\*[*!])")
RE_DIRECTIVE = re.compile(r"^[@\\](\w+)\b[ \t]*(.*)$")

# Replace whatever came before; last one wins.
DIRECTIVE_SCALAR = {"target", "kind", "std", "test", "version"}
# Accumulate across every comment and every file in the link set.
DIRECTIVE_LIST = {"pkg", "pkg_optional", "libs", "cflags", "ldflags",
                  "define", "defines", "os", "arch", "sources", "headers",
                  "rule"}

# @define and @defines are the same directive. The config file spells it
# plural because it holds a list; a comment spells it singular because it
# usually carries one. Accepting both everywhere costs a line and removes a
# reason to look anything up.
DIRECTIVE_ALIAS = {"defines": "define"}
DIRECTIVES = DIRECTIVE_SCALAR | DIRECTIVE_LIST

KINDS = ("exe", "shared", "static")

# The split above is what decides whether a directive replaces or accumulates,
# so it has to be the single statement of that fact rather than a comment next
# to code that reads each one by hand. Ann asserts against it.
assert not (DIRECTIVE_SCALAR & DIRECTIVE_LIST)
assert DIRECTIVE_SCALAR | DIRECTIVE_LIST == DIRECTIVES


def _uncomment(line):
	"""Remove the comment furniture, keeping the indentation after it.

    The indentation matters: a `@rule` recipe is recognised the way Make
    recognises one, by being indented under the rule it belongs to.
    """
	line = re.sub(r"^\s*(?://[/!]+|/\*[*!]+)", "", line)
	line = re.sub(r"^\s*\*+(?!/)", "", line)
	return re.sub(r"\*/\s*$", "", line).rstrip()


def _one_edit_apart(a, b):
	"""True when one insertion, deletion or substitution turns a into b."""
	if a == b or abs(len(a) - len(b)) > 1:
		return False
	if len(a) == len(b):
		return sum(x != y for x, y in zip(a, b)) == 1
	short, long = (a, b) if len(a) < len(b) else (b, a)
	return any(long[:i] + long[i + 1:] == short for i in range(len(long)))


def near_directive(name):
	"""The directive `name` was probably meant to be, or None.

    `@lib` for `@libs` does nothing and says nothing, because an unknown
    command has to be ignored -- the comment is shared with Doxygen, and
    warning about `@brief` would make the integration unusable. So the
    question is not "is this unknown" but "is this unknown *and* almost one
    of ours", which is answerable without knowing anything about Doxygen.

    Two conditions: one edit away, and the same first three characters.

    Measured rather than argued. Against Doxygen's 161 documented commands,
    **the edit distance alone is already enough** -- not one of them is a
    single edit from any directive here, so the prefix rule is not what
    keeps `@brief` quiet. An earlier version of this comment claimed `@par`
    was one edit from `@pkg`; it is two, and the claim was invented rather
    than checked.

    What the prefix buys is the suggestion being *useful* rather than the
    check being safe. Doxygen is not the only thing that writes `@word` in
    a comment, and one edit is a wide net over arbitrary words: `@bind` is
    one edit from `@kind`, and answering it with "did you mean @kind?" is
    worse than saying nothing, because it is confident and wrong.

    It also means `@os` -- two characters -- proposes nothing. That is the
    right trade: a rule loose enough to guess at two-letter words guesses
    badly.
    """
	if len(name) < 3:
		return None
	hits = {DIRECTIVE_ALIAS.get(d, d) for d in DIRECTIVES
	        if name[:3] == d[:3] and _one_edit_apart(name, d)}
	return sorted(hits)[0] if len(hits) == 1 else None


def parse_directives(comments):
	"""Directives found in Doxygen comments: {name: [[line, [args]], ...]},
    and the near misses worth mentioning: [[line, written, meant], ...]."""
	found, typos = {}, []
	for lineno, body in comments:
		if not RE_DOXY_OPEN.match(body):
			continue
		clean = [_uncomment(l) for l in body.split("\n")]
		for offset, line in enumerate(clean):
			m = RE_DIRECTIVE.match(line.strip())
			if not m:
				continue
			name, rest = m.group(1), m.group(2).strip()
			name = DIRECTIVE_ALIAS.get(name, name)
			if name not in DIRECTIVES:
				meant = near_directive(name)
				if meant:
					typos.append([lineno + offset, name, meant])
				continue          # @brief, @param and friends

			if name == "rule":
				# Makefile syntax, which shlex would mangle, and which
				# continues onto the lines indented beneath it -- exactly as
				# a recipe is written in a Makefile.
				head = len(line) - len(line.lstrip())
				block = [rest]
				for cont in clean[offset + 1:]:
					if not cont.strip():
						break
					if len(cont) - len(cont.lstrip()) <= head:
						break
					if cont.lstrip().startswith(("@", "\\")):
						break
					block.append("\t" + cont.strip())
				found.setdefault(name, []).append(
				    [lineno + offset, ["\n".join(block)]])
				continue

			try:
				args = shlex.split(rest)
			except ValueError:
				args = rest.split()
			found.setdefault(name, []).append([lineno + offset, args])
	return found, typos


class Ann:
	"""Directives for one translation unit, with their source lines."""

	__slots__ = ("raw",)

	def __init__(self, raw=None):
		self.raw = raw or {}

	def __bool__(self):
		return bool(self.raw)

	def scalar(self, name, default=None):
		"""Last value wins, per the precedence rules."""
		assert name in DIRECTIVE_SCALAR, f"{name} is not a scalar directive"
		entries = self.raw.get(name)
		if not entries or not entries[-1][1]:
			return default
		return entries[-1][1][0]

	def items(self, name):
		"""Every argument of every occurrence, in order."""
		assert name in DIRECTIVE_LIST, f"{name} is not an accumulating directive"
		return [a for _ln, args in self.raw.get(name, []) for a in args]

	def groups(self, name):
		"""Each occurrence separately -- @pkg takes a whole line as one unit."""
		assert name in DIRECTIVE_LIST, f"{name} is not an accumulating directive"
		return [args for _ln, args in self.raw.get(name, []) if args]

	def line(self, name):
		entries = self.raw.get(name)
		return entries[0][0] if entries else None

	def names(self):
		return sorted(self.raw)


def host_os():
	p = sys.platform
	for prefix, name in (("linux", "linux"), ("darwin", "darwin"),
	                     ("freebsd", "freebsd"), ("openbsd", "openbsd"),
	                     ("netbsd", "netbsd"), ("win", "windows"),
	                     ("cygwin", "windows"), ("sunos", "solaris")):
		if p.startswith(prefix):
			return name
	return p


def host_arch():
	m = platform.machine().lower()
	return {"amd64": "x86_64", "x64": "x86_64", "arm64": "aarch64",
	        "i386": "x86", "i486": "x86", "i586": "x86",
	        "i686": "x86"}.get(m, m)


# Suffixes that state which platform a file is for. Only spellings that
# cannot plausibly mean anything else: `foo_win32.c` is Windows and nothing
# else, while `foo_win.c` could be a window and `foo_mac.c` a MAC address.
# `_posix` and `_unix` are families rather than platforms -- fmake's own
# README uses `util_posix.c` as an example of a file it copes with -- and a
# family needs a rule about membership that nothing here has.
PLATFORM_SUFFIXES = {
    "linux": ("os", "linux"),
    "darwin": ("os", "darwin"), "macos": ("os", "darwin"),
    "windows": ("os", "windows"), "win32": ("os", "windows"),
    "win64": ("os", "windows"),
    "freebsd": ("os", "freebsd"), "openbsd": ("os", "openbsd"),
    "netbsd": ("os", "netbsd"), "solaris": ("os", "solaris"),
    "android": ("os", "android"), "ios": ("os", "ios"),
    "haiku": ("os", "haiku"),
    "x86_64": ("arch", "x86_64"), "amd64": ("arch", "x86_64"),
    "aarch64": ("arch", "aarch64"), "arm64": ("arch", "aarch64"),
    "riscv64": ("arch", "riscv64"), "ppc64": ("arch", "ppc64"),
    "ppc64le": ("arch", "ppc64le"), "i386": ("arch", "x86"),
    "mips64": ("arch", "mips64"), "s390x": ("arch", "s390x"),
}

# Longest first: `foo_x86_64.c` ends with `_x86_64` and with `_64`, and only
# one of those is a claim about anything.
_PLATFORM_ORDER = sorted(PLATFORM_SUFFIXES, key=len, reverse=True)

# The same words in front, which is the other half of the same convention:
# hydra names its four Android sources `android_view.cpp`, and the rule
# written for that report did not fire on the tree that asked for it.
#
# `ios` is excluded here and kept only as a suffix. `ios_utils.cpp` about
# C++ iostreams is an ordinary file to write, and a rule whose safety
# argument is that a word cannot mean anything else does not get to keep a
# word that can.
PLATFORM_PREFIX_UNSAFE = {"ios"}


def filename_platform(rel):
	"""(kind, value, word) the file's name claims, or None."""
	stem = os.path.splitext(os.path.basename(rel))[0].lower()
	for word in _PLATFORM_ORDER:
		if stem.endswith("_" + word):
			kind, value = PLATFORM_SUFFIXES[word]
			return kind, value, word
	for word in _PLATFORM_ORDER:
		if word in PLATFORM_PREFIX_UNSAFE:
			continue
		if stem.startswith(word + "_"):
			kind, value = PLATFORM_SUFFIXES[word]
			return kind, value, word
	return None


def filename_excludes(rel, ann, want_os=None, want_arch=None):
	"""Why the name says this TU belongs to another platform, or None.

    The file is what CMake would have put inside `if(ANDROID)`. It carries
    no self-guard, because the build system was what excluded it -- so
    fmake compiles it and fails on a header that is not there, which is one
    project's hard blocker and no flag fixes.

    An explicit `@os` or `@arch` wins outright, including one that names
    the platform being built for: the name is a convention and the
    annotation is a statement, and a file that says both means the second.
    """
	if ann.items("os") or ann.items("arch"):
		return None
	got = filename_platform(rel)
	if not got:
		return None
	kind, value, suffix = got
	want = ((want_os or host_os()) if kind == "os"
	        else (want_arch or host_arch()))
	if value == want:
		return None
	return (f"named for {value} only (building for {want}); "
	        f"@{kind} overrides the name")


def platform_excludes(ann, want_os=None, want_arch=None):
	"""Why this TU is not built for the target platform, or None if it is.

    The platform tested is the one being built *for*. On a native build that
    is the host; on a cross build [toolchain] os/arch says otherwise, and
    testing the host instead is silently wrong every time.
    """
	want_os = want_os or host_os()
	want_arch = want_arch or host_arch()
	oses = [o.lower() for o in ann.items("os")]
	if oses and want_os not in oses:
		return f"@os {' '.join(oses)} (building for {want_os})"
	arches = [a.lower() for a in ann.items("arch")]
	if arches and want_arch not in arches:
		return f"@arch {' '.join(arches)} (building for {want_arch})"
	return None


