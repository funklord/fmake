def _rel(path, root):
    """Shorten absolute paths for display; commands stay copy-pasteable."""
    try:
        r = os.path.relpath(path, root)
    except ValueError:
        return path
    return path if r.startswith("..") else r


def _show_cmd(cmd, root):
    out = []
    for a in cmd:
        if os.path.isabs(a):
            out.append(_rel(a, root))
        elif a[:2] in ("-I", "-L") and os.path.isabs(a[2:]):
            out.append(a[:2] + _rel(a[2:], root))
        else:
            out.append(a)
    return " ".join(out)


def explain(t, cl, cfg, incflags, outdir, all_units, root, other_roots=(),
            res=None, excluded=None, conf=None):
    W = 36
    name = t.filename
    if t.conf.get("name") or t.conf.get("kind") or t.conf.get("sources"):
        named = f"[target.*] in {CONF_FILE}"
    elif t.ann.scalar("target"):
        named = "@target"
    else:
        named = "no @target"
    print(f"{BOLD('target')} {BOLD(name)} ({t.kind})  {DIM('[' + named + ']')}")
    if t.members is not None:
        print(f"  {CYAN('membership'):<{W}}"
              f"{DIM('declared, so the closure is not consulted')}")

    # Directives are reported per file, because an unknown one is ignored in
    # silence and this is the only place a typo becomes visible.
    seen = [(u.rel, u.ann) for u in cl.link if u.ann]
    if seen:
        print(f"  {CYAN('directives')}")
        for rel, ann in seen:
            for d in ann.names():
                # Read each directive the way it is declared, not uniformly.
                vals = (ann.scalar(d, "") if d in DIRECTIVE_SCALAR
                        else " ".join(ann.items(d))) or "(no arguments)"
                head = f"@{d} {vals}"
                if len(head) > W - 5:
                    head = head[:W - 8] + "..."
                print(f"    {head:<{W-4}}"
                      f"{DIM(rel + ':' + str(ann.line(d)))}")

    if conf:
        print(f"  {CYAN('configuration')}")
        print(f"    {CONF_FILE:<{W-4}}"
              f"{DIM('profile: ' + (conf.profile_name or 'none'))}")
        if cfg.os != host_os() or cfg.arch != host_arch():
            print(f"    {'building for':<{W-4}}"
                  f"{DIM(cfg.os + '/' + cfg.arch + '  (host is '
                         + host_os() + '/' + host_arch() + ')')}")

    if excluded:
        print(f"  {CYAN('excluded here')}")
        for rel, why in sorted(excluded.items()):
            print(f"    {rel:<{W-4}}{DIM(why)}")
    if t.members is not None:
        how = f"[declared in {CONF_FILE}]"
    elif t.kind != "exe":
        how = "[every TU in the tree; a library is not pruned]"
    else:
        how = "[symbol closure from " + _rel(cl.root.obj, root) + "]"
    print(f"  {CYAN('link set'):<{W}}{DIM(how)}")
    for u in cl.link:
        if u is cl.root and t.kind == "exe":
            print(f"    {u.rel:<{W-4}}{DIM('root: defines main()')}")
        elif u is cl.root:
            print(f"    {u.rel:<{W-4}}{DIM('part of the library')}")
        else:
            sym, by = cl.why.get(u.rel, ("?", "?"))
            why = sym if not by else f"<- {sym}  ({by})"
            print(f"    {u.rel:<{W-4}}{DIM(why)}")

    # Other programs' roots are compiled but obviously not part of this one;
    # listing them as unreachable reads like a problem when it isn't.
    linked = {u.rel for u in cl.link}
    spare = [u for u in all_units
             if u.rel not in linked and u.rel not in other_roots]
    if spare:
        print(f"  {CYAN('compiled, not linked')}")
        for u in spare:
            print(f"    {u.rel:<{W-4}}{DIM('defines nothing reachable')}")

    if res and (res["chosen"] or res["unresolved"] or res["unused"]):
        print(f"  {CYAN('libraries'):<{W}}"
              f"{DIM('[from the external symbols above]')}")
        for lib in res["chosen"]:
            syms = res["why"].get(lib, [])
            shown = ", ".join(syms[:3]) + (" ..." if len(syms) > 3 else "")
            src = res["proposed"].get(lib)
            tag = f"[also {src[2]} at {src[1]}]" if src else ""
            print(f"    -l{lib:<{W-6}}{DIM(shown)}")
            if tag:
                print(f"    {'':<{W-4}}{DIM(tag)}")
            for alt in res["alts"].get(lib, [])[:3]:
                print(f"    {'':<{W-4}}{DIM('could also come from -l' + alt)}")
        for lib, (module, where, header) in sorted(res["unused"].items()):
            print(f"    {'(not linked)':<{W-4}}"
                  f"{DIM(f'{header} at {where} suggests {module}, but no '
                         f'symbol needs it')}")
        for lib in res.get("declared", []):
            print(f"    {'-l' + lib:<{W-4}}"
                  f"{DIM('declared with @libs / @pkg; linked regardless')}")
        for w in res.get("wrap", []):
            print(f"    {'-Wl,--wrap=' + w:<{W-4}}"
                  f"{DIM('the link set defines __wrap_' + w)}")
        if res["unresolved"]:
            print(f"    {'(unresolved)':<{W-4}}"
                  f"{DIM(', '.join(res['unresolved'][:6]))}")
            print(f"    {'':<{W-4}}"
                  f"{DIM('no ' + describe_identity(res.get('ident'))
                         + ' library exports these -- name it with --ldflags')}")

    if VERBOSE:
        print(f"  {CYAN('library search'):<{W}}"
              f"{DIM(describe_identity((res or {}).get('ident')) + ' only')}")
        for d in cfg.libdirs:
            shown = os.path.normpath(_rel(d, root))
            if len(shown) > W - 5:
                shown = "..." + shown[-(W - 8):]
            print(f"    {shown:<{W-4}}"
                  f"{DIM(str(len(linkable_libs([d]))) + ' linkable')}")

    if cl.external:
        implicit = len(res["implicit"]) if res else 0
        named = sum(len(v) for v in (res["why"].values() if res else []))
        print(f"  {CYAN('external symbols'):<{W}}"
              f"{DIM(f'[{len(cl.external)} total, {implicit} in libc, '
                     f'{named} from the libraries above]')}")
        for sym in sorted(cl.external)[:12]:
            print(f"    {sym:<{W-4}}"
                  f"{DIM('referenced by ' + cl.external[sym][0])}")
        if len(cl.external) > 12:
            print(f"    {DIM('... and %d more (-v for all)' % (len(cl.external) - 12))}")

    ldflags = (res["ldflags"] if res else []) + cfg.ldflags
    print(f"  {CYAN('flags')}")
    print(f"    {' '.join(cfg.cflags + ['-I' + _rel(f[2:], root) if f.startswith('-I') else f for f in incflags] + cfg.override)}")
    if ldflags:
        print(f"    {' '.join(ldflags)}")
    print(f"  {CYAN('argv')}")
    for u in cl.link[:2]:
        print(f"    {DIM(_show_cmd(compile_cmd(u, cfg, incflags), root))}")
    if len(cl.link) > 2:
        print(f"    {DIM('... %d more' % (len(cl.link) - 2))}")
    # The same call the linker gets, not a second rendering of it.
    shown = link_cmd(t, cl, cfg, outdir, res["ldflags"] if res else [])
    print(f"    {DIM(_show_cmd(shown, root))}")
    print()

