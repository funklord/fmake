# Toolchain & configuration
# ---------------------------------------------------------------------------

def tool_version(exe):
	try:
		r = subprocess.run([exe, "--version"], capture_output=True, text=True, errors="replace")
		return (r.stdout or r.stderr).splitlines()[0].strip()
	except (OSError, IndexError):
		return "?"


RE_TOOL_PREFIX = re.compile(r"^(.*-)(?:gcc|g\+\+|cc|c\+\+|clang(?:\+\+)?)"
                            r"(?:-\d+(?:\.\d+)*)?$")


def _tool_prefix(cc):
	"""The target prefix a compiler name carries, or None.

    aarch64-linux-gnu-gcc -> "aarch64-linux-gnu-". Plain cc, gcc or clang
    carry none, which is the native case.
    """
	m = RE_TOOL_PREFIX.match(os.path.basename(cc))
	return m.group(1) if m else None


def find_nm(configured=None):
	for cand in (os.environ.get("NM"), configured, "nm", "llvm-nm", "gnm"):
		if cand and shutil.which(cand):
			return shutil.which(cand)
	die("no nm found. fmake reads object symbol tables to work out the "
	    "link set; install binutils or llvm, or set $NM.")


class Config:
	def __init__(self, args, conf=None):
		# `conf or Conf({})` looks equivalent and is not: __bool__ answers
		# "is there a config file", so a Conf carrying directives folded in
		# from fmake.mk is falsy when there is no fmake.toml, and `or` threw
		# it away. A __bool__ that means something domain-specific defeats
		# every `x or y` in the file.
		conf = conf if conf is not None else Conf({})
		tool = conf.tool

		# $CC beats fmake.toml, per the precedence chain: the environment is
		# the outermost level, so a one-off cross build needs no edit.
		# A tool built to run *here* is a separate build for a separate
		# machine, and its objects are foreign on purpose.
		self.for_build_machine = getattr(args, "use_build_toolchain", False)
		self.cc      = os.environ.get("CC")  or tool.get("cc", "cc")
		# aarch64-linux-gnu-gcc implies aarch64-linux-gnu-nm and -ar. Naming
		# the compiler should be enough; a host nm can often read foreign
		# objects, but relying on that is luck rather than design.
		self.prefix  = _tool_prefix(self.cc)
		# The C++ compiler was the one this rule was written for and did not
		# reach, because it was chosen a line above the prefix that would
		# have derived it. A cross build with no `cxx' named compiled C++
		# with the host compiler, linked with it, produced an x86-64 binary
		# for a tree declaring aarch64, and said `built prog'. Nothing was
		# wrong anywhere a person would look.
		self.cxx     = (os.environ.get("CXX") or tool.get("cxx")
		                or self._prefixed("g++") or self._prefixed("c++")
		                or "c++")
		self.triplet = _stdout([self.cc, "-print-multiarch"]).strip() \
		               or _stdout([self.cc, "-dumpmachine"]).strip()
		self.nm      = find_nm(tool.get("nm")
		                       or self._prefixed("nm"))
		self.sysroot = tool.get("sysroot")
		# rustc takes no prefix. It targets by `--target <triple>' rather
		# than by being a differently-named binary, which is clang's model
		# and not gcc's -- so _prefixed would look for a tool nobody ships.
		self.rustc   = os.environ.get("RUSTC") or tool.get("rustc", "rustc")
		# 2015 is rustc's default and is the wrong one for almost every
		# tree written since: `mod' paths and `dyn' both changed. There is
		# no Cargo.toml to read it from, because a tool whose premise is
		# that a tree needs no build file cannot begin by reading one, so
		# it is a setting with a modern default.
		self.rust_edition = str(tool.get("rust-edition") or RUST_EDITION)

		# A cross build must test @os/@arch against the machine being built
		# *for*, not the one doing the building. Without this the host is
		# assumed, which is silently wrong for every cross compilation.
		self.os      = tool.get("os") or host_os()
		self.arch    = tool.get("arch") or host_arch()

		# Three bands, general to specific: defaults and fmake.toml, then
		# each file's own annotations, then the command line. Later wins at
		# the compiler, so the command line has to come last or --cflags -O0
		# cannot override a file that asked for -O2 -- which is exactly what
		# anyone reaching for the flag is trying to do.
		# The two switchable bands are kept nameable rather than being
		# stirred into cflags and lost, because --eject has to emit them as
		# Make conditionals instead of baking them in. An ejected build that
		# ignores DEBUG is worse than one that never offered it: `make
		# DEBUG=1' reports success and quietly builds a release.
		#
		# opt_flags is empty when --cflags replaced the defaults, which is
		# also the right answer for the ejected file -- somebody who forced
		# the flags gets them baked, because that is what forcing them means.
		self.opt_flags = [] if args.cflags else default_cflags()
		self.sanitize_flags = (list(SANITIZE_CFLAGS) if sanitize_wanted()
		                       else [])

		self.cflags   = list(self.opt_flags)
		self.cflags  += conf.cflags()
		self.override = list(args.cflags)
		self.ldflags = conf.ldflags() + list(args.ldflags)
		# rustc's band is its own. --cflags is a C flag list and handing it
		# to rustc would fail on the first -Os; $RUSTFLAGS is the spelling
		# every Rust toolchain already uses for this.
		self.rustflags = default_rustflags() + shlex.split(
		    os.environ.get("RUSTFLAGS", "")) + conf.rustflags()

		# $SANITIZE goes to both sides, and the link side is the one that
		# matters. A sanitizer is a runtime as well as an instrumentation:
		# compiled but not linked leaves every __asan_report_* undefined,
		# which is the failure netcfgd reported in section 76 and arrives
		# as a wall of link errors naming none of this.
		#
		# Appended after the bands above rather than inside them, so that
		# --cflags cannot drop it: replacing the defaults is what that flag
		# is for, and asking for a sanitized build and silently not getting
		# one is the shape this exists to avoid. A file's own @cflags still
		# wins, because a `-fno-sanitize=` written next to the code is
		# somebody saying they know about that file.
		if self.sysroot:
			self.cflags.append("--sysroot=" + self.sysroot)
			self.ldflags.insert(0, "--sysroot=" + self.sysroot)

		# Last, and it has to stay last: base_cflags() takes these back off
		# the end by length, so anything appended after them would be
		# removed instead.
		self.cflags += self.sanitize_flags

		if not shutil.which(self.cc):
			# `CC="clang --target=aarch64-linux-gnu"' is how a toolchain
			# that does not prefix its tools is normally named, and it is
			# one string with a space in it -- so the failure is "no such
			# program" and looks nothing like the cause. fmake takes a
			# program here rather than a command line, because a flag like
			# --target changes what -print-search-dirs and -print-multiarch
			# answer and those are asked separately.
			if len(shlex.split(self.cc)) > 1:
				die(f"C compiler {self.cc!r} not found -- that is a command "
				    f"line, and fmake takes a program.\n"
				    f"Name the compiler alone, and put its flags in "
				    f"[project] cflags: they reach the compile and the link "
				    f"alike, which is what a --target needs.")
			die(f"C compiler {self.cc!r} not found "
			    f"(set $CC, or [toolchain] cc in {CONF_FILE})")
		self.ar     = (os.environ.get("AR") or tool.get("ar")
		               or self._prefixed("ar")
		               or shutil.which("ar") or shutil.which("llvm-ar"))
		# The bare name in an ejected build file: a resolved absolute path
		# would not survive being carried to another machine.
		self.ar_name = (os.environ.get("AR") or tool.get("ar")
		                or os.path.basename(self.ar or "ar"))
		self.pkgexe = tool.get("pkg-config") or self._prefixed("pkg-config")
		# Not prefixed like the binutils are: moc runs here and emits C++, so
		# a cross build wants the build machine's moc, not a target one it
		# could not execute. Only asking is reliable, so there is no guess.
		self.moc    = tool.get("moc")
		self.uic    = tool.get("uic")
		self.rcc    = tool.get("rcc")
		self.extra_libdirs = list(tool.get("lib-dirs", []))
		self.ccver  = tool_version(self.cc)
		self.cxxver = tool_version(self.cxx) if shutil.which(self.cxx) else "?"
		# The profile is in here through cflags, so switching profiles gets a
		# separate object directory rather than invalidating the old one.
		self._libdirs = None
		self.refresh_key()

	def link_flags(self):
		"""The project-wide compile flags, plus the link-only ones.

        **The compile flags belong on the link line**, and leaving them off
        was a real defect rather than a tidiness. A whole family of flags is
        an instrumentation *and* a runtime, and the compiler only links the
        runtime if it sees the flag again at link time:

          --coverage   undefined reference to `__gcov_exit' -- a hard
                       failure, which is the lucky case
          -pg          links, runs, and writes no gmon.out at all: the
                       profiler silently does nothing
          -fopenmp     undefined GOMP_* the moment a pragma is used
          -flto        works here only because GCC's fat objects let the
                       linker plugin cope

        The sanitizers were special-cased for exactly this reason after
        netcfgd hit it (section 76), and special-casing them one at a time
        is a hand-written list of the kind section 15 already warns about
        three of. Passing the project's compile flags is what the sibling
        Makefiles do -- `LDFLAGS ?= $(CFLAGS)` -- and it needs no list.

        Harmless in the other direction: `-I`, `-std=` and `-Wall` at a
        link line are accepted and do nothing. That asymmetry is the whole
        argument -- passing too much costs a longer command, passing too
        little costs a binary that is wrong in a way nothing reports.

        Per-file `@cflags` are not here, and must not be: they belong to
        one translation unit, which is section 4's asymmetry and the reason
        `@ldflags` exists separately.
        """
		return self.cflags + self.override + self.ldflags

	def base_cflags(self):
		"""cflags with the two switchable bands taken back off.

        What is left is what is genuinely a property of this tree -- the
        config file's flags, a sysroot, the language standard -- as opposed
        to what DEBUG and SANITIZE chose on this particular run. `--eject`
        wants that split, because those two have to come out the far side
        as Make conditionals rather than as baked-in text.

        Sliced by length rather than matched by value, so a project that
        legitimately writes `-Os` in its own cflags does not have somebody
        else's flag removed from it.
        """
		end = len(self.cflags) - len(self.sanitize_flags)
		return self.cflags[len(self.opt_flags):end]

	def refresh_key(self):
		"""Recompute the configuration identity.

        Must be called after anything changes cflags, including flags fmake
        adds for itself. The key names the object directory, so a flag that
        is not in it is a flag that silently reuses objects built without it.
        """
		# rustc and its flags are in the key for the reason everything
		# else is: a crate archive built at one opt-level must not be
		# reused for a build asking for another, and the object directory
		# is what keeps two configurations apart.
		self.key = sha(" ".join([self.cc, self.cxx, self.ccver, self.cxxver,
		                         self.os, self.arch,
		                         *self.cflags, "|", *self.override,
		                         "|", self.rustc, self.rust_edition,
		                         *self.rustflags]))[:12]

	def _prefixed(self, tool):
		"""The toolchain's own copy of a binutil, if there is one."""
		if not self.prefix:
			return None
		return shutil.which(self.prefix + tool)

	def driver(self, cxx):
		return self.cxx if cxx else self.cc

	@property
	def libdirs(self):
		if self._libdirs is None:
			self._libdirs = lib_search_dirs(self)
		return self._libdirs

