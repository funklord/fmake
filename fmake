def git_ignored(root, paths):
	"""Which of these git is already told to ignore, or an empty set.

    Not a signal fmake builds with -- what to compile is decided from the
    source, and adding a second authority for it is a design change rather
    than a diagnostic. This is only ever consulted while explaining a
    failure, where it costs one subprocess on a path that is about to exit
    anyway.

    It earns that on the commonest confusing case there is: a build output
    left in the tree, colliding with the file it was generated from. The
    reader is shown two files defining one symbol and no reason to prefer
    either, when git has known all along that one of them is not source.
    """
	if not os.path.isdir(os.path.join(root, ".git")) or not shutil.which("git"):
		return set()
	try:
		r = subprocess.run(["git", "-C", root, "check-ignore", "--stdin"],
		                   input="\n".join(paths), capture_output=True,
		                   text=True, errors="replace", timeout=10)
	except (OSError, subprocess.SubprocessError):
		return set()
	# 0 means some were ignored, 1 means none were; anything else is a
	# git that could not answer, and a guess here would be worse than
	# silence.
	if r.returncode not in (0, 1):
		return set()
	return {l.strip() for l in r.stdout.splitlines() if l.strip()}


def ensure_gitignore(root):
	if not os.path.isdir(os.path.join(root, ".git")):
		return
	path = os.path.join(root, ".gitignore")
	try:
		with open(path) as fh:
			if any(l.strip().rstrip("/") == STATE_DIR for l in fh):
				return
	except OSError:
		pass
	try:
		with open(path, "a") as fh:
			fh.write(f"{STATE_DIR}/\n")
	except OSError:
		pass


def _human(n):
	"""A byte count somebody can read at a glance."""
	for unit in ("B", "K", "M", "G"):
		if n < 1024 or unit == "G":
			return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
		n /= 1024.0


def do_clean(root):
	"""Remove the state directory, having checked it is the state directory.

	This is the one shape a wholesale removal is allowed to take: a
	directory the tool itself created, and which holds nothing else. Even
	then the path is verified rather than trusted, because the way a clean
	target eats something it should not is always a variable that did not
	contain what everyone assumed.

	A symlink is refused rather than followed -- `shutil.rmtree` declines a
	symlink anyway, but saying so is better than the traceback.
	"""
	state = os.path.join(root, STATE_DIR)
	if os.path.basename(state.rstrip(os.sep)) != STATE_DIR:
		die(f"refusing to clean {state!r}: that is not {STATE_DIR}/")
	if os.path.islink(state):
		die(f"refusing to clean {state!r}: it is a symlink, and what it "
		    f"points at is not fmake's to remove")
	if not os.path.isdir(state):
		info("nothing to clean")
		return 0

	# Generated sources, named one by one, for the reason `--uninstall' and
	# the ejected clean rule name theirs: this is removing files from
	# somebody's source tree, so it must not be able to take one it did not
	# write. The list is what the generators actually produced, read out of
	# the cache before the cache goes -- not a pattern, and not the declared
	# outputs, which would mean scanning the tree to find the rules that
	# live in source comments.
	#
	# The ejected Makefile has removed these since it first had a clean
	# rule. fmake not doing it was an inconsistency between the two, in the
	# direction of leaving a build behind that a fresh checkout would not
	# have.
	wrote = Cache(os.path.join(state, CACHE_FILE)).data.get(
	    "generated_outputs", {})
	removed = []
	for rel in sorted({o for outs in wrote.values() for o in outs}):
		# Inside the tree, and a file. A rule could name anything; this is
		# the one place that matters, because nothing else here deletes.
		full = os.path.normpath(os.path.join(root, rel))
		if not full.startswith(os.path.join(root, "")) or os.path.islink(full):
			continue
		if os.path.isfile(full):
			os.remove(full)
			removed.append(rel)
	if removed:
		info(f"removed {len(removed)} generated file(s): "
		     + ", ".join(removed[:4])
		     + (f", and {len(removed) - 4} more" if len(removed) > 4 else ""))
	count, bytes_ = 0, 0
	for base, _sub, files in os.walk(state):
		for f in files:
			count += 1
			try:
				bytes_ += os.lstat(os.path.join(base, f)).st_size
			except OSError:
				pass
	# The size, because it is the answer to the question that brings
	# anybody here. An object directory is kept per configuration on
	# purpose -- switching profiles or toolchains is then free -- and
	# nothing ever reclaims one, so a tree that has been built four ways
	# holds four sets. That is the intended trade and it is invisible
	# until this line says how much of it there is.
	shutil.rmtree(state)
	info(f"removed {STATE_DIR}/ ({count} file(s), {_human(bytes_)})")
	return 0

