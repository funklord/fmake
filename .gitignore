# fmake's own build state: objects, depfiles and the cache.
.fmake/

# Where an ejected Makefile or build.ninja puts its objects.
build/

# The build products of a tree fmake has been run in. The names come from
# the sources, so there is nothing general to match -- add your own.

__pycache__/
*.pyc

# Editor and tool state.
.claude/
*.swp
*~

# Packaging artefacts. fmake.1 is generated by `fmake --man`.
fmake.1
debian/fmake/
debian/files
debian/*.substvars
debian/*.debhelper.log
debian/.debhelper/
debian/debhelper-build-stamp
